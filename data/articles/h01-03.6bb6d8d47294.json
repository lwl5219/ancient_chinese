{"id":"h01-03","volume":1,"volumeTitle":"人间词话","volumeSubtitle":"六十四则","index":3,"title":{"t":"「有我之境」與「無我之境」","s":"「有我之境」与「无我之境」"},"book":{"t":"人間詞話","s":"人间词话"},"sourceHead":{"t":"國粹學報本","s":"国粹学报本"},"author":"王国维","annotated":true,"paragraphs":[{"sentences":[{"tr":"境界之中，有一种是有我之境，还有一种是无我之境。","tokens":[{"t":"有","s":"有","py":"","ctx":"有、存在。","pos":"","extra":"","level":"sentence"},{"t":"有","s":"有","py":"","ctx":"有、存在。","pos":"","extra":"","level":"sentence"},{"t":"我","s":"我","py":"","ctx":"我。","pos":"","extra":"","level":"sentence"},{"t":"之","s":"之","py":"","ctx":"的。","pos":"","extra":"","level":"sentence"},{"t":"境","s":"境","py":"","ctx":"境地。","pos":"","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"有","s":"有","py":"","ctx":"有、存在。","pos":"","extra":"","level":"sentence"},{"t":"無","s":"无","py":"","ctx":"没有。","pos":"","extra":"","level":"sentence"},{"t":"我","s":"我","py":"","ctx":"我。","pos":"","extra":"","level":"sentence"},{"t":"之","s":"之","py":"","ctx":"的。","pos":"","extra":"","level":"sentence"},{"t":"境","s":"境","py":"","ctx":"境地。","pos":"","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"“泪眼问花花不语，乱红飞过秋千去”，含着泪去问花，花却不回答，零乱的花瓣飞过秋千；“可堪孤馆闭春寒，杜鹃声里斜阳暮”，孤零零的客馆被春寒关住，杜鹃声里又是斜阳又是黄昏，叫人怎么受得了。这两处都是有我之境。","tokens":[{"t":"「","s":"「","punct":true},{"t":"淚","s":"泪","py":"","ctx":"泪。","pos":"","extra":"","level":"sentence"},{"t":"眼","s":"眼","py":"","ctx":"眼。","pos":"","extra":"","level":"sentence"},{"t":"問","s":"问","py":"","ctx":"问。","pos":"","extra":"","level":"sentence"},{"t":"花","s":"花","py":"","ctx":"花。","pos":"","extra":"","level":"sentence"},{"t":"花","s":"花","py":"","ctx":"花。","pos":"","extra":"","level":"sentence"},{"t":"不","s":"不","py":"","ctx":"表示否定。","pos":"","extra":"","level":"sentence"},{"t":"語","s":"语","py":"","ctx":"话。告诉别人读 yù。","pos":"","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"亂","s":"乱","py":"","ctx":"动乱、扰乱。","pos":"","extra":"","level":"sentence"},{"t":"紅","s":"红","py":"","ctx":"红色。","pos":"","extra":"","level":"sentence"},{"t":"飛","s":"飞","py":"","ctx":"飞。","pos":"","extra":"","level":"sentence"},{"t":"過","s":"过","py":"","ctx":"经过，或超过。","pos":"","extra":"","level":"sentence"},{"t":"鞦","s":"秋","py":"","ctx":"秋天。","pos":"","extra":"","level":"sentence"},{"t":"韆","s":"千","py":"","ctx":"千。","pos":"","extra":"","level":"sentence"},{"t":"去","s":"去","py":"","ctx":"离开，或去掉。","pos":"","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true},{"t":"」","s":"」","punct":true},{"t":"「","s":"「","punct":true},{"t":"可","s":"可","py":"","ctx":"可以、能够。","pos":"","extra":"","level":"sentence"},{"t":"堪","s":"堪","py":"","ctx":"能够承受。","pos":"","extra":"","level":"sentence"},{"t":"孤","s":"孤","py":"","ctx":"孤单，或幼年丧父。","pos":"","extra":"","level":"sentence"},{"t":"館","s":"馆","py":"","ctx":"馆舍。","pos":"","extra":"","level":"sentence"},{"t":"閉","s":"闭","py":"","ctx":"关闭。","pos":"","extra":"","level":"sentence"},{"t":"春","s":"春","py":"","ctx":"春天。","pos":"","extra":"","level":"sentence"},{"t":"寒","s":"寒","py":"","ctx":"寒冷。","pos":"","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"杜","s":"杜","py":"","ctx":"堵塞。","pos":"","extra":"","level":"sentence"},{"t":"鵑","s":"鹃","py":"","ctx":"杜鹃。","pos":"","extra":"","level":"sentence"},{"t":"聲","s":"声","py":"","ctx":"声音。","pos":"","extra":"","level":"sentence"},{"t":"裡","s":"里","py":"","ctx":"里面，或长度单位。","pos":"","extra":"","level":"sentence"},{"t":"斜","s":"斜","py":"","ctx":"斜。","pos":"","extra":"","level":"sentence"},{"t":"陽","s":"阳","py":"","ctx":"山的南面、水的北面，或阳光。","pos":"","extra":"","level":"sentence"},{"t":"暮","s":"暮","py":"","ctx":"傍晚。","pos":"","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true},{"t":"」","s":"」","punct":true},{"t":"有","s":"有","py":"","ctx":"有、存在。","pos":"","extra":"","level":"sentence"},{"t":"我","s":"我","py":"","ctx":"我。","pos":"","extra":"","level":"sentence"},{"t":"之","s":"之","py":"","ctx":"的。","pos":"","extra":"","level":"sentence"},{"t":"境","s":"境","py":"","ctx":"境地。","pos":"","extra":"","level