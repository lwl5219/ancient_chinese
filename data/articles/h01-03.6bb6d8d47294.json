"。","punct":true},{"t":"」","s":"」","punct":true},{"t":"無","s":"无","py":"","ctx":"没有。","pos":"","extra":"","level":"sentence"},{"t":"我","s":"我","py":"","ctx":"我。","pos":"","extra":"","level":"sentence"},{"t":"之","s":"之","py":"","ctx":"的。","pos":"","extra":"","level":"sentence"},{"t":"境","s":"境","py":"","ctx":"境地。","pos":"","extra":"","level":"sentence"},{"t":"也","s":"也","py":"","ctx":"句末语气词，表示判断或肯定。","pos":"","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"有我之境是拿我自己去看外物，所以外物和我都染上了我的情绪色彩。","tokens":[{"t":"有","s":"有","py":"","ctx":"有、存在。","pos":"","extra":"","level":"sentence"},{"t":"我","s":"我","py":"","ctx":"我。","pos":"","extra":"","level":"sentence"},{"t":"之","s":"之","py":"","ctx":"的。","pos":"","extra":"","level":"sentence"},{"t":"境","s":"境","py":"","ctx":"境地。","pos":"","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"以","s":"以","py":"","ctx":"用、拿。","pos":"","extra":"","level":"sentence"},{"t":"我","s":"我","py":"","ctx":"我。","pos":"","extra":"","level":"sentence"},{"t":"觀","s":"观","py":"","ctx":"看。","pos":"","extra":"","level":"sentence"},{"t":"物","s":"物","py":"","ctx":"事物。","pos":"","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"故","s":"故","py":"","ctx":"所以。也指旧。","pos":"","extra":"","level":"sentence"},{"t":"物","s":"物","py":"","ctx":"事物。","pos":"","extra":"","level":"sentence"},{"t":"我","s":"我","py":"","ctx":"我。","pos":"","extra":"","level":"sentence"},{"t":"皆","s":"皆","py":"","ctx":"都。","pos":"","extra":"","level":"sentence"},{"t":"著","s":"著","py":"zhuó","ctx":"穿。","pos":"","extra":"","level":"sentence"},{"t":"我","s":"我","py":"","ctx":"我。","pos":"","extra":"","level":"sentence"},{"t":"之","s":"之","py":"","ctx":"的。","pos":"","extra":"","level":"sentence"},{"t":"色","s":"色","py":"","ctx":"颜色，或景色。","pos":"","extra":"","level":"sentence"},{"t":"彩","s":"彩","py":"","ctx":"彩色。","pos":"","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"无我之境是顺着物去看物，所以分不清哪一边是我，哪一边是物。","tokens":[{"t":"無","s":"无","py":"","ctx":"没有。","pos":"","extra":"","level":"sentence"},{"t":"我","s":"我","py":"","ctx":"我。","pos":"","extra":"","level":"sentence"},{"t":"之","s":"之","py":"","ctx":"的。","pos":"","extra":"","level":"sentence"},{"t":"境","s":"境","py":"","ctx":"境地。","pos":"","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"以","s":"以","py":"","ctx":"用、拿。","pos":"","extra":"","level":"sentence"},{"t":"物","s":"物","py":"","ctx":"事物。","pos":"","extra":"","level":"sentence"},{"t":"觀","s":"观","py":"","ctx":"看。","pos":"","extra":"","level":"sentence"},{"t":"物","s":"物","py":"","ctx":"事物。","pos":"","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"故","s":"故","py":"","ctx":"所以。也指旧。","pos":"","extra":"","level":"sentence"},{"t":"不","s":"不","py":"","ctx":"表示否定。","pos":"","extra":"","level":"sentence"},{"t":"知","s":"知","py":"","ctx":"知道、了解。有时同“智”。","pos":"","extra":"","level":"sentence"},{"t":"何","s":"何","py":"","ctx":"什么、为什么、哪里。","pos":"","extra":"","level":"sentence"},{"t":"者","s":"者","py":"","ctx":"……的人，或……的事物。","pos":"","extra":"","level":"sentence"},{"t":"爲","s":"为","py":"","ctx":"做、是、成为。","pos":"","extra":"","level":"sentence"},{"t":"我","s":"我","py":"","ctx":"我。","pos":"","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"何","s":"何","py":"","ctx":"什么、为什么、哪里。","pos":"","extra":"","level":"sentence"},{"t":"者","s":"者","py":"","ctx":"……的人，或……的事物。","pos":"","extra":"","level":"sentence"},{"t":"爲","s":"为","py":"","ctx":"做、是、成为。","pos":"","extra":"","level":"sentence"},{"t":"物","s":"物","py":"","ctx":"事物。","pos":"","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"古人填词，写有我之境的占多数，但并不是不能写无我之境，这就要看是不是豪杰之士，能够自己立得住。","tokens":[{"t":"古","s":"古","py":"","ctx":"古代。","pos":"","extra":"","level":"sentence"},{"t":"人","s":"人","py":"","ctx":"人。","pos":"","extra":"","level":"sentence"},{"t":"爲","s":"为","py":"","ctx":"做、是、成为。","pos":"","extra":"","level":"sentence"},{"t":"詞","s":"词","py":"","ctx":"词，或言辞。","pos":"","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"寫","s":"写","py":"","ctx":"书写。","pos":"","extra":"","level":"sentence"},{"t":"有","s":"有","py":"","ctx":"有、存在。","pos":"","extra":"","level":"sentence"},{"t":"我","s":"我","py":"","ctx":"我。","pos":"","extra":"","level":"sentence"},{"t":"之","s":"之","py":"","ctx":"的。","pos":"","extra":"","level":"sentence"},{"t":"境","s":"境","py":"","ctx":"境地。","pos":"","extra":"","level":"sentence"},{"t":"者","s":"者","py":"","ctx":"……的人，或……的事物。","pos":"","extra":"","level":"sentence"},{"t":"爲","s":"为","py":"","ctx":"做、是、成为。","pos":"","extra":"","level":"sentence"},{"t":"多","s":"多","py":"","ctx":"多。","pos":"","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"然","s":"然","py":"","ctx":"这样。附在描写词后面，表示那种样子。","pos":"","extra":"","level":"sentence"},{"t":"未","s":"未","py":"","ctx":"还没有。","pos":"","extra":"","level":"sentence"},{"t":"始","s":"始","py":"","ctx":"开始。","pos":"","extra":"","level":"sentence"},{"t":"不","s":"不","py":"","ctx":"表示否定。","pos":"","extra":"","level":"sentence"},{"t":"能","s":"能","py":"","ctx":"能够。","pos":"","extra":"","level":"sentence"},{"t":"寫","s":"写","py":"","ctx":"书写。","pos":"","extra":"","level":"sentence"},{"t":"無","s":"无","py":"","ctx":"没有。","pos":"","extra":"","level":"sentence"},{"t":"我","s":"我","py":"","ctx":"我。","pos":"","extra":"","level":"sentence"},{"t":"之","s":"之","py":"","ctx":"的。","pos":"","extra":"","level":"sentence"},{"t":"境","s":"境","py":"","ctx":"境地。","pos":"","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"此","s":"此","py":"","ctx":"这、这个。","pos":"","extra":"","level":"sentence"},{"t":"在","s":"在","py":"","ctx":"在。","pos":"","extra":"","level":"sentence"},{"t":"豪","s":"豪","py":"","ctx":"豪杰，或强横。","pos":"","extra":"","level":"sentence"},{"t":"傑","s":"杰","py":"","ctx":"杰出的人。","pos":"","extra":"","level":"sentence"},{"t":"之","s":"之","py":"","ctx":"的。","pos":"","extra":"","level":"sentence"},{"t":"士","s":"士","py":"","ctx":"士人、读书人，或兵士。","pos":"","extra":"","level":"sentence"},{"t":"能","s":"能","py":"","ctx":"能够。","pos":"","extra":"","level":"sentence"},{"t":"自","s":"自","py":"","ctx":"自己，或从。","pos":"","extra":"","level":"sentence"},{"t":"樹","s":"树","py":"","ctx":"树。","pos":"","extra":"","level":"sentence"},{"t":"立","s":"立","py":"","ctx":"站立，或立刻。","pos":"","extra":"","level":"sentence"},{"t":"耳","s":"耳","py":"","ctx":"而已。","pos":"","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"本则是王国维《人间词话》第三则。这些已刊则文于1908年至1909年连载在《国粹学报》上。王国维把境界分成有我和无我。有我举的是“泪眼问花花不语，乱红飞过秋千去”和“可堪孤馆闭春寒，杜鹃声里斜阳暮”。前两句通常读作欧阳修《蝶恋花》里的句子，后两句出自秦观《踏莎行》。无我举的是陶渊明《饮酒》的“采菊东篱下，悠然见南山”，以及元好问《颍亭留别》的“寒波澹澹起，白鸟悠悠下”。他没有在则文里写出这四位的名字，只引了句子。","theme":"这一则分辨两种境界。有我之境是拿自己的心情去看事物，事物跟着带上我的色彩：问花的人在流泪，花就不回答，春寒、杜鹃、斜阳都变得难以承受。无我之境是顺着物去看物，采菊的人和南山、寒波和白鸟各在自己的状态里，读的人分不清哪里是我、哪里是物。他承认古人填词多数写有我，又认为无我并不是写不出来，只是要作者自己立得住。泪眼问花、可堪孤馆属于有我；采菊东篱、寒波澹澹属于无我。","technique":"先下两个名目，再用引文归类，然后各给一句定义，最后落到填词的难易。有我的两处引文都把人的难堪放在景物前面：泪眼、可堪。无我的两处引文里，人和物并排出现，情绪不往外物上涂。定义用“以我观物”对“以物观物”，结果分别是“皆著我之色彩”和“不知何者为我，何者为物”。末句“未始不能……耳”先否定“不能”，再用“耳”把条件收成一句：关键在豪杰之士能自树立。诗句按他写下的文字讲解，陶诗这里是“见南山”。","keyContentWords":[{"word":"有我之境","reading":"yǒu wǒ zhī jìng","note":"以我观物得到的境界。泪眼问花、可堪孤馆两处，景物都带着观景人的哀苦。"},{"word":"无我之境","reading":"wú wǒ zhī jìng","note":"以物观物得到的境界。采菊见山、寒波白鸟两处，物象按自己的样子出现。"},{"word":"著","reading":"zhuó","note":"附着、染上。读 zhuó。“皆著我之色彩”是外物和我都染上了我的感情颜色。"},{"word":"可堪","reading":"kě kān","note":"哪能忍受。秦观这句用可堪把孤馆、春寒、杜鹃、斜阳都收进难以承受的心情。"}],"keyFunctionWords":[{"word":"以","reading":"yǐ","note":"凭着、用。“以我观物”是拿我做观看的出发点，“以物观物”是顺着物去看。"},{"word":"何","reading":"hé","note":"疑问代词，哪一个。“何者为我，何者为物”是分不出彼此。"}],"ancientModern":[{"word":"物","note":"外界的景物、事物。不是现代口语里的物品、货物。"},{"word":"色彩","note":"感情染上去的色调。不是单指颜料的颜色。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"观","note":"观物的观是动词，观看、对待。以我、以物说明观看时站在哪一边。"}],"specialSyntax":[{"name":"……也","note":"“有我之境也”“无我之境也”是判断句。也字放在句末，给前面的引文归类。"},{"name":"未始不能","note":"未始加上不能，两层否定，意思是并非不能。后面的耳把话说成仅仅取决于能不能自树立。"}]}}