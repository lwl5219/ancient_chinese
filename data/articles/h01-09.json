"","pos":"","extra":"","level":"dict"},{"t":"月","s":"月","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"鏡","s":"镜","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"中","s":"中","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"象","s":"象","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"言","s":"言","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"盡","s":"尽","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"意","s":"意","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"窮","s":"穷","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true},{"t":"」","s":"」","punct":true},{"t":"余","s":"余","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"謂","s":"谓","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"：","s":"：","punct":true},{"t":"北","s":"北","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"宋","s":"宋","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"前","s":"前","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"詞","s":"词","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"亦","s":"亦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"復","s":"复","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"如","s":"如","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"是","s":"是","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"可是严羽所说的兴趣，王士禎所说的神韵，还只说到了它的外表；不如我拈出“境界”这两个字，才算探到了根本。","tokens":[{"t":"然","s":"然","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"滄","s":"沧","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"浪","s":"浪","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"謂","s":"谓","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"興","s":"兴","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"趣","s":"趣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"阮","s":"阮","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"亭","s":"亭","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"謂","s":"谓","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"神","s":"神","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"韻","s":"韵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"猶","s":"犹","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"過","s":"过","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"道","s":"道","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"面","s":"面","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"目","s":"目","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"若","s":"若","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"鄙","s":"鄙","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"拈","s":"拈","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"出","s":"出","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"「","s":"「","punct":true},{"t":"境","s":"境","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"界","s":"界","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"」","s":"」","punct":true},{"t":"二","s":"二","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"字","s":"字","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"探","s":"探","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"本","s":"本","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"本则是王国维《人间词话》第九则。这些已刊则文于1908年至1909年连载在《国粹学报》上。王国维先引严羽《沧浪诗话》论盛唐：唯在兴趣，羚羊挂角，无迹可求，妙处透彻玲珑，不可凑泊，如空中之音、相中之色、水中之月、镜中之象，言有尽而意无穷。他说北宋以前的词也是这样。然后他点出王士禎号阮亭，说严羽的兴趣、阮亭的神韵都只说到面目，自己拈出的境界两个字才是探本。","theme":"这一则把境界和前人的两个术语放在一起比。严羽用兴趣形容盛唐诗歌那种找不到着力痕迹、话完了意思还在的妙处，王国维认为北宋以前的词也有这种样子。他并不推翻这段描写，只把兴趣和神韵降为面目，也就是外面看得见的效果。境界才是这些效果从哪里来的根本。所以这一则是在给自己的术语排位置：兴趣、神韵可以说中外表，境界才探到本。","technique":"先整段引严羽，引文里连续用比喻：羚羊挂角、空中之音、相中之色、水中之月、镜中之象。引完用“余谓”接自己的话，把这段诗论移到北宋以前的词上，先表示赞同。第二句用“然”转折，把沧浪和阮亭并列，用“犹不过道其面目”压低他们，再用“不若”推出自己的“境界”，并用“面目”对“本”。论证的办法是先引权威把现象说满，再把现象收成外表，把自己的术语放在根本的位置。","keyContentWords":[{"word":"兴趣","reading":"xìng qù","note":"严羽的术语。兴读 xìng，指感情被触动后的那种诗味，不是今天说的业余爱好。"},{"word":"神韵","reading":"shén yùn","note":"王士禎论诗的术语，指诗里传出来的韵味。王国维认为它还停在面目上。"},{"word":"境界","reading":"jìng jiè","note":"王国维自己拈出的词。他认为这两个字探到的是本，比兴趣、神韵更深一层。"},{"word":"凑泊","reading":"còu bó","note":"凑近、拼合上去抓住。不可凑泊，是说那种妙处不能靠一块块拼出来。"}],"keyFunctionWords":[{"word":"犹","reading":"yóu","note":"仍然、还只是。“犹不过”把兴趣和神韵的作用限在面目。"},{"word":"不若","reading":"bù ruò","note":"比不上。用来比较沧浪、阮亭的说法和他自己拈出的境界。"}],"ancientModern":[{"word":"面目","note":"外表、看得到的样子。不是人的脸。道其面目，是只说到外面的效果。"},{"word":"相","note":"读 xiàng，事物呈现出来的相状。“相中之色”是相状里的颜色，不能按互相、照片去讲。"},{"word":"本","note":"根本。探其本是找到兴趣、神韵那些效果从哪里来，不是本子、笔记本。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"拈","note":"拈本是用手指取物。这里写提出一个批评术语，把“境界”两个字从现象里拈出来。"}],"specialSyntax":[{"name":"不若……为……也","note":"比较句加判断。不若引出更好的做法，为字说明这样做就是探其本，也字收住判断。"}]}}
