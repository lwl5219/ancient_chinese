{"id":"h01-09","volume":1,"volumeTitle":"人间词话","volumeSubtitle":"六十四则","index":9,"title":{"t":"「興趣」、「神韻」不如「境界」","s":"「兴趣」、「神韵」不如「境界」"},"book":{"t":"人間詞話","s":"人间词话"},"sourceHead":{"t":"國粹學報本","s":"国粹学报本"},"author":"王国维","annotated":true,"paragraphs":[{"sentences":[{"tr":"严羽在《沧浪诗话》里说：盛唐那些诗人，关键只在兴趣，好比羚羊夜里用角把自己挂在树上，地上寻不到踪迹。所以他们的妙处透彻玲珑，不能靠拼凑去抓住，就像空中的声音、物相里的颜色、水中的月亮、镜子里的形象，话有说完的时候，意思却没有尽头。我认为北宋以前的词，也同样是这样。","tokens":[{"t":"嚴","s":"严","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"滄","s":"沧","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"浪","s":"浪","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"《","s":"《","punct":true},{"t":"詩","s":"诗","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"話","s":"话","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"》","s":"》","punct":true},{"t":"謂","s":"谓","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"：","s":"：","punct":true},{"t":"「","s":"「","punct":true},{"t":"盛","s":"盛","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"唐","s":"唐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"諸","s":"诸","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"唯","s":"唯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"在","s":"在","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"興","s":"兴","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"趣","s":"趣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true},{"t":"羚","s":"羚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"羊","s":"羊","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"掛","s":"挂","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"角","s":"角","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"跡","s":"迹","py":"","ctx":"","po