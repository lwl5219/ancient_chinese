"pos":"","extra":"","level":"dict"},{"t":"書","s":"书","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"宋朝道君皇帝的《燕山亭》词，也有一点像这样。","tokens":[{"t":"宋","s":"宋","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"道","s":"道","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"皇","s":"皇","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"帝","s":"帝","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"《","s":"《","punct":true},{"t":"燕","s":"燕","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"山","s":"山","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"亭","s":"亭","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"》","s":"》","punct":true},{"t":"詞","s":"词","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"亦","s":"亦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"略","s":"略","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"似","s":"似","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"但是道君不过自己诉说这一生的悲戚，后主则简直像有释迦、基督把人类罪恶担在肩上的意思，两边的大小本来就不同。","tokens":[{"t":"然","s":"然","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"道","s":"道","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"過","s":"过","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"自","s":"自","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"道","s":"道","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"生","s":"生","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"世","s":"世","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"戚","s":"戚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"後","s":"后","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"主","s":"主","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"則","s":"则","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"儼","s":"俨","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"釋","s":"释","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"迦","s":"迦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"基","s":"基","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"督","s":"督","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"擔","s":"担","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"荷","s":"荷","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"類","s":"类","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"罪","s":"罪","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"惡","s":"恶","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"意","s":"意","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"大","s":"大","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"小","s":"小","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"固","s":"固","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"同","s":"同","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"矣","s":"矣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"王国维《人间词话》第十八则，1908–1909年连载于《国粹学报》。这一则用尼采（Friedrich Nietzsche）的话来称李煜的词。尼采说一切文学里他爱以血书的那种，王国维认为后主之词正是这样。以血书，是说句子从真实的灾祸里出来，不是用笔墨把哀愁写成好看的话。他又拉来宋徽宗赵佶的《燕山亭》作比。赵佶被尊为道君皇帝，这首词写于北行途中看见杏花。王国维承认略似，随即把尺度分开：徽宗只是自道本人一生的悲戚，后主的词则大到像把人类的罪过担起来。释迦与基督是王国维打的比方，用来量这种担负的大小，不是说李煜信奉基督，也不是说他的词在讲宗教。","theme":"论点是后主之词大于道君之词。两者都写帝王失国以后的痛，都能叫人想起用血来写，但痛的范围不同。以血书指的是话从真实灾祸里逼出来。李煜国亡身俘，词是这场灾祸的产物。《燕山亭》也写于被掳北去之后，所以说亦略似之；可是王国维用「不过自道生世之戚」把它圈在赵佶一个人的身世之内。后主则俨有释迦、基督担荷人类罪恶之意。俨有是看上去像有，比拟的是担负的大，不是坐实李煜的信仰。结尾「其大小固不同矣」，这一则要辨的就是这个大小。","technique":"三句先立一个外来的判词，再拿一个相近的例子来衬，最后用「不过……则……」把大小拆开。尼采的话整句引进，王国维不解释尼采，只把「以血书」扣在后主身上，用「真所谓……者也」接住。「亦略似之」先让《燕山亭》站到旁边，好像可以并列。「然」字一转，「不过」压住道君，「俨有」抬高后主。俨有不是断定，是说仿佛有这层意思。结尾用「固」把差别说成本来就在，不必再证。引文「一切文学，余爱以血书者」保持王国维的中文，不另换成尼采的德文。","keyContentWords":[{"word":"以血书","reading":"yǐ xuè shū","note":"用血来书写。借尼采的话，指词从真实灾祸里出来，比普通的哀愁句子重。"},{"word":"生世","reading":"shēng shì","note":"这一生、平生的遭际。「自道生世之戚」是自己诉说一生的悲戚。"},{"word":"戚","reading":"qī","note":"悲戚，忧伤。不是亲戚。"},{"word":"担荷","reading":"dān hè","note":"肩负。荷读 hè，是背负，不是荷花的荷。"},{"word":"俨有","reading":"yǎn yǒu","note":"仿佛有、看上去像有。比拟担负之大，并不坐实李煜信奉释迦或基督。"}],"keyFunctionWords":[{"word":"所谓","reading":"suǒ wèi","note":"人们说的、刚才那句话所说的。「真所谓以血书者」是把尼采的话接过来用。"},{"word":"不过","reading":"bú guò","note":"只是、仅仅。把道君的词限制在自道一生悲戚之内。"},{"word":"固","reading":"gù","note":"本来。「其大小固不同矣」是大小本来就不同。"}],"ancientModern":[{"word":"书","note":"这里是动词，书写。今天「书」多作名词，指一本书。"},{"word":"略","note":"略微、稍微。「亦略似之」是也有一点像，不是战略，也不是忽略。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"书","note":"名词用作动词。「以血书」是用血来写。"}],"specialSyntax":[{"name":"真所谓……者也","note":"用「所谓」接住别人的原话，再用「者也」做成判断，把后主的词断成以血书的那一类。"},{"name":"不过……则……","note":"「不过」把前项收小，「则」把后项推进到更大的一层。大小的对比靠这一转。"}]}}
