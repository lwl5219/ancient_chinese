,"ctx":"","pos":"","extra":"","level":"dict"},{"t":"老","s":"老","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true},{"t":"」","s":"」","punct":true},{"t":"劉","s":"刘","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"融","s":"融","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"齋","s":"斋","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"謂","s":"谓","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"：","s":"：","punct":true},{"t":"少","s":"少","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"游","s":"游","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"一","s":"一","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"生","s":"生","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"似","s":"似","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"專","s":"专","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"學","s":"学","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"此","s":"此","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"種","s":"种","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"我的看法是：冯正中的《玉楼春》说：「芳菲次第长相续，自是情多无处足。尊前百计得春归，莫为伤春眉黛促。」永叔一辈子好像专门学的就是这一种。","tokens":[{"t":"余","s":"余","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"謂","s":"谓","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"：","s":"：","punct":true},{"t":"馮","s":"冯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"正","s":"正","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"中","s":"中","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"《","s":"《","punct":true},{"t":"玉","s":"玉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"樓","s":"楼","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"春","s":"春","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"》","s":"》","punct":true},{"t":"詞","s":"词","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"：","s":"：","punct":true},{"t":"「","s":"「","punct":true},{"t":"芳","s":"芳","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"菲","s":"菲","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"次","s":"次","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"第","s":"第","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"長","s":"长","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"相","s":"相","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"續","s":"续","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"自","s":"自","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"是","s":"是","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"情","s":"情","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"多","s":"多","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"處","s":"处","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"足","s":"足","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true},{"t":"尊","s":"尊","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"前","s":"前","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"百","s":"百","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"計","s":"计","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"得","s":"得","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"春","s":"春","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"歸","s":"归","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"莫","s":"莫","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"傷","s":"伤","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"春","s":"春","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"眉","s":"眉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"黛","s":"黛","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"促","s":"促","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true},{"t":"」","s":"」","punct":true},{"t":"永","s":"永","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"叔","s":"叔","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"一","s":"一","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"生","s":"生","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"似","s":"似","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"專","s":"专","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"學","s":"学","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"此","s":"此","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"種","s":"种","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"王国维《人间词话》第二十二则，1908–1909年连载于《国粹学报》。圣俞是梅尧臣，融斋是刘熙载，少游是秦观，永叔是欧阳修，正中是冯延巳。刘熙载说过，秦观一辈子像专门在学梅尧臣《苏幕遮》里那种句子：梨花落尽，春天又结束，满地是残阳，绿色和烟一起老去。王国维顺着这个说法，另配一副：欧阳修一辈子像专门在学冯延巳《玉楼春》里那种句子，花继续开，情却总不够。引文里的「尊前」「长相续」「自是情多」都照王国维所写，不改成别本的字。","theme":"论点是北宋两家各有一个源头，而且两种源头不一样。梅尧臣这几句把春天的结束写成看得见的颜色：梨花落尽，地上是残阳，绿意跟着烟变老。刘熙载认为秦观一生的词就贴着这种景色里的迟暮。冯延巳那四句相反。花一轮接一轮，并不是没有春，而是情太多，没有地方放够；在酒杯前想尽办法把春留住，又劝人不要为伤春把眉皱起来。王国维认为欧阳修一生学的是这一种，学的是情感自己停不下来。两则判断用同一个「一生似专学此种」，把秦观和欧阳修分成两路。","technique":"结构是仿句。第一句先引梅词三句，再引刘熙载的判断，王国维自己不下结论。第二句用「余谓」接上，句式故意与刘熙载那句平行：同样是先引词，再下「一生似专学此种」。平行本身就是论证。读者要自己看出两种词的差别。一边是「春又了」「翠色和烟老」，季节在外面结束；一边是「情多无处足」「莫为伤春」，情感在里面还要继续。王国维不另加形容词，把分辨交给引文。「似」字两处都留着，不断然说他们自己声明过在学谁。","keyContentWords":[{"word":"次第","reading":"cì dì","note":"按次序，一轮接一轮。「芳菲次第长相续」是花期接连不断。"},{"word":"芳菲","reading":"fāng fēi","note":"花草的香气和美盛。这里指一轮接一轮的花。"},{"word":"眉黛","reading":"méi dài","note":"用黛色画的眉。「眉黛促」是眉头皱紧。"},{"word":"少游","reading":"shào yóu","note":"秦观的字。淮海是对他词的另一路称呼。少读 shào。"}],"keyFunctionWords":[{"word":"似","reading":"sì","note":"像、仿佛。把「专学此种」留在像上，不是两人自己的声明。"},{"word":"莫","reading":"mò","note":"不要。引文里「莫为伤春眉黛促」是劝人别为伤春皱眉。"},{"word":"自是","reading":"zì shì","note":"本来就是。引文里情多无处足被说成事情本就如此。"}],"ancientModern":[{"word":"了","note":"结束。「春又了」是春天又过去了。不是今天句末的助词了。"},{"word":"尊","note":"酒器。「尊前」是在酒樽之前。这个意思后来多写作樽。这里不是尊敬。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"老","note":"形容词用作动词，变老。「翠色和烟老」是绿色随着烟霭一起老去。"}],"specialSyntax":[{"name":"一生似专学此种","note":"此种回指前面引的那几句。两句用同一个收束，把刘熙载的句式借来写成欧阳修一条。"},{"name":"余谓与刘融斋谓相对","note":"第一句归刘熙载，第二句归王国维自己。论证靠两句平行，不靠再解释一遍。"}]}}
