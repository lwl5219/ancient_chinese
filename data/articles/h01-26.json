{"id":"h01-26","volume":1,"volumeTitle":"人间词话","volumeSubtitle":"六十四则","index":26,"title":{"t":"古今之成大事業、大學問者必經三種境界","s":"古今之成大事业、大学问者必经三种境界"},"book":{"t":"人間詞話","s":"人间词话"},"sourceHead":{"t":"國粹學報本","s":"国粹学报本"},"author":"王国维","annotated":true,"paragraphs":[{"sentences":[{"tr":"古今凡要成就大事业、大学问的人，一定经过三种境界：「昨夜西风凋碧树。独上高楼，望尽天涯路。」这是第一种境界。","tokens":[{"t":"古","s":"古","py":"","ctx":"古代。","pos":"","extra":"","level":"sentence"},{"t":"今","s":"今","py":"","ctx":"现在，或这。","pos":"","extra":"","level":"sentence"},{"t":"之","s":"之","py":"","ctx":"的。","pos":"","extra":"","level":"sentence"},{"t":"成","s":"成","py":"","ctx":"完成、成为。","pos":"","extra":"","level":"sentence"},{"t":"大","s":"大","py":"","ctx":"大。","pos":"","extra":"","level":"sentence"},{"t":"事","s":"事","py":"","ctx":"事情。","pos":"","extra":"","level":"sentence"},{"t":"業","s":"业","py":"","ctx":"事业、学业。","pos":"","extra":"","level":"sentence"},{"t":"、","s":"、","punct":true},{"t":"大","s":"大","py":"","ctx":"大。","pos":"","extra":"","level":"sentence"},{"t":"學","s":"学","py":"","ctx":"学习。","pos":"","extra":"","level":"sentence"},{"t":"問","s":"问","py":"","ctx":"问。","pos":"","extra":"","level":"sentence"},{"t":"者","s":"者","py":"","ctx":"……的人，或……的事物。","pos":"","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"必","s":"必","py":"","ctx":"一定。","pos":"","extra":"","level":"sentence"},{"t":"經","s":"经","py":"","ctx":"经典，或经过。","pos":"","extra":"","level":"sentence"},{"t":"過","s":"过","py":"","ctx":"经过，或超过。","pos":"","extra":"","level":"sentence"},{"t":"三","s":"三","py":"","ctx":"三。","pos":"","extra":"","level":"sentence"},{"t":"種","s":"种","py":"","ctx":"种子、种类。","pos":"","extra":"","level":"sentence"},{"t":"之","s":"之","py":"","ctx":"的。","pos":"","extra":"","level":"sentence"},{"t":"境","s":"境","py":"","ctx":"境地。","pos":"","extra":"","level":"sentence"},{"t":"界","s":"界","py":"","ctx":"界限。","pos":"","extra":"","level":"sentence"},{"t":"：","s":"：","punct":true},{"t":"「","s":"「","punct":true},{"t":"昨","s":"昨","py":"","ctx":"昨天。","pos":""