{"id":"h01-31","volume":1,"volumeTitle":"人间词话","volumeSubtitle":"六十四则","index":31,"title":{"t":"詞中少淵明詩、薛收賦氣象","s":"词中少渊明诗、薛收赋气象"},"book":{"t":"人間詞話","s":"人间词话"},"sourceHead":{"t":"國粹學報本","s":"国粹学报本"},"author":"王国维","annotated":true,"paragraphs":[{"sentences":[{"tr":"昭明太子称陶渊明的诗：「跌宕昭彰，独超众类。抑扬爽朗，莫之与京。」王无功称薛收的赋：「韵趣高奇，词义晦远。嵯峨萧瑟，真不可言。」词里面可惜缺少这两种气象。前一种只有东坡，后一种只有白石，不过略微得到一两分罢了。","tokens":[{"t":"昭","s":"昭","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"明","s":"明","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"太","s":"太","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"稱","s":"称","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"：","s":"：","punct":true},{"t":"陶","s":"陶","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"淵","s":"渊","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"明","s":"明","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"詩","s":"诗","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"「","s":"「","punct":true},{"t":"跌","s":"跌","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"宕","s":"宕","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"昭","s":"昭","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"彰","s":"彰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"獨","s":"独","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"超","s":"超","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"眾","s":"众","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"類","s":"类","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true},{"t":"抑","s":"抑","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"揚","s":"扬","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爽","s":"爽","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"朗","s":"朗","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punc