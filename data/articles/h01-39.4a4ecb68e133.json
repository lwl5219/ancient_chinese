":"","extra":"","level":"sentence"},{"t":"絶","s":"绝","py":"","ctx":"断绝、到了极点。","pos":"","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"然","s":"然","py":"","ctx":"这样。附在描写词后面，表示那种样子。","pos":"","extra":"","level":"sentence"},{"t":"如","s":"如","py":"","ctx":"像、依照。","pos":"","extra":"","level":"sentence"},{"t":"霧","s":"雾","py":"","ctx":"雾。","pos":"","extra":"","level":"sentence"},{"t":"裡","s":"里","py":"","ctx":"里面，或长度单位。","pos":"","extra":"","level":"sentence"},{"t":"看","s":"看","py":"","ctx":"看。","pos":"","extra":"","level":"sentence"},{"t":"花","s":"花","py":"","ctx":"花。","pos":"","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"終","s":"终","py":"","ctx":"终于，或结束。","pos":"","extra":"","level":"sentence"},{"t":"隔","s":"隔","py":"","ctx":"隔开。","pos":"","extra":"","level":"sentence"},{"t":"一","s":"一","py":"","ctx":"数目一。有时表示全、都，或一旦。","pos":"","extra":"","level":"sentence"},{"t":"層","s":"层","py":"","ctx":"层。","pos":"","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"史达祖、吴文英这些人写景的毛病，都出在一个「隔」字上。","tokens":[{"t":"梅","s":"梅","py":"","ctx":"梅树。","pos":"","extra":"","level":"sentence"},{"t":"溪","s":"溪","py":"","ctx":"溪。","pos":"","extra":"","level":"sentence"},{"t":"、","s":"、","punct":true},{"t":"夢","s":"梦","py":"","ctx":"梦。","pos":"","extra":"","level":"sentence"},{"t":"窗","s":"窗","py":"","ctx":"窗。","pos":"","extra":"","level":"sentence"},{"t":"諸","s":"诸","py":"","ctx":"众，或“之于”。","pos":"","extra":"","level":"sentence"},{"t":"家","s":"家","py":"","ctx":"家，或家庭、专家。","pos":"","extra":"","level":"sentence"},{"t":"寫","s":"写","py":"","ctx":"书写。","pos":"","extra":"","level":"sentence"},{"t":"景","s":"景","py":"","ctx":"日光，或景色。","pos":"","extra":"","level":"sentence"},{"t":"之","s":"之","py":"","ctx":"的。","pos":"","extra":"","level":"sentence"},{"t":"病","s":"病","py":"","ctx":"病，或困苦。","pos":"","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"皆","s":"皆","py":"","ctx":"都。","pos":"","extra":"","level":"sentence"},{"t":"在","s":"在","py":"","ctx":"在。","pos":"","extra":"","level":"sentence"},{"t":"一","s":"一","py":"","ctx":"数目一。有时表示全、都，或一旦。","pos":"","extra":"","level":"sentence"},{"t":"「","s":"「","punct":true},{"t":"隔","s":"隔","py":"","ctx":"隔开。","pos":"","extra":"","level":"sentence"},{"t":"」","s":"」","punct":true},{"t":"字","s":"字","py":"","ctx":"文字。","pos":"","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"北宋词的那种风流，一过长江就断绝了。","tokens":[{"t":"北","s":"北","py":"","ctx":"北。","pos":"","extra":"","level":"sentence"},{"t":"宋","s":"宋","py":"","ctx":"宋国。","pos":"","extra":"","level":"sentence"},{"t":"風","s":"风","py":"","ctx":"风。","pos":"","extra":"","level":"sentence"},{"t":"流","s":"流","py":"","ctx":"水流，或流动、流传。","pos":"","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"渡","s":"渡","py":"","ctx":"渡。","pos":"","extra":"","level":"sentence"},{"t":"江","s":"江","py":"","ctx":"长江，或江河。","pos":"","extra":"","level":"sentence"},{"t":"遂","s":"遂","py":"","ctx":"于是、终于。","pos":"","extra":"","level":"sentence"},{"t":"絶","s":"绝","py":"","ctx":"断绝、到了极点。","pos":"","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"他接着问，这中间是不是真有时运在起作用。","tokens":[{"t":"抑","s":"抑","py":"","ctx":"或者、压制。","pos":"","extra":"","level":"sentence"},{"t":"眞","s":"真","py":"","ctx":"真。","pos":"","extra":"","level":"sentence"},{"t":"有","s":"有","py":"","ctx":"有、存在。","pos":"","extra":"","level":"sentence"},{"t":"運","s":"运","py":"","ctx":"命运、运转。","pos":"","extra":"","level":"sentence"},{"t":"會","s":"会","py":"","ctx":"会合、恰逢。","pos":"","extra":"","level":"sentence"},{"t":"存","s":"存","py":"","ctx":"存在。","pos":"","extra":"","level":"sentence"},{"t":"乎","s":"乎","py":"","ctx":"吗、呢，句末语气词。有时同“于”。","pos":"","extra":"","level":"sentence"},{"t":"其","s":"其","py":"","ctx":"他的、它的，或那。","pos":"","extra":"","level":"sentence"},{"t":"間","s":"间","py":"","ctx":"中间。读 jiàn 时是隔开、参与或间隙。","pos":"","extra":"","level":"sentence"},{"t":"耶","s":"耶","py":"","ctx":"吗，或父亲。","pos":"","extra":"","level":"sentence"},{"t":"？","s":"？","punct":true}]}]}],"lesson":{"background":"王国维《人间词话》第三十九则，1908–1909年连载于《国粹学报》。这一则专说姜夔写景。白石是姜夔。三例按正文的次序，是「二十四桥仍在，波心荡、冷月无声」「数峰清苦，商略黄昏雨」「高树晩蝉，说西风消息」。梅溪是史达祖，梦窗是吴文英。王国维认为这些句子格韵极高，仍如雾里看花，终隔一层；又说梅溪、梦窗写景的病也在隔。末两句写北宋风流渡江而绝，并追问是不是有运会。","theme":"隔，是景物没有直接放到眼前，中间还站着一层说法。二十四桥是杜牧写扬州时用过的名目，冷月无声的画面很完整，这个现成桥名仍拦在景前。数峰清苦，却用商略去写它们商量黄昏的雨，雨本身不先出现。高树上的晚蝉是在「说」西风的消息，西风变成被转告的音讯。三句都被承认格韵高绝，不足处只在这一层。梅溪、梦窗的写景被归入同一个字。北宋风流在这里紧接写景来说，指那种把景物直接写出的风气；王国维说它随宋室南渡而断，接着又用问句把原因暂放在运会上，问是不是时运如此。","technique":"第一句先排列三则引文，次序就是正文的次序，然后才用「虽……然……」同时给出格韵高绝和终隔一层，使夸奖与指责落在同一批句子上。第二句把梅溪、梦窗收进同一个「隔」字，不再另引他们的词。第三句换成时代的判断，第四句用「抑……耶」把运会写成疑问，不写成已经证实的历史定律。","keyContentWords":[{"word":"格韵","reading":"gé yùn","note":"格调和韵味。王国维承认这三则写景的格韵高，同时认为它们隔。"},{"word":"商略","reading":"shāng lüè","note":"商量、揣度。姜夔用它写山峰对黄昏雨的态度。景物因此像经过一层商量才出现。"},{"word":"隔","reading":"gé","note":"词和景物之间隔着一层，读者不能直接看见。这一则把姜夔、史达祖、吴文英的写景都放在这个字下。"},{"word":"运会","reading":"yùn huì","note":"时运和际会，一个时代碰上的气运。王国维用问句提出它，问北宋风流的中断是不是由于此。"},{"word":"渡江","reading":"dù jiāng","note":"渡过长江，指北宋灭亡后宋室南渡。正文说北宋风流到这里便断。"}],"keyFunctionWords":[{"word":"虽","reading":"suī","note":"「虽格韵高绝」先让出优点。后面的然才转到雾里看花。"},{"word":"抑","reading":"yì","note":"句首的抑用于推想中的发问，相当于「难道是」。运会没有被说成定论。"}],"ancientModern":[{"word":"消息","note":"「西风消息」的消息是音讯、征兆，蝉把西风要来的消息说出来。不是后世报刊、通信里的一条消息。"},{"word":"风流","note":"「北宋风流」在这一则里紧接写景的隔，指北宋词直接写景的那一派风气，不是专指风月之事。"},{"word":"清苦","note":"写山峰的清冷瘦硬，是景物的气象，不是家境贫寒。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"荡","note":"「波心荡」的荡是动词，波心在摇动。冷月映在这摇动里。"}],"specialSyntax":[{"name":"虽……然……终隔一层","note":"让步和转折装在一句里。高和隔同时成立，隔是最终的判断。"},{"name":"抑真有……耶","note":"以问句收束。运会被提问，不是被宣告。"}]}}