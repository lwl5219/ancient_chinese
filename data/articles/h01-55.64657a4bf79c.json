os":"","extra":"","level":"dict"},{"t":"古","s":"古","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"題","s":"题","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"詞","s":"词","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"亦","s":"亦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"作","s":"作","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"題","s":"题","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"这就像观看一幅很好的山水，立刻说这是某座山、某条河，这种做法并不合适。","tokens":[{"t":"如","s":"如","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"觀","s":"观","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"一","s":"一","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"幅","s":"幅","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"佳","s":"佳","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"山","s":"山","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"水","s":"水","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"即","s":"即","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"此","s":"此","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"某","s":"某","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"山","s":"山","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"某","s":"某","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"河","s":"河","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"可","s":"可","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乎","s":"乎","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"？","s":"？","punct":true}]},{"tr":"诗有了负责把意思说破的题目，诗就亡了；词有了这样的题目，词也亡了。可是中等才具的人，很少能明白这一点并自己振拔出来。","tokens":[{"t":"詩","s":"诗","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"題","s":"题","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"詩","s":"诗","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"亡","s":"亡","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"詞","s":"词","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"題","s":"题","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"詞","s":"词","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"亡","s":"亡","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"然","s":"然","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"中","s":"中","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"材","s":"材","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"士","s":"士","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"鮮","s":"鲜","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"能","s":"能","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"知","s":"知","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"此","s":"此","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"自","s":"自","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"振","s":"振","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"拔","s":"拔","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"王国维《人间词话》第55则，1908–1909年连载于《国粹学报》。这一则提出「诗有题而诗亡，词有题而词亡」。他说《诗经》三百篇、《古诗十九首》、五代和北宋词都无题，随即补一句：诗词中之意，不能以题尽之。从《花庵词选》和《草堂诗余》开始，选家给每调立题，连古人无题之词也代为作题。他用一幅山水被说成某山某河作比，并说中材之士很少能知道这一点而自己振拔。","theme":"题目一旦担负起说明诗的任务，诗本身就不再载着那个意思，所以说亡。三百篇的篇名多取开篇字面，《十九首》也常以首句为名，五代、北宋词多半只有词牌，没有另立一件把事由和意蕴说破的题。王国维说「非无题也」，要紧的是意思本来就不能被题目穷尽。南宋选本《花庵》《草堂》给每支词安上题目，还替古人补题，等于对着一幅已经完整的山水，硬指它是某山某河。词牌可以标明唱法，那不是这则要取消的东西；这则要说的是那个代替诗意的题。中等才具的人很少看出这件事，也就很少能自己从这风气里振拔出来。","technique":"先下一句很满的「皆无题也」，下一句马上用「非无题也」把字面收窄，真正的判断落在「不能以题尽之」。然后点出《花庵》《草堂》两部选本的做法，用「并」字把「替古人补题」加重。山水的比喻只有一问，「可乎」并不作答，答案放在后面的「诗亡」「词亡」。末句转到读诗的人，中材之士鲜能知、鲜能振拔，把批评从选本延伸到作诗的习惯。","keyContentWords":[{"word":"三百篇","reading":"sān bǎi piān","note":"《诗经》。篇名多取首句字面。王国维说它们没有把诗意说尽的题。"},{"word":"十九首","reading":"shí jiǔ shǒu","note":"《古诗十九首》。习称也用首句当名字，同样没有另作说明事由的题。"},{"word":"花庵","reading":"huā ān","note":"指南宋黄升所编《花庵词选》。王国维说它开始给每支词立题目。"},{"word":"草堂","reading":"cǎo táng","note":"指词选《草堂诗余》。它和《花庵》一样替词作题，连古人无题的词也补上题。"},{"word":"振拔","reading":"zhèn bá","note":"自己振作，从这种依赖题目的风气里拔出来。"}],"keyFunctionWords":[{"word":"鲜","reading":"xiǎn","note":"少。鲜能知此而自振拔，是很少有人既明白又能自己摆脱。"},{"word":"尽","reading":"jìn","note":"「以题尽之」的尽是说完、穷尽。意思不能被题目说完。"}],"ancientModern":[{"word":"题","note":"这里的题是把内容、事由说明白的题目。词牌标明腔调，不是这则所说的那种题。"},{"word":"亡","note":"「诗亡」「词亡」是诗和词本身不再载着意思。不是作者去世，也不是篇目散失。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"尽","note":"动词。不能以题尽之，是不能靠题目把意思说尽。之指诗词中之意。"}],"specialSyntax":[{"name":"非无题也","note":"紧接在「皆无题也」之后，先收回字面，再把判断落到「不能以题尽之」。"},{"name":"可乎","note":"问山水能不能被立刻说成某山某河。问句不自答，否定的意思留到「诗亡」「词亡」。"}]}}
