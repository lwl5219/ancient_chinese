":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"淫","s":"淫","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"詞","s":"词","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"讀","s":"读","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"但","s":"但","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"覺","s":"觉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"親","s":"亲","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"切","s":"切","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"動","s":"动","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"他们不是没有鄙词，只觉得精力饱满。","tokens":[{"t":"非","s":"非","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"鄙","s":"鄙","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"詞","s":"词","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"但","s":"但","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"覺","s":"觉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"精","s":"精","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"力","s":"力","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"彌","s":"弥","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"滿","s":"满","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"可见淫词和鄙词的毛病，不是淫和鄙的毛病，而是游词的毛病。","tokens":[{"t":"可","s":"可","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"知","s":"知","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"淫","s":"淫","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"詞","s":"词","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"與","s":"与","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"鄙","s":"鄙","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"詞","s":"词","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"病","s":"病","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"非","s":"非","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"淫","s":"淫","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"與","s":"与","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"鄙","s":"鄙","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"病","s":"病","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"遊","s":"游","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"詞","s":"词","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"病","s":"病","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"那句说「难道不想念你吗，只是住处远」。孔子说：「他并没有去想。真要是想了，又有什么远呢？」孔子厌恶的就是这种游。","tokens":[{"t":"「","s":"「","punct":true},{"t":"豈","s":"岂","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爾","s":"尔","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"思","s":"思","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"室","s":"室","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"是","s":"是","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"遠","s":"远","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true},{"t":"」","s":"」","punct":true},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"：","s":"：","punct":true},{"t":"「","s":"「","punct":true},{"t":"未","s":"未","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"思","s":"思","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"夫","s":"夫","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"何","s":"何","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"遠","s":"远","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"？","s":"？","punct":true},{"t":"」","s":"」","punct":true},{"t":"惡","s":"恶","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"遊","s":"游","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"王国维《人间词话》第62则，1908–1909年连载于《国粹学报》。这一则分辨淫词、鄙词和游词。前一首是《古诗十九首》里「昔为倡家女，今为荡子妇。荡子行不归，空床难独守」，后一首是同书「何不策高足，先据要路津？无为守穷贱，坎坷长苦辛」。王国维说二者可为淫鄙之尤，但因为真，没有人把它们当成有病的淫词、鄙词。五代北宋大词人亦然。真正的病是游词。游是话没有真情托着，不是游览。例证是《论语·子罕》里的「岂不尔思，室是远而」，孔子答「未之思也，夫何远之有」。","theme":"第一首把守空床的欲望说得极明白，所以可以叫淫到极点。第二首把催马、占渡口、不肯守贫贱说得极坦白，所以可以叫鄙到极点。王国维认为它们仍然不是有病的淫词、鄙词，病不在淫和鄙，病在不真。五代、北宋大词人的作品里也有说得很艳、说得很露的句子，读下去只觉亲切，或者只觉精力充满。游词才是病：话说了思念，感情却不在这句话里。孔子驳「岂不尔思，室是远而」，说这是没有想；真想了，远近不成借口。王国维把孔子厌恶的这一点叫做游。游字是王国维的说明，孔子原话里没有这个字。","technique":"先把两首古诗的最露骨的句子原文引出，马上下「可为淫鄙之尤」，好像已经定罪。下一句用「然」字翻过来，理由只有「以其真也」四个字。再推到五代北宋词，用两个「非无……但觉……」承认那些词里有淫、有鄙，同时把阅读的感觉写成亲切和精力弥满。判断句到「而游词之病也」才落定。最后引孔子的驳语作游的实例，引文之后只用「恶其游也」四字点题。","keyContentWords":[{"word":"倡家","reading":"chāng jiā","note":"歌舞乐伎人家。倡读 chāng。「昔为倡家女」是说从前是这样人家的女儿。"},{"word":"荡子","reading":"dàng zǐ","note":"出门浪游、久不回家的人。诗里是女主人公的丈夫，不是泛泛骂人。"},{"word":"高足","reading":"gāo zú","note":"好马。策高足，是催动好马赶路。今天说的高足常指学生，这里不是。"},{"word":"要路津","reading":"yào lù jīn","note":"要道上的渡口。先据要路津，字面是先占住这个渡口，诗里借指先占住紧要的位置。"},{"word":"游词","reading":"yóu cí","note":"话游离开了情，嘴上说了，感情并不在其中。游不是游览、旅游。"}],"keyFunctionWords":[{"word":"非","reading":"fēi","note":"「非无淫词」是并不是没有淫词。非和无连用，先承认有，再写读后的感觉。"},{"word":"而","reading":"ér","note":"「室是远而」里，而放在句末，只表语气。「而游词之病也」里，而把前面的判断接到游词上。"}],"ancientModern":[{"word":"高足","note":"好马。和今天尊称别人学生为高足不同。"},{"word":"鄙","note":"鄙词的鄙是粗鄙、艳羡利禄那一路露骨。不是自谦说鄙人的鄙。"},{"word":"游","note":"游词的游是游离、不落实到感情上。不要理解成游玩。"},{"word":"恶","note":"读 wù，厌恶。恶其游，是厌恶那种游。不是凶恶的 è。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"策","note":"本可指马鞭，这里作动词，鞭赶。策高足就是催动好马。"}],"specialSyntax":[{"name":"未之思也","note":"否定句里代词宾语提前。未之思就是未思之，没有想这件事。"},{"name":"何远之有","note":"「何……之有」把宾语提前。何远之有就是有何远，还有什么远。"},{"name":"岂不尔思","note":"疑问兼否定的句子里，尔提到思的前面。岂不尔思就是岂不思尔。"}]}}
