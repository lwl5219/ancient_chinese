名","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"其","s":"其","py":"qí","ctx":"那。","pos":"代","extra":"","level":"sentence"},{"t":"樂","s":"乐","py":"lè","ctx":"快乐。","pos":"形","extra":"","level":"sentence"},{"t":"也","s":"也","py":"yě","ctx":"语气词。","pos":"助","extra":"","level":"sentence"},{"t":"洩洩","s":"泄泄","py":"yì yì","ctx":"舒畅和乐的样子。","pos":"形","extra":"","level":"sentence"},{"t":"。」","s":"。」","punct":true}]},{"tr":"于是恢复了母子关系，像当初一样。","tokens":[{"t":"遂","s":"遂","py":"suì","ctx":"于是。","pos":"副","extra":"","level":"sentence"},{"t":"爲","s":"为","py":"wéi","ctx":"成为。","pos":"动","extra":"","level":"sentence"},{"t":"母子","s":"母子","py":"mǔ zǐ","ctx":"母亲和儿子。","pos":"名","extra":"","level":"sentence"},{"t":"如","s":"如","py":"rú","ctx":"如同。","pos":"动","extra":"","level":"sentence"},{"t":"初","s":"初","py":"chū","ctx":"当初。与篇首「初」呼应。","pos":"名","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]}]},{"sentences":[{"tr":"君子说：「颍考叔，是纯正的孝子。","tokens":[{"t":"君子","s":"君子","py":"jūn zǐ","ctx":"有德者。《左传》常借君子发表评论。","pos":"名","extra":"","level":"sentence"},{"t":"曰","s":"曰","py":"yuē","ctx":"说。","pos":"动","extra":"","level":"sentence"},{"t":"：「","s":"：「","punct":true},{"t":"潁考叔","s":"颍考叔","py":"Yǐng Kǎo shū","ctx":"颍考叔。","pos":"名","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"純孝","s":"纯孝","py":"chún xiào","ctx":"纯正专一的孝。","pos":"名","extra":"","level":"sentence"},{"t":"也","s":"也","py":"yě","ctx":"判断语气。","pos":"助","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"爱自己的母亲，并把这种爱推广到庄公身上。」","tokens":[{"t":"愛","s":"爱","py":"ài","ctx":"爱。","pos":"动","extra":"","level":"sentence"},{"t":"其","s":"其","py":"qí","ctx":"自己的。","pos":"代","extra":"","level":"sentence"},{"t":"母","s":"母","py":"mǔ","ctx":"母亲。","pos":"名","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"施","s":"施","py":"yì","ctx":"延伸、推广。","pos":"动","extra":"","level":"sentence"},{"t":"及","s":"及","py":"jí","ctx":"到。","pos":"动","extra":"","level":"sentence"},{"t":"莊公","s":"庄公","py":"Zhuāng gōng","ctx":"郑庄公。","pos":"名","extra":"","level":"sentence"},{"t":"。」","s":"。」","punct":true}]},{"tr":"《诗经》说：『孝子的孝心不会穷尽，永远赐给你的同类。』","tokens":[{"t":"《","s":"《","punct":true},{"t":"詩","s":"诗","py":"Shī","ctx":"《诗经·大雅·既醉》。","pos":"名","extra":"","level":"sentence"},{"t":"》","s":"》","punct":true},{"t":"曰","s":"曰","py":"yuē","ctx":"说。","pos":"动","extra":"","level":"sentence"},{"t":"：『","s":"：『","punct":true},{"t":"孝子","s":"孝子","py":"xiào zǐ","ctx":"孝子。","pos":"名","extra":"","level":"sentence"},{"t":"不匱","s":"不匮","py":"bù kuì","ctx":"不竭、没有穷尽。","pos":"动","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"永","s":"永","py":"yǒng","ctx":"长久地。","pos":"副","extra":"","level":"sentence"},{"t":"錫","s":"锡","py":"cì","ctx":"赐给。","pos":"动","extra":"通「赐」","level":"sentence"},{"t":"爾","s":"尔","py":"ěr","ctx":"你。","pos":"代","extra":"","level":"sentence"},{"t":"類","s":"类","py":"lèi","ctx":"同类的人。","pos":"名","extra":"","level":"sentence"},{"t":"。』","s":"。』","punct":true}]},{"tr":"大概说的就是这种情况吧！」","tokens":[{"t":"其","s":"其","py":"qí","ctx":"大概。揣测语气。","pos":"副","extra":"","level":"sentence"},{"t":"是","s":"是","py":"shì","ctx":"这种情况。宾语前置。","pos":"代","extra":"","level":"sentence"},{"t":"之","s":"之","py":"zhī","ctx":"宾语前置的标志。是之谓 = 谓是。","pos":"助","extra":"","level":"sentence"},{"t":"謂","s":"谓","py":"wèi","ctx":"说。","pos":"动","extra":"","level":"sentence"},{"t":"乎","s":"乎","py":"hū","ctx":"吧。","pos":"助","extra":"","level":"sentence"},{"t":"！」","s":"！」","punct":true}]}]}],"lesson":{"background":"本篇选自《左传·隐公元年》，题目取自《春秋》经文「郑伯克段于鄢」。郑是西周分封的姬姓诸侯国，始封君郑桓公为周厉王幼子。郑武公掘突娶申国之女武姜，生庄公与共叔段。庄公难产，武姜厌恶他，偏爱幼子段，一再请求立段为继承人，武公不许。隐公元年（前722），庄公即位后，这场偏爱终于演成兄弟相残。作者旧传为左丘明，春秋末期鲁国人；《左传》是配合《春秋》的编年史，长于记事和揭示人物心理。","keyContentWords":[{"word":"亟","reading":"qì","note":"屡次。不是现代汉语「急迫」的意思。"},{"word":"都","reading":"dū","note":"有先君宗庙的城邑。"},{"word":"雉","reading":"zhì","note":"城墙计量单位，长三丈、高一丈为一雉。"},{"word":"鄙","reading":"bǐ","note":"边境城邑。"},{"word":"贰","reading":"èr","note":"两属，同时臣属于双方。"},{"word":"完聚","reading":"wán jù","note":"修葺城郭，聚集百姓、粮食。"},{"word":"袭","reading":"xí","note":"乘人不备而进攻。"},{"word":"启","reading":"qǐ","note":"开门，这里指做内应开城门。"},{"word":"克","reading":"kè","note":"战胜。按《左传》的书法，像两国之君交战才用「克」。"},{"word":"遗","reading":"wèi","note":"送给。"},{"word":"纯孝","reading":"chún xiào","note":"纯正专一的孝。"},{"word":"寤生","reading":"wù shēng","note":"难产。本篇夹注：寤犹苏，指生下来时气绝又苏醒，不是通「啎」、解成逆生。"}],"keyFunctionWords":[{"word":"焉","reading":"yān","note":"本篇有两用：虢叔死焉，「于是、在那里」；焉辟害，「怎么」。"},{"word":"之","reading":"zhī","note":"或代人（遂恶之），或作结构助词（何厌之有），或作动词「往」以外的各种虚指，须按句看。"},{"word":"为","reading":"wèi / wéi","note":"为之请制，读 wèi，介词「替」。早为之所，读 wéi，动词「安排」。"},{"word":"诸","reading":"zhū","note":"公伐诸鄢，「之于」的合音。"},{"word":"其","reading":"qí","note":"其谁曰不然，语气副词，加强反问。"}],"ancientModern":[{"word":"夫人","note":"古：诸侯的妻子，这里专指武姜。今：对已婚妇女的通称。"},{"word":"鄙","note":"古：边境城邑。今：多指粗俗，或用作谦辞、轻视。"},{"word":"国","note":"「参国之一」的国指国都。今「国」多指国家。同篇「国之害也」则指国家。"},{"word":"兵","note":"古：兵器。缮甲兵。今：多指士兵。"},{"word":"乘","note":"古：兵车，读 shèng。今：多读 chéng，乘坐。"},{"word":"遗","note":"古：赠送，读 wèi。今：多读 yí，遗失、遗留。"}],"phoneticLoans":[{"word":"辟","loan":"避","note":"焉辟害：躲避祸害。"},{"word":"厌","loan":"餍","note":"何厌之有：满足。厌，本句读 yān。"},{"word":"参","loan":"三","note":"大都不过参国之一：三分之一。"},{"word":"寘","loan":"置","note":"寘姜氏于城颍：安置。寘、置古常通用。"},{"word":"阙","loan":"掘","note":"阙地及泉：挖地。阙，本句读 jué。"},{"word":"锡","loan":"赐","note":"永锡尔类：赐给。锡，本句读 cì。"}],"flexibleUsage":[{"word":"生","note":"无生民心：使动，使百姓产生二心。"},{"word":"隧","note":"隧而相见：名词作动词，挖隧道。"},{"word":"大","note":"京城大叔：大读 tài，用为尊称，等于「太」。"}],"specialSyntax":[{"name":"宾语前置","note":"何厌之有 = 有何厌。「之」是前置的标志。其是之谓乎 = 谓是，「之」同样标志宾语「是」前置。"},{"name":"省略","note":"他邑唯命，承上省略「是听」。中五之一、小九之一，承上省略「都」「国」。"},{"name":"合音兼词","note":"公伐诸鄢：诸 = 之于。虢叔死焉：焉 = 于之（于此）。"},{"name":"判断句","note":"颍考叔，纯孝也。用「……也」表判断，没有系词「是」。"}],"theme":"表面写家庭偏爱和兄弟冲突，落点却在郑庄公的心机：他不早加管束，坐等共叔段「多行不义」，再以「克」的名义讨伐，连母亲也被放逐。颍考叔用孝心把母子关系挽回，作者以「纯孝」作结，是用孝对照前面的忍与毒。","technique":"叙事极省，对话极显人。庄公的「唯命」「姜氏欲之」「姑待之」「将自及」「可矣」一层比一层冷，祭仲、公子吕越劝越急，形成反衬。经文「郑伯克段于鄢」六字，后文用一段「书法」拆开讲，是《左传》解释《春秋》用字的典型。结尾引《诗》收束，余味在感叹而不在说教。"},"classicComment":{"t":"鄭莊志欲殺弟，祭仲，子封諸臣，皆不得而知。「姜氏欲之，焉辟害」、「必自斃，子姑待之」、「將自及」、「厚將崩」等語，分明是逆料其必至于此，故雖婉言直陳，一切不聽。迨後乘時迅發，并及于母。是以兵機施于骨肉真殘忍之尤。幸良心忽現，又被考叔一番救正，得母子如初。左氏以純孝贊考叔作結，寓慨殊深。","s":"郑庄志欲杀弟，祭仲，子封诸臣，皆不得而知。「姜氏欲之，焉辟害」、「必自毙，子姑待之」、「将自及」、「厚将崩」等语，分明是逆料其必至于此，故虽婉言直陈，一切不听。迨后乘时迅发，并及于母。是以兵机施于骨肉真残忍之尤。幸良心忽现，又被考叔一番救正，得母子如初。左氏以纯孝赞考叔作结，寓慨殊深。"}}
