]},{"tr":"况且低贱妨害尊贵，年少欺凌年长，疏远离间亲近，新人离间旧人，弱小凌驾强大，放纵破坏道义，这就是所说的六逆。","tokens":[{"t":"且夫","s":"且夫","py":"qiě fú","ctx":"况且。把话再推开一层。","pos":"连","extra":"","level":"sentence"},{"t":"賤","s":"贱","py":"jiàn","ctx":"地位低贱的人。","pos":"名","extra":"","level":"sentence"},{"t":"妨","s":"妨","py":"fáng","ctx":"妨害。","pos":"动","extra":"","level":"sentence"},{"t":"貴","s":"贵","py":"guì","ctx":"地位尊贵的人。","pos":"名","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"少","s":"少","py":"shào","ctx":"年少的人。","pos":"名","extra":"","level":"sentence"},{"t":"陵","s":"陵","py":"líng","ctx":"欺凌。","pos":"动","extra":"","level":"sentence"},{"t":"長","s":"长","py":"zhǎng","ctx":"年长的人。","pos":"名","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"遠","s":"远","py":"yuǎn","ctx":"关系疏远的人。","pos":"名","extra":"","level":"sentence"},{"t":"間","s":"间","py":"jiàn","ctx":"离间。","pos":"动","extra":"","level":"sentence"},{"t":"親","s":"亲","py":"qīn","ctx":"关系亲近的人。","pos":"名","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"新","s":"新","py":"xīn","ctx":"新进、新得宠的人。","pos":"名","extra":"","level":"sentence"},{"t":"間","s":"间","py":"jiàn","ctx":"离间。","pos":"动","extra":"","level":"sentence"},{"t":"舊","s":"旧","py":"jiù","ctx":"旧人。","pos":"名","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"小","s":"小","py":"xiǎo","ctx":"势位小的人。","pos":"名","extra":"","level":"sentence"},{"t":"加","s":"加","py":"jiā","ctx":"凌驾在上面。","pos":"动","extra":"","level":"sentence"},{"t":"大","s":"大","py":"dà","ctx":"势位大的人。","pos":"名","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"淫","s":"淫","py":"yín","ctx":"放纵。","pos":"名","extra":"","level":"sentence"},{"t":"破","s":"破","py":"pò","ctx":"破坏。","pos":"动","extra":"","level":"sentence"},{"t":"義","s":"义","py":"yì","ctx":"道义。","pos":"名","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"所謂","s":"所谓","py":"suǒ wèi","ctx":"所说的。","pos":"动","extra":"","level":"sentence"},{"t":"六逆","s":"六逆","py":"liù nì","ctx":"六种悖理的事。","pos":"名","extra":"","level":"sentence"},{"t":"也","s":"也","py":"yě","ctx":"判断语气。","pos":"助","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"国君行事合于义，臣下执行君命，父亲慈爱，儿子孝顺，兄长友爱，弟弟恭敬，这就是所说的六顺。","tokens":[{"t":"君","s":"君","py":"jūn","ctx":"国君。","pos":"名","extra":"","level":"sentence"},{"t":"義","s":"义","py":"yì","ctx":"行事合于道义。","pos":"动","extra":"活用：名词作动词","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"臣","s":"臣","py":"chén","ctx":"臣下。","pos":"名","extra":"","level":"sentence"},{"t":"行","s":"行","py":"xíng","ctx":"奉行职分。","pos":"动","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"父","s":"父","py":"fù","ctx":"父亲。","pos":"名","extra":"","level":"sentence"},{"t":"慈","s":"慈","py":"cí","ctx":"慈爱。","pos":"动","extra":"活用：形容词作动词","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"子","s":"子","py":"zǐ","ctx":"儿子。","pos":"名","extra":"","level":"sentence"},{"t":"孝","s":"孝","py":"xiào","ctx":"孝顺。","pos":"动","extra":"活用：名词作动词","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"兄","s":"兄","py":"xiōng","ctx":"兄长。","pos":"名","extra":"","level":"sentence"},{"t":"愛","s":"爱","py":"ài","ctx":"对弟弟友爱。","pos":"动","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"弟","s":"弟","py":"dì","ctx":"弟弟。","pos":"名","extra":"","level":"sentence"},{"t":"敬","s":"敬","py":"jìng","ctx":"恭敬兄长。","pos":"动","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"所謂","s":"所谓","py":"suǒ wèi","ctx":"所说的。","pos":"动","extra":"","level":"sentence"},{"t":"六順","s":"六顺","py":"liù shùn","ctx":"六种顺理的事。","pos":"名","extra":"","level":"sentence"},{"t":"也","s":"也","py":"yě","ctx":"判断语气。","pos":"助","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"丢掉顺理的事，去学悖理的事，这就是使祸患加快到来的原因。","tokens":[{"t":"去","s":"去","py":"qù","ctx":"丢掉。","pos":"动","extra":"","level":"sentence"},{"t":"順","s":"顺","py":"shùn","ctx":"六顺。","pos":"名","extra":"","level":"sentence"},{"t":"效","s":"效","py":"xiào","ctx":"仿效。","pos":"动","extra":"","level":"sentence"},{"t":"逆","s":"逆","py":"nì","ctx":"六逆。","pos":"名","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"所以","s":"所以","py":"suǒ yǐ","ctx":"用来……的原因。","pos":"助","extra":"","level":"sentence"},{"t":"速","s":"速","py":"sù","ctx":"使加快到来。","pos":"动","extra":"活用：使动","level":"sentence"},{"t":"禍","s":"祸","py":"huò","ctx":"祸患。","pos":"名","extra":"","level":"sentence"},{"t":"也","s":"也","py":"yě","ctx":"判断语气。","pos":"助","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"做人君的，应当专心去掉祸患。","tokens":[{"t":"君","s":"君","py":"jūn","ctx":"统治。","pos":"动","extra":"活用：名词作动词","level":"sentence"},{"t":"人","s":"人","py":"rén","ctx":"人民。","pos":"名","extra":"","level":"sentence"},{"t":"者","s":"者","py":"zhě","ctx":"……的人。","pos":"助","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"將","s":"将","py":"jiāng","ctx":"应当。","pos":"副","extra":"","level":"sentence"},{"t":"禍","s":"祸","py":"huò","ctx":"祸患。提前的宾语。","pos":"名","extra":"","level":"sentence"},{"t":"是","s":"是","py":"shì","ctx":"宾语前置的标志。祸是务去，等于务去祸。","pos":"助","extra":"","level":"sentence"},{"t":"務","s":"务","py":"wù","ctx":"致力、务必。","pos":"副","extra":"","level":"sentence"},{"t":"去","s":"去","py":"qù","ctx":"除去。","pos":"动","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"现在却让祸患加快到来，恐怕不可以吧？」","tokens":[{"t":"而","s":"而","py":"ér","ctx":"却。","pos":"连","extra":"","level":"sentence"},{"t":"速","s":"速","py":"sù","ctx":"使加快到来。","pos":"动","extra":"活用：使动","level":"sentence"},{"t":"之","s":"之","py":"zhī","ctx":"它，指祸。","pos":"代","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"無乃","s":"无乃","py":"wú nǎi","ctx":"恐怕、只怕。","pos":"副","extra":"","level":"sentence"},{"t":"不可","s":"不可","py":"bù kě","ctx":"不可以。","pos":"能","extra":"","level":"sentence"},{"t":"乎","s":"乎","py":"hū","ctx":"吗。反问语气。","pos":"助","extra":"","level":"sentence"},{"t":"？」","s":"？」","punct":true}]},{"tr":"庄公不听。","tokens":[{"t":"弗","s":"弗","py":"fú","ctx":"不。","pos":"副","extra":"","level":"sentence"},{"t":"聽","s":"听","py":"tīng","ctx":"听从。","pos":"动","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"石碏的儿子石厚和州吁交游，石碏禁止他，止不住。","tokens":[{"t":"其","s":"其","py":"qí","ctx":"他的，指石碏。","pos":"代","extra":"","level":"sentence"},{"t":"子","s":"子","py":"zǐ","ctx":"儿子。","pos":"名","extra":"","level":"sentence"},{"t":"厚","s":"厚","py":"Hòu","ctx":"石厚。","pos":"名","extra":"","level":"sentence"},{"t":"與","s":"与","py":"yǔ","ctx":"和。","pos":"介","extra":"","level":"sentence"},{"t":"州吁","s":"州吁","py":"Zhōu Xū","ctx":"公子州吁。","pos":"名","extra":"","level":"sentence"},{"t":"遊","s":"游","py":"yóu","ctx":"交游、来往。","pos":"动","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"禁","s":"禁","py":"jìn","ctx":"禁止。主语是石碏。","pos":"动","extra":"","level":"sentence"},{"t":"之","s":"之","py":"zhī","ctx":"他，指石厚。","pos":"代","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"不可","s":"不可","py":"bù kě","ctx":"不听从，禁止不住。","pos":"动","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"桓公即位，石碏就告老退休了。","tokens":[{"t":"桓公","s":"桓公","py":"Huán gōng","ctx":"卫桓公。","pos":"名","extra":"","level":"sentence"},{"t":"立","s":"立","py":"lì","ctx":"即位。","pos":"动","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"乃","s":"乃","py":"nǎi","ctx":"于是。","pos":"副","extra":"","level":"sentence"},{"t":"老","s":"老","py":"lǎo","ctx":"告老，辞官退休。","pos":"动","extra":"活用：形容词作动词","level":"sentence"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"本篇选自《左传·隐公三年》。卫庄公娶齐国太子得臣的妹妹，称庄姜，貌美而无子，卫国人因此作《硕人》。他又娶陈国厉妫，生孝伯，早死；厉妫随嫁的妹妹戴妫生桓公，庄姜收为己子。宠妾所生的州吁喜欢武事，庄公不禁止，庄姜厌恶他。大夫石碏劝庄公用义方教子，指出宠禄过度会引出骄、奢、淫、佚，并对比六逆、六顺。庄公不听。石碏的儿子石厚与州吁交游，禁止不住。桓公即位，石碏告老。作者旧传为左丘明，春秋末期鲁国人；《左传》常借谏辞把祸乱的根由说在事先。隐公四年州吁弑桓公，石碏后来设计除掉州吁和石厚，那是后话，本篇停在祸乱酿成之前。","keyContentWords":[{"word":"义方","reading":"yì fāng","note":"道义上的规矩、法度。"},{"word":"宠禄","reading":"chǒng lù","note":"宠爱和俸禄。禄是宠的实惠。"},{"word":"阶","reading":"jiē","note":"做阶梯，一步步酿成。"},{"word":"眕","reading":"zhěn","note":"克制、安重，心里怨恨仍能按住自己。"},{"word":"鲜","reading":"xiǎn","note":"少。"},{"word":"六逆","reading":"liù nì","note":"贱妨贵、少陵长、远间亲、新间旧、小加大、淫破义。"},{"word":"六顺","reading":"liù shùn","note":"君义、臣行、父慈、子孝、兄爱、弟敬。"},{"word":"速祸","reading":"sù huò","note":"使祸患加快到来。"},{"word":"老","reading":"lǎo","note":"告老，辞官退休。"}],"keyFunctionWords":[{"word":"于","reading":"yú","note":"娶于齐、娶于陈：从。纳于邪：到、进入。"},{"word":"为","reading":"wèi / wéi","note":"卫人所为：读 wèi，与「所」组成表原因的结构。以为己子、阶之为祸：读 wéi，当作、成为。"},{"word":"而","reading":"ér","note":"美而无子：却。有宠而好兵：并且。宠而不骄：却，表转折。"},{"word":"乃","reading":"nǎi","note":"乃定之矣、乃老：就、于是。无乃不可乎：与「无」合成「恐怕」。"},{"word":"之","reading":"zhī","note":"或作「的」（得臣之妹），或代人（恶之、禁之），或放在主谓之间（四者之来）。"},{"word":"是","reading":"shì","note":"将祸是务去：宾语前置的标志。祸是务去，等于务去祸。"}],"ancientModern":[{"word":"兵","note":"古：兵器、武事。好兵。今：多指士兵、军队。"},{"word":"方","note":"义方的方，古指规矩、准则。今：多指方向、方法、方形。"},{"word":"纳","note":"古：使进入。弗纳于邪。今：多指交纳、接纳。"},{"word":"阶","note":"古：这里作动词，酿成、铺成台阶。今：台阶。"},{"word":"鲜","note":"古：读 xiǎn，少。今：多读 xiān，新鲜。"},{"word":"间","note":"古：读 jiàn，离间。今：多读 jiān，中间。"},{"word":"陵","note":"古：欺凌。少陵长。今：多指丘陵、陵墓。"},{"word":"速","note":"古：使到来、招致。速祸。今：多指速度。"},{"word":"老","note":"古：告老退休。乃老。今：年岁大。"},{"word":"游","note":"古：交游、来往。与州吁游。今：多指游览、游泳。"}],"phoneticLoans":[{"word":"蚤","loan":"早","note":"蚤死：早死。"},{"word":"佚","loan":"逸","note":"骄、奢、淫、佚：安逸放荡。佚通「逸」。"}],"flexibleUsage":[{"word":"阶","note":"阶之为祸：名词作动词，做成祸患的台阶。"},{"word":"君","note":"君人者：名词作动词，统治人民。"},{"word":"速","note":"所以速祸、而速之：使动，使祸患快快到来。"},{"word":"老","note":"乃老：形容词作动词，告老退休。"},{"word":"义","note":"君义、臣行、父慈、子孝、兄爱、弟敬：名词或形容词直接作谓语，表示做出该有的那种德行。"}],"specialSyntax":[{"name":"宾语前置","note":"将祸是务去 = 将务去祸。「是」是把宾语「祸」提前的标志。"},{"name":"判断句","note":"公子州吁，嬖人之子也。骄、奢、淫、佚，所自邪也。四者之来，宠禄过也。所谓六逆也、所谓六顺也、所以速祸也。都用「也」表判断，没有系词「是」。"},{"name":"假设对举","note":"将立州吁，乃定之矣；若犹未也，阶之为祸。两条路都说死：要立就定，不定就会养成祸。"}],"theme":"全篇扣住一个「宠」字。庄姜美而无子，桓公靠嫡母得位；州吁是嬖人之子，却因宠而好兵。石碏把爱子说成教以义方，不让他走进邪路。宠禄一过，骄奢淫佚就有了来处，六逆也就跟着来。去掉六顺、仿效六逆，正是把祸招快。庄公的「弗禁」「弗听」把话全部挡住，石厚的「不可」说明这股宠已经进了石家。桓公一即位，石碏就告老，是看见劝既不行于君，又不行于子。","technique":"前半只铺亲属：谁是嫡，谁早死，谁被庄姜当作己子，谁是嬖人之子。关系一摆开，后面的贱贵、少长、新间旧就有了着落。谏辞先立标准，再解释邪从哪里来，然后用「将立」和「若犹未」把庄公的两条路都堵住。六逆、六顺是两组排句，贱贵、少长、远亲、新旧、小大、淫义，对上君臣父子兄弟。结尾不再讲道理，只用「弗听」「不可」「乃老」三个短句，把劝谏的失败和告老的决断留在句外。"},"classicComment":{"t":"「寵」字，乃此篇始終關鍵。自古寵子未有不驕，驕子未有不敗。石碏有見于此，故以教之義方爲愛子之法。是拔本塞源，而預絕其禍根也。莊公愎而弗圖，辨之不早，貽禍後嗣，嗚呼慘哉！","s":"「宠」字，乃此篇始终关键。自古宠子未有不骄，骄子未有不败。石碏有见于此，故以教之义方为爱子之法。是拔本塞源，而预绝其祸根也。庄公愎而弗图，辨之不早，贻祸后嗣，呜呼惨哉！"}}