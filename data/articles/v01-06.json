":[{"t":"百官","s":"百官","py":"bǎi guān","ctx":"众官。","pos":"名","extra":"","level":"sentence"},{"t":"象","s":"象","py":"xiàng","ctx":"仿效。","pos":"动","extra":"活用：名词作动词","level":"sentence"},{"t":"之","s":"之","py":"zhī","ctx":"这件事，指纳鼎入庙。","pos":"代","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"其","s":"其","py":"qí","ctx":"还。加强反问。","pos":"副","extra":"","level":"sentence"},{"t":"又","s":"又","py":"yòu","ctx":"又。","pos":"副","extra":"","level":"sentence"},{"t":"何","s":"何","py":"hé","ctx":"什么、谁。作「诛」的宾语，提前。","pos":"代","extra":"","level":"sentence"},{"t":"誅","s":"诛","py":"zhū","ctx":"责备、责罚。","pos":"动","extra":"","level":"sentence"},{"t":"焉","s":"焉","py":"yān","ctx":"呢。","pos":"助","extra":"","level":"sentence"},{"t":"？","s":"？","punct":true}]},{"tr":"国家的败坏，是由于官吏走上邪路。","tokens":[{"t":"國家","s":"国家","py":"guó jiā","ctx":"国家。","pos":"名","extra":"","level":"sentence"},{"t":"之","s":"之","py":"zhī","ctx":"的。","pos":"助","extra":"","level":"sentence"},{"t":"敗","s":"败","py":"bài","ctx":"败坏。","pos":"名","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"由","s":"由","py":"yóu","ctx":"由于。","pos":"介","extra":"","level":"sentence"},{"t":"官","s":"官","py":"guān","ctx":"官吏。","pos":"名","extra":"","level":"sentence"},{"t":"邪","s":"邪","py":"xié","ctx":"邪僻。","pos":"形","extra":"","level":"sentence"},{"t":"也","s":"也","py":"yě","ctx":"判断语气。","pos":"助","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"官吏丧失德行，是因为宠幸和贿赂公开了。","tokens":[{"t":"官","s":"官","py":"guān","ctx":"官吏。","pos":"名","extra":"","level":"sentence"},{"t":"之","s":"之","py":"zhī","ctx":"的。用在主谓之间。","pos":"助","extra":"","level":"sentence"},{"t":"失","s":"失","py":"shī","ctx":"丧失。","pos":"动","extra":"","level":"sentence"},{"t":"德","s":"德","py":"dé","ctx":"德行。","pos":"名","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"寵賂","s":"宠赂","py":"chǒng lù","ctx":"宠幸和贿赂。","pos":"名","extra":"","level":"sentence"},{"t":"章","s":"章","py":"zhāng","ctx":"公开显露。","pos":"动","extra":"通「彰」","level":"sentence"},{"t":"也","s":"也","py":"yě","ctx":"判断语气。","pos":"助","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"郜鼎放在太庙里，还有什么比这张扬得更厉害呢？","tokens":[{"t":"郜鼎","s":"郜鼎","py":"Gào dǐng","ctx":"郜国的大鼎。","pos":"名","extra":"","level":"sentence"},{"t":"在","s":"在","py":"zài","ctx":"在。","pos":"动","extra":"","level":"sentence"},{"t":"廟","s":"庙","py":"miào","ctx":"太庙。","pos":"名","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"章","s":"章","py":"zhāng","ctx":"显露。","pos":"动","extra":"通「彰」","level":"sentence"},{"t":"孰","s":"孰","py":"shú","ctx":"什么、哪一种。","pos":"代","extra":"","level":"sentence"},{"t":"甚","s":"甚","py":"shèn","ctx":"更严重。","pos":"形","extra":"","level":"sentence"},{"t":"焉","s":"焉","py":"yān","ctx":"于是，比这个。","pos":"兼","extra":"","level":"sentence"},{"t":"？","s":"？","punct":true}]},{"tr":"武王战胜商朝，把九鼎迁到洛邑，义士中还有人非议他，何况要把标明违礼作乱的贿赂器物公开展示在太庙里，这该怎么办呢？」","tokens":[{"t":"武王","s":"武王","py":"Wǔ wáng","ctx":"周武王。","pos":"名","extra":"","level":"sentence"},{"t":"克","s":"克","py":"kè","ctx":"战胜。","pos":"动","extra":"","level":"sentence"},{"t":"商","s":"商","py":"Shāng","ctx":"商朝。","pos":"名","extra":"","level":"sentence"},{"t":"遷","s":"迁","py":"qiān","ctx":"迁移。","pos":"动","extra":"","level":"sentence"},{"t":"九鼎","s":"九鼎","py":"jiǔ dǐng","ctx":"象征三代政权的九个鼎。","pos":"名","extra":"","level":"sentence"},{"t":"於","s":"于","py":"yú","ctx":"到。","pos":"介","extra":"","level":"sentence"},{"t":"雒邑","s":"雒邑","py":"Luò yì","ctx":"洛邑，周的东都。","pos":"名","extra":"同「洛」","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"義士","s":"义士","py":"yì shì","ctx":"坚守道义的人，如伯夷一类。","pos":"名","extra":"","level":"sentence"},{"t":"猶","s":"犹","py":"yóu","ctx":"尚且。","pos":"副","extra":"","level":"sentence"},{"t":"或","s":"或","py":"huò","ctx":"有的人。","pos":"代","extra":"","level":"sentence"},{"t":"非","s":"非","py":"fēi","ctx":"非难、批评。","pos":"动","extra":"","level":"sentence"},{"t":"之","s":"之","py":"zhī","ctx":"这件事。","pos":"代","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"而況","s":"而况","py":"ér kuàng","ctx":"何况。","pos":"连","extra":"","level":"sentence"},{"t":"將","s":"将","py":"jiāng","ctx":"要。","pos":"副","extra":"","level":"sentence"},{"t":"昭","s":"昭","py":"zhāo","ctx":"公开展示。","pos":"动","extra":"活用：使动","level":"sentence"},{"t":"違亂","s":"违乱","py":"wéi luàn","ctx":"违背礼义、制造祸乱。","pos":"名","extra":"","level":"sentence"},{"t":"之","s":"之","py":"zhī","ctx":"的。","pos":"助","extra":"","level":"sentence"},{"t":"賂器","s":"赂器","py":"lù qì","ctx":"贿赂来的器物。","pos":"名","extra":"","level":"sentence"},{"t":"於","s":"于","py":"yú","ctx":"在。","pos":"介","extra":"","level":"sentence"},{"t":"大廟","s":"大庙","py":"tài miào","ctx":"太庙。","pos":"名","extra":"大通「太」","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"其","s":"其","py":"qí","ctx":"语气副词，加强反问。","pos":"副","extra":"","level":"sentence"},{"t":"若","s":"若","py":"ruò","ctx":"奈、拿。","pos":"动","extra":"","level":"sentence"},{"t":"之","s":"之","py":"zhī","ctx":"它，指这件事。","pos":"代","extra":"","level":"sentence"},{"t":"何","s":"何","py":"hé","ctx":"怎么办。若之何，拿它怎么办。","pos":"代","extra":"","level":"sentence"},{"t":"？」","s":"？」","punct":true}]},{"tr":"桓公不听。","tokens":[{"t":"公","s":"公","py":"gōng","ctx":"鲁桓公。","pos":"名","extra":"","level":"sentence"},{"t":"不","s":"不","py":"bù","ctx":"不。","pos":"副","extra":"","level":"sentence"},{"t":"聽","s":"听","py":"tīng","ctx":"听从。","pos":"动","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]}]},{"sentences":[{"tr":"周王室的内史听到这件事，说：「臧孙达在鲁国大概还会有后嗣吧。","tokens":[{"t":"周內史","s":"周内史","py":"Zhōu nèi shǐ","ctx":"周王室的内史，掌管策命的官。","pos":"名","extra":"","level":"sentence"},{"t":"聞","s":"闻","py":"wén","ctx":"听说。","pos":"动","extra":"","level":"sentence"},{"t":"之","s":"之","py":"zhī","ctx":"这件事。","pos":"代","extra":"","level":"sentence"},{"t":"曰","s":"曰","py":"yuē","ctx":"说。","pos":"动","extra":"","level":"sentence"},{"t":"：「","s":"：「","punct":true},{"t":"臧孫達","s":"臧孙达","py":"Zāngsūn Dá","ctx":"即臧哀伯。达是名，臧孙是氏。","pos":"名","extra":"","level":"sentence"},{"t":"其","s":"其","py":"qí","ctx":"大概。揣测语气。","pos":"副","extra":"","level":"sentence"},{"t":"有","s":"有","py":"yǒu","ctx":"有。","pos":"动","extra":"","level":"sentence"},{"t":"後","s":"后","py":"hòu","ctx":"后嗣，能继承其位的子孙。","pos":"名","extra":"","level":"sentence"},{"t":"於","s":"于","py":"yú","ctx":"在。","pos":"介","extra":"","level":"sentence"},{"t":"魯","s":"鲁","py":"Lǔ","ctx":"鲁国。","pos":"名","extra":"","level":"sentence"},{"t":"乎","s":"乎","py":"hū","ctx":"吧。","pos":"助","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"国君做了违背德礼的事，他却不忘记用德来劝谏。」","tokens":[{"t":"君","s":"君","py":"jūn","ctx":"国君，指鲁桓公。","pos":"名","extra":"","level":"sentence"},{"t":"違","s":"违","py":"wéi","ctx":"违背德礼。","pos":"动","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"不","s":"不","py":"bù","ctx":"不。","pos":"副","extra":"","level":"sentence"},{"t":"忘","s":"忘","py":"wàng","ctx":"忘记。","pos":"动","extra":"","level":"sentence"},{"t":"諫","s":"谏","py":"jiàn","ctx":"劝谏。","pos":"动","extra":"","level":"sentence"},{"t":"之","s":"之","py":"zhī","ctx":"他，指桓公。","pos":"代","extra":"","level":"sentence"},{"t":"以","s":"以","py":"yǐ","ctx":"用。","pos":"介","extra":"","level":"sentence"},{"t":"德","s":"德","py":"dé","ctx":"德。指昭德这番道理。","pos":"名","extra":"","level":"sentence"},{"t":"。」","s":"。」","punct":true}]}]}],"lesson":{"background":"本篇选自《左传·桓公二年》。宋国华督杀掉宋殇公，怕诸侯讨伐，把郜国铸造的大鼎送给鲁桓公。这年夏四月，桓公从宋国取来这座鼎，放进太庙。《左传》先下了一句「非礼也」。臧哀伯是臧僖伯的儿子，名达，又称臧孙达。他劝桓公：做人君的要显明德行、堵住邪违，给百官作对照；太庙里的车服、冠冕、佩饰、旌旗，分别昭示节俭、制度、等数、花纹、色彩、声音和光彩。现在把贿赂来的鼎放进太庙，是灭德立违，百官会照着学，事后就无法责罚。国家败坏从官吏走邪开始，官吏失德又从宠幸和贿赂公开开始。武王把九鼎迁到洛邑，义士还有人非议，何况把标明违乱的贿赂器物放在太庙。桓公不听。周王室的内史听说后，认为臧孙达在鲁国还会有后嗣，因为国君虽然违礼，他仍不忘用德来劝谏。作者旧传为左丘明。","keyContentWords":[{"word":"大庙","reading":"tài miào","note":"太庙，供奉始祖的庙。大读 tài。"},{"word":"昭德塞违","reading":"zhāo dé sè wéi","note":"显明美德，堵住邪违。全篇的纲领。"},{"word":"令德","reading":"lìng dé","note":"美德。令，善。"},{"word":"大路","reading":"tài lù","note":"天子祭天的车子，朴素不加华丽装饰。路通「辂」。"},{"word":"越席","reading":"huó xí","note":"结蒲草编成的席。越读 huó。"},{"word":"大羹","reading":"tài gēng","note":"不调盐梅的肉汁，表示太古的朴素。"},{"word":"粢食","reading":"zī sì","note":"祭祀用的黍稷饭食。食读 sì。"},{"word":"不凿","reading":"bù zuò","note":"不舂成精米。凿读 zuò。"},{"word":"赂器","reading":"lù qì","note":"贿赂来的器物，这里指郜鼎。"},{"word":"九鼎","reading":"jiǔ dǐng","note":"传说夏禹所铸，三代相传，视为政权的重器。"},{"word":"雒邑","reading":"Luò yì","note":"洛邑，周的东都。雒同「洛」。"}],"keyFunctionWords":[{"word":"以","reading":"yǐ","note":"以临照百官、以示子孙：用来。文物以纪之：用。谏之以德：用。"},{"word":"于","reading":"yú","note":"取郜大鼎于宋：从。纳于大庙、置于大庙、迁于雒邑：到、在。有后于鲁：在。"},{"word":"其","reading":"qí","note":"昭其俭的其，指君主这些做法所体现的德。其又何诛、其若之何、其有后：语气副词，表反问或揣测。"},{"word":"之","reading":"zhī","note":"或作「的」（国家之败），或作代词（失之、象之、非之、谏之）。"},{"word":"而","reading":"ér","note":"俭而有度：又。而不敢易纪律：就。而置其赂器：却。"},{"word":"焉","reading":"yān","note":"其又何诛焉、章孰甚焉：语气词；后一句兼有「于是」的意思，比这。"}],"ancientModern":[{"word":"取","note":"古：这里是接受送来的鼎，《春秋》用「取」含责备。今：多指拿取。"},{"word":"纳","note":"古：放入。纳于大庙。今：多指交纳、接纳。"},{"word":"违","note":"古：邪僻、不合德的事。塞违、立违。今：多指违背、离别。"},{"word":"令","note":"古：善。令德。今：多指命令、使。"},{"word":"路","note":"大路的路，古指车子。今：道路。"},{"word":"越","note":"古：读 huó，编结。越席。今：多读 yuè，越过。"},{"word":"致","note":"古：把滋味调到极致。不致，不加盐梅。今：多指送达、导致。"},{"word":"食","note":"粢食的食，古读 sì，饭食。今：多读 shí，吃。"},{"word":"凿","note":"古：读 zuò，把谷舂成精米。今：多读 záo，开凿。"},{"word":"度","note":"昭其度、有度，古指制度、法度。今：多指程度，或读 duó 表示猜测。"},{"word":"数","note":"昭其数、有数，古指礼器的等数。今：多读 shù，数目；读 shǔ 才是清点。"},{"word":"物","note":"昭其物的物，古指色彩、物色。今：泛指东西。"},{"word":"纪","note":"古：维系、标识。以纪之。今：多指纪录、纪律。"},{"word":"发","note":"古：发扬。声、明以发之。今：多指发生、送出。"},{"word":"易","note":"古：改变。不敢易纪律。今：多指容易，或交易。"},{"word":"象","note":"古：仿效。百官象之。今：多指形象、大象。"},{"word":"诛","note":"古：责备。何诛。今：多指诛杀。"},{"word":"章","note":"古：公开显露。宠赂章也。今：多指章节、徽章。"},{"word":"或","note":"古：有的人。犹或非之。今：多指或者。"},{"word":"后","note":"古：后嗣，能继承其位的子孙。有后于鲁。今：多指时间或位置在后。"}],"phoneticLoans":[{"word":"路","loan":"辂","note":"大路：祭天的车。路通「辂」。"},{"word":"幅","loan":"偪","note":"带、裳、幅、舄的幅：绑腿。幅读 bì，通「偪」。"},{"word":"游","loan":"旒","note":"游缨的游：旌旗下垂的飘带。游读 liú，通「旒」。"},{"word":"章","loan":"彰","note":"宠赂章也、章孰甚焉：显露。章通「彰」。"},{"word":"寘","loan":"置","note":"寘其赂器于大庙：安放。寘同「置」。"},{"word":"雒","loan":"洛","note":"雒邑：洛邑。雒同「洛」。"},{"word":"大","loan":"太","note":"大庙、大路、大羹的大，读 tài，通「太」。郜大鼎的大仍读 dà。"}],"flexibleUsage":[{"word":"君","note":"君人者：名词作动词，统治人民。"},{"word":"昭","note":"昭德、昭令德、昭其俭：使动，使德行或某种品质显明。"},{"word":"象","note":"百官象之：名词作动词，仿效。"},{"word":"易","note":"不敢易纪律：作动词，改变。易在这里不是「容易」。"}],"specialSyntax":[{"name":"判断句","note":"非礼也。昭其俭也、昭其度也，一直排到昭其明也。国家之败，由官邪也。官之失德，宠赂章也。都用「也」判断。"},{"name":"疑问代词作宾语","note":"其又何诛焉 = 又诛何。何是诛的宾语，疑问代词放在动词前。"},{"name":"反问递进","note":"义士犹或非之，而况将昭违乱之赂器于大庙，其若之何。先让一步，再用「而况」把纳鼎说得更难辩护。"}],"theme":"哀伯要守住的是「昭德塞违」，不是单纯不许收礼。太庙里每一种看似琐碎的器物，都被他说成美德的公开：清庙茅屋、大路越席、大羹不致、粢食不凿，昭示的是俭；冠服佩饰昭示度、数和文；五色、车铃、日月旗昭示物、声和明。这些东西一旦把德立住，百官才会戒惧，不敢改动法纪。郜鼎放进同一座庙，公开的却是贿赂。所以「章孰甚焉」比空讲受贿厉害：庙是百官助祭的地方，鼎在那里，宠赂就无法再遮。武王迁九鼎尚且有义士非议，衬出桓公做的是把违乱本身摆上祭台。","technique":"叙事只有三句，第三句「非礼也」先判决，后面的谏辞是把判决展开。开篇「昭德塞违」四字是总纲，中间七个「昭其……也」是分项。每一项都是一串名词加上一个判断，读起来像礼器清单，实际上是在太庙里给桓公找对照。清单之后用「夫德」收束，把俭、度、数、文、物、声、明收成「临照百官」。转折只靠一个「今」字，灭德立违、置赂器、百官象之，一层比一层落在后果上。再以国家之败、官之失德、郜鼎在庙三句把「章」字钉死。最后抬出武王和义士，用「犹或」对「而况」。内史不再重复论据，只补「有后」和「不忘」，把僖伯谏观鱼、哀伯谏纳鼎接成父子两世。"},"classicComment":{"t":"劈頭將「昭德塞違」四字提綱，而「塞違」全在「昭德」處見。故中間節節將「昭」字分疏，見廟堂中何一非令德所在，則大廟容不得違亂賂鼎可知。後復將「塞違」意分作三樣寫法，以冀君之一寤而出鼎，故曰「不忘」。","s":"劈头将「昭德塞违」四字提纲，而「塞违」全在「昭德」处见。故中间节节将「昭」字分疏，见庙堂中何一非令德所在，则大庙容不得违乱赂鼎可知。后复将「塞违」意分作三样写法，以冀君之一寤而出鼎，故曰「不忘」。"}}