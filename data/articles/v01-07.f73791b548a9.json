tence"},{"t":"之","s":"之","py":"zhī","ctx":"他们，百姓。","pos":"代","extra":"","level":"sentence"},{"t":"福","s":"福","py":"fú","ctx":"福。","pos":"名","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"所以一行动就有成效。","tokens":[{"t":"故","s":"故","py":"gù","ctx":"所以。","pos":"连","extra":"","level":"sentence"},{"t":"動","s":"动","py":"dòng","ctx":"行动。","pos":"动","extra":"","level":"sentence"},{"t":"則","s":"则","py":"zé","ctx":"就。","pos":"副","extra":"","level":"sentence"},{"t":"有成","s":"有成","py":"yǒu chéng","ctx":"有成功。","pos":"动","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"现在百姓各有各的心，鬼神缺少凭依的主体，您即使独自把祭品备得丰盛，难道会有什么福？","tokens":[{"t":"今","s":"今","py":"jīn","ctx":"现在。","pos":"名","extra":"","level":"sentence"},{"t":"民","s":"民","py":"mín","ctx":"百姓。","pos":"名","extra":"","level":"sentence"},{"t":"各","s":"各","py":"gè","ctx":"各自。","pos":"副","extra":"","level":"sentence"},{"t":"有","s":"有","py":"yǒu","ctx":"有。","pos":"动","extra":"","level":"sentence"},{"t":"心","s":"心","py":"xīn","ctx":"心意，指不和。","pos":"名","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"而","s":"而","py":"ér","ctx":"因而。","pos":"连","extra":"","level":"sentence"},{"t":"鬼神","s":"鬼神","py":"guǐ shén","ctx":"鬼神。","pos":"名","extra":"","level":"sentence"},{"t":"乏","s":"乏","py":"fá","ctx":"缺少。","pos":"动","extra":"","level":"sentence"},{"t":"主","s":"主","py":"zhǔ","ctx":"所凭依的百姓。","pos":"名","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"君","s":"君","py":"jūn","ctx":"您。","pos":"代","extra":"","level":"sentence"},{"t":"雖","s":"虽","py":"suī","ctx":"即使。","pos":"连","extra":"","level":"sentence"},{"t":"獨","s":"独","py":"dú","ctx":"独自。","pos":"副","extra":"","level":"sentence"},{"t":"豐","s":"丰","py":"fēng","ctx":"祭品丰盛。","pos":"形","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"其","s":"其","py":"qí","ctx":"难道。","pos":"副","extra":"","level":"sentence"},{"t":"何","s":"何","py":"hé","ctx":"什么。宾语前置。","pos":"代","extra":"","level":"sentence"},{"t":"福","s":"福","py":"fú","ctx":"福。","pos":"名","extra":"","level":"sentence"},{"t":"之","s":"之","py":"zhī","ctx":"宾语前置的标志。","pos":"助","extra":"","level":"sentence"},{"t":"有","s":"有","py":"yǒu","ctx":"有。","pos":"动","extra":"","level":"sentence"},{"t":"？","s":"？","punct":true}]},{"tr":"您姑且修明政事，亲近兄弟国家，或许能免于祸难。」","tokens":[{"t":"君","s":"君","py":"jūn","ctx":"您。","pos":"代","extra":"","level":"sentence"},{"t":"姑","s":"姑","py":"gū","ctx":"姑且。","pos":"副","extra":"","level":"sentence"},{"t":"修政","s":"修政","py":"xiū zhèng","ctx":"修明政事。","pos":"动","extra":"","level":"sentence"},{"t":"而","s":"而","py":"ér","ctx":"并且。","pos":"连","extra":"","level":"sentence"},{"t":"親","s":"亲","py":"qīn","ctx":"亲近。","pos":"动","extra":"","level":"sentence"},{"t":"兄弟","s":"兄弟","py":"xiōng dì","ctx":"同姓兄弟。","pos":"名","extra":"","level":"sentence"},{"t":"之","s":"之","py":"zhī","ctx":"的。","pos":"助","extra":"","level":"sentence"},{"t":"國","s":"国","py":"guó","ctx":"国家。","pos":"名","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"庶","s":"庶","py":"shù","ctx":"或许。","pos":"副","extra":"","level":"sentence"},{"t":"免","s":"免","py":"miǎn","ctx":"免除。","pos":"动","extra":"","level":"sentence"},{"t":"於","s":"于","py":"yú","ctx":"从。","pos":"介","extra":"","level":"sentence"},{"t":"難","s":"难","py":"nàn","ctx":"祸难。","pos":"名","extra":"","level":"sentence"},{"t":"。」","s":"。」","punct":true}]},{"tr":"随侯害怕了，就修明政事。","tokens":[{"t":"隨侯","s":"随侯","py":"Suí hóu","ctx":"随国国君。","pos":"名","extra":"","level":"sentence"},{"t":"懼","s":"惧","py":"jù","ctx":"畏惧。","pos":"动","extra":"","level":"sentence"},{"t":"而","s":"而","py":"ér","ctx":"就。","pos":"连","extra":"","level":"sentence"},{"t":"修政","s":"修政","py":"xiū zhèng","ctx":"修明政事。","pos":"动","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"楚国不敢攻打随国。","tokens":[{"t":"楚","s":"楚","py":"Chǔ","ctx":"楚国。","pos":"名","extra":"","level":"sentence"},{"t":"不敢","s":"不敢","py":"bù gǎn","ctx":"不敢。","pos":"副","extra":"","level":"sentence"},{"t":"伐","s":"伐","py":"fá","ctx":"攻打。","pos":"动","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"本篇选自《左传·桓公六年》。楚武王想向汉水以东扩展，派薳章向随国求和，把军队停在瑕地。随国派少师去主持和谈。楚大夫鬬伯比主张故意示弱，让骄傲的少师促成随侯自大，从而离间随和汉东小国。随臣季梁识破示弱，劝随侯先修政、亲兄弟之国。随侯听从，楚国便不敢进攻。作者旧传为左丘明。","keyContentWords":[{"word":"求成","reading":"qiú chéng","note":"求和。"},{"word":"董成","reading":"dǒng chéng","note":"主持和谈。"},{"word":"间","reading":"jiàn","note":"离间。"},{"word":"羸","reading":"léi","note":"瘦弱。这里指故意使军队显得弱。"},{"word":"馁","reading":"něi","note":"饥饿。"},{"word":"牲牷","reading":"shēng quán","note":"毛色纯一、肢体完整的祭牲。"},{"word":"粢盛","reading":"zī chéng","note":"装在祭器里的谷物。"},{"word":"禋祀","reading":"yīn sì","note":"诚敬的祭祀。"}],"keyFunctionWords":[{"word":"焉","reading":"yān","note":"求成焉：向随人。君何急焉：呢。"},{"word":"则","reading":"zé","note":"我则使然：就是。彼则惧：就。"},{"word":"其","reading":"qí","note":"其诱我也：恐怕。其何福之有：难道。"},{"word":"庶","reading":"shù","note":"庶免于难：或许可以。"}],"ancientModern":[{"word":"张","note":"古：扩张，或使对方自高自大。今：多指张开、张望。"},{"word":"间","note":"古：读 jiàn，离间。今：多读 jiān，中间。"},{"word":"成","note":"求成、董成：讲和。今：多指完成、成为。"},{"word":"主","note":"神之主：神所凭依的主体，指百姓。今：多指主人、主要。"}],"phoneticLoans":[{"word":"被","loan":"披","note":"被吾甲兵：披上铠甲、拿起兵器。"}],"flexibleUsage":[{"word":"军","note":"军于瑕：名词作动词，驻扎。"},{"word":"张","note":"请羸师以张之：使随国骄傲。形容词使动。"},{"word":"羸","note":"羸师：使军队显得疲弱。形容词使动。"},{"word":"成","note":"先成民：使百姓安定。形容词使动。"}],"specialSyntax":[{"name":"判断句","note":"随为大。小国离，楚之利也。夫民，神之主也。"},{"name":"宾语前置","note":"其何福之有 = 有何福。"},{"name":"引用告神之辞","note":"博硕肥腯、洁粢丰盛、嘉栗旨酒，都是祭告时的套语，下文逐层解释。"}],"theme":"小国要抵挡大国，不能靠祭品丰盛，而要忠于民、信于神。民是神的主体：百姓和乐、农时不误，神才降福。对外则先修好邻国，不急于追击示弱的楚军。","technique":"前半是楚人的计，后半是季梁的识破，两面对照。季梁不空讲道，把「博硕肥腯」「洁粢丰盛」「嘉栗旨酒」三句祭辞逐句拆开，都落到百姓身上，说理因此具体。"},"classicComment":{"t":"起手將忠民、信神並提，轉到民爲神主。先民後神，乃千古不易之論。篇中偏從致力於神處看出成民作用來，故足以破隨侯之惑，而起其懼心。至其行文，如流雲織錦，天花亂墜，令人應接不暇。","s":"起手将忠民、信神并提，转到民为神主。先民后神，乃千古不易之论。篇中偏从致力于神处看出成民作用来，故足以破随侯之惑，而起其惧心。至其行文，如流云织锦，天花乱坠，令人应接不暇。"}}