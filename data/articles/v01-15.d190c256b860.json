，","punct":true},{"t":"身","s":"身","py":"shēn","ctx":"身体、自身。","pos":"名","extra":"","level":"sentence"},{"t":"之","s":"之","py":"zhī","ctx":"的。","pos":"助","extra":"","level":"sentence"},{"t":"文","s":"文","py":"wén","ctx":"文饰。","pos":"名","extra":"","level":"sentence"},{"t":"也","s":"也","py":"yě","ctx":"判断语气。","pos":"助","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"自身将要隐藏，哪里用得着文饰它？","tokens":[{"t":"身","s":"身","py":"shēn","ctx":"自身。","pos":"名","extra":"","level":"sentence"},{"t":"將","s":"将","py":"jiāng","ctx":"将要。","pos":"副","extra":"","level":"sentence"},{"t":"隱","s":"隐","py":"yǐn","ctx":"隐居。","pos":"动","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"焉","s":"焉","py":"yān","ctx":"哪里。","pos":"副","extra":"","level":"sentence"},{"t":"用","s":"用","py":"yòng","ctx":"用。","pos":"动","extra":"","level":"sentence"},{"t":"文","s":"文","py":"wén","ctx":"文饰。","pos":"动","extra":"活用：名词作动词","level":"sentence"},{"t":"之","s":"之","py":"zhī","ctx":"自身。","pos":"代","extra":"","level":"sentence"},{"t":"？","s":"？","punct":true}]},{"tr":"这样做是求显达。」","tokens":[{"t":"是","s":"是","py":"shì","ctx":"这。","pos":"代","extra":"","level":"sentence"},{"t":"求","s":"求","py":"qiú","ctx":"追求。","pos":"动","extra":"","level":"sentence"},{"t":"顯","s":"显","py":"xiǎn","ctx":"显达。","pos":"形","extra":"","level":"sentence"},{"t":"也","s":"也","py":"yě","ctx":"判断语气。","pos":"助","extra":"","level":"sentence"},{"t":"。」","s":"。」","punct":true}]},{"tr":"他的母亲说：「能像这样吗？我和你一起隐居。」","tokens":[{"t":"其","s":"其","py":"qí","ctx":"他的。","pos":"代","extra":"","level":"sentence"},{"t":"母","s":"母","py":"mǔ","ctx":"母亲。","pos":"名","extra":"","level":"sentence"},{"t":"曰","s":"曰","py":"yuē","ctx":"说。","pos":"动","extra":"","level":"sentence"},{"t":"：「","s":"：「","punct":true},{"t":"能","s":"能","py":"néng","ctx":"能够。","pos":"能","extra":"","level":"sentence"},{"t":"如是","s":"如是","py":"rú shì","ctx":"像这样。","pos":"代","extra":"","level":"sentence"},{"t":"乎","s":"乎","py":"hū","ctx":"吗。","pos":"助","extra":"","level":"sentence"},{"t":"？","s":"？","punct":true},{"t":"與","s":"与","py":"yǔ","ctx":"和。","pos":"介","extra":"","level":"sentence"},{"t":"汝","s":"汝","py":"rǔ","ctx":"你。","pos":"代","extra":"","level":"sentence"},{"t":"偕","s":"偕","py":"xié","ctx":"一起。","pos":"副","extra":"","level":"sentence"},{"t":"隱","s":"隐","py":"yǐn","ctx":"隐居。","pos":"动","extra":"","level":"sentence"},{"t":"。」","s":"。」","punct":true}]},{"tr":"于是隐居到死。","tokens":[{"t":"遂","s":"遂","py":"suì","ctx":"于是。","pos":"副","extra":"","level":"sentence"},{"t":"隱","s":"隐","py":"yǐn","ctx":"隐居。","pos":"动","extra":"","level":"sentence"},{"t":"而","s":"而","py":"ér","ctx":"直到。","pos":"连","extra":"","level":"sentence"},{"t":"死","s":"死","py":"sǐ","ctx":"死。","pos":"动","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]}]},{"sentences":[{"tr":"晋侯寻找他没有找到，把绵上作为他的祭田。","tokens":[{"t":"晉侯","s":"晋侯","py":"Jìn hóu","ctx":"晋文公。","pos":"名","extra":"","level":"sentence"},{"t":"求","s":"求","py":"qiú","ctx":"寻找。","pos":"动","extra":"","level":"sentence"},{"t":"之","s":"之","py":"zhī","ctx":"他。","pos":"代","extra":"","level":"sentence"},{"t":"不獲","s":"不获","py":"bù huò","ctx":"没有找到。","pos":"动","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"以","s":"以","py":"yǐ","ctx":"把。","pos":"介","extra":"","level":"sentence"},{"t":"緜上","s":"緜上","py":"Mián shàng","ctx":"地名。","pos":"名","extra":"緜通「绵」","level":"sentence"},{"t":"爲","s":"为","py":"wéi","ctx":"作为。","pos":"动","extra":"","level":"sentence"},{"t":"之","s":"之","py":"zhī","ctx":"他的。","pos":"代","extra":"","level":"sentence"},{"t":"田","s":"田","py":"tián","ctx":"祭田。","pos":"名","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"说：「用来记下我的过错，并且表彰好人。」","tokens":[{"t":"曰","s":"曰","py":"yuē","ctx":"文公说。","pos":"动","extra":"","level":"sentence"},{"t":"：「","s":"：「","punct":true},{"t":"以","s":"以","py":"yǐ","ctx":"用来。","pos":"连","extra":"","level":"sentence"},{"t":"志","s":"志","py":"zhì","ctx":"记下。","pos":"动","extra":"","level":"sentence"},{"t":"吾","s":"吾","py":"wú","ctx":"我的。","pos":"代","extra":"","level":"sentence"},{"t":"過","s":"过","py":"guò","ctx":"过错。","pos":"名","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"且","s":"且","py":"qiě","ctx":"并且。","pos":"连","extra":"","level":"sentence"},{"t":"旌","s":"旌","py":"jīng","ctx":"表彰。","pos":"动","extra":"","level":"sentence"},{"t":"善人","s":"善人","py":"shàn rén","ctx":"好人，指介之推。","pos":"名","extra":"","level":"sentence"},{"t":"。」","s":"。」","punct":true}]}]}],"lesson":{"background":"本篇选自《左传·僖公二十四年》。晋文公赏赐跟随他流亡的人。介之推不谈禄位，禄位也没有轮到他。他认为文公能回国是上天的安排，跟随的人把天功说成自己的力量，是欺骗。母亲劝他去求，他不肯，母子一起隐居到死。文公找不到他，把绵上作为他的祭田，用来记下自己的过错、表彰好人。作者旧传为左丘明。","keyContentWords":[{"word":"从亡","reading":"cóng wáng","note":"跟随流亡。"},{"word":"禄","reading":"lù","note":"禄位、俸禄。"},{"word":"置","reading":"zhì","note":"安排、立。"},{"word":"诬","reading":"wū","note":"欺骗。"},{"word":"怼","reading":"duì","note":"怨恨。"},{"word":"绵上","reading":"Mián shàng","note":"晋地，在今山西介休东南。"},{"word":"旌","reading":"jīng","note":"表彰。"}],"keyFunctionWords":[{"word":"而","reading":"ér","note":"非君而谁：还有。"},{"word":"盍","reading":"hé","note":"何不。"},{"word":"焉","reading":"yān","note":"焉用文之：哪里。罪又甚焉：比这。"},{"word":"以","reading":"yǐ","note":"以为己力：把。以绵上：把。以志：用来。"}],"ancientModern":[{"word":"文","note":"身之文：文饰、外表的文采。今：多指文字、文章、文化。"},{"word":"志","note":"以志吾过：记下。今：多指志向、志气。"},{"word":"田","note":"为之田：祭田、封地。今：农田。"},{"word":"推","note":"这里是人名介之推的省称，不是推辞的推。推辞的意思由「不言禄」表达。"}],"phoneticLoans":[{"word":"緜","loan":"绵","note":"绵上，地名。"}],"flexibleUsage":[{"word":"义","note":"下义其罪：名词意动，把罪过当成正义。"},{"word":"赏","note":"上赏其奸：把奸邪当作该赏的。"},{"word":"文","note":"焉用文之：名词作动词，文饰。"}],"specialSyntax":[{"name":"反问","note":"非君而谁？不亦诬乎？以死谁怼？"},{"name":"判断句","note":"言，身之文也。是求显也。"},{"name":"对比","note":"窃人之财犹谓之盗，况贪天之功。下义其罪，上赏其奸。"}],"theme":"流亡的人把上天的安排说成自己的功劳，在下的人把这种过错当成正义，在上的人又赏赐它。介之推不愿效仿，也不肯用隐居做一番表白，所以连让文公知道都不愿意。","technique":"介之推的话一层比一层紧：先说天置君，再说贪天功甚于盗，再说上下相蒙不能共处。母亲三次发问，他三次拒绝，最后母子一同隐去。文公的赏田出现在人已经死了以后，表彰因此带着补过的意味。"},"classicComment":{"t":"晉文反國之初，從行諸臣，駢首爭功，有市人之所不忍爲者。而介推獨超然衆紛之外，孰謂此時而有此人乎。是宜百世之後，聞其風者，猶咨嗟歎息不能已也。篇中三提其母，作三樣寫法。介推之高，其母成之歟。","s":"晋文反国之初，从行诸臣，骈首争功，有市人之所不忍为者。而介推独超然众纷之外，孰谓此时而有此人乎。是宜百世之后，闻其风者，犹咨嗟叹息不能已也。篇中三提其母，作三样写法。介推之高，其母成之欤。"}}