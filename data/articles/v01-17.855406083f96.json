el":"sentence"},{"t":"有益","s":"有益","py":"yǒu yì","ctx":"有好处。","pos":"动","extra":"","level":"sentence"},{"t":"於","s":"于","py":"yú","ctx":"对。","pos":"介","extra":"","level":"sentence"},{"t":"君","s":"君","py":"jūn","ctx":"您，秦伯。","pos":"代","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"敢","s":"敢","py":"gǎn","ctx":"冒昧。","pos":"副","extra":"","level":"sentence"},{"t":"以","s":"以","py":"yǐ","ctx":"拿（亡郑这件事）。","pos":"介","extra":"","level":"sentence"},{"t":"煩","s":"烦","py":"fán","ctx":"麻烦。","pos":"动","extra":"","level":"sentence"},{"t":"執事","s":"执事","py":"zhí shì","ctx":"办事的人，敬称秦伯。","pos":"名","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"越过别国把远地当作边邑，您知道那是难的。","tokens":[{"t":"越","s":"越","py":"yuè","ctx":"越过。","pos":"动","extra":"","level":"sentence"},{"t":"國","s":"国","py":"guó","ctx":"别国，指晋。","pos":"名","extra":"","level":"sentence"},{"t":"以","s":"以","py":"yǐ","ctx":"来。","pos":"连","extra":"","level":"sentence"},{"t":"鄙","s":"鄙","py":"bǐ","ctx":"把……当作边邑。","pos":"动","extra":"活用：名词意动","level":"sentence"},{"t":"遠","s":"远","py":"yuǎn","ctx":"远方的郑国。","pos":"名","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"君","s":"君","py":"jūn","ctx":"您。","pos":"代","extra":"","level":"sentence"},{"t":"知","s":"知","py":"zhī","ctx":"知道。","pos":"动","extra":"","level":"sentence"},{"t":"其","s":"其","py":"qí","ctx":"那样做。","pos":"代","extra":"","level":"sentence"},{"t":"難","s":"难","py":"nán","ctx":"困难。","pos":"形","extra":"","level":"sentence"},{"t":"也","s":"也","py":"yě","ctx":"判断语气。","pos":"助","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"哪里用得着灭掉郑国来给邻国增加土地。","tokens":[{"t":"焉","s":"焉","py":"yān","ctx":"哪里。","pos":"副","extra":"","level":"sentence"},{"t":"用","s":"用","py":"yòng","ctx":"用。","pos":"动","extra":"","level":"sentence"},{"t":"亡","s":"亡","py":"wáng","ctx":"使灭亡。","pos":"动","extra":"","level":"sentence"},{"t":"鄭","s":"郑","py":"Zhèng","ctx":"郑国。","pos":"名","extra":"","level":"sentence"},{"t":"以","s":"以","py":"yǐ","ctx":"来。","pos":"连","extra":"","level":"sentence"},{"t":"陪","s":"陪","py":"péi","ctx":"增加。","pos":"动","extra":"","level":"sentence"},{"t":"鄰","s":"邻","py":"lín","ctx":"邻国，指晋。","pos":"名","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"邻国的土地加厚了，就是您的力量变薄了。","tokens":[{"t":"鄰","s":"邻","py":"lín","ctx":"晋国。","pos":"名","extra":"","level":"sentence"},{"t":"之","s":"之","py":"zhī","ctx":"取消句子独立性。","pos":"助","extra":"","level":"sentence"},{"t":"厚","s":"厚","py":"hòu","ctx":"变雄厚。","pos":"动","extra":"活用：形容词作动词","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"君","s":"君","py":"jūn","ctx":"您。","pos":"代","extra":"","level":"sentence"},{"t":"之","s":"之","py":"zhī","ctx":"取消句子独立性。","pos":"助","extra":"","level":"sentence"},{"t":"薄","s":"薄","py":"bó","ctx":"变削弱。","pos":"动","extra":"活用：形容词作动词","level":"sentence"},{"t":"也","s":"也","py":"yě","ctx":"判断语气。","pos":"助","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"如果放下郑国，把它当作东方路上的主人，使者来往，供给他们缺少的东西，您也没有什么损害。","tokens":[{"t":"若","s":"若","py":"ruò","ctx":"如果。","pos":"连","extra":"","level":"sentence"},{"t":"舍","s":"舍","py":"shě","ctx":"放弃、放过。","pos":"动","extra":"","level":"sentence"},{"t":"鄭","s":"郑","py":"Zhèng","ctx":"郑国。","pos":"名","extra":"","level":"sentence"},{"t":"以","s":"以","py":"yǐ","ctx":"把。","pos":"介","extra":"","level":"sentence"},{"t":"爲","s":"为","py":"wéi","ctx":"作为。","pos":"动","extra":"","level":"sentence"},{"t":"東道主","s":"东道主","py":"dōng dào zhǔ","ctx":"东方路上的主人。","pos":"名","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"行李","s":"行李","py":"xíng lǐ","ctx":"外交使者。","pos":"名","extra":"","level":"sentence"},{"t":"之","s":"之","py":"zhī","ctx":"取消句子独立性。","pos":"助","extra":"","level":"sentence"},{"t":"往來","s":"往来","py":"wǎng lái","ctx":"来来往往。","pos":"动","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"共","s":"共","py":"gōng","ctx":"供给。","pos":"动","extra":"通「供」","level":"sentence"},{"t":"其","s":"其","py":"qí","ctx":"他们的。","pos":"代","extra":"","level":"sentence"},{"t":"乏困","s":"乏困","py":"fá kùn","ctx":"缺少的物资。","pos":"名","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"君","s":"君","py":"jūn","ctx":"您。","pos":"代","extra":"","level":"sentence"},{"t":"亦","s":"亦","py":"yì","ctx":"也。","pos":"副","extra":"","level":"sentence"},{"t":"無","s":"无","py":"wú","ctx":"没有。","pos":"动","extra":"","level":"sentence"},{"t":"所害","s":"所害","py":"suǒ hài","ctx":"受损害的地方。","pos":"名","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"况且您曾经给晋君施过恩惠。","tokens":[{"t":"且","s":"且","py":"qiě","ctx":"况且。","pos":"连","extra":"","level":"sentence"},{"t":"君","s":"君","py":"jūn","ctx":"您。","pos":"代","extra":"","level":"sentence"},{"t":"嘗","s":"尝","py":"cháng","ctx":"曾经。","pos":"副","extra":"","level":"sentence"},{"t":"爲","s":"为","py":"wéi","ctx":"给予、施予。","pos":"动","extra":"","level":"sentence"},{"t":"晉君","s":"晋君","py":"Jìn jūn","ctx":"晋惠公。","pos":"名","extra":"","level":"sentence"},{"t":"賜","s":"赐","py":"cì","ctx":"恩惠。","pos":"名","extra":"","level":"sentence"},{"t":"矣","s":"矣","py":"yǐ","ctx":"了。","pos":"助","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"（他）答应把焦、瑕给您，早晨过了河，晚上就筑起防御工事。","tokens":[{"t":"許","s":"许","py":"xǔ","ctx":"答应给。","pos":"动","extra":"","level":"sentence"},{"t":"君","s":"君","py":"jūn","ctx":"您。","pos":"代","extra":"","level":"sentence"},{"t":"焦瑕","s":"焦瑕","py":"Jiāo Xiá","ctx":"晋国的两座城。","pos":"名","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"朝","s":"朝","py":"zhāo","ctx":"早晨。","pos":"名","extra":"","level":"sentence"},{"t":"濟","s":"济","py":"jì","ctx":"渡河。","pos":"动","extra":"","level":"sentence"},{"t":"而","s":"而","py":"ér","ctx":"却。","pos":"连","extra":"","level":"sentence"},{"t":"夕","s":"夕","py":"xī","ctx":"晚上。名词作状语。","pos":"名","extra":"","level":"sentence"},{"t":"設版","s":"设版","py":"shè bǎn","ctx":"筑墙设防。版，筑墙的夹板。","pos":"动","extra":"","level":"sentence"},{"t":"焉","s":"焉","py":"yān","ctx":"在那里。","pos":"兼","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"这是您所知道的。","tokens":[{"t":"君","s":"君","py":"jūn","ctx":"您。","pos":"代","extra":"","level":"sentence"},{"t":"之","s":"之","py":"zhī","ctx":"的。","pos":"助","extra":"","level":"sentence"},{"t":"所知","s":"所知","py":"suǒ zhī","ctx":"知道的事。","pos":"名","extra":"","level":"sentence"},{"t":"也","s":"也","py":"yě","ctx":"判断语气。","pos":"助","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"晋国，哪里有满足的时候？","tokens":[{"t":"夫","s":"夫","py":"fú","ctx":"发语词。","pos":"助","extra":"","level":"sentence"},{"t":"晉","s":"晋","py":"Jìn","ctx":"晋国。","pos":"名","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"何","s":"何","py":"hé","ctx":"什么。宾语前置。","pos":"代","extra":"","level":"sentence"},{"t":"厭","s":"厌","py":"yàn","ctx":"满足。","pos":"动","extra":"通「餍」","level":"sentence"},{"t":"之","s":"之","py":"zhī","ctx":"宾语前置的标志。","pos":"助","extra":"","level":"sentence"},{"t":"有","s":"有","py":"yǒu","ctx":"有。","pos":"动","extra":"","level":"sentence"},{"t":"？","s":"？","punct":true}]},{"tr":"已经向东把郑国当作疆界，又想扩展它西边的疆界。","tokens":[{"t":"旣","s":"既","py":"jì","ctx":"已经。","pos":"副","extra":"","level":"sentence"},{"t":"東","s":"东","py":"dōng","ctx":"向东。名词作状语。","pos":"名","extra":"","level":"sentence"},{"t":"封","s":"封","py":"fēng","ctx":"以……为疆界。","pos":"动","extra":"活用：名词作动词","level":"sentence"},{"t":"鄭","s":"郑","py":"Zhèng","ctx":"郑国。","pos":"名","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"又","s":"又","py":"yòu","ctx":"又。","pos":"副","extra":"","level":"sentence"},{"t":"欲","s":"欲","py":"yù","ctx":"想要。","pos":"动","extra":"","level":"sentence"},{"t":"肆","s":"肆","py":"sì","ctx":"延伸、扩张。","pos":"动","extra":"","level":"sentence"},{"t":"其","s":"其","py":"qí","ctx":"它的。","pos":"代","extra":"","level":"sentence"},{"t":"西","s":"西","py":"xī","ctx":"西边。","pos":"名","extra":"","level":"sentence"},{"t":"封","s":"封","py":"fēng","ctx":"疆界。","pos":"名","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"如果不损害秦国，将从哪里取得土地？","tokens":[{"t":"若","s":"若","py":"ruò","ctx":"如果。","pos":"连","extra":"","level":"sentence"},{"t":"不","s":"不","py":"bù","ctx":"不。","pos":"副","extra":"","level":"sentence"},{"t":"闕","s":"阙","py":"quē","ctx":"使亏损、侵削。","pos":"动","extra":"","level":"sentence"},{"t":"秦","s":"秦","py":"Qín","ctx":"秦国。","pos":"名","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"將","s":"将","py":"jiāng","ctx":"将要。","pos":"副","extra":"","level":"sentence"},{"t":"焉","s":"焉","py":"yān","ctx":"从哪里。","pos":"副","extra":"","level":"sentence"},{"t":"取","s":"取","py":"qǔ","ctx":"取得土地。","pos":"动","extra":"","level":"sentence"},{"t":"之","s":"之","py":"zhī","ctx":"土地。","pos":"代","extra":"","level":"sentence"},{"t":"？","s":"？","punct":true}]},{"tr":"损害秦国来使晋国得利，只希望您考虑这件事。」","tokens":[{"t":"闕","s":"阙","py":"quē","ctx":"损害。","pos":"动","extra":"","level":"sentence"},{"t":"秦","s":"秦","py":"Qín","ctx":"秦国。","pos":"名","extra":"","level":"sentence"},{"t":"以","s":"以","py":"yǐ","ctx":"来。","pos":"连","extra":"","level":"sentence"},{"t":"利","s":"利","py":"lì","ctx":"使……得利。","pos":"动","extra":"活用：名词使动","level":"sentence"},{"t":"晉","s":"晋","py":"Jìn","ctx":"晋国。","pos":"名","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"唯","s":"唯","py":"wéi","ctx":"希望。","pos":"副","extra":"","level":"sentence"},{"t":"君","s":"君","py":"jūn","ctx":"您。","pos":"代","extra":"","level":"sentence"},{"t":"圖","s":"图","py":"tú","ctx":"考虑。","pos":"动","extra":"","level":"sentence"},{"t":"之","s":"之","py":"zhī","ctx":"这件事。","pos":"代","extra":"","level":"sentence"},{"t":"。」","s":"。」","punct":true}]},{"tr":"秦伯高兴了，和郑国人订立盟约。","tokens":[{"t":"秦伯","s":"秦伯","py":"Qín bó","ctx":"秦穆公。","pos":"名","extra":"","level":"sentence"},{"t":"說","s":"说","py":"yuè","ctx":"高兴。","pos":"动","extra":"通「悦」","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"與","s":"与","py":"yǔ","ctx":"和。","pos":"介","extra":"","level":"sentence"},{"t":"鄭人","s":"郑人","py":"Zhèng rén","ctx":"郑国人。","pos":"名","extra":"","level":"sentence"},{"t":"盟","s":"盟","py":"méng","ctx":"订盟。","pos":"动","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"派杞子、逢孙、杨孙驻守郑国，自己就回去了。","tokens":[{"t":"使","s":"使","py":"shǐ","ctx":"派遣。","pos":"动","extra":"","level":"sentence"},{"t":"杞子","s":"杞子","py":"Qǐ Zǐ","ctx":"秦国大夫。","pos":"名","extra":"","level":"sentence"},{"t":"、","s":"、","punct":true},{"t":"逢孫","s":"逢孙","py":"Páng Sūn","ctx":"秦国大夫。","pos":"名","extra":"","level":"sentence"},{"t":"、","s":"、","punct":true},{"t":"楊孫","s":"杨孙","py":"Yáng Sūn","ctx":"秦国大夫。","pos":"名","extra":"","level":"sentence"},{"t":"戍","s":"戍","py":"shù","ctx":"驻守。","pos":"动","extra":"","level":"sentence"},{"t":"之","s":"之","py":"zhī","ctx":"郑国。","pos":"代","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"乃","s":"乃","py":"nǎi","ctx":"就。","pos":"副","extra":"","level":"sentence"},{"t":"還","s":"还","py":"huán","ctx":"回国。","pos":"动","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]}]},{"sentences":[{"tr":"子犯请求袭击秦军。","tokens":[{"t":"子犯","s":"子犯","py":"Zǐ fàn","ctx":"晋国大夫狐偃。","pos":"名","extra":"","level":"sentence"},{"t":"請","s":"请","py":"qǐng","ctx":"请求。","pos":"动","extra":"","level":"sentence"},{"t":"擊","s":"击","py":"jī","ctx":"攻击。","pos":"动","extra":"","level":"sentence"},{"t":"之","s":"之","py":"zhī","ctx":"秦军。","pos":"代","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"晋文公说：「不行。","tokens":[{"t":"公","s":"公","py":"gōng","ctx":"晋文公。","pos":"名","extra":"","level":"sentence"},{"t":"曰","s":"曰","py":"yuē","ctx":"说。","pos":"动","extra":"","level":"sentence"},{"t":"：「","s":"：「","punct":true},{"t":"不可","s":"不可","py":"bù kě","ctx":"不可以。","pos":"能","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"如果没有那个人的力量，我到不了今天这个地位。","tokens":[{"t":"微","s":"微","py":"wēi","ctx":"如果没有。","pos":"连","extra":"","level":"sentence"},{"t":"夫人","s":"夫人","py":"fú rén","ctx":"那个人，指秦穆公。","pos":"代","extra":"","level":"sentence"},{"t":"之","s":"之","py":"zhī","ctx":"的。","pos":"助","extra":"","level":"sentence"},{"t":"力","s":"力","py":"lì","ctx":"力量。","pos":"名","extra":"","level":"sentence"},{"t":"不及","s":"不及","py":"bù jí","ctx":"不能达到。","pos":"动","extra":"","level":"sentence"},{"t":"此","s":"此","py":"cǐ","ctx":"这个地位。","pos":"代","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"依靠别人的力量，又去损害他，这不仁。","tokens":[{"t":"因","s":"因","py":"yīn","ctx":"依靠。","pos":"动","extra":"","level":"sentence"},{"t":"人","s":"人","py":"rén","ctx":"别人，指秦。","pos":"名","extra":"","level":"sentence"},{"t":"之","s":"之","py":"zhī","ctx":"的。","pos":"助","extra":"","level":"sentence"},{"t":"力","s":"力","py":"lì","ctx":"力量。","pos":"名","extra":"","level":"sentence"},{"t":"而","s":"而","py":"ér","ctx":"却。","pos":"连","extra":"","level":"sentence"},{"t":"敝","s":"敝","py":"bì","ctx":"损害。","pos":"动","extra":"活用：形容词作动词","level":"sentence"},{"t":"之","s":"之","py":"zhī","ctx":"他。","pos":"代","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"不仁","s":"不仁","py":"bù rén","ctx":"不合仁。","pos":"形","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"失掉自己的同盟，这不智。","tokens":[{"t":"失","s":"失","py":"shī","ctx":"失掉。","pos":"动","extra":"","level":"sentence"},{"t":"其","s":"其","py":"qí","ctx":"自己的。","pos":"代","extra":"","level":"sentence"},{"t":"所與","s":"所与","py":"suǒ yǔ","ctx":"结盟的国家。","pos":"名","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"不知","s":"不知","py":"bù zhì","ctx":"不聪明。","pos":"形","extra":"知通「智」","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"用冲突替换原来整齐的联盟，这不是武。","tokens":[{"t":"以","s":"以","py":"yǐ","ctx":"用。","pos":"介","extra":"","level":"sentence"},{"t":"亂","s":"乱","py":"luàn","ctx":"相互冲突。","pos":"名","extra":"","level":"sentence"},{"t":"易","s":"易","py":"yì","ctx":"替换。","pos":"动","extra":"","level":"sentence"},{"t":"整","s":"整","py":"zhěng","ctx":"步调一致的联盟。","pos":"名","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"不武","s":"不武","py":"bù wǔ","ctx":"不合武德。","pos":"形","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"我们还是回去吧。」","tokens":[{"t":"吾","s":"吾","py":"wú","ctx":"我。","pos":"代","extra":"","level":"sentence"},{"t":"其","s":"其","py":"qí","ctx":"还是。","pos":"副","extra":"","level":"sentence"},{"t":"還","s":"还","py":"huán","ctx":"回去。","pos":"动","extra":"","level":"sentence"},{"t":"也","s":"也","py":"yě","ctx":"商量语气。","pos":"助","extra":"","level":"sentence"},{"t":"。」","s":"。」","punct":true}]},{"tr":"晋军也离开了郑国。","tokens":[{"t":"亦","s":"亦","py":"yì","ctx":"也。","pos":"副","extra":"","level":"sentence"},{"t":"去","s":"去","py":"qù","ctx":"离开。","pos":"动","extra":"","level":"sentence"},{"t":"之","s":"之","py":"zhī","ctx":"郑国。","pos":"代","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"本篇选自《左传·僖公三十年》。晋文公流亡时经过郑国，郑文公没有以礼相待，后来又在城濮之战中帮助楚国。晋文公回国后，联合秦穆公围攻郑国。郑国大夫佚之狐推荐烛之武夜见秦伯。烛之武不谈郑国的委屈，只讲灭郑对秦有害、存郑对秦有利，并点出晋国不可靠。秦军撤退，晋军也随之离开。作者旧传为左丘明。","keyContentWords":[{"word":"贰","reading":"èr","note":"两属，一边依附晋，一边依附楚。"},{"word":"缒","reading":"zhuì","note":"用绳子把人从城上放下去。"},{"word":"执事","reading":"zhí shì","note":"办事的人。不直称秦伯，表示尊敬。"},{"word":"东道主","reading":"dōng dào zhǔ","note":"东方路上的主人，招待过路的秦使。"},{"word":"行李","reading":"xíng lǐ","note":"使者。"},{"word":"阙","reading":"quē","note":"使亏损、损害。"}],"keyFunctionWords":[{"word":"以","reading":"yǐ","note":"因为。以其无礼于晋。也表示用来、把。"},{"word":"焉","reading":"yān","note":"哪里。焉用亡郑、将焉取之。"},{"word":"微","reading":"wēi","note":"如果没有。"},{"word":"其","reading":"qí","note":"吾其还也：还是，表商量。"}],"ancientModern":[{"word":"行李","note":"古：出使的人。今：出门携带的箱包。"},{"word":"东道主","note":"古：东方道路上的主人。今：请客的一方，不再限于东方。"},{"word":"夫人","note":"微夫人之力：读 fú rén，那个人，指秦穆公。今：多读 fū ren，妻子。"},{"word":"以为","note":"舍郑以为东道主：把（郑国）当作。今「以为」多表示认为。"}],"phoneticLoans":[{"word":"共","loan":"供","note":"共其乏困：供给秦国使者缺少的东西。"},{"word":"厌","loan":"餍","note":"何厌之有：哪里有满足。"},{"word":"说","loan":"悦","note":"秦伯说：高兴。"},{"word":"知","loan":"智","note":"失其所与，不知：不聪明。"}],"flexibleUsage":[{"word":"军","note":"晋军函陵：名词作动词，驻扎。"},{"word":"鄙","note":"越国以鄙远：名词意动，把远方当作边邑。"},{"word":"厚、薄","note":"邻之厚，君之薄：形容词作动词，变厚、变薄。"},{"word":"封","note":"东封郑、肆其西封：疆界，这里用作动词，以……为疆界。"},{"word":"敝","note":"因人之力而敝之：形容词作动词，损害。"}],"specialSyntax":[{"name":"判断句","note":"邻之厚，君之薄也。是寡人之过也。"},{"name":"宾语前置","note":"何厌之有 = 有何厌。之是宾语前置的标志。"},{"name":"省略","note":"敢以烦执事：省略「亡郑」这件事。"}],"theme":"郑国危在旦夕，烛之武不求怜悯，只让秦伯算一笔账：灭郑是替晋国增加土地，存郑才能让秦国在东边有接应。秦晋联盟因此拆开。","technique":"说辞层层递进：亡郑无益、越国难守、存郑有利、晋曾背秦、晋得郑后还会向西损害秦。每层都站在秦国一边说话。结尾晋文公四个短句「不仁、不知、不武」，把退兵说成守规矩，和烛之武的利字形成对照。"},"classicComment":{"t":"鄭近于晉，而遠于秦。秦得鄭而晉收之，勢必至者。越國鄙遠，亡鄭陪鄰，闕秦利晉，俱爲至理。古今破同事之國，多用此說。篇中前段寫亡鄭，乃以陪晉。後段寫亡鄭，卽以亡秦。中閒引晉背秦一證，思之毛骨俱竦。宜乎秦伯之不但去鄭，而且戍鄭也。","s":"郑近于晋，而远于秦。秦得郑而晋收之，势必至者。越国鄙远，亡郑陪邻，阙秦利晋，俱为至理。古今破同事之国，多用此说。篇中前段写亡郑，乃以陪晋。后段写亡郑，即以亡秦。中闲引晋背秦一证，思之毛骨俱竦。宜乎秦伯之不但去郑，而且戍郑也。"}}