。","pos":"能","extra":"","level":"sentence"},{"t":"早","s":"早","py":"zǎo","ctx":"早些。","pos":"副","extra":"","level":"sentence"},{"t":"用","s":"用","py":"yòng","ctx":"任用。","pos":"动","extra":"","level":"sentence"},{"t":"子","s":"子","py":"zǐ","ctx":"您。","pos":"代","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"今","s":"今","py":"jīn","ctx":"现在。","pos":"名","extra":"","level":"sentence"},{"t":"急","s":"急","py":"jí","ctx":"危急。","pos":"形","extra":"","level":"sentence"},{"t":"而","s":"而","py":"ér","ctx":"才。","pos":"连","extra":"","level":"sentence"},{"t":"求","s":"求","py":"qiú","ctx":"请求。","pos":"动","extra":"","level":"sentence"},{"t":"子","s":"子","py":"zǐ","ctx":"您。","pos":"代","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"是","s":"是","py":"shì","ctx":"这。","pos":"代","extra":"","level":"sentence"},{"t":"寡人","s":"寡人","py":"guǎ rén","ctx":"国君自称。","pos":"代","extra":"","level":"sentence"},{"t":"之","s":"之","py":"zhī","ctx":"的。","pos":"助","extra":"","level":"sentence"},{"t":"過","s":"过","py":"guò","ctx":"过错。","pos":"名","extra":"","level":"sentence"},{"t":"也","s":"也","py":"yě","ctx":"判断语气。","pos":"助","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"可是郑国灭亡了，您也有不利。」","tokens":[{"t":"然","s":"然","py":"rán","ctx":"然而。","pos":"连","extra":"","level":"sentence"},{"t":"鄭","s":"郑","py":"Zhèng","ctx":"郑国。","pos":"名","extra":"","level":"sentence"},{"t":"亡","s":"亡","py":"wáng","ctx":"灭亡。","pos":"动","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"子","s":"子","py":"zǐ","ctx":"您。","pos":"代","extra":"","level":"sentence"},{"t":"亦","s":"亦","py":"yì","ctx":"也。","pos":"副","extra":"","level":"sentence"},{"t":"有","s":"有","py":"yǒu","ctx":"有。","pos":"动","extra":"","level":"sentence"},{"t":"不利","s":"不利","py":"bù lì","ctx":"不利的地方。","pos":"名","extra":"","level":"sentence"},{"t":"焉","s":"焉","py":"yān","ctx":"在这件事上。","pos":"兼","extra":"","level":"sentence"},{"t":"。」","s":"。」","punct":true}]},{"tr":"烛之武答应了。","tokens":[{"t":"許","s":"许","py":"xǔ