tra":"","level":"dict"},{"t":"年","s":"年","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"齊","s":"齐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"侵","s":"侵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"蔡","s":"蔡","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"亦","s":"亦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"獲","s":"获","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"成","s":"成","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"楚","s":"楚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"夹在大国中间，服从强者的号令，难道是他的罪过吗？","tokens":[{"t":"居","s":"居","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"大","s":"大","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"國","s":"国","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"間","s":"间","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"從","s":"从","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"強","s":"强","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"令","s":"令","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"豈","s":"岂","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"罪","s":"罪","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"？","s":"？","punct":true}]},{"tr":"大国如果不加体谅，我们就没有地方逃避你们的命令。","tokens":[{"t":"大","s":"大","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"國","s":"国","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"若","s":"若","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"弗","s":"弗","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"圖","s":"图","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"逃","s":"逃","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"命","s":"命","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"信写到这里。","tokens":[{"t":"」","s":"」","punct":true}]}]},{"sentences":[{"tr":"晋国的巩朔到郑国去讲和，赵穿和公壻池留在那里做人质。","tokens":[{"t":"晉","s":"晋","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"鞏","s":"巩","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"朔","s":"朔","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"行","s":"行","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"成","s":"成","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"鄭","s":"郑","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"趙","s":"赵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"穿","s":"穿","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"公","s":"公","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"壻","s":"壻","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"池","s":"池","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"質","s":"质","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"焉","s":"焉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"本篇选自《左传·文公十七年》，作者旧题左丘明。鲁文公十七年，公元前610年，晋灵公在扈会合诸侯，事情是平定宋乱。扈在郑地，约在今河南原阳西。会上晋灵公不肯见郑穆公，认为郑国一面事晋、一面倾向楚。郑大夫子家，就是公子归生，派执讯官送信给晋卿赵盾，也就是赵宣子。当时晋国政令多在赵盾手里，所以信送到他那里。信中的年份从郑穆公即位算起。","theme":"信要辩明郑国并没有辜负晋国。穆公在位，自己朝过晋襄公一次，又两次受到晋灵公接见；太子夷和大臣也接连走到晋都绛。陈、蔡紧靠楚国，却不敢对晋有二心，子家说这是郑国周旋的结果。晋国仍说郑国没有满足自己。信里用“畏首畏尾”和“鹿死不择音”两句古话，把小国夹在晋、楚之间的处境说完：大国以德相待，小国就按人的方式事奉；大国不讲德，小国就只能像被追的鹿一样奔走。郑文公当年朝齐、为齐侵蔡，同时又和楚讲和，用来说明夹在大国之间、服从较强的一方，不能算郑国的罪。","technique":"正文是一封书信，先摆事实，后说利害。子家按即位三年、九月、十一月、十二年、十四年、十五年，以及去年正月、八月，把朝晋的人和次数排成清单，用来顶住“贰于楚”这句话。后半改用古语，从怕头怕尾说到鹿不择荫，再落到铤而走险，语气由小心变成逼仄。信末又跳回郑文公的旧事，说明这种两面受压不是这一代才有。赵宣子没有出场答话，文章只用巩朔讲和、赵穿与公壻池做人质收束，晋国退让一步，是从结果里看出来的。","keyContentWords":[{"word":"执讯","reading":"zhí xùn","note":"负责通讯、传话的官。子家派他把信送到赵宣子那里。"},{"word":"蒇","reading":"chǎn","note":"完成。「以蒇陈事」是把陈侯朝晋这件事办完。"},{"word":"敝赋","reading":"bì fù","note":"敝是谦称，赋是按田亩征发的军备和兵力。「悉敝赋」是把我国的军队全部调出来。"},{"word":"铤","reading":"tǐng","note":"急走的样子。「铤而走险」是走投无路时急急奔向危险的地方。"}],"keyFunctionWords":[{"word":"焉","reading":"yān","note":"兼词，相当于「于之」。「不敢贰焉」是不敢对晋有二心；「为质焉」是在郑国做人质。"},{"word":"唯","reading":"wéi","note":"范围副词，只。「唯执事命之」是说没有别的出路，只听晋国发落。"}],"ancientModern":[{"word":"执事","note":"字面是办事的人。信里用来敬称晋侯及其大臣，避免直呼其名。"},{"word":"质","note":"「为质」是留下做人质，不是质地，也不是质问。"}],"phoneticLoans":[{"word":"音","loan":"荫","note":"「鹿死不择音」的音借作荫，读 yìn，指可以遮蔽的地方。鹿临死顾不上选择荫处。"}],"flexibleUsage":[{"word":"朝","note":"读 cháo，用作动词，朝见。「朝于齐」「又往朝」都是去朝见，不是早晨。"},{"word":"贰","note":"数词用作动词，生出二心。「贰于楚」是不专心事晋，倒向楚国。"}],"specialSyntax":[{"name":"寡君是以不得","note":"「是以」等于「以是」，代词「是」提到「以」前，表示因此。"}]},"classicComment":{"t":"前幅寫事晉唯謹，逐年逐月算之，猶爲兢兢畏大國之言。後幅寫到晉之不知恤小，鄭亦不能復耐，竟說出貳楚亦勢之不得不然。晉必欲見罪，我亦顧忌不得許多。一團憤懣之氣，令人難犯，所以晉人竟爲之屈。","s":"前幅写事晋唯谨，逐年逐月算之，犹为兢兢畏大国之言。后幅写到晋之不知恤小，郑亦不能复耐，竟说出贰楚亦势之不得不然。晋必欲见罪，我亦顾忌不得许多。一团愤懑之气，令人难犯，所以晋人竟为之屈。"}}
