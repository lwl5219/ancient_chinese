ct"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"師","s":"师","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"旅","s":"旅","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乃","s":"乃","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"實","s":"实","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"闕","s":"阙","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"攜","s":"携","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"諸","s":"诸","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"侯","s":"侯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"罪","s":"罪","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"我","s":"我","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"諸","s":"诸","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"戎","s":"戎","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"！","s":"！","punct":true}]},{"tr":"我们这些戎人的饮食衣服与华夏不同，礼物不相往来，言语不通，能做什么坏事呢？","tokens":[{"t":"我","s":"我","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"諸","s":"诸","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"戎","s":"戎","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"飲","s":"饮","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"食","s":"食","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"衣","s":"衣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"服","s":"服","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"不","s":"不","py":"","ctx":"