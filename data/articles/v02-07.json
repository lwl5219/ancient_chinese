:"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"虎","s":"虎","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"棄","s":"弃","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"社","s":"社","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"稷","s":"稷","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"您若推行善政，谁敢不努力？多杀人又做什么呢？","tokens":[{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"善","s":"善","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"誰","s":"谁","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"敢","s":"敢","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"勉","s":"勉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"多","s":"多","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"殺","s":"杀","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"何","s":"何","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"宣子高兴了，和祁奚同乘一辆车，向晋侯进言，赦免了叔向。","tokens":[{"t":"宣","s":"宣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"說","s":"说","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"與","s":"与","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乘","s":"乘","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"言","s":"言","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"諸","s":"诸","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"公","s":"公","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"免","s":"免","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"祁奚没有去见叔向就回去了。","tokens":[{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"見","s":"见","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"叔","s":"叔","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"向","s":"向","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"歸","s":"归","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"叔向也不向祁奚报告自己被赦免，就去上朝。","tokens":[{"t":"叔","s":"叔","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"向","s":"向","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"亦","s":"亦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"告","s":"告","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"免","s":"免","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"焉","s":"焉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"朝","s":"朝","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"本篇选自《左传·襄公二十一年》，旧题左丘明作。晋大夫栾盈被母亲栾祁和执政范宣子驱逐，出奔楚国。栾盈的同党羊舌虎被杀，虎的哥哥叔向连带被囚禁。叔向拒绝乐王鲋的帮忙，认定已经告老的祁奚才会救他。祁奚听说后乘驿车去见范宣子，引用《诗》《书》和前代的事，请他把羊舌虎的罪和叔向分开。宣子向晋平公说明，叔向得免。祁奚不去见叔向，叔向也不来道谢。叔向所引“优哉游哉，聊以卒岁”，今本《诗经》没有，前人以为是逸诗。","theme":"叔向先看清谁能救自己。乐王鲋只会顺着国君，后来晋侯问起，他就说叔向不弃亲人、大概有份，正说明这种人不能指望。祁奚早年举荐过仇人解狐，也举荐过自己的儿子祁午，办事不按亲疏，所以不会因为叔向属于哪一党就丢下他。祁奚把叔向说成谋划少错、施惠教导不倦的人，是社稷的依靠；十世都该赦免的人，不该因一次罪过自身不保。鲧与禹、伊尹与太甲、管叔蔡叔与周公，都是亲属之间功罪分开。杀得再多也不能代替善政。两人事后不相见，救与被救都不是私情。","technique":"先写叔向不回答乐王鲋，再用和室老的对话把“必祁大夫”的理由说在祁奚出场之前。乐王鲋对晋侯的回答，又回头证明叔向的判断。祁奚的话先引《诗》的“子孙保之”和《书》的“明征定保”，立下应当保护有功者的标准，然后说叔向当得起。接着连用三件旧事，说明父兄有罪，贤者仍可任用。末了用“多杀何为”反问。结尾只写不见、不告免，不再议论，公心落在行动上。","keyContentWords":[{"word":"驲","reading":"rì","note":"驿站的传车。乘驲而见宣子，是乘驿车赶去。"},{"word":"宥","reading":"yòu","note":"赦免。十世宥之，宽宥到十代。"},{"word":"觉","reading":"jué","note":"正直。有觉德行、觉者也，都指德行正直。诗句见于《大雅·抑》。"},{"word":"室老","reading":"shì lǎo","note":"卿大夫家臣的头领。这里是叔向的家臣头目。"}],"keyFunctionWords":[{"word":"夫","reading":"fú","note":"句首发语词。夫谋而鲜过，引出下面的判断。"}],"ancientModern":[{"word":"老","note":"祁奚老矣：老是告老退休。今多指年纪大。"},{"word":"劝","note":"以劝能者：劝是勉励。今多指用话劝人。"}],"phoneticLoans":[{"word":"说","loan":"悦","note":"宣子说：说通“悦”，高兴，读 yuè。"},{"word":"知","loan":"智","note":"其为不知乎、知也：知通“智”，明智，读 zhì。"},{"word":"大","loan":"太","note":"伊尹放大甲：大甲就是太甲，大通“太”，读 tài。大夫的大仍读 dà。"}],"flexibleUsage":[{"word":"固","note":"社稷之固也：固由形容词用作名词，指使国家稳固的人。"}],"specialSyntax":[{"name":"宾语前置","note":"多杀何为，等于为何多杀。何是为的宾语。"}]},"classicComment":{"t":"樂王鮒見叔向，而自請免之。祁奚免叔向，而竟不見之。君子小人，相去霄壤。「不應」、「不拜」，所以絕小人。「不告免」，所以待君子。","s":"乐王鲋见叔向，而自请免之。祁奚免叔向，而竟不见之。君子小人，相去霄壤。「不应」、「不拜」，所以绝小人。「不告免」，所以待君子。"}}
