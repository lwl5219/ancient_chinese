":"征","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"定","s":"定","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"保","s":"保","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"谋划而很少出错、施惠教导不知疲倦的，叔向具备这些。","tokens":[{"t":"夫","s":"夫","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"謀","s":"谋","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"鮮","s":"鲜","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"過","s":"过","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"惠","s":"惠","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"訓","s":"训","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"倦","s":"倦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"叔","s":"叔","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"向","s":"向","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"焉","s":"焉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"他是使社稷稳固的人。","tokens":[{"t":"社","s":"社","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"稷","s":"稷","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"固","s":"固","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"这样的人即使子孙有罪，也还要宽免十代，用来鼓励有才能的人。","tokens":[{"t":"猶","s":"犹","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"將","s":"将","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"十","s":"十","py":"","ctx":"","pos":"","extra