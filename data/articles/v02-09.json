":"誰","s":"谁","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"敢","s":"敢","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"任","s":"任","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"？","s":"？","punct":true}]},{"tr":"况且别人有国君却把国君杀了，我怎么能为他去死，又怎么能为他出亡？","tokens":[{"t":"且","s":"且","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"弒","s":"弑","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"吾","s":"吾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"焉","s":"焉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"得","s":"得","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"死","s":"死","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"焉","s":"焉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"得","s":"得","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"亡","s":"亡","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"？","s":"？","punct":true}]},{"tr":"还将回到哪里去呢？","tokens":[{"t":"將","s":"将","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"庸","s":"庸","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"何","s":"何","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"歸","s":"归","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"？","s":"？","punct":true}]},{"tr":"门开了，他进去，把头枕在尸体的大腿上痛哭。","tokens":[{"t":"門","s":"门","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"啓","s":"启","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"入","s":"入","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"枕","s":"枕","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"尸","s":"尸","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"股","s":"股","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"哭","s":"哭","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"站起来，按丧礼顿足跳了三次，然后出去。","tokens":[{"t":"興","s":"兴","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"三","s":"三","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"踴","s":"踊","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"出","s":"出","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"有人对崔子说：一定要杀掉他！","tokens":[{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"謂","s":"谓","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"崔","s":"崔","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"必","s":"必","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"殺","s":"杀","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"！","s":"！","punct":true}]},{"tr":"崔子说：“他是百姓所仰望的人，放了他就能得民心。","tokens":[{"t":"」","s":"」","punct":true},{"t":"崔","s":"崔","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"：「","s":"：「","punct":true},{"t":"民","s":"民","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"望","s":"望","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"舍","s":"舍","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"得","s":"得","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"民","s":"民","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"崔子的话到这里说完。","tokens":[{"t":"」","s":"」","punct":true}]}]}],"lesson":{"background":"本篇选自《左传·襄公二十五年》，旧题左丘明作。齐大夫崔杼，文中称崔武子，娶了棠公的遗孀棠姜。齐庄公与棠姜私通，崔杼因此杀死庄公。晏婴来到崔家门外，随从问他该不该死、该不该逃、该不该回去。他说臣子只在国君为社稷而死、为社稷出亡时才跟着做，然后进门，在尸前哭踊，按礼节离开。崔氏左右主张杀掉他，崔杼认为他是百姓仰望的人，放了他可以得民。","theme":"晏婴把国君和社稷分开。做君主不是为了压在百姓上面，而是主持社稷；做臣子不是为了俸禄，而是保养社稷。所以国君为国家死，臣子才为他死；为国家出亡，臣子才跟着出亡。庄公死于私情，轮得到的是他的私暱，不是晏婴这种朝臣。崔杼自己有君而又弑君，晏婴既没有理由陪死，也没有理由陪着逃亡。他仍然进门哭尸、三踊而出，完成的是丧礼，不是投靠崔氏。","technique":"门外三问三答，句子很短。“独吾君也乎哉”挡住死，“吾罪也乎哉”挡住亡，然后再说国君死了无处可归。议论用君民者和臣君者对举，社稷是主、社稷是养把宾语提前，职责说得很硬。后面用条件和假设分成两路：为社稷，就跟着；为了自己，就不是一般臣子的事。哭踊一段不再讲道理，只写开门、枕股、三踊、出去。崔杼说舍之得民，从对方嘴里补出晏婴在国人中的地位。","keyContentWords":[{"word":"口实","reading":"kǒu shí","note":"俸禄。岂为其口实，难道是为了嘴里的吃食，指爵禄。"},{"word":"私暱","reading":"sī nì","note":"私下亲昵的人。不是国君的私宠，就不必为他的私事殉死。"},{"word":"踊","reading":"yǒng","note":"丧礼中顿足跳跃，表示哀痛。三踊是哭丧的节度。"},{"word":"弑","reading":"shì","note":"臣杀君。崔子弑之，崔杼杀死齐庄公。"}],"keyFunctionWords":[{"word":"焉","reading":"yān","note":"庄公通焉：焉相当于“于她”，通是私通。吾焉得死之：焉是哪里。"}],"ancientModern":[{"word":"亡","note":"为社稷亡、吾亡也：亡是出逃。今多指死亡。"}],"phoneticLoans":[{"word":"取","loan":"娶","note":"遂取之：取通“娶”，娶妻，读 qǔ。"}],"flexibleUsage":[{"word":"美","note":"见棠姜而美之：认为她美丽。形容词的意动用法。"},{"word":"死","note":"则死之：为动用法，为国君而死。亡之是为他出亡。"},{"word":"枕","note":"枕尸股：枕由名词用作动词，把头枕在尸体的大腿上。"}],"specialSyntax":[{"name":"宾语前置","note":"社稷是主、社稷是养：是标志宾语提前，等于主社稷、养社稷。"}]},"classicComment":{"t":"起手死亡歸，三層疊下，無數烟波，只欲逼出社稷兩字也。注眼看著社稷兩字，君臣死生之際，乃有定案。","s":"起手死亡归，三层叠下，无数烟波，只欲逼出社稷两字也。注眼看著社稷两字，君臣死生之际，乃有定案。"}}
