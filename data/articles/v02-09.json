{"id":"v02-09","volume":2,"volumeTitle":"卷二","volumeSubtitle":"周文","index":9,"title":{"t":"晏子不死君難","s":"晏子不死君难"},"book":{"t":"左傳","s":"左传"},"sourceHead":{"t":"襄公二十五年","s":"襄公二十五年"},"author":"左丘明","annotated":true,"paragraphs":[{"sentences":[{"tr":"崔武子看见棠姜，觉得她美，就娶了她。","tokens":[{"t":"崔","s":"崔","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"武","s":"武","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"見","s":"见","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"棠","s":"棠","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"姜","s":"姜","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"美","s":"美","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"遂","s":"遂","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"取","s":"取","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"齐庄公和她私通。","tokens":[{"t":"莊","s":"庄","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"公","s":"公","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"通","s":"通","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"焉","s":"焉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"崔子杀了庄公。","tokens":[{"t":"崔","s":"崔","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"弒","s":"弑","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]},{"sentences":[{"tr":"晏子站在崔家的门外。","tokens":[{"t":"晏","s":"晏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":""