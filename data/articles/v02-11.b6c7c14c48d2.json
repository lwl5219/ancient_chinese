el":"dict"},{"t":"侯","s":"侯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"館","s":"馆","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]},{"sentences":[{"tr":"叔向说：「辞令是不可以废掉的，竟到了这种地步啊！","tokens":[{"t":"叔","s":"叔","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"向","s":"向","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"：「","s":"：「","punct":true},{"t":"辭","s":"辞","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"可","s":"可","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"已","s":"已","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"如","s":"如","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"是","s":"是","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"夫","s":"夫","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"！","s":"！","punct":true}]},{"tr":"子产善于辞令，诸侯都靠着他得了好处。","tokens":[{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"產","s":"产","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"辭","s":"辞","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"諸","s":"诸","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"侯","s":"侯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"賴","s":"赖","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"怎么能放弃辞令呢？","tokens":[{"t":"若","s":"若","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"何","s":"何","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"釋","s":"释","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"辭","s":"辞","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"？","s":"？","punct":true}]},{"tr":"《诗》上说：『辞令和睦，百姓就协同；辞令叫人喜悦，百姓就安定。","tokens":[{"t":"《","s":"《","punct":true},{"t":"詩","s":"诗","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"》","s":"》","punct":true},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"：『","s":"：『","punct":true},{"t":"辭","s":"辞","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"輯","s":"辑","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"矣","s":"矣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"民","s":"民","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"協","s":"协","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"矣","s":"矣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"辭","s":"辞","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"懌","s":"怿","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"矣","s":"矣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"民","s":"民","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"莫","s":"莫","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"矣","s":"矣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"』诗人大概懂得辞令的用处了。","tokens":[{"t":"』","s":"』","punct":true},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"知","s":"知","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"矣","s":"矣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"（叔向的话到此说完。）","tokens":[{"t":"」","s":"」","punct":true}]}]}],"lesson":{"background":"本篇选自《左传·襄公三十一年》。这一年鲁襄公去世，郑简公由子产相礼，到晋国朝见。晋平公拿鲁丧做理由，迟迟不接见。晋、郑、鲁都是姬姓，郑伯本该受到盟主接待，可是宾馆门小墙高，车马进不去。子产派人拆墙，把车马安顿进去。晋大夫士文伯名匄，奉命责问。子产拿晋文公待客的旧例，对照当时绵延数里的铜鞮宫。执政赵武认错以后，晋侯加礼送郑伯回国，并另建诸侯宾馆。叔向在事后专论辞令。","theme":"子产要辩明的是盟主不该让宾客进退无路。礼物不能私自送进府库，也不能淋晒到朽坏；晋侯不给出见的日子，围墙又把车子挡死，郑国两边都构成罪过。他把文公宫室低小、宾至如归说全，再落到铜鞮宫高大、诸侯却住在奴仆般的房子里。赵武只用一个「信」字认账。墙拆了，晋国把礼补上，后来还重筑宾馆。叔向因此说辞令废不得，小国把话说准，诸侯才有所依靠。","technique":"士文伯的话短，只抓住盗贼和墙，把修墙说成盟主对客人的责任。子产先并列不敢交币和不敢露天，说明不拆墙就没有出路，再整段追述文公：馆舍、库厩、道路、涂墙，然后是庭燎、车辖、隶人和百官，最后才是文公不留宾、与宾客同忧乐。过去写得越具体，今天的铜鞮宫、公行的盗贼和不知何时召见就越没有着落。文伯没有再辩。赵武认错、晋侯加礼、重新筑馆都用叙事带过，结尾由叔向引《大雅·板》，点明和顺的辞令能使百姓协同、安定。","keyContentWords":[{"word":"坏","reading":"guài","note":"拆毁。坏其馆之垣，把宾馆的墙拆掉。这个意义读 guài。"},{"word":"见","reading":"xiàn","note":"进见国君。未之见、未知见时、宾见无时、晋侯见郑伯，都是召见、进见。"},{"word":"赢","reading":"yíng","note":"接待、容纳。以隶人之垣以赢诸侯，用奴隶住的墙来接待诸侯。"},{"word":"莫","reading":"mù","note":"民之莫矣：百姓安定。这里不是「没有」。"}],"keyFunctionWords":[{"word":"焉","reading":"yān","note":"兼词，相当于「于是」。纳车马焉，把车马纳进馆里。"}],"ancientModern":[{"word":"让","note":"士文伯让之：责备。今多用于谦让、转让。"},{"word":"诛","note":"诛求无时：责求、索取。大国来要东西没有定时。今多用于诛杀。"}],"phoneticLoans":[{"word":"共","loan":"供","note":"其何以共命：靠什么供给宾客的需求。共读 gōng。"},{"word":"菑","loan":"灾","note":"无宁菑患：难道还会有灾祸。菑是灾的通假。"}],"flexibleUsage":[{"word":"高","note":"高其闬闳：使动，把大门加高。厚其墙垣，是把围墙加厚。"}],"specialSyntax":[{"name":"未之见","note":"否定句里代词宾语提前，等于「未见之」，没有接见郑伯。"},{"name":"无若……何","note":"无若诸侯之属辱在寡君者何：对屈尊来见晋君的诸侯臣属，没有办法安置。"}]},"classicComment":{"t":"晉爲盟主，而子產以蕞爾鄭朝晉，盡壞館垣，大是奇事。只是胸中早有成算，故說來句句針鋒相對，義正而不阿，詞強而不激。文伯不措一語，文子輸心帖服，叔向歎息不已，子產之有辭，洵非小補也。","s":"晋为盟主，而子产以蕞尔郑朝晋，尽坏馆垣，大是奇事。只是胸中早有成算，故说来句句针锋相对，义正而不阿，词强而不激。文伯不措一语，文子输心帖服，叔向叹息不已，子产之有辞，洵非小补也。"}}
