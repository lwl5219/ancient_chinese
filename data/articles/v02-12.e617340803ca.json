":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"要是没有您这番话，我不会知道。","tokens":[{"t":"微","s":"微","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"言","s":"言","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"吾","s":"吾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"知","s":"知","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"从前我说：『您治理郑国，我治理自己的家来得到庇护，那就可以了。","tokens":[{"t":"他","s":"他","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"日","s":"日","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"我","s":"我","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"：『","s":"：『","punct":true},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"鄭","s":"郑","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"國","s":"国","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"我","s":"我","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"吾","s":"吾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"家","s":"家","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"庇","s":"庇","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"焉","s":"焉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"可","s":"可","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"』从今以后才知道这样不够。","tokens":[{"t":"』","s":"』","punct":true},{"t":"今","s":"今","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"後","s":"后","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"知","s":"知","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"足","s":"足","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"从今天起向您请求，即使是我的家事，也听您的办理。","tokens":[{"t":"自","s":"自","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"今","s":"今","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"請","s":"请","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"雖","s":"虽","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"吾","s":"吾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"家","s":"家","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"聽","s":"听","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"行","s":"行","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"子产说：「人心各不相同，就像人的面孔各不相同。","tokens":[{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"產","s":"产","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"：「","s":"：「","punct":true},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"心","s":"心","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"同","s":"同","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"如","s":"如","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"面","s":"面","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"焉","s":"焉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"我怎么敢说您的面孔要像我的面孔呢？","tokens":[{"t":"吾","s":"吾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"豈","s":"岂","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"敢","s":"敢","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"謂","s":"谓","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"面","s":"面","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"如","s":"如","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"吾","s":"吾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"面","s":"面","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乎","s":"乎","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"？","s":"？","punct":true}]},{"tr":"不过心里觉得危险的事，也就告诉您。","tokens":[{"t":"抑","s":"抑","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"心","s":"心","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"謂","s":"谓","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"危","s":"危","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"亦","s":"亦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"告","s":"告","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"子皮认为他忠诚，所以把政事交给他。","tokens":[{"t":"」","s":"」","punct":true},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"皮","s":"皮","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"忠","s":"忠","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"故","s":"故","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"委","s":"委","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"政","s":"政","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"焉","s":"焉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"子产因此能够治理郑国。","tokens":[{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"產","s":"产","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"是","s":"是","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"能","s":"能","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"鄭","s":"郑","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"國","s":"国","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"本篇选自《左传·襄公三十一年》，与子产拆晋国馆墙一事同年。子皮是郑卿罕虎，国政当时还在他手里。他打算让宠信的家臣尹何治理采邑。尹何年轻，子产认为不能把没有学过政事的人放到城邑上。对话里子产自称侨，子皮自称虎。谈完以后，子皮把郑国的政事交给子产，子产从此主持国政。","theme":"子产反对的是用喜爱代替能力。喜爱一个人，应当使他得到好处；把大邑交给不会治理的人，像把刀交给不会用刀的人，受伤的正是被爱的一方。子皮是郑国的栋梁，栋折了，子产自己也会被压，所以不能不说。美锦尚且不给人学着裁，官职和城邑比美锦更贵重，更不能拿来让人学着治。应当学好再做官，不能拿官做学堂。子皮听懂之后，连家事也交给子产。子产说人心不同如面，只是把心里认为危险的事讲出来，并不逼子皮事事跟自己一样。","technique":"全篇用比喻往前推，一层接一层。不会拿刀却让人去割，针对「吾爱之」；栋折榱崩，说明子产也不能袖手；美锦不给人学裁，针对「使夫往而学」；打猎必须先会射箭驾车，针对「夫亦愈知治」。比喻都从对方刚才的话里长出来。子皮的回答把衣服和官邑对照，承认自己只对贴身的小事小心。结尾仍用面孔作比，把劝告收成「心里觉得危险就告诉你」，国政的托付放在这句话后面，不再另起议论。","keyContentWords":[{"word":"愿","reading":"yuàn","note":"谨慎忠厚。子皮说尹何愿，是说他老实可靠。"},{"word":"少","reading":"shào","note":"年轻。少，未知可否，指尹何年纪小，未必能治理采邑。"},{"word":"栋","reading":"dòng","note":"屋脊上的正梁。子于郑国，栋也，把子皮比成郑国所倚靠的人。"},{"word":"榱","reading":"cuī","note":"椽子。栋折榱崩，正梁断了，椽子也就塌下来。"}],"keyFunctionWords":[{"word":"夫","reading":"fú","note":"指示代词，那个人。使夫往而学焉的两个夫都指尹何。"},{"word":"微","reading":"wēi","note":"微子之言：要是没有您这番话。微表示假设的没有。"}],"ancientModern":[{"word":"慢","note":"我远而慢之：轻忽，不放在心上。今多指速度慢。"}],"phoneticLoans":[{"word":"厌","loan":"压","note":"侨将厌焉、败绩厌覆的厌，读 yā，是被压住。厌通「压」。"},{"word":"贯","loan":"惯","note":"射御贯：射箭、驾车已经熟练。贯通「惯」。"}],"flexibleUsage":[{"word":"利","note":"求利之：动词，使他得到好处。不是名词「利益」。"}],"specialSyntax":[{"name":"不吾叛","note":"否定句里代词宾语提前，等于「不叛吾」，不会背叛我。"},{"name":"败绩厌覆是惧","note":"害怕的内容提前，用是复指。败绩是车子坏毁，厌覆是人被压翻，只怕这个，顾不上去捕获。"}]},"classicComment":{"t":"「學而後入政，未聞以政學」二語，是通體結穴，前後總是發明此意。子產傾心吐露，子皮從善若流，相知之深，無過于此。全篇純以譬喻作態，故文勢宕逸不羣。","s":"「学而后入政，未闻以政学」二语，是通体结穴，前后总是发明此意。子产倾心吐露，子皮从善若流，相知之深，无过于此。全篇纯以譬喻作态，故文势宕逸不群。"}}
