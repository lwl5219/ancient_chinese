"extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"天","s":"天","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"：『","s":"：『","punct":true},{"t":"予","s":"予","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"必","s":"必","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"享","s":"享","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"征","s":"征","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"且","s":"且","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"觀","s":"观","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"兵","s":"兵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"』这恐怕是废弃了先王的训典，终世来朝的礼制也几乎要败坏了吧！","tokens":[{"t":"』","s":"』","punct":true},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乃","s":"乃","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"廢","s":"废","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"先","s":"先","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"訓","s":"训","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"幾","s":"几","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"頓","s":"顿","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乎","s":"乎","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"！","s":"！","punct":true}]},{"tr":"我听说那犬戎立心敦厚，能遵循旧有的德行，坚守终世来朝的职分，专一不变，他们就有条件抵御我们了！","tokens":[{"t":"吾","s":"吾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"聞","s":"闻","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"夫","s":"夫","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"犬","s":"犬","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"戎","s":"戎","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"樹","s":"树","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"惇","s":"惇","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"能","s":"能","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"帥","s":"帅","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"舊","s":"旧","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"德","s":"德","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"守","s":"守","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"終","s":"终","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"純","s":"纯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"固","s":"固","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"禦","s":"御","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"我","s":"我","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"矣","s":"矣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"！","s":"！","punct":true}]},{"tr":"（祭公谋父的话到此说完。）","tokens":[{"t":"」","s":"」","punct":true}]}]},{"sentences":[{"tr":"穆王不听，于是出兵征讨，得到四只白狼、四只白鹿就回来了。","tokens":[{"t":"「","s":"「","punct":true},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"聽","s":"听","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"遂","s":"遂","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"征","s":"征","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"得","s":"得","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"四","s":"四","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"白","s":"白","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"狼","s":"狼","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"四","s":"四","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"白","s":"白","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"鹿","s":"鹿","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"歸","s":"归","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"从此荒服的部族不再来朝。","tokens":[{"t":"自","s":"自","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"是","s":"是","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"荒","s":"荒","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"服","s":"服","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"至","s":"至","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"本篇选自《国语·周语上》。周穆王要征讨西方的犬戎，卿士祭公谋父劝他停手。祭是畿内封国，谋父是他的名。犬戎按荒服的职分，只须在一世终了时朝见，大毕、伯仕死后已经来朝。穆王却想用宾服「不享」的标准问罪，并趁机展示兵力。谋父追述周人从后稷、不窋到武王的德政，以及五服的贡职。穆王不听，出征所得只有白狼、白鹿。旧题左丘明著。","theme":"全篇要说明先王把德行放在前面，武力只在该用时才用。百姓能感德畏威，周的基业才保得住。五服由近到远，祭、祀、享、贡、朝的疏密不同；对方失职，天子先反省自己，最后才用刑，远方仍以修德为主，不轻易劳民。穆王责备犬戎不享，是把近处的礼加到荒服上。出兵所得甚轻，荒服从此不来，正说明这条训典被破坏了。","technique":"开头用「耀德不观兵」定下主张，接着引《周颂·时迈》分证收藏兵器和求德。再按时间写周人自己如何靠农事和德行立国，武王用兵也被说成是为民除害。中间把五服拆成地域、职分、期限、自修、用刑五层，每层都收在先王的训典上。末段才落到犬戎，用「无乃」「其有以御我」把反对说成推测。叙事结尾不再议论，只记下狼、鹿和荒服不至。","keyContentWords":[{"word":"观兵","reading":"guàn bīng","note":"炫耀武力。观读 guàn，向人展示。"},{"word":"戢","reading":"jí","note":"收藏、聚集。兵戢而时动，兵器收起，到时候才用。"},{"word":"荒服","reading":"huāng fú","note":"五服中最远的一服，戎翟所在，职责是终世朝见一次。"},{"word":"民隐","reading":"mín yǐn","note":"百姓的痛苦。勤恤民隐，忧念民间的疾苦。"}],"keyFunctionWords":[{"word":"夫","reading":"fú","note":"句首发语词。夫兵戢而时动、夫先王之制。"},{"word":"无乃","reading":"wú nǎi","note":"恐怕，表示委婉的推测。其无乃废先王之训。"}],"ancientModern":[{"word":"玩","note":"观则玩：轻慢、不以为意。今「玩」多指玩耍、欣赏。"},{"word":"王","note":"荒服者王、来王：动词，朝见天子。今「王」多指帝王或王位。"}],"phoneticLoans":[{"word":"帅","loan":"率","note":"能帅旧德：帅通率，遵循。"}],"flexibleUsage":[{"word":"茂","note":"茂正其德：形容词作动词，勉力去端正。"},{"word":"櫜","note":"载櫜弓矢：名词作动词，把弓箭装进弓袋。"}],"specialSyntax":[{"name":"判断句","note":"日祭、月祀、时享、岁贡、终王，先王之训也。用「也」判断这是先王的制度。"}]},"classicComment":{"t":"「耀德不觀兵」是一篇主腦，迴環往復，不出此意。穆王車轍馬跡徧天下，其中侈然有自大之心，不過觀兵犬戎以示雄武耳，乃僅得狼鹿以歸。不但不能耀德，并不成觀兵矣。結出「荒服不至」一語，煞有深意。","s":"「耀德不观兵」是一篇主脑，回环往复，不出此意。穆王车辙马迹徧天下，其中侈然有自大之心，不过观兵犬戎以示雄武耳，乃仅得狼鹿以归。不但不能耀德，并不成观兵矣。结出「荒服不至」一语，煞有深意。"}}
