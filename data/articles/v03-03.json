","s":"大","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"章","s":"章","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"忝","s":"忝","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"天","s":"天","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"下","s":"下","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"若","s":"若","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"先","s":"先","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"與","s":"与","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"百","s":"百","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"姓","s":"姓","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"何","s":"何","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"还算什么政令。","tokens":[{"t":"何","s":"何","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"政","s":"政","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"令","s":"令","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"若不然，叔父自己有封地，在那里开掘墓道，我又怎么知道。","tokens":[{"t":"若","s":"若","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"然","s":"然","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"叔","s":"叔","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"父","s":"父","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"地","s":"地","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"隧","s":"隧","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"焉","s":"焉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"余","s":"余","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"安","s":"安","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"能","s":"能","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"知","s":"知","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]},{"sentences":[{"tr":"文公于是不敢再请求，接受土地后回去了。","tokens":[{"t":"文","s":"文","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"公","s":"公","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"遂","s":"遂","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"敢","s":"敢","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"請","s":"请","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"受","s":"受","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"地","s":"地","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"還","s":"还","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"本篇选自《国语·周语中》。周襄王的弟弟王子带作乱，襄王出居在郑。晋文公出兵送襄王回王城，在郏地使他复位，并除掉王子带。襄王把土地赐给文公作为慰劳。文公不接受田地，转而请求使用天子的隧葬。隧是天子葬礼中的墓道，诸侯不得使用。襄王按同姓诸侯的称呼，称晋文公为叔父，当面说明不能把这种礼送人。旧题左丘明记述。","theme":"襄王拒绝的是名分，不是那一片土地。先王的甸服要供给祭祀、百官、民众和意外之需，其余土地已经分给诸侯，天子自己的宫官和享用都有定数，与诸侯的差别主要在生前死后的服物等级。隧属于这一等，不能用来酬谢迎王复位的私德。晋国只要还是姬姓诸侯，就该守住公侯的职分；真到改姓、自建制度的时候，礼才会自行归他。私下开掘，王可以不知，正式请求则不能许。","technique":"答辞很少直接说不许。先从千里甸服、五等封国和九御九品写先王留下的限度，说明天子并没有多余的东西可以私相授受，再把差别收束到服物采章。后文用「岂敢有爱」撇开吝惜，用「改玉改行」转到身份和仪节必须相配。接着连设三层假设：能改朝换代则礼器可以自取，仍列公侯则大礼不能改，自己在封地开掘则王也不必知情。文公只能受地而还。","keyContentWords":[{"word":"隧","reading":"suì","note":"掘地通到墓室的道，天子葬礼。请隧，就是请求用这种葬制。"},{"word":"班","reading":"bān","note":"分赐。班先王之大物，把先王的大礼分给人。"},{"word":"大物","reading":"dà wù","note":"重大的礼制，这里指隧。"},{"word":"不佞","reading":"bù nìng","note":"不才。襄王自称没有才能。"}],"keyFunctionWords":[{"word":"其","reading":"qí","note":"叔父其茂昭明德，表希望。大物其未可改，表委婉，恐怕。"},{"word":"焉","reading":"yān","note":"兼词，于是。请隧焉，向周王请求隧；有地而隧焉，在自己的地上行隧。"}],"ancientModern":[{"word":"爱","note":"岂敢有爱：吝惜。今「爱」多指喜爱。"},{"word":"百姓","note":"这里指百官，尤其是有世功的官族。今「百姓」指民众。文中另用「兆民」指众民。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"隧","note":"请隧、隧焉：名词作动词，采用隧葬、开掘墓道。"},{"word":"光","note":"光裕大德：形容词作动词，使德行光大。"}],"specialSyntax":[{"name":"宾语前置","note":"王何异之有，即有何异。何辞之与有、何政令之为，也是把疑问宾语放在动词前面。"},{"name":"介词短语后置","note":"定襄王于郏，即在郏地安定襄王。降祸灾于周室，同例。"}]},"classicComment":{"t":"通篇只是不爲天子、不得用隧意。卻妙在俱用逆筆振入、無一筆實寫不許。而不許之意、一步緊一步。自使重耳神色俱沮。","s":"通篇只是不为天子、不得用隧意。却妙在俱用逆笔振入、无一笔实写不许。而不许之意、一步紧一步。自使重耳神色俱沮。"}}
