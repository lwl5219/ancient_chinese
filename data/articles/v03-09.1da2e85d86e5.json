"level":"dict"},{"t":"、","s":"、","punct":true},{"t":"則","s":"则","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"寶","s":"宝","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"玉足以庇护好的庄稼，使它不遭水旱之灾，就把玉当作宝。","tokens":[{"t":"玉","s":"玉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"足","s":"足","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"庇","s":"庇","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"廕","s":"荫","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"嘉","s":"嘉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"穀","s":"谷","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"使","s":"使","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"水","s":"水","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"旱","s":"旱","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"災","s":"灾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"則","s":"则","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"寶","s":"宝","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"龟甲足以作为判断好坏的依据，就把龟当作宝。","tokens":[{"t":"龜","s":"龟","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"足","s":"足","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"憲","s":"宪","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"臧","s":"臧","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"否","s":"否","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"則","s":"则","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"寶","s":"宝","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"珍珠足以抵御火灾，就把珍珠当作宝。","tokens":[{"t":"珠","s":"珠","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"足","s":"足","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"禦","s":"御","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"火","s":"火","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"災","s":"灾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"則","s":"则","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"寶","s":"宝","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"金属足以抵御战乱，就把金属当作宝。","tokens":[{"t":"金","s":"金","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"足","s":"足","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"禦","s":"御","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"兵","s":"兵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"亂","s":"乱","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"則","s":"则","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"寶","s":"宝","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"山林和湖泽足以准备财用，就把它们当作宝。","tokens":[{"t":"山","s":"山","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"林","s":"林","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"藪","s":"薮","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"澤","s":"泽","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"足","s":"足","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"備","s":"备","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"財","s":"财","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"用","s":"用","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"則","s":"则","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"寶","s":"宝","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"至于那种喧响的华美，楚国虽然是蛮夷，也不会把它当作宝。","tokens":[{"t":"若","s":"若","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"夫","s":"夫","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"譁","s":"哗","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"囂","s":"嚣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"美","s":"美","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"楚","s":"楚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"雖","s":"虽","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"蠻","s":"蛮","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"夷","s":"夷","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"能","s":"能","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"寶","s":"宝","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"本篇选自《国语·楚语下》，旧传为左丘明所作。春秋晚期，楚大夫王孙圉到晋国聘问，晋定公设宴，晋卿赵简子担任相礼。赵简子名鞅，宴上故意摇响佩玉，并问楚国的美玉白珩还在不在、价值多少。王孙圉不顺着夸玉，而把楚国所宝说成两类：一类是能办交涉、能以史事谏君的人，即观射父和左史倚相；一类是云梦一带的云连徒洲，那里出产军需和聘享诸侯的物资。说完六种国宝之后，他把叮当作响的佩饰撇开，回话正好对着赵简子的鸣玉。","theme":"王孙圉要分辨的是：可宝之物必须有用，玩好不足为宝。观射父能写训辞，使诸侯抓不住楚君的话柄；倚相能称引训典，早晚用成败提醒国君，并能顺导鬼神的好恶，使神不对楚国怨怒。云连徒洲出产金木竹箭和龟珠角齿、皮革羽毛，既可以备军赋、防意外，又可以供给币帛，用来聘享诸侯。人、辞令、物产和神佑合在一起，国君才上不获罪于诸侯，下可以保全国民。白珩只是先王玩物。他接着说国宝有六：能制议百物的圣人、能庇荫庄稼的玉、能显示吉凶的龟、能御火灾的珠、能御兵乱的金，以及能出财用的山林薮泽。佩玉的喧响华美不在其中。","technique":"宴会一开场先写鸣玉，再写问白珩，把赵简子的炫耀放在明处。王孙圉先用「未尝为宝」截断，然后连用观射父、倚相、云连徒洲三段，每段都落到「使」或「所以」，说明宝在于能做什么，不在于本身贵重。三段说完，又把辞令、币帛、不虞之备和皇神的佑助串成一句，归到「此楚国之宝也」，与白珩的「何宝焉」对照。白珩的问答本来已经结束，他又另起「国之宝六而已」，把标准从楚国推到凡为国者，最后用「哗嚣之美」回指开篇的鸣玉。问得矜持，答得平稳，锋芒留在末句。","keyContentWords":[{"word":"白珩","reading":"bái héng","note":"楚国佩玉上的横玉。赵简子问它还在不在，并当作宝物来估价。"},{"word":"口实","reading":"kǒu shí","note":"话柄。「无以寡君为口实」，不让诸侯拿楚君的言辞作笑柄。"},{"word":"恶","reading":"wù","note":"厌恶。「顺道其欲恶」，顺着鬼神的喜好和厌恶来引导。欲读 yù。"},{"word":"薮","reading":"sǒu","note":"水草丛生的大泽。云连徒洲是楚国云梦一带相连的湖泽。"}],"keyFunctionWords":[{"word":"若夫","reading":"ruò fú","note":"至于，另提一件事物。夫读 fú。「若夫白珩」「若夫哗嚣之美」。"},{"word":"所以","reading":"suǒ yǐ","note":"用来……的东西。「所以备赋」「所以共币帛」，都指这些物产的用途。"}],"ancientModern":[{"word":"几何","note":"「其为宝也几何矣」的几何，是多少。今多指几何学。"},{"word":"玩","note":"「先王之玩」的玩，指赏玩的物件。今多指玩耍、玩乐。"}],"phoneticLoans":[{"word":"说","loan":"悦","note":"「上下说乎鬼神」的说通悦，使喜悦，读 yuè。"},{"word":"共","loan":"供","note":"「所以共币帛」的共通供，供给，读 gōng。"}],"flexibleUsage":[{"word":"宝","note":"「则宝之」「不能宝也」的宝，名词作动词，当作宝物。"}],"specialSyntax":[{"name":"判断句","note":"「此楚国之宝也」「若夫白珩，先王之玩也」用「也」判断什么才算宝、什么只是玩物。"}]},"classicComment":{"t":"所寶唯賢、自是主論。却著眼在雲連徒洲一段。蓋藪澤鐘美、皆堪有用、自當爲寶、正與好玩無用之白珩緊照。後一段于聖能制議之下、復接龜珠金玉。山林藪澤、皆可資之爲用者。跌到不寶嘩囂之美、處處針鋒相對。","s":"所宝唯贤、自是主论。却著眼在云连徒洲一段。盖薮泽钟美、皆堪有用、自当为宝、正与好玩无用之白珩紧照。后一段于圣能制议之下、复接龟珠金玉。山林薮泽、皆可资之为用者。跌到不宝哗嚣之美、处处针锋相对。"}}
