py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"幣","s":"币","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"重","s":"重","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"必","s":"必","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"便","s":"便","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"于","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"虞","s":"虞","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"虞公不肯听从。","tokens":[{"t":"虞","s":"虞","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"公","s":"公","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"弗","s":"弗","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"聽","s":"听","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"于是收下晋国的礼物，把道路借给了他们。","tokens":[{"t":"遂","s":"遂","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"受","s":"受","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"幣","s":"币","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"借","s":"借","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"道","s":"道","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"宫之奇又劝谏说：俗话说，嘴唇没有了，牙齿就要受寒。","tokens":[{"t":"宮","s":"宫","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"奇","s":"奇","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"又","s":"又","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"諫","s":"谏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"語","s":"语","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"脣","s":"唇","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"亡","s":"亡","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"則","s":"则","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"齒","s":"齿","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"寒","s":"寒","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"大概说的就是我们这种情形吧。","tokens":[{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"斯","s":"斯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"謂","s":"谓","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"與","s":"与","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"他带着妻子儿女逃到曹国。","tokens":[{"t":"挈","s":"挈","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"妻","s":"妻","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"奔","s":"奔","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曹","s":"曹","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"献公灭掉虢国，过了五年，然后攻取虞国。","tokens":[{"t":"獻","s":"献","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"公","s":"公","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"亡","s":"亡","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"虢","s":"虢","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"五","s":"五","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"年","s":"年","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"後","s":"后","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"舉","s":"举","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"虞","s":"虞","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"荀息牵着马、捧着璧走上前说：璧还是原来那样，马齿却增长了。","tokens":[{"t":"荀","s":"荀","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"息","s":"息","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"牽","s":"牵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"馬","s":"马","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"操","s":"操","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"璧","s":"璧","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"前","s":"前","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"璧","s":"璧","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"則","s":"则","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"猶","s":"犹","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"是","s":"是","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"馬","s":"马","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"齒","s":"齿","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"加","s":"加","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"長","s":"长","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"矣","s":"矣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"这篇是《谷梁传·僖公二年》解释经文“虞师晋师灭夏阳”，旧题谷梁赤。夏阳是虢国的边邑，坐落在虞、虢之间的险要处。晋献公要打虢，道路必须经过虞。大夫荀息建议，用屈地出产的良马和垂棘出产的玉璧向虞借路。虞国有大夫宫之奇，献公担心他出来阻拦。谷梁先讲经文为什么对一座城用“灭”，为什么没有出兵的虞也称为师，并且写在晋的前面，再追述这次借道，用来说明虞国对灭夏阳负有主要责任。","theme":"经文已经把责任定在虞国一边。夏阳虽不是国家，却是虞、虢共同倚靠的边塞，此城一失，两国都保不住，所以用“灭”字。虞排在晋前，又称为师，是把它写成灭夏阳的主谋。荀息把马和璧看成从内库暂放到外库，算准虞君不敢白拿大国的礼物。他又看准宫之奇心明而懦弱，说话只举纲要，又从小和虞君相处，国君并不看重他。玩好摆在眼前，祸患要等虢亡之后才显现，中等才智以下的虞君不会想到那么远。宫之奇说出唇亡齿寒，仍不被采纳，只好带家人逃往曹国。献公灭虢五年后攻取虞国，荀息交还原璧，只说马长了牙齿。宝物回到手里，虞国已经不在。","technique":"开篇连问“灭”“师”和“先晋”，答语都收到“虞为主”这一句上，夏阳是两国塞邑的说明则把“重”字坐实。叙事转入荀息和献公的对话后，中府与外府、中厩与外厩连用两个比喻，把借道说成毫无损失。宫之奇的为人被拆成达心、懦弱、少长于君三层，后文两番劝谏都极短：第一番只说辞卑币重，第二番只引一句俗语，正好照应“言略”和不能强谏。虞公的反应只剩“弗听”和收下礼物。结尾不写交战，让荀息牵马操璧说马齿加长，灭国的结果用一句闲话带出。","keyContentWords":[{"word":"塞邑","reading":"sài yì","note":"边境上的险要城邑。塞读 sài，不读 sè。夏阳是虞、虢两边都要守的关口，所以失掉它，两国一起危险。"},{"word":"乘","reading":"shèng","note":"兵车，这里指驾车的良马。屈产之乘，是屈地出产的马。乘在这个意义上读 shèng，不读 chéng。"},{"word":"玩好","reading":"wán hào","note":"供玩赏的宝物，这里指马和璧。好读 hào。玩好在耳目之前，是说这些东西立刻就能看见、听见。"},{"word":"少长","reading":"shào zhǎng","note":"从年少到长大。少读 shào，长读 zhǎng。少长于君，是说宫之奇从小和虞君相处，国君和他熟了，反而不看重他。"}],"keyFunctionWords":[{"word":"焉","reading":"yān","note":"兼词，相当于“于此”。“宫之奇存焉”，是说宫之奇还在虞国那里。"},{"word":"夫","reading":"fú","note":"句首语气词，用在“且夫”里，把话再推进一层。这里不读丈夫的 fū。"}],"ancientModern":[{"word":"币","note":"送给别国的礼物，指屈产之乘和垂棘之璧。今语“币”多指货币。受吾币，就是收下晋国的礼物。"},{"word":"妻子","note":"妻子和儿女。挈其妻子以奔曹，是宫之奇带全家逃到曹国。今语“妻子”通常只指男子的配偶。"}],"phoneticLoans":[{"word":"知","loan":"智","note":"“中知”的知读 zhì，通“智”，指才智。中知以上，是中等才智以上的人；中知以下，是够不上这个程度的人。"},{"word":"与","loan":"欤","note":"“其斯之谓与”的与读 yú，通“欤”，是句末的疑问语气，表示推测。不读 yǔ。"}],"flexibleUsage":[{"word":"重","note":"形容词用作动词，看重。“重夏阳”是说经文特别重视这座城，所以对它用了灭国的“灭”字。"}],"specialSyntax":[{"name":"宾语前置","note":"“其斯之谓与”里，斯靠之提到谓的前面，等于“其谓斯与”，意思是说的就是唇亡齿寒这种情况吧。"}]},"classicComment":{"t":"全篇總是寫虞師主滅夏陽、筆端清婉、迅快無比。中間玩好在耳目之前一段、尤異樣出色、禍患之成、往往墮此、古今所同慨也。","s":"全篇总是写虞师主灭夏阳、笔端清婉、迅快无比。中间玩好在耳目之前一段、尤异样出色、祸患之成、往往堕此、古今所同慨也。"}}
