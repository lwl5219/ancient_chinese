{"id":"v03-18","volume":3,"volumeTitle":"卷三","volumeSubtitle":"周文","index":18,"title":{"t":"曾子易簀","s":"曾子易箦"},"book":{"t":"禮記","s":"礼记"},"sourceHead":{"t":"檀弓上","s":"檀弓上"},"author":"戴圣（编）","annotated":true,"paragraphs":[{"sentences":[{"tr":"曾子卧病在床，病势已经加重。","tokens":[{"t":"曾","s":"曾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"寢","s":"寝","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"疾","s":"疾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"病","s":"病","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"乐正子春坐在床下，曾元、曾申坐在脚边，童子坐在墙角，手里拿着蜡烛。","tokens":[{"t":"樂","s":"乐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"正","s":"正","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"春","s":"春","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"坐","s":"坐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"牀","s":"床","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"下","s":"下","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"曾","s":"曾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"元","s":"元","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"曾","s":"曾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"申","s":"申","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"坐","s":"坐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"足","s":"足","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"童","s":"童","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"隅","s":"隅","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"坐","s":"坐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"執","s":"执","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"燭","s":"烛","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"童子说：这席子花纹华丽，表面又光洁，是大夫用的席子吧？","tokens":[{"t":"童","s":"童","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"華","s":"华","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"睆","s":"睆","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"大","s":"大","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"夫","s":"夫","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"簀","s":"箦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"與","s":"与","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"子春说：别说了。","tokens":[{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"春","s":"春","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"止","s":"止","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"曾子听见了，吃惊地出声，像是要问。","tokens":[{"t":"曾","s":"曾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"聞","s":"闻","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t