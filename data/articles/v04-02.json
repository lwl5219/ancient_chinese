,"level":"dict"},{"t":"、","s":"、","punct":true},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"能","s":"能","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"禁","s":"禁","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"这就是我说的危险，不如伐蜀来得万全。","tokens":[{"t":"此","s":"此","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"臣","s":"臣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"謂","s":"谓","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"危","s":"危","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"如","s":"如","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"伐","s":"伐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"蜀","s":"蜀","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"完","s":"完","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"惠王说：好，我听你的。","tokens":[{"t":"惠","s":"惠","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"善","s":"善","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"寡","s":"寡","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"聽","s":"听","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"终于起兵攻蜀，十个月就拿下了，于是平定蜀地。","tokens":[{"t":"卒","s":"卒","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"起","s":"起","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"兵","s":"兵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"伐","s":"伐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"蜀","s":"蜀","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"十","s":"十","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"月","s":"月","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"取","s":"取","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"遂","s":"遂","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"定","s":"定","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"蜀","s":"蜀","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"蜀主改称侯，秦派陈庄去做蜀相。","tokens":[{"t":"蜀","s":"蜀","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"主","s":"主","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"更","s":"更","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"號","s":"号","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"侯","s":"侯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"使","s":"使","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"陳","s":"陈","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"莊","s":"庄","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"相","s":"相","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"蜀","s":"蜀","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"蜀归属秦国以后，秦国更加富强，因而看轻诸侯。","tokens":[{"t":"蜀","s":"蜀","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"旣","s":"既","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"屬","s":"属","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"秦","s":"秦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"益","s":"益","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"強","s":"强","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"富","s":"富","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"厚","s":"厚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"輕","s":"轻","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"諸","s":"诸","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"侯","s":"侯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"本篇选自《战国策·秦策一》，记秦惠王更元九年前后的一次廷议。司马错主张伐蜀，张仪主张先亲魏善楚，出兵三川，胁迫两周交出九鼎。惠王听完双方的话，采用司马错的意见，起兵十个月而定蜀，把蜀主改称为侯，派陈庄为相。","theme":"张仪看重名器，认为九鼎、图籍和挟天子令诸侯才是王业，蜀地偏远，打下来也不能成名。司马错把王业拆成地、民、德三件实事：秦国当时地小民贫，应当先取容易得到的土地和财物。伐蜀可以广国富民，又不背“劫天子”的恶名；攻韩则会使周、韩把鼎和地转送给楚、魏，秦国反而控制不住。惠王的决断和后来定蜀，都落在这个比较上。","technique":"两段议论对着写。张仪用一条进兵路线把魏、楚、韩、二周串起来，句句都是地盘和名器。司马错先立“地、民、德”三条标准，再用豺狼逐羊说明蜀易取，然后反过来推演劫天子以后各国如何合谋。前文的“王业”到后文变成“危”，同一个目标用两种算法，读者可以看出惠王为什么改听司马错。","keyContentWords":[{"word":"三川","reading":"sān chuān","note":"指黄河、伊水、洛水一带，当时属韩，张仪主张进兵的地方。"},{"word":"九鼎","reading":"jiǔ dǐng","note":"相传夏禹所铸，为周天子传国的重器。张仪想迫使周室把它交出来。"},{"word":"图籍","reading":"tú jí","note":"地图和户籍，掌握了就可以知道土地和人口，用来号令天下。"}],"keyFunctionWords":[{"word":"顾","reading":"gù","note":"“顾争于戎狄”的顾是转折连词，反而、却。"},{"word":"焉","reading":"yān","note":"“王不争焉”的焉兼词，相当于“于是”，指三川、周室这处市朝。"}],"ancientModern":[{"word":"市朝","note":"争利的市场和争名的朝廷。张仪用来比三川、周室，不是单指街市。"},{"word":"与国","note":"“周之与国”指结交的盟国，不是参与或给予。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"王","note":"“欲王者”的王用作动词，读 wàng，意思是成就王业。"},{"word":"广","note":"“务广其地”“足以广国”的广用作动词，使土地扩大。"}],"specialSyntax":[{"name":"利尽四海","note":"利益取尽于四海。蜀在西方，这句话说的是夺取蜀地的全部财物，诸侯却不把这看作贪婪。"}]},"classicComment":{"t":"周雖衰弱、名器猶存、張儀首倡破周之說、實是喪心。司馬錯建議伐蜀、句句駁倒張儀。生當戰國、而能顧惜大義、誠超于人一等。秦王平日信任張儀、而此策獨從錯、可謂識時務之要。","s":"周虽衰弱、名器犹存、张仪首倡破周之说、实是丧心。司马错建议伐蜀、句句驳倒张仪。生当战国、而能顾惜大义、诚超于人一等。秦王平日信任张仪、而此策独从错、可谓识时务之要。"}}
