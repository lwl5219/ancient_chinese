,"pos":"","extra":"","level":"dict"},{"t":"諫","s":"谏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"門","s":"门","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"庭","s":"庭","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"若","s":"若","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"市","s":"市","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"數","s":"数","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"月","s":"月","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"後","s":"后","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"時","s":"时","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"時","s":"时","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"間","s":"间","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"進","s":"进","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"朞","s":"朞","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"年","s":"年","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"後","s":"后","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"雖","s":"虽","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"欲","s":"欲","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"言","s":"言","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"可","s":"可","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"進","s":"进","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"燕、赵、韩、魏听说这件事，都来朝见齐国。","tokens":[{"t":"燕","s":"燕","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"趙","s":"赵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"韓","s":"韩","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"魏","s":"魏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"聞","s":"闻","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"皆","s":"皆","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"朝","s":"朝","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"于","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"齊","s":"齐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"这就是人们说的在朝廷上战胜了别国。","tokens":[{"t":"此","s":"此","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"謂","s":"谓","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"戰","s":"战","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"勝","s":"胜","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"于","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"朝","s":"朝","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"廷","s":"廷","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"本篇选自《战国策·齐策一》。《古文观止》把作者题作国策，不标某一个人。书中是战国游说和记事的汇编，西汉刘向整理成编。邹忌是齐人，齐威王时以鼓琴进见，后来做了齐相。威王早期听得进奉承，朝政容易被左右蒙住。这篇从邹忌在家里和城北徐公比美写起，写他怎样由妻、妾、客人的话，悟出自己受了蒙蔽，再入朝劝威王下令纳谏。情境是臣子拿闺房里的小事讽喻国君，不是上朝直接弹劾某一个大臣。","theme":"邹忌的重点不在夸自己美，而在承认自己确实不如徐公。妻子、妾和客人却一致说他更美，原因分别是偏爱、害怕和有所求。他把这三层原样移到齐王身上：宫妇偏爱王，朝臣害怕王，境内的人对王有所求，所以王受到的蒙蔽比自己更深。威王下令以后，进谏的人由拥挤变得稀少，是因为可以指出的过失少了。燕赵韩魏来朝，说明国君在朝廷上肯听逆耳的话，不必出兵也能使邻国折服。","technique":"妻、妾、客三问三答，句子逐步变短，赞美也逐步变轻，邹忌的不信却逐步加重。徐公亲自到来，用仔细看和照镜子两番对照，把别人的话按到实处。入朝以后不再另起比喻，只把私、畏、求三个字从家里搬到国里，是类比，也是拿自己作例子。奖赏分上、中、下三等，效果又按刚下令、几个月、满一年分成三截，时间和人情互相照应。末句在朝廷上战胜别国一句收住，不再铺开。","keyContentWords":[{"word":"朝","reading":"zhāo","note":"朝服衣冠的朝读 zhāo，是早晨。后文入朝、皆朝于齐的朝读 cháo，指朝廷和朝见。"},{"word":"间","reading":"jiàn","note":"时时而间进的间是间隔、间或。几个月后，进谏的人要隔一段时间才来一次。"}],"keyFunctionWords":[{"word":"孰","reading":"shú","note":"疑问代词，谁、哪一个。我孰与城北徐公美，是问我和徐公相比谁更美。"},{"word":"莫","reading":"mò","note":"没有谁。莫不私王就是没有人不偏爱王，莫不是不要。"}],"ancientModern":[{"word":"修","note":"这里指身高。邹忌修八尺有余是说他身材高。后来修多指修理、修饰，不再单指身长。"},{"word":"地方","note":"齐地方千里要断开来懂：齐地，方圆千里。方是纵横的长度。这里的地方是土地的面积，不是今天说的某个地点。"},{"word":"私","note":"私我、私王是偏爱。因为偏心才夸对方，不是现代说的隐私，也不只是自私。"},{"word":"谤","note":"谤议于市朝是在公开场合议论过失。齐王把它列为可以受赏的事，这里的谤不是造谣中伤。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"美","note":"美我是意动用法，认为我美。吾妻之美我者，不是说妻子使我变美。"},{"word":"服","note":"朝服衣冠的服是动词，穿戴。衣冠是它的宾语。"},{"word":"闻","note":"闻寡人之耳是使动，让我的耳朵听到，也就是使我知道。不是闻字普通的听见。"}],"specialSyntax":[{"name":"孰与","note":"比较的句式。我孰与城北徐公美，等于我与城北徐公孰美。同篇后文吾与徐公孰美，是同一问法的另一种说法。"}]},"classicComment":{"t":"鄒忌將己之美、徐公之美、細細詳勘、正欲于此參出微理。千古臣諂君蔽、興亡關頭、從閨房小語破之、快哉。","s":"邹忌将己之美、徐公之美、细细详勘、正欲于此参出微理。千古臣谄君蔽、兴亡关头、从闺房小语破之、快哉。"}}
