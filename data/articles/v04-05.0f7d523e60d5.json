太","s":"太","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"璞","s":"璞","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"完","s":"完","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"士生长在偏僻的乡野，一被推举就得到俸禄。不是不尊贵显达，可是形体和精神就不完整了。","tokens":[{"t":"士","s":"士","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"生","s":"生","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乎","s":"乎","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"鄙","s":"鄙","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"野","s":"野","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"推","s":"推","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"選","s":"选","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"則","s":"则","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"祿","s":"禄","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"焉","s":"焉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"非","s":"非","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"尊","s":"尊","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"遂","s":"遂","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"然","s":"然","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"形","s":"形","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"神","s":"神","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"全","s":"全","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"我希望能够回去，把饿了再吃当作吃肉，把从容步行当作坐车，把没有罪过当作尊贵，靠清净正直来自得其乐。","tokens":[{"t":"斶","s":"斶","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"願","s":"愿","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"得","s":"得","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"歸","s":"归","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"晚","s":"晚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"食","s":"食","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"當","s":"当","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"肉","s":"肉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"安","s":"安","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"步","s":"步","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"當","s":"当","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"車","s":"车","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"罪","s":"罪","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"當","s":"当","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"貴","s":"贵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"清","s":"清","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"淨","s":"净","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"貞","s":"贞","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"正","s":"正","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"自","s":"自","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"虞","s":"虞","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"于是他拜了两拜，告辞离开。","tokens":[{"t":"則","s":"则","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"再","s":"再","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"拜","s":"拜","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"辭","s":"辞","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"去","s":"去","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"君子说：颜斶知道满足了。回到本真，恢复天然的璞，就能终身不受侮辱。","tokens":[{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"斶","s":"斶","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"知","s":"知","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"足","s":"足","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"矣","s":"矣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"歸","s":"归","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"真","s":"真","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"反","s":"反","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"璞","s":"璞","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"則","s":"则","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"終","s":"终","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"身","s":"身","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"辱","s":"辱","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"本篇选自《战国策·齐策四》。《古文观止》作者题作国策，材料是战国游士的记载，西汉刘向编定成书，不是颜斶本人的作品。颜斶是齐人，齐宣王召见他。宣王命他上前，他反而要王上前，当面争辩士和王谁更尊贵。《古文观止》删去了中间论历代帝王、诸侯称孤道寡的一大段，只留下柳下季的坟和齐王人头的对照，以及后半颜斶拒绝太牢、车马，辞别归去。情境是士人当着国君的面不肯为爵禄折腰。","theme":"颜斶认为，自己上前是慕势，王上前才是趋士，所以宁可让王走过来。他用秦国的两道军令作比：柳下季的坟五十步以内不许打柴，犯者处死；齐王的头却可以换万户侯和千金。活着的王的头，竟不如已死的士的坟，这就是士贵、王不贵的根据。宣王要拜他为师，并用丰盛的筵席、车马和华丽衣服留他。颜斶把玉一雕琢就失去完整的璞，比作士一受禄就形神不全，宁可晚些吃饭、缓步走路、不犯罪过，守住自己的本真。","technique":"前半用斶前、王前反复顶住同一句话，左右的责问和颜斶的分解都不另起头绪。宣王怒问谁尊贵，回答先落下士贵耳，再补王者不贵，语气很陡。两道秦令，一道写死士的坟，一道写活王的头，对照本身就是结论。后半宣王仍用富贵挽留，颜斶用玉和士对举；晚食、安步、无罪三句，分别顶住太牢、乘车和尊贵。结尾借君子的评语收住，点明知足和不受辱。","keyContentWords":[{"word":"垄","reading":"lǒng","note":"坟墓。柳下季垄就是柳下季的坟。柳下季即鲁国的柳下惠，名展禽。"},{"word":"太牢","reading":"tài láo","note":"牛、羊、猪三牲齐备的筵席。宣王用食必太牢表示饮食的最高规格。"}],"keyFunctionWords":[{"word":"夫","reading":"fú","note":"句首语气词，提起议论。夫斶前为慕势、夫玉生于山的夫都不指丈夫。"},{"word":"曾","reading":"zēng","note":"竟然，用来加强否定。曾不若就是竟然不如，不是曾经。"},{"word":"焉","reading":"yān","note":"君子焉可侮哉的焉是疑问词，怎么。制则破焉的焉代被雕琢的玉，相当于它。"}],"ancientModern":[{"word":"去","note":"去柳下季垄五十步的去是距离、相距，不是离开。"},{"word":"妻子","note":"妻子和儿女，统指一家眷属。妻子衣服丽都是说家属的衣服都华丽，不是只指配偶。"},{"word":"病","note":"自取病的病是羞辱、难堪。宣王说自己讨来没趣，不是说生了病。"}],"phoneticLoans":[{"word":"说","loan":"悦","note":"宣王不说的说通悦，读 yuè，是高兴。同篇有说乎的说读 shuō，是说法、理由，两个说不是一个意思。"},{"word":"虞","loan":"娱","note":"以自虞的虞通娱，快乐。清净贞正以自虞，是靠清净正直使自己安乐。"}],"flexibleUsage":[{"word":"前","note":"方位名词用作动词，走到面前。斶前、王前都是叫对方上前来。"}],"specialSyntax":[{"name":"与使……不如使……","note":"固定句式，相当于与其让……不如让……。颜斶用它比较慕势和趋士，取舍说得很明确。"}]},"classicComment":{"t":"起得唐突、收得超忽。後段形神不全四字、說盡富貴利達人、良可悲也。戰國士氣、卑汙極矣、得此可以一迴狂瀾。","s":"起得唐突、收得超忽。后段形神不全四字、说尽富贵利达人、良可悲也。战国士气、卑污极矣、得此可以一回狂澜。"}}
