"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"可","s":"可","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"忘","s":"忘","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"如今您杀了晋鄙，救下邯郸，打败秦军，保全了赵国，这是很大的恩德。","tokens":[{"t":"今","s":"今","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"殺","s":"杀","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"晉","s":"晋","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"鄙","s":"鄙","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"救","s":"救","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"邯","s":"邯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"鄲","s":"郸","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"破","s":"破","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"秦","s":"秦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"存","s":"存","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"趙","s":"赵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"國","s":"国","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"此","s":"此","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"大","s":"大","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"德","s":"德","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"现在赵王亲自到郊外迎接，您突然见到赵王时，希望您忘掉自己的这件恩德。","tokens":[{"t":"今","s":"今","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"趙","s":"赵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"自","s":"自","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"郊","s":"郊","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"迎","s":"迎","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"卒","s":"卒","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"然","s":"然","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"見","s":"见","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"趙","s":"赵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"願","s":"愿","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"忘","s":"忘","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"信陵君说：无忌恭敬地接受指教。","tokens":[{"t":"信","s":"信","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"陵","s":"陵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"忌","s":"忌","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"謹","s":"谨","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"受","s":"受","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"教","s":"教","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"本篇选自《战国策·魏策》。秦军围困邯郸时，魏公子无忌夺取将军晋鄙的军队，击退秦军，赵国得以保存。赵王亲自到郊外迎接。唐雎就在这个场合劝说信陵君。事情紧接救赵之后，约在魏安厘王时期、公元前257年邯郸解围之际。全文只保留唐雎的一段话和信陵君的答谢。","theme":"唐雎担心救赵的大功在郊迎时变成居功。别人的憎恨不能不觉察，自己的憎恨却不能让对方知道；别人的恩德不可忘，自己给人的恩德却必须忘掉。杀晋鄙、存赵国是大德，赵王亲自出郊，正是施恩的人最容易记得自己功劳的时候。他要信陵君在骤然见面时忘掉这件事，免得功劳压到受恩的国君身上。","technique":"开头用四个不可排成一组未加解释的话，等信陵君问何谓也，再分成憎和德两组拆开。两组都是一正一反，字数几乎相同。不可不忘只比不可忘多一个不，意思却从应当记住变成必须忘记。抽象的句子说完，才落到杀晋鄙、存赵国和郊迎，读者这时才明白那句不可不忘是为这一次功劳准备的。信陵君只答谨受教，后事不再补写。","keyContentWords":[{"word":"郊迎","reading":"jiāo yíng","note":"到郊外迎接，是国君对有大功者表示尊宠的礼节。"},{"word":"憎","reading":"zēng","note":"憎恨。人之憎我、我憎人，都是这个意思。"}],"keyFunctionWords":[{"word":"得","reading":"dé","note":"能够。不可得而知也，是不能让对方知道，不是自己无法了解。"}],"ancientModern":[{"word":"德","note":"有德于我、此大德也的德都指恩惠。今多指道德、品行。"}],"phoneticLoans":[{"word":"卒","loan":"猝","note":"卒然见赵王的卒通猝，读 cù，突然。"}],"flexibleUsage":[{"word":"存","note":"存赵国的存是使动用法，使赵国保存下来。"}],"specialSyntax":[{"name":"双重否定","note":"不可不忘也。两个不叠用，表示必须忘记。它和上一分句不可忘也只差一个不。"}]},"classicComment":{"t":"謂信陵君、只須說不可不忘、却先說不可忘。亦只須說不可忘、不可不忘、却又先說不可不知不可得而知。文有寬而不懈者、其勢急也。詞有複而不板者、其氣逸也。","s":"谓信陵君、只须说不可不忘、却先说不可忘。亦只须说不可忘、不可不忘、却又先说不可不知不可得而知。文有宽而不懈者、其势急也。词有复而不板者、其气逸也。"}}
