"謝","s":"谢","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"先","s":"先","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"生","s":"生","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"坐","s":"坐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"何","s":"何","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"至","s":"至","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"此","s":"此","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"寡","s":"寡","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"諭","s":"谕","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"矣","s":"矣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"韩国、魏国灭亡了，而安陵凭五十里土地还能保存，只是因为有先生。","tokens":[{"t":"夫","s":"夫","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"韓","s":"韩","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"魏","s":"魏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"滅","s":"灭","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"亡","s":"亡","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"安","s":"安","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"陵","s":"陵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"五","s":"五","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"十","s":"十","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"里","s":"里","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"地","s":"地","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"存","s":"存","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"徒","s":"徒","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"先","s":"先","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"生","s":"生","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"本篇选自《战国策·魏策》。安陵是依附魏国的小国，土地方圆不过数十里。秦王嬴政在灭韩、亡魏之后，派人向安陵君提出用五百里之地交换安陵，话说成恩惠，用意是让安陵交出国土。安陵君不肯，派唐雎出使。唐雎在秦廷用布衣之士的愤怒顶住恐吓，秦王当场收敛。文中秦王自己说已经灭韩亡魏，事情在秦统一六国之前。","theme":"安陵君和唐雎守住的是先王留下的土地，不接受把吞并说成以大易小的交换。秦王先用灭韩亡魏表示自己本可以不把安陵放在心上，再用天子之怒压人。唐雎把百万尸体、千里流血收成两具尸体、五步流血，并举专诸、聂政、要离，表明自己可以和秦王同归于尽。秦王色挠长跪之后，把安陵尚存归到唐雎身上。不辱使命，就落在国土和使臣的立场都没有丢掉。","technique":"双方的话一路对照。五百里对五十里，千里不敢易对岂直五百里，天子之怒对布衣之怒。专诸刺王僚、聂政刺韩傀、要离刺庆忌，三句结构相同，都是一位刺客加上一种天象，再用与臣而将四矣把往事接到秦廷。挺剑而起四个字打断长谈，秦王立刻长跪道歉，前面伏尸百万的夸说因此落空。篇末改由秦王自己说出徒以有先生，完成对使命的评价。","keyContentWords":[{"word":"布衣","reading":"bù yī","note":"平民穿的衣服，这里指平民。布衣之怒就是平民的愤怒，用来对照天子之怒。"},{"word":"使","reading":"shǐ","note":"秦王使人的使是派遣，派人去通知安陵君。安陵君因使唐雎的使也是派遣；使于秦的使是出使。"},{"word":"抢","reading":"qiāng","note":"撞。以头抢地，是用头撞地。这里不读抢夺的 qiǎng。"}],"keyFunctionWords":[{"word":"其","reading":"qí","note":"安陵君其许寡人的其，表示希望、祈使，含有可要的意思。"},{"word":"徒","reading":"tú","note":"徒以有先生也的徒是只、仅仅。免冠徒跣的徒是光着，徒跣就是赤脚。"},{"word":"与","reading":"yú","note":"轻寡人与的与读 yú，句末疑问，同欤。与臣而将四矣的与读 yǔ，是加上、算上。"}],"ancientModern":[{"word":"虽然","note":"虽然，受地于先王，是虽然如此。今虽然只作转折连词，后面不再包含如此。"},{"word":"谢","note":"长跪而谢之的谢是道歉。今多作感谢。"}],"phoneticLoans":[{"word":"说","loan":"悦","note":"秦王不说的说通悦，读 yuè，高兴。不说就是不高兴。"},{"word":"错","loan":"措","note":"故不错意也的错通措，放置。不错意，就是不放在心上。"}],"flexibleUsage":[{"word":"轻","note":"轻寡人的轻是形容词作动词，轻视。"},{"word":"缟素","note":"天下缟素的缟素读 gǎo sù，本指白色丧服，这里用作动词，穿上丧服。"}],"specialSyntax":[{"name":"对照","note":"天子之怒是伏尸百万、流血千里，士之怒收成伏尸二人、流血五步。数字缩小，威胁却移到秦王面前。"}]},"classicComment":{"t":"博浪之椎、唐雎荊卿之劍、雖未亡秦、皆不可少。","s":"博浪之椎、唐雎荆卿之剑、虽未亡秦、皆不可少。"}}
