"s":"尺","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"短","s":"短","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"寸","s":"寸","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"長","s":"长","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"物","s":"物","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"足","s":"足","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"智","s":"智","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"明","s":"明","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"數","s":"数","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"逮","s":"逮","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"神","s":"神","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"通","s":"通","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"照您自己的心去做，实行您自己的意愿。龟甲和蓍草实在不能知道这件事。","tokens":[{"t":"用","s":"用","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"心","s":"心","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"行","s":"行","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"意","s":"意","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"龜","s":"龟","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"䇲","s":"䇲","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"誠","s":"诚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"能","s":"能","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"知","s":"知","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"此","s":"此","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"事","s":"事","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"屈原名平，战国楚人，曾做楚怀王的左徒，主张联齐抗秦，被上官大夫等人谗毁，后来又遭顷襄王放逐。本篇选自《楚辞·卜居》，旧题屈原作。题里的「卜」是占卜，「居」是处世的立场。文章假设他放逐已经三年，不能再见君王，心里烦乱，去找掌卜的太卜郑詹尹。太卜是官名，郑是姓，詹尹是名。他并没有真把命运交给龟策，一连串问句本身已经把取舍说出来了。","theme":"八组「宁肯……还是……」把两条路摆在一起：诚恳尽忠，还是忙着应酬；亲自耕田，还是巴结权贵；直言使自己遭险，还是苟且偷生；远走以保全本性，还是向妇人献媚；廉洁使自己清白，还是圆滑像油脂；做千里马、黄鹄，还是做随波的野鸭、争食的鸡鸭。问的是哪样吉利、该离开什么，骨子里已经否定后一条。后面「蝉翼为重，千钧为轻」「黄钟毁弃，瓦釜雷鸣」，是说世道把轻重和贤愚颠倒了。郑詹尹放下蓍草，承认尺有所短、卦数也有算不到的地方，只让他按自己的心去做。占卜解决不了忠佞的选择。","technique":"体裁是有韵的对问，问句密，答语很短。屈原这边几乎全用「宁……乎，将……乎」的选择句，每组前半是他所守的，后半是他所鄙的，节奏相同，话说得一层比一层尖，「侍奉妇人」「像油脂软皮」「和鸡鸭争食」都是逼出来的反话。詹尹不替他挑选，先说尺短寸长、神有不通，再用「用君之心，行君之意」把问题交还。占卜的架子还在，判断却不出于龟策，而出于问话的人自己。","keyContentWords":[{"word":"放","reading":"fàng","note":"放逐。「屈原既放」，是已经被流放，不是释放。"},{"word":"黄钟","reading":"huáng zhōng","note":"乐律中声音最洪大的音调，这里比喻正声和贤者。黄钟毁弃，是说雅正的被扔掉。"},{"word":"瓦釜","reading":"wǎ fǔ","note":"陶土做的锅，比喻庸人。瓦釜雷鸣，是说平庸的人声势很大。"},{"word":"滑稽","reading":"gǔ jī","note":"本是一种圆转倾注的酒器，这里比喻圆滑随顺。不读今音 huá jī，也不是可笑的意思。"}],"keyFunctionWords":[{"word":"宁","reading":"nìng","note":"宁可。和「将」配成「宁……乎，将……乎」，表示二者择一。"},{"word":"夫","reading":"fú","note":"「夫尺有所短」的夫用在句首，引出詹尹下面的一番话。"}],"ancientModern":[{"word":"谢","note":"「释䇲而谢」的谢是推辞。今多指感谢。"}],"phoneticLoans":[{"word":"媮","loan":"偷","note":"「媮生」的媮通「偷」，苟且地活着。"}],"flexibleUsage":[{"word":"危","note":"「以危身」的危是使动，使自身陷于危险。"},{"word":"清","note":"「以自清」的清是使动，使自己保持清白。"}],"specialSyntax":[{"name":"选择问句","note":"全文连用「宁……乎，将……乎」，前句和后句并列，请对方择一。问卜只是引起这些句子的由头。"}]},"classicComment":{"t":"屈原疾邪曲之害公、方正之不容、故設爲不知所從、而假龜策以決之。非實有所疑、而求之于卜也。中間請卜之詞、以一寧字、將字到底、語意低昂、隱隱自見。","s":"屈原疾邪曲之害公、方正之不容、故设为不知所从、而假龟策以决之。非实有所疑、而求之于卜也。中间请卜之词、以一宁字、将字到底、语意低昂、隐隐自见。"}}
