":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"深","s":"深","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"考","s":"考","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"表","s":"表","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"見","s":"见","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"皆","s":"皆","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"虛","s":"虚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"《尚书》残缺已经有相当长的时间了，散失的内容却常常在别的说法里见到。","tokens":[{"t":"書","s":"书","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"缺","s":"缺","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"間","s":"间","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"矣","s":"矣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"軼","s":"轶","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乃","s":"乃","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"時","s":"时","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"時","s":"时","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"見","s":"见","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"他","s":"他","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"說","s":"说","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"若不是好学深思、心里明白其中的意思，本来就难以讲给见识浅、见闻少的人听。","tokens":[{"t":"非","s":"非","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"好","s":"好","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"學","s":"学","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"深","s":"深","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"思","s":"思","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"心","s":"心","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"知","s":"知","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"意","s":"意","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"固","s":"固","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"難","s":"难","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"淺","s":"浅","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"見","s":"见","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"寡","s":"寡","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"聞","s":"闻","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"道","s":"道","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"我把这些材料一并编排，只选择说法特别雅正的，所以写成列在本纪开头的这一篇。","tokens":[{"t":"余","s":"余","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"并","s":"并","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"論","s":"论","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"次","s":"次","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"擇","s":"择","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"言","s":"言","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"尤","s":"尤","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"雅","s":"雅","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"故","s":"故","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"著","s":"著","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"本","s":"本","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"紀","s":"纪","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"書","s":"书","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"首","s":"首","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"本篇是司马迁《史记·五帝本纪》篇末的论赞，《古文观止》抽出单行，题为《五帝本纪赞》。司马迁在汉武帝时任太史令，继承父亲司马谈的遗志，要把上古直到当世的史事写成一家之言。五帝指黄帝、颛顼、帝喾、尧、舜，年代极远。《尚书》所记从尧写起，诸子讲黄帝又多有荒诞不经的文字。他仍把五帝放在十二本纪之首，这篇赞就是说明取材的依据：哪些能信，哪些只能存疑，以及自己怎样在残缺的文献和四方见闻之间决定去取。","theme":"司马迁认为五帝之事虽然久远，却不是完全不可考。他不采纳百家那些不典雅、无凭据的说法，也不因为有的儒者不传《五帝德》《帝系姓》就一概丢开。各地长老仍能指出黄帝、尧、舜的遗迹，风俗各不相同；可采的是不背离古文、又能与《春秋》《国语》相互印证的记载。古书有缺，散失的内容常出现在别的说法里，必须好学深思才能判断。所以他编排史料，只把特别雅正的写入本纪开头。全篇交代的是取舍标准，不是空泛地歌颂五帝。","technique":"全文用「太史公曰」领起，先说五帝之说年代久远，再用「然」转出《尚书》与百家的差别，取舍在第一层就立住。中间写西至空峒、北过涿鹿、东至于海、南浮江淮，好像游历，其实是证明传说还有实地可指，随即用「不离古文者近是」把口传收回到文献。《春秋》《国语》用来旁证《五帝德》《帝系姓》，「顾弟弗深考」又轻轻撇开儒者的怀疑。结尾才落到「择其言尤雅者」，与前面的「不雅驯」首尾相应。句子短，转折多，语气却是史家说明体例，不断然把缺略说成定案。","keyContentWords":[{"word":"尚","reading":"shàng","note":"久远。学者多称五帝，尚矣：称道五帝已经是很古的事。"},{"word":"雅驯","reading":"yǎ xùn","note":"典雅而有依据，经得起推敲。其文不雅驯，指百家讲黄帝的文字芜杂难信。"},{"word":"渐","reading":"jiàn","note":"流入，这里是走到。东渐于海，向东一直到达海边。"}],"keyFunctionWords":[{"word":"顾","reading":"gù","note":"不过，只是。顾弟弗深考，转折后把话收住。"},{"word":"固","reading":"gù","note":"本来，确实。风教固殊焉；固难为浅见寡闻道也。"}],"ancientModern":[{"word":"往往","note":"长老皆各往往称：到处、常常。今多只表示某种情况经常出现，没有「处处」的意思。"},{"word":"古文","note":"不离古文者近是：这里指古代典籍的记载。今常指文言文这一类文体。"}],"phoneticLoans":[{"word":"荐","loan":"搢","note":"荐绅先生即搢绅先生，把笏插在绅带上，指士大夫。"},{"word":"弟","loan":"第","note":"顾弟弗深考：弟通第，只是、但是。"},{"word":"轶","loan":"佚","note":"其轶乃时时见于他说：轶通佚，散失的记载。"}],"flexibleUsage":[{"word":"西、北、东、南","note":"方位名词作状语。西至空峒、北过涿鹿、东渐于海、南浮江淮，分别是向西、向北、向东、向南。"}],"specialSyntax":[{"name":"介宾表对象","note":"难为浅见寡闻道：为引进讲述的对象，意思是难以向见识浅、见闻少的人说明。浅见寡闻后省去「者」。"}]},"classicComment":{"t":"此爲贊語之首、古質奧雅、文簡意多。轉折層曲、往復回環。其傳疑不敢自信之意、絕不作一了結語。乃贊語中之尤超絕者。","s":"此为赞语之首、古质奥雅、文简意多。转折层曲、往复回环。其传疑不敢自信之意、绝不作一了结语。乃赞语中之尤超绝者。"}}
