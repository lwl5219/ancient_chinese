nct":true},{"t":"難","s":"难","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"矣","s":"矣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"他夸耀自己的功劳，只逞个人的聪明而不效法古人，一讲霸王的事业，就想靠武力征伐来治理天下；五年终于亡了国，自己死在东城，还不醒悟，不肯责备自己，这就错了。","tokens":[{"t":"自","s":"自","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"矜","s":"矜","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"功","s":"功","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"伐","s":"伐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"奮","s":"奋","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"私","s":"私","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"智","s":"智","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"師","s":"师","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"古","s":"古","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"謂","s":"谓","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"霸","s":"霸","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"業","s":"业","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"欲","s":"欲","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"力","s":"力","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"征","s":"征","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"經","s":"经","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"營","s":"营","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"天","s":"天","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"下","s":"下","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"五","s":"五","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"年","s":"年","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"卒","s":"卒","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"亡","s":"亡","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"國","s":"国","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"身","s":"身","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"死","s":"死","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"東","s":"东","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"城","s":"城","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"尚","s":"尚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"覺","s":"觉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"寤","s":"寤","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"自","s":"自","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"責","s":"责","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"過","s":"过","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"矣","s":"矣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"他竟然说是天要灭亡我，不是用兵的过错，难道不荒谬吗？","tokens":[{"t":"乃","s":"乃","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"引","s":"引","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"天","s":"天","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"亡","s":"亡","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"我","s":"我","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"非","s":"非","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"用","s":"用","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"兵","s":"兵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"罪","s":"罪","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"豈","s":"岂","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"謬","s":"谬","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"哉","s":"哉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"本篇是司马迁《史记·项羽本纪》篇末的论赞，《古文观止》题作《项羽本纪赞》。项羽名籍，下相人，随叔父项梁起兵反秦。巨鹿之战后，诸侯军都听他节制；灭秦以后自号西楚霸王，分封王侯，建都彭城，又放逐义帝。楚汉相争约五年，他在垓下战败，被困东城，自刎而死。司马迁不把他放进世家或列传，而写入本纪，与天子同列。周生是他听到的一位汉儒，名字已不可考。赞从舜与项羽都有重瞳说起，再评价项羽的崛起和失败。","theme":"司马迁承认项羽兴起快得罕见：没有尺寸封地，三年就率领诸侯灭秦，政令出自他一人，近古没有第二人。他并不因此放过失败的原因。放弃关中而东归楚地，放逐义帝又自立，再怨王侯背叛，局面已经难保。更根本的是自夸功劳，只凭私智，不效法古人，以为霸业可以靠武力维持。五年亡国，死在东城，还把责任推给天。赞的落点是「岂不谬哉」：兴得暴，败也有由，不能用天命替自己开脱。","technique":"起笔借周生说舜有重瞳，再接项羽也有重瞳，用「岂其苗裔邪」把两个人轻轻连上，只作疑辞，并不坐实。下面先用陈涉发难、豪杰并争铺开秦末的局面，再用「然」把项羽从众人里拔出，一气数完灭秦、封侯、号霸王，褒意到「未尝有也」为止。后半连用「及」「自矜」「乃引」，一层比一层紧，从政治失策说到不肯认错。前面写其兴，后面写其亡，都落在项羽自己的选择上，天命只出现在他临终的借口里，随即被反问驳回。","keyContentWords":[{"word":"重瞳","reading":"chóng tóng","note":"一只眼睛里有两个瞳仁。文中用来连结舜和项羽。"},{"word":"苗裔","reading":"miáo yì","note":"后代。羽岂其苗裔邪，其指舜。"},{"word":"暴","reading":"bào","note":"突然，迅猛。何兴之暴也，问他为什么兴起得这样快。"},{"word":"功伐","reading":"gōng fá","note":"功劳。伐也是功。自矜功伐，夸耀自己的战功劳绩。"}],"keyFunctionWords":[{"word":"盖","reading":"gài","note":"大概。舜目盖重瞳子，表示得之传闻，不是确指。"},{"word":"夫","reading":"fú","note":"句首发语词。夫秦失其政，引出秦末形势，没有实在意义。"}],"ancientModern":[{"word":"经营","note":"欲以力征经营天下：筹划、治理。今多指经商办企业。"},{"word":"尺寸","note":"非有尺寸：一点点土地或权位可以凭借。今多指长度，或比喻说话办事的分寸。"}],"phoneticLoans":[{"word":"寤","loan":"悟","note":"尚不觉寤：寤通悟，醒悟、明白。"}],"flexibleUsage":[{"word":"蠭","note":"豪杰蠭起：蠭即蜂，名词作状语，像蜂群一样成群兴起。"}],"specialSyntax":[{"name":"主谓之间加「之」","note":"何兴之暴也：在主语「兴」和谓语「暴」之间加「之」，构成感叹，意思是兴起得多么迅猛。"}]},"classicComment":{"t":"一贊中、五層轉折、唱歎不窮、而一紀之神情已盡。","s":"一赞中、五层转折、唱叹不穷、而一纪之神情已尽。"}}
