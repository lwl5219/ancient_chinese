"ctx":"","pos":"","extra":"","level":"dict"},{"t":"在","s":"在","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"土","s":"土","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"这就是书传上所说的大圣人吧？难道不是天意吗？难道不是天意吗？","tokens":[{"t":"此","s":"此","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乃","s":"乃","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"傳","s":"传","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"謂","s":"谓","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"大","s":"大","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"聖","s":"圣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乎","s":"乎","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"豈","s":"岂","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"非","s":"非","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"天","s":"天","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"哉","s":"哉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"豈","s":"岂","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"非","s":"非","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"天","s":"天","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"哉","s":"哉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"若不是大圣人，谁又能在这种时势里承受天命而称帝呢？","tokens":[{"t":"非","s":"非","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"大","s":"大","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"聖","s":"圣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"孰","s":"孰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"能","s":"能","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"當","s":"当","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"此","s":"此","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"受","s":"受","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"命","s":"命","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"帝","s":"帝","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乎","s":"乎","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"本篇是司马迁《史记·秦楚之际月表》前面的序，《古文观止》用表名收了这段文字。秦楚之际指秦朝将亡、项氏称霸、汉家初兴的短暂时段。司马迁用「月表」而不是年表，是因为这几年里号令更换太快，按年排比不够用。序文从陈涉发难写到刘邦践帝祚，拿虞舜、夏禹、商汤、周武王的长期积累，以及秦自襄公到始皇一百多年的兼并，来对照汉家五年之内完成帝业。文中的契是商的始祖，后稷是周的始祖，孟津之会则是周武王伐纣前的事。","theme":"司马迁要说明的是：统一为什么通常极慢，汉家受命为什么又快得空前。虞、夏靠几十年积德并先摄政，汤、武的基业从契、后稷算起已经许多代，秦从襄公到始皇也用了一百多年，才把中原诸侯并掉。秦称帝后怕诸侯再起，不分封、毁城、销兵、除豪杰，以为可以安稳万世。结果王业从闾巷兴起，联合讨伐的声势超过三代，秦的禁令反而替后来的人扫清了障碍。序的落点是汉高祖。司马迁称他为大圣，并把这五年的骤变更迭归于天，这是他解释汉家得天下的看法。","technique":"序文先用三句把陈涉、项氏、汉家的先后排定，再收成「号令三嬗」，五年的急促一下就显出来。中间连用虞夏、汤武、秦三层对照，一层比一层长，最后用「以德若彼，用力如此」把德与力收在一起，衬出「一统若斯之难」。写秦的措施用「无尺土之封、堕坏名城、销锋镝、鉏豪杰」短句排开，紧接着「然」字翻过，说这些禁令适足以资贤者。结尾「岂非天哉」叠用两次，是感叹，也是把前文的比较都归到受命上。全篇是表序，重点在时势的缓急，不展开具体战事。","keyContentWords":[{"word":"嬗","reading":"shàn","note":"更替。号令三嬗，五年里发号施令的人换了三次，紧接上文的陈涉、项氏、汉家。"},{"word":"亟","reading":"jí","note":"急，快。受命若斯之亟，承受天命像这样急促。"},{"word":"闾巷","reading":"lǘ xiàng","note":"里巷，指民间。王迹之兴起于闾巷，与秦的诸侯、名城相对。"}],"keyFunctionWords":[{"word":"适","reading":"shì","note":"恰好。乡秦之禁，适足以资贤者，禁令正好帮了后来的人。"}],"ancientModern":[{"word":"稍","note":"稍以蚕食六国：逐渐。今多作稍微，程度很轻。"},{"word":"传","note":"此乃传之所谓大圣：传读 zhuàn，书传、记载。今「传」常读 chuán，作传递、传播。"}],"phoneticLoans":[{"word":"乡","loan":"向","note":"乡秦之禁：乡通向，从前。指秦朝当年的那些禁令。"},{"word":"缪","loan":"穆","note":"章于文缪：缪通穆，文缪指秦文公、秦穆公。"},{"word":"从","loan":"纵","note":"合从讨伐：从通纵，联合。这里指众人联合起来讨伐。"}],"flexibleUsage":[{"word":"王","note":"汤武之王、无土不王：名词作动词，读 wàng，称王。"},{"word":"帝","note":"受命而帝：名词作动词，称帝。"}],"specialSyntax":[{"name":"反问","note":"安在无土不王：哪里真是没有封土就不能称王。岂非天哉叠用两句，用反问把汉家受命归于天。"}]},"classicComment":{"t":"前三段一正、后三段一反、而歸功于漢。以四層咏歎、無限委蛇、如黄河之水、百折百迴、究未嘗著一實筆、使讀者自得之。最爲深妙。","s":"前三段一正、后三段一反、而归功于汉。以四层咏叹、无限委蛇、如黄河之水、百折百回、究未尝著一实笔、使读者自得之。最为深妙。"}}
