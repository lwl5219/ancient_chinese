,"s":"辱","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"亦","s":"亦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"當","s":"当","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"世","s":"世","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"得","s":"得","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"失","s":"失","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"林","s":"林","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"何","s":"何","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"必","s":"必","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"舊","s":"旧","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"聞","s":"闻","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"于是我慎重记录他们的始末，用表把情形列出来，仍有不少本末不能写全；明白的就写上，有疑问的就空着。","tokens":[{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"是","s":"是","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"謹","s":"谨","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"終","s":"终","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"始","s":"始","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"表","s":"表","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"見","s":"见","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"文","s":"文","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"頗","s":"颇","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"盡","s":"尽","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"本","s":"本","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"末","s":"末","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"著","s":"著","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"明","s":"明","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"疑","s":"疑","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"闕","s":"阙","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"以后的君子如果想推究并排列这些史事，可以查阅这份表。","tokens":[{"t":"後","s":"后","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"欲","s":"欲","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"推","s":"推","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"列","s":"列","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"得","s":"得","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"覽","s":"览","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"焉","s":"焉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"本篇是司马迁《史记·高祖功臣侯者年表》的序，《古文观止》题作《高祖功臣侯年表》。汉高祖刘邦在天下初定时把功臣封为列侯，封爵誓词希望黄河不变成衣带、泰山不变成磨石，封国就永远传给子孙。当时大战刚停，人口稀少，大侯也不过万家。到汉武帝太初年间，距离初封大约百年，户口已经大大增加，一百多个侯国却绝大多数因犯罪废除，还保住爵位的只剩几个。司马迁作这张表，就是把每个人怎样得到尊宠、又怎样失去封国的始末列出来。","theme":"序文比较的是古代诸侯何以能长久，汉初功臣的子孙何以迅速失侯。唐虞的侯伯经历三代仍能藩卫天子，周初所封到春秋还能见到，司马迁把原因归于仁义和奉法。汉的列侯起初户少，后来萧何、曹参、周勃、灌婴一类封户多至四万，子孙却骄傲淫佚，忘记先人创业的艰难。他承认法网比当初稍密，但接着说失侯的人都没有对当时的禁令小心谨慎，不全把责任推给法令。记古是为了给今人作镜子，帝王的礼制和要务各不相同，不能拿一个死标准去缝合。表所呈现的得宠与废辱，本身就是当代得失的汇集。","technique":"开头先列勋、劳、功、伐、阅五等，给「功臣」二字定出旧尺度，再引出封爵誓词。誓词说国可永宁、爰及苗裔，下文却用汉侯百年之间几乎耗尽来对照，「异哉所闻」四个字把誓词和史实的差距点破。中间插入唐虞、周封八百两层，是用古诸侯的长久反衬汉侯的短促。写户口由十二三增到四万，是盛；「见侯五，余皆坐法」是衰，一盛一衰都落在子孙是否兢兢上。结尾说明列表的体例：终始要谨，明白的才写，疑者空着，把序收回到「表」本身。","keyContentWords":[{"word":"陵夷","reading":"líng yí","note":"像丘陵渐渐削平，引申为衰微。枝叶稍陵夷衰微，指封国子孙日渐没落。"},{"word":"息","reading":"xī","note":"增长，繁殖。户益息，户口越来越增多。"},{"word":"绲","reading":"gǔn","note":"缝合。岂可绲乎，怎么能把不同帝王的做法强行缝成一个样子。"},{"word":"统纪","reading":"tǒng jì","note":"纲纪，总的准则。要以成功为统纪，关键看是否成就功业。"}],"keyFunctionWords":[{"word":"爰","reading":"yuán","note":"于是，乃。爰及苗裔，于是传到子孙后代。"}],"ancientModern":[{"word":"见","note":"见侯五：见读 xiàn，现存的。今多读 jiàn，作看见。"},{"word":"志","note":"志古之道：记住。今多指志向、志愿。"}],"phoneticLoans":[{"word":"厉","loan":"砺","note":"泰山若厉：厉通砺，磨刀石。誓词说泰山小得像磨石。"},{"word":"罔","loan":"网","note":"罔亦少密焉：罔通网，法网。少，稍微。"}],"flexibleUsage":[{"word":"侯","note":"高祖侯功臣：名词作动词，把功臣封为列侯。"},{"word":"镜","note":"所以自镜也：名词作动词，当作镜子对照自己。"}],"specialSyntax":[{"name":"让步假设","note":"使河如带，泰山若厉，国以永宁：即使黄河窄成衣带、泰山小成磨石，封国仍要永远安宁。用两件不会发生的事，表示希望永保封爵。"}]},"classicComment":{"t":"通篇全以慨歎作致、而層層回互、步步照顧、節節頓挫。如龍之一體、鱗鬣爪甲而已、而其中多少屈伸變化、卽龍亦有不能自知者。此所以爲神物也。","s":"通篇全以慨叹作致、而层层回互、步步照顾、节节顿挫。如龙之一体、鳞鬣爪甲而已、而其中多少屈伸变化、即龙亦有不能自知者。此所以为神物也。"}}
