pos":"","extra":"","level":"dict"},{"t":"昌","s":"昌","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"下","s":"下","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"相","s":"相","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"國","s":"国","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"相","s":"相","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"國","s":"国","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"酇","s":"酂","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"侯","s":"侯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"下","s":"下","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"諸","s":"诸","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"侯","s":"侯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"御","s":"御","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"史","s":"史","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"中","s":"中","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"執","s":"执","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"法","s":"法","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"下","s":"下","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"郡","s":"郡","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"守","s":"守","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"如果有名声与美德相称的人，当地长官必须亲自前往劝请，给他备好车马，送到相国府，并登记他的品行、仪容和年龄。","tokens":[{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"意","s":"意","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"稱","s":"称","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"明","s":"明","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"德","s":"德","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"必","s":"必","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"身","s":"身","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"勸","s":"劝","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"駕","s":"驾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"遣","s":"遣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"詣","s":"诣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"相","s":"相","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"國","s":"国","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"府","s":"府","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"署","s":"署","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"行","s":"行","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"義","s":"义","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"年","s":"年","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"有这样的人却不上报，一旦被发觉，就免去当事官员的职务。","tokens":[{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"弗","s":"弗","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"言","s":"言","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"覺","s":"觉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"免","s":"免","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"年老体衰、身有疾病的，不要遣送。","tokens":[{"t":"年","s":"年","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"老","s":"老","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"癃","s":"癃","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"病","s":"病","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"勿","s":"勿","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"遣","s":"遣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"《高帝求贤诏》出自《汉书·高帝纪》，是汉高祖刘邦在高祖十一年二月颁布的。这一年正月，淮阴侯韩信在长安因谋反被杀；再往前，代相陈豨反叛，高祖亲自到邯郸用兵，正月回到洛阳，二月颁布这道诏书。天下虽然已经合成一家，他仍然担心宗庙祭祀不能一代代维持下去，而能够分任郡国、一起安定天下的人不够。于是公开下诏，要地方把德行可称的人亲自劝请、备车送到相国府。传达的次序写得很清楚：御史大夫周昌下达相国萧何，再分送诸侯王和郡守。","theme":"这篇诏书要把“一起打天下”和“一起守天下”分开。贤人已经帮助刘邦平定了海内，如果此后不让他们分享安定和利益，刘氏的祭祀就未必保得住。所以诏书不停留在思贤的空话上，而答应肯来共事的人可以尊贵显达，并规定了劝请、备车、送到相国府、登记品行年岁的办法。年老病弱的不必上路，有贤不报的官员则要免职。中心是给天下士人一条进身的路，用来维持刚刚统一的政权。","technique":"开头用周文王和齐桓公作对照，把求贤说成王业和霸业的旧例，接着反问当今贤人的才智难道不如古人，把责任收到“人主不交”五个字上。中间用“可乎”把话锋转向自己，等于当众承认不能只用功臣打完天下就撒手。后半不再议论，改成办事文书：谁向下传达、人送到哪里、登记哪几项、隐匿怎么处分、老病如何除外。前面的历史和自责，是为了让后面的程序显得出自真心，而不是一篇冠冕的告示。","keyContentWords":[{"word":"癃","reading":"lóng","note":"身体衰弱、腰背弯曲，常指年老多病。年老癃病，就是年老体衰、行动不便的人。"}],"keyFunctionWords":[{"word":"奚","reading":"xī","note":"疑问代词，相当于“何”。“士奚由进”是士人从哪里得到进用。"}],"ancientModern":[{"word":"大夫","note":"官职名。御史大夫是中央高官，位次在相国之下，不是今天说的医生。"},{"word":"游","note":"“从我游”是跟随我、和我共事，不是外出游玩。"}],"phoneticLoans":[{"word":"亡","loan":"无","note":"“世世奉宗庙亡绝也”的“亡”通“无”，读 wú。亡绝就是永不中断。"},{"word":"伯","loan":"霸","note":"“伯者”的“伯”通“霸”，读 bà，指诸侯中的霸主。这里与“王者”相对，不要读成 bó。"}],"flexibleUsage":[{"word":"尊显","note":"都是形容词的使动用法。“尊显之”是使他尊贵、使他显达。"}],"specialSyntax":[{"name":"宾语前置","note":"“士奚由进”里，疑问代词“奚”是“由”的宾语，按常序应说“由奚进”。疑问代词作宾语时提前。"}]},"classicComment":{"t":"高帝平日慢侮諸生、及天下旣定、乃屈意求賢、如恐不及、蓋知創業與守成異也。漢室得人、其風動固爲有本。","s":"高帝平日慢侮诸生、及天下既定、乃屈意求贤、如恐不及、盖知创业与守成异也。汉室得人、其风动固为有本。"}}
