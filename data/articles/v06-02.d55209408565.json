{"id":"v06-02","volume":6,"volumeTitle":"卷六","volumeSubtitle":"汉文","index":2,"title":{"t":"文帝議佐百姓詔","s":"文帝议佐百姓诏"},"book":{"t":"西漢文","s":"西汉文"},"sourceHead":{"t":"","s":""},"author":"西汉","annotated":true,"paragraphs":[{"sentences":[{"tr":"近来连续几年收成不好，又有水灾、旱灾和疫病，我非常忧虑。","tokens":[{"t":"間","s":"间","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"數","s":"数","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"年","s":"年","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"比","s":"比","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"登","s":"登","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"又","s":"又","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"水","s":"水","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"旱","s":"旱","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"疾","s":"疾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"疫","s":"疫","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"災","s":"灾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"朕","s":"朕","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"甚","s":"甚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"憂","s":"忧","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"我自己愚昧不明，还不明白过错究竟在哪里。","tokens":[{"t":"愚","s":"愚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"明","s":"明","py":"","ctx":"","pos":"","ext