:"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"这些细小的和重大的道理，我还没能把握到恰切的地方。","tokens":[{"t":"細","s":"细","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"大","s":"大","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"義","s":"义","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"吾","s":"吾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"未","s":"未","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"能","s":"能","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"得","s":"得","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"中","s":"中","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"希望同丞相、列侯、秩二千石的官吏和博士一起商议，凡是可以帮助百姓的办法，都要尽心作长远的考虑，不要有所隐瞒。","tokens":[{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"與","s":"与","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"丞","s":"丞","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"相","s":"相","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"列","s":"列","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"侯","s":"侯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"吏","s":"吏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"二","s":"二","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"千","s":"千","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"石","s":"石","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"博","s":"博","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"士","s":"士","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"議","s":"议","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"可","s":"可","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"佐","s":"佐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"百","s":"百","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"姓","s":"姓","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"率","s":"率","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"意","s":"意","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"遠","s":"远","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"思","s":"思","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"隱","s":"隐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"《文帝议佐百姓诏》见于《汉书·文帝纪》，是汉文帝刘恒在后元元年春天发布的。刘恒在位已经十几年，多次减收田租、提倡节俭，可是诏书承认，近几年谷物接连不能成熟，又遇上水灾、旱灾和疫病，百姓的口粮非常缺乏。他没有先把罪责派给某一级官吏，而是把政令是否失误、官俸是否太费、民间从事工商、酿酒和畜牧是否耗掉了粮食，一并交给丞相、列侯、二千石和博士讨论，请他们尽心设想可以帮助百姓的办法，不要隐瞒。","theme":"诏书追问的是一个具体的不平衡：田亩并没有更少，户口也没有大增，按人口分摊的土地比起古代还有余，为什么百姓仍然吃不饱。文帝把天时、地利、人事、鬼神、官费和民间耗谷都列成尚未判定的可能，自己说还没有弄清过错所在，也还没能抓住大小道理里真正要紧的一点。他要群臣回答的，不是空泛的灾异解说，而是哪一种缘故切中眼前的饥荒，以及什么措施真能补助百姓。","technique":"通篇几乎都用探问推进。先承认自己愚昧不明，再用“意者……与”“乃……与”“将……与”“无乃……与”把嫌疑从天子本人排到天道、鬼神、官俸和民间的末业、酒醪、六畜。句子长，落点却窄，几次都收在民食缺少和“其咎安在”上。直到最后才用“其与……议之”转成命令，并加上“率意远思，无有所隐”，允许臣下把不中听的原因直接说出来。疑问本身就是这道诏书的写法。","keyContentWords":[{"word":"登","reading":"dēng","note":"谷物成熟。比不登，就是接连歉收。"},{"word":"末","reading":"mò","note":"相对农耕这个“本”而言，指工商业。从事于末，就是去经营工商。"},{"word":"度","reading":"duó","note":"丈量、测算。度田是丈量田亩，这里不要读成 dù。"}],"keyFunctionWords":[{"word":"比","reading":"bì","note":"接连、频繁。数年比不登，是连续几年没有收成，不要读成 bǐ。"},{"word":"夫","reading":"fú","note":"句首语气词，提起下面的推论，没有实在意义。"}],"ancientModern":[{"word":"博士","note":"秦汉官名，掌通晓古今、备皇帝顾问，不是现代的学位。"}],"phoneticLoans":[{"word":"与","loan":"欤","note":"句末的“与”通“欤”，读 yú，表示疑问。政有所失……与、鬼神废不享与、六畜之食焉者众与，都是这种用法。"}],"flexibleUsage":[{"word":"食","note":"“六畜之食焉者”的“食”读 sì，是喂养。这句话是说饲养马、牛、羊、猪、狗、鸡的人太多。"}],"specialSyntax":[{"name":"宾语前置","note":"“其咎安在”等于“其咎在安”。疑问代词“安”作“在”的宾语，提到动词前面，意思是过错在哪里。"}]},"classicComment":{"t":"帝在位日久、佐民未嘗不至。至是復議佐之之策、可見其愛民之心、愈久而不忘也。","s":"帝在位日久、佐民未尝不至。至是复议佐之之策、可见其爱民之心、愈久而不忘也。"}}
