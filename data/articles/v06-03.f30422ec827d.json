耕田，皇后亲自采桑养蚕，用来供给宗庙的祭粮和祭服，给天下人做出表率。","tokens":[{"t":"朕","s":"朕","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"親","s":"亲","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"耕","s":"耕","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"后","s":"后","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"親","s":"亲","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"桑","s":"桑","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"奉","s":"奉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"宗","s":"宗","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"廟","s":"庙","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"粢","s":"粢","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"盛","s":"盛","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"祭","s":"祭","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"服","s":"服","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"天","s":"天","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"下","s":"下","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"先","s":"先","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"不接受贡品，削减太官掌管的膳食，减轻徭役和赋税，希望天下人专心农耕蚕桑，平时就有积蓄，以便防备灾害。","tokens":[{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"受","s":"受","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"獻","s":"献","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"減","s":"减","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"太","s":"太","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"官","s":"官","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"省","s":"省",