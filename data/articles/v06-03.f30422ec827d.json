","s":"伪","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"吏","s":"吏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"吏","s":"吏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"貨","s":"货","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"賂","s":"赂","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"市","s":"市","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"漁","s":"渔","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"奪","s":"夺","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"百","s":"百","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"姓","s":"姓","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"侵","s":"侵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"牟","s":"牟","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"萬","s":"万","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"民","s":"民","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"县丞是县里地位较高的官吏，却违法乱纪，去帮助盗贼做偷窃的事，实在太没有道理。","tokens":[{"t":"縣","s":"县","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"丞","s":"丞","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"長","s":"长","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"吏","s":"吏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"姦","s":"奸","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"法","s":"法","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"與","s":"与","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"盜","s":"盗","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"盜","s":"盗","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"甚","s":"甚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"謂","s":"谓","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"现在命令秩二千石的官员，各自整顿自己的职事。","tokens":[{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"令","s":"令","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"二","s":"二","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"千","s":"千","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"石","s":"石","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"各","s":"各","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"修","s":"修","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"職","s":"职","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"不履行职守、昏乱失职的，丞相要上报给我，请求定他们的罪。","tokens":[{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"事","s":"事","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"官","s":"官","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"職","s":"职","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"耗","s":"耗","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"亂","s":"乱","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"丞","s":"丞","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"相","s":"相","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"聞","s":"闻","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"請","s":"请","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"罪","s":"罪","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"向天下公布，让人们明白我的心意。","tokens":[{"t":"布","s":"布","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"告","s":"告","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"天","s":"天","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"下","s":"下","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"使","s":"使","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"明","s":"明","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"知","s":"知","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"朕","s":"朕","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"意","s":"意","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"《景帝令二千石修职诏》见于《汉书·景帝纪》，是汉景帝刘启在后二年夏四月颁布的。景帝上承文帝，仍把农桑看作衣食的根本。后二年收成不好，这年春天还因为歉收，禁止内郡用粮食喂马。四月的诏书先从奢侈说起：器物上雕花刻镂会占去农时，锦绣和丝带会占去妇女的纺织。接着他把百姓缺粮的原因追到官吏身上，指出有人靠欺诈做官，把贿赂当交易，县丞本是一县的长吏，却执法而与盗同行。","theme":"景帝的意思是，饥饿和寒冷同时压来，百姓就很难不去做违法的事，所以防饥寒必须先保护农时和女工。皇帝亲耕、皇后亲桑，不受献、减膳食、省徭赋，都是要朝廷自己先站到农桑一边，并让强者不夺弱者、人多者不欺人少、老人能寿终、孤儿能长大。当年粮食短少，他认为过错不在这些礼数没有讲过，而在贪吏和失职的县丞。因此命令郡守、诸侯相这一级各自整顿职事，昏乱不任职的由丞相上报治罪。","technique":"开头用两组整齐的对句，把雕文刻镂接到饥饿，把锦绣纂组接到寒冷，因果写得很直。接着插入皇帝亲耕、皇后亲桑，让发布命令的人先进入他要求天下遵守的秩序。写到当年歉收，文句忽然变硬，渔夺、侵牟、与盗盗都不再留余地。结尾恢复诏令的套式，指定二千石修职，由丞相举奏，再用“使明知朕意”收住。前半讲本业为什么不能伤，后半专治吏，中间用饥寒则民易为非把两段接起来。","keyContentWords":[{"word":"纂组","reading":"zuǎn zǔ","note":"彩色的丝绦、绶带。锦绣纂组连言，指精美而费工的丝织品。"},{"word":"侵牟","reading":"qīn móu","note":"侵夺、贪取。侵牟万民，就是剥削广大百姓。"}],"keyFunctionWords":[{"word":"夫","reading":"fú","note":"句首语气词，引出“饥寒并至”这一层推论。"}],"ancientModern":[{"word":"二千石","note":"用俸禄等级称呼官员。汉朝郡守、诸侯相一类长官秩二千石，不是说两千块石头。"},{"word":"颇","note":"“民食颇寡”的“颇”是程度深，相当于“很”，不是后来常说的“稍微”。"}],"phoneticLoans":[{"word":"红","loan":"工","note":"“女红”的“红”通“工”，读 gōng。女红就是女工，指妇女采桑、纺织、缝纫。"},{"word":"繇","loan":"徭","note":"“省繇赋”的“繇”通“徭”，读 yáo。繇赋是徭役和赋税。"},{"word":"畜","loan":"蓄","note":"“素有畜积”的“畜”通“蓄”，读 xù。畜积就是平时的积蓄。"},{"word":"耗","loan":"眊","note":"“耗乱”的“耗”通“眊”，读 mào，意思是昏昧。耗乱是糊涂昏乱，不是耗费。"}],"flexibleUsage":[{"word":"先","note":"“为天下先”的“先”用作动词，意思是做表率、走在前面。"},{"word":"盗","note":"“与盗盗”里前一个“盗”是名词，指盗贼；后一个“盗”用作动词，指偷窃。合起来是帮助盗贼去偷。"}],"specialSyntax":[]},"classicComment":{"t":"一念奢侈、飢寒立至、起手數言、窮極原委。姦法與盜盜一語、透盡千古利弊。國家最患在吏飽、府庫空虛、百姓窮困、而奸吏自富、此大害也。二千石修職、誠足民本務。","s":"一念奢侈、饥寒立至、起手数言、穷极原委。奸法与盗盗一语、透尽千古利弊。国家最患在吏饱、府库空虚、百姓穷困、而奸吏自富、此大害也。二千石修职、诚足民本务。"}}
