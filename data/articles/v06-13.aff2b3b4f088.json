:"降","s":"降","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"高","s":"高","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"帝","s":"帝","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"詔","s":"诏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"衛","s":"卫","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"尉","s":"尉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"聽","s":"听","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"仇","s":"仇","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"張","s":"张","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"步","s":"步","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"前","s":"前","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"亦","s":"亦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"殺","s":"杀","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"伏","s":"伏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"隆","s":"隆","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"若","s":"若","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"步","s":"步","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"來","s":"来","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"歸","s":"归","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"命","s":"命","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"吾","s":"吾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"當","s":"当","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"詔","s":"诏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"大","s":"大","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"司","s":"司","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"徒","s":"徒","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"釋","s":"释","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"怨","s":"怨","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"又","s":"又","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"事","s":"事","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"尤","s":"尤","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"相","s":"相","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"類","s":"类","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"将军从前在南阳提出这个大计，我常常觉得它疏阔、难以实现；有志向的人，事情终究会成功。","tokens":[{"t":"將","s":"将","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"軍","s":"军","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"前","s":"前","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"在","s":"在","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"南","s":"南","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"陽","s":"阳","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"建","s":"建","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"此","s":"此","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"大","s":"大","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"策","s":"策","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"常","s":"常","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"落","s":"落","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"落","s":"落","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"難","s":"难","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"合","s":"合","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"志","s":"志","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"事","s":"事","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"竟","s":"竟","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"成","s":"成","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"这篇是光武帝刘秀在临淄慰劳耿弇的一段话，出自《后汉书·耿弇传》。建武五年，耿弇连破张步的军队，攻下祝阿，追到临淄，张步来攻，被打得大败。光武帝亲自到军中，当着群臣把耿弇和汉初的韩信放在一起称赞。说话时张步尚未最终归顺，所以后半又用高祖处理田横旧怨的办法，预先解开伏氏的仇隙。","theme":"这段话的中心是肯定耿弇平齐的功劳，并鼓励他把事情做完。历下和祝阿同在齐地西界，韩信与耿弇的战功因此可以相比；但韩信打的是已经接受劝降的军队，耿弇打的是未降的强敌，所以更难。田横杀郦生、张步杀伏隆，旧恨都可能挡住受降。光武帝答应由自己下诏消怨，是在夸奖之外给收兵留出路。最后一句把当初看来难合的南阳之策，收成有志者终能成功。","technique":"全文几乎全是当面的比较，没有战场细节。先以韩信破历下对耿弇攻祝阿，地点都落在齐之西界，功绩才站得住。接着用“袭击已降”对“独拔勍敌”，把表面的相似改成高下。再以田横、郦生对张步、伏隆，高帝的诏令对光武帝自己将下的诏令，历史被拿来作即将实行的政策。末句先承认自己曾经认为大策落落难合，再以有志者事竟成翻过来说，赞许里含着自责。","keyContentWords":[{"word":"劳军","reading":"lào jūn","note":"慰劳军队。劳读 lào。车驾自劳军，是光武帝亲自到临淄军中，不是派使者。"},{"word":"历下","reading":"lì xià","note":"齐地城邑，在齐的西部。韩信攻破历下，是汉初开辟齐地的一仗。"},{"word":"祝阿","reading":"zhù ē","note":"齐地西界的城邑。耿弇攻张步，先从祝阿打开局面，所以说攻祝阿以发迹。"},{"word":"勍敌","reading":"qíng dí","note":"强敌。独拔勍敌，是说耿弇攻下的是尚未投降的劲敌，与韩信袭击已降不同。"},{"word":"归命","reading":"guī mìng","note":"把性命交给对方，即归顺。若步来归命，是假设张步前来投降。"},{"word":"落落","reading":"luò luò","note":"疏阔、难以与实情相合的样子。落落难合，是光武帝当初觉得南阳大策不容易实现。"}],"keyFunctionWords":[{"word":"以","reading":"yǐ","note":"“破历下以开基”“攻祝阿以发迹”的以连接前后两事，表示由此、从而。"},{"word":"乃","reading":"nǎi","note":"“其功乃难于信也”的乃是加强判断，这功劳确实比韩信更难。"},{"word":"若","reading":"ruò","note":"如果。“若步来归命”，下面诏大司徒释怨还没有发生，只是预先说明。"},{"word":"尤","reading":"yóu","note":"更加。“又事尤相类也”，田横与张步的旧怨，比历下和祝阿那一层更加相像。"}],"ancientModern":[{"word":"车驾","note":"本篇用来代指皇帝本人。车驾至临淄，就是光武帝到了临淄。今义多指车辆驾驶。"},{"word":"发迹","note":"这里是兴起功业、打开局面。今义多指由贫贱变得富贵。"},{"word":"方","note":"“功足相方”的方是比较。今义多指方向、方形或方才。"},{"word":"听","note":"“不听为仇”的听是允许。诏卫尉不听为仇，是不准他报仇。今义多指用耳朵听。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"劳","note":"“自劳军”的劳读 lào，用作动词，慰劳。主语是皇帝自己。"},{"word":"方","note":"“功足相方”的方用作动词，相比、对照。"},{"word":"释","note":"“释其怨”的释用作动词，放开、消除。怨本是名词，这里被释支配。"}],"specialSyntax":[{"name":"比较句","note":"“其功乃难于信也”，用“难于”把耿弇的功劳和韩信比较，结论是耿弇更难。"},{"name":"假设句","note":"“若步来归命，吾当诏大司徒释其怨”，用若和当配合，先说条件，再说自己将做的事。"},{"name":"对举","note":"韩信与将军、历下与祝阿、田横与张步、卫尉与大司徒两两相对，赞语全靠对举推进。"}]},"classicComment":{"t":"前一段、表弇之功。末一段、佳弇之志。中間將自己處張步、與高帝處田橫、比方一番、以動步歸誠之意。英主作用、全在此數語。","s":"前一段、表弇之功。末一段、佳弇之志。中间将自己处张步、与高帝处田横、比方一番、以动步归诚之意。英主作用、全在此数语。"}}
