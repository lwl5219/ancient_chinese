s":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"未","s":"未","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"嘗","s":"尝","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"臨","s":"临","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"文","s":"文","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"嗟","s":"嗟","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"悼","s":"悼","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"能","s":"能","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"喻","s":"喻","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"懷","s":"怀","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"由此确实知道，把死和生看成一样是虚妄的，把长寿和短命等同起来是胡乱的说法。","tokens":[{"t":"固","s":"固","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"知","s":"知","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"一","s":"一","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"死","s":"死","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"生","s":"生","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"虛","s":"虚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"誕","s":"诞","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"齊","s":"齐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"彭","s":"彭","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"殤","s":"殇","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"妄","s":"妄","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"作","s":"作","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"后人看现在，也就像现在的人看从前，可悲啊。","tokens":[{"t":"後","s":"后","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"視","s":"视","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"今","s":"今","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"亦","s":"亦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"猶","s":"犹","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"今","s":"今","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"視","s":"视","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"昔","s":"昔","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"悲","s":"悲","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"夫","s":"夫","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"所以逐一记下当时的人，录下他们所写的文字。虽然时代不同、事情各异，引发感怀的原因，那情致是一样的。","tokens":[{"t":"故","s":"故","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"列","s":"列","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"敘","s":"叙","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"時","s":"时","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"錄","s":"录","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"述","s":"述","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"雖","s":"虽","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"世","s":"世","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"殊","s":"殊","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"事","s":"事","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"異","s":"异","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"興","s":"兴","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"懷","s":"怀","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"致","s":"致","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"一","s":"一","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"后来阅读的人，也将对这篇文章有所感触。","tokens":[{"t":"後","s":"后","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"覽","s":"览","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"亦","s":"亦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"將","s":"将","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"感","s":"感","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"斯","s":"斯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"文","s":"文","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"东晋穆帝永和九年是癸丑年，三月初三，王羲之和谢安、孙绰等四十多人在会稽山阴的兰亭举行修禊，临流饮酒赋诗，事后把诗集中起来，王羲之写了这篇序。原文开头还有永和九年一句，这里的断句从岁在癸丑起。会稽山阴在今浙江绍兴一带。修禊本是临水洗去不祥的旧俗，到这一天已经变成名士聚会和诗文之事。","theme":"序文从聚会的快乐写到生命的短暂。山水、清流、一觞一咏都真实可喜，可是欣于所遇只能暂得于己，所爱很快变成陈迹，寿命又随造化归于尽。作者不接受把生死看成一样、把彭祖和夭折看成等同的说法，认为死生是大事，悲痛无法用道理取消。记下与会者和他们的诗，是要让后来的人在不同的时代里碰到同样的感怀。","technique":"前半是记游，地点、人物、山水、天气依次展开，仰观俯察把视线从宴集拉到宇宙，乐字到信可乐也就到了顶点。后半用夫人之相与一转，两种活法并举，却同样逃不过厌倦和老去。句式从短促的景语变成层层推进的长句，向之所欣、犹不能、况修短，一步比一步重。结尾列叙时人、录其所述，把眼前的诗集说成后人仍会读懂的理由，序和集因此扣在一起。","keyContentWords":[{"word":"修禊","reading":"xiū xì","note":"三月上巳临水举行的祓除活动，人们临流盥洗，祈求除去不祥。这里同时是兰亭聚会的由头。"},{"word":"流觞","reading":"liú shāng","note":"把酒杯放在弯曲的水上，漂到谁面前谁就取杯饮酒。曲水就是引来的弯渠。"},{"word":"其次","reading":"qí cì","note":"它的旁边，指曲水岸边。列坐其次，即依次坐在水边，不是后世的第二。"},{"word":"晤言","reading":"wù yán","note":"面对面交谈。晤是相遇、相对。"},{"word":"形骸","reading":"xíng hái","note":"身体、形体。放浪形骸之外，是摆脱形体礼法的拘束。"},{"word":"陈迹","reading":"chén jì","note":"旧事、过去的痕迹。向之所欣已为陈迹，是说刚才还喜爱的转眼成了往事。"},{"word":"彭殇","reading":"Péng shāng","note":"彭是彭祖，传说中的长寿者；殇是未成年而亡。齐彭殇，即把长寿和短命看成一样。"},{"word":"契","reading":"qì","note":"符契。若合一契，是说古人和今人感慨的缘由像两半符节合在一起。"}],"keyFunctionWords":[{"word":"所以","reading":"suǒ yǐ","note":"用来。所以游目骋怀，是借仰观俯察来放眼抒怀，不是后世的因此。"},{"word":"曾","reading":"zēng","note":"竟然。曾不知老之将至，强调快乐时完全想不到衰老。"},{"word":"之","reading":"zhī","note":"所之既倦的之是动词，往、追求。与前后作代词、助词的之不同。"},{"word":"固","reading":"gù","note":"本来、确实。固知一死生为虚诞，是说这种齐同生死的说法确实靠不住。"},{"word":"夫","reading":"fú","note":"悲夫的夫是句末语气词，加强感叹。夫人之相与的夫则是句首发语词，也读 fú。"}],"ancientModern":[{"word":"其次","note":"古：这里指曲水旁边的地方。今：多指次序上的第二。"},{"word":"所以","note":"古：可以是用来。所以游目骋怀即用来放眼抒怀。今：所以多表示结果。"},{"word":"期","note":"终期于尽的期，是期望、最终落到。今：期多指日期、期限。这里读 qī。"},{"word":"一","note":"一死生的一是动词，把不同的看成同样。今：一多作数词。"}],"phoneticLoans":[{"word":"俛","loan":"俯","note":"俛仰之间的俛，通俯，低头。俛仰就是一低头一抬头，形容时间极短。"}],"flexibleUsage":[{"word":"一","note":"一死生：数词作动词，把死和生看成一样。下文齐彭殇的齐，同样是等同起来。"},{"word":"极","note":"极视听之娱：形容词作动词，穷尽。"},{"word":"齐","note":"齐彭殇：形容词作动词，使等同、看作同等。"}],"specialSyntax":[{"name":"判断句","note":"修禊事也、信可乐也，用也说明聚会的目的和快乐的判断。"},{"name":"状语后置","note":"会于会稽山阴之兰亭，于字短语后置，即在会稽山阴的兰亭聚会。"},{"name":"定语后置","note":"仰观宇宙之大，俯察品类之盛。之大、之盛把形容词放在中心语后面，强调宇宙的大、品类的盛。"}]},"classicComment":{"t":"通篇著眼在死生二字。只爲當時士大夫、務清談、鮮實效、一死生而齊彭殤、無經濟大略、故觸景興懷、俯仰若有餘痛。但逸少曠達人、故雖蒼涼感歎之中、自有無窮逸趣。","s":"通篇著眼在死生二字。只为当时士大夫、务清谈、鲜实效、一死生而齐彭殇、无经济大略、故触景兴怀、俯仰若有余痛。但逸少旷达人、故虽苍凉感叹之中、自有无穷逸趣。"}}
