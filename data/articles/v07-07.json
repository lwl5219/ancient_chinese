":"","pos":"","extra":"","level":"dict"},{"t":"任","s":"任","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"擇","s":"择","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"善","s":"善","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"從","s":"从","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"那么有智慧的人献出全部谋略，勇敢的人使尽全部力气，仁爱的人播散他的恩惠，诚信的人献出他的忠诚。","tokens":[{"t":"則","s":"则","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"智","s":"智","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"盡","s":"尽","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"謀","s":"谋","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"勇","s":"勇","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"竭","s":"竭","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"力","s":"力","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"仁","s":"仁","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"播","s":"播","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"惠","s":"惠","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"信","s":"信","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"效","s":"效","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"忠","s":"忠","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"文臣武将一起使用，君主垂衣拱手就能治理天下。","tokens":[{"t":"文","s":"文","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"武","s":"武","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"並","s":"并","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"用","s":"用","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"垂","s":"垂","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"拱","s":"拱","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"治","s":"治","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"何必劳神苦苦思索，去代替百官做他们的职事呢。","tokens":[{"t":"何","s":"何","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"必","s":"必","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"勞","s":"劳","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"神","s":"神","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"苦","s":"苦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"思","s":"思","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"代","s":"代","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"百","s":"百","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"司","s":"司","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"職","s":"职","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"役","s":"役","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"哉","s":"哉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"魏徵字玄成，早年随瓦岗军，后事隐太子李建成。玄武门之变以后，唐太宗仍然留用他，朝堂上多次当面争辩。贞观中期，天下比隋末安定，宫室、巡游和赏罚也比开国时更容易放纵。这篇疏不从某一件工程说起，而从树木和水流说到国家：根不牢，树不会高；源不深，流不会远；德义不厚，国家不会安。他担心君主在忧患里还能竭诚待人，一旦得志就傲视臣下，再用严刑压住表面的恭敬。十思就是对着这种转变列出的十个回头处。","theme":"全文的重心在思，所思的是德义，是知人、纳谏和节制自己。前半用根、源和舟三个比喻，说明天下取得之后仍会失去，原因常常出在得志以后以傲待人。远隔的胡越可以因诚意结成一体，骨肉也可以因傲气变成路人；严刑只能让人苟且免罪，不能让人从心里归服。后半十思，分别对着欲望、兴建、高位、自满、田猎、懈怠、蒙蔽、谗邪、奖赏和刑罚。结句说不必代替百官劳神，是把思从琐碎事务里拉出来，交给选人和从善。","technique":"开头三个必字排成一组，马上用源不深、根不固、德不厚翻成否定，使正面的道理先受一次检验。写历代君主，只用善始者实繁、克终者盖寡作对照，不铺陈史事。十思每句都是则思，条件在前，念头在后，读起来像十条可以对照的戒律，又始终连着前面的根和源。结尾连用智、勇、仁、信四种人，把君主的思转到用人上，再用垂拱而治收住。何必劳神苦思说明想对了地方，就不必侵占百官的职事。","keyContentWords":[{"word":"浚","reading":"jùn","note":"疏浚，挖深。欲流之远者，必浚其泉源。"},{"word":"长","reading":"zhǎng","note":"生长，长高。求木之长者的长，读上声，指树木长大。"},{"word":"神器","reading":"shén qì","note":"帝位。人君当神器之重，君主承担皇位的重任。当，读 dāng，主持。"},{"word":"殷忧","reading":"yīn yōu","note":"深重的忧患。殷，深。在忧患中，君主才会竭诚待下。"},{"word":"董","reading":"dǒng","note":"监督。董之以严刑，用严刑去督责百姓。"},{"word":"盘游","reading":"pán yóu","note":"游乐，这里指打猎。三驱是围猎时网开一面，用来作为节制的限度。"},{"word":"谦冲","reading":"qiān chōng","note":"谦虚平和。自牧，自我修养。牧，养。语意近于易经所说的卑以自牧。"},{"word":"垂拱","reading":"chuí gǒng","note":"垂下衣裳，拱着手。形容君主不必亲自包办事务，天下仍然能治理。"},{"word":"九得","reading":"jiǔ dé","note":"从十思中得到的诸多好处。宏，发扬。本文作九得，有人把它理解成九德，字面上仍是得。"}],"keyFunctionWords":[{"word":"以","reading":"yǐ","note":"戒奢以俭、知足以自戒：用。无以怒而滥刑：因为。"},{"word":"则","reading":"zé","note":"就。十思各句都用则思把条件和念头接上。"},{"word":"盖","reading":"gài","note":"大概，表示推断。克终者盖寡。盖在殷忧，也是推原原因。"},{"word":"所","reading":"suǒ","note":"恩所加、罚所及，指恩惠加到的地方、刑罚落到的地方。"},{"word":"何必","reading":"hé bì","note":"为什么一定要。何必劳神苦思，反问不必代行百官的职事。"}],"ancientModern":[{"word":"根本","note":"古：树根。必固其根本。今：多指事物的基础、源头，也可以仍指树根。"},{"word":"景","note":"古：承天景命的景，大。景命就是上天的大命。今：景多指景色。"},{"word":"人","note":"古：可畏惟人、以安人的人，指百姓。唐代避太宗李世民的名，常把民写作人。今：人泛指人类。"},{"word":"作","note":"古：将有作，兴建宫室一类的事。今：作多指做、写作。"},{"word":"简","note":"古：简能而任之，选拔。今：简多指简单、书简。"}],"phoneticLoans":[{"word":"振","loan":"震","note":"振之以威怒。振读 zhèn，通震，震慑、威吓。"}],"flexibleUsage":[{"word":"固","note":"必固其根本：形容词使动，使根基牢固。"},{"word":"下","note":"江海下百川：方位名词作动词，处在百川的下游。"},{"word":"安","note":"知止以安人：形容词使动，使百姓安宁。"},{"word":"宏","note":"宏兹九得：形容词使动，使这些收获得到发扬。"},{"word":"正","note":"正身以黜恶：形容词作动词，端正自身。"}],"specialSyntax":[{"name":"省略","note":"竭诚，则胡越为一体，省去主语人君。傲物，则骨肉为行路，同样省去主语。"},{"name":"反问","note":"岂取之易、守之难乎。何必劳神苦思、代百司之职役哉。两处反问把话从表面的难易转到君主自己的念头。"},{"name":"判断句","note":"斯亦伐根以求木茂、塞源而欲流长也。也表判断，把不居安思危说成砍根堵源。"}]},"classicComment":{"t":"通篇只重一思字、却要從德義上看出。世主何嘗不勞神苦思、但所思不在德義、則反不如不用思者之爲得也。魏公十思之論、剴切深厚、可與三代謨誥並傳。","s":"通篇只重一思字、却要从德义上看出。世主何尝不劳神苦思、但所思不在德义、则反不如不用思者之为得也。魏公十思之论、剀切深厚、可与三代谟诰并传。"}}
