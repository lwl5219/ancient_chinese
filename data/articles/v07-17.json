{"id":"v07-17","volume":7,"volumeTitle":"卷七","volumeSubtitle":"六朝唐文","index":17,"title":{"t":"獲麟解","s":"获麟解"},"book":{"t":"韓愈","s":"韩愈"},"sourceHead":{"t":"","s":""},"author":"韩愈","annotated":true,"paragraphs":[{"sentences":[{"tr":"麒麟作为一种灵兽，是明明白白的。","tokens":[{"t":"麟","s":"麟","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"靈","s":"灵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"昭","s":"昭","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"昭","s":"昭","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"它被《诗》歌咏，被《春秋》记载，又散见于史传和百家的书里，即使妇女和小孩，都知道它是祥瑞。","tokens":[{"t":"詠","s":"咏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"詩","s":"诗","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"書","s":"书","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"春","s":"春","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"秋","s":"秋","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"雜","s":"杂","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"出","s":"出","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"傳","s":"传","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"記","s":"记","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"百","s":"百","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"家","s":"家","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"書","s":"书","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"雖","s":"虽","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"婦","s":"妇","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"小","s":"小","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"皆","s":"皆","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"知","s":"知","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"祥","s":"祥","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"然而麒麟这种动物，不在家里畜养，不常在世上出现，它的形貌也和别的兽不同，不像马、牛、狗、猪、豺、狼、麋、鹿那样。","tokens":[{"t":"然","s":"然","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"麟","s":"麟","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"物","s":"物","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"畜","s":"畜","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"家","s":"家","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"恆","s":"恒","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"天","s":"天","py":"","ctx":"","pos":"","extra":"","leve