{"id":"v07-18","volume":7,"volumeTitle":"卷七","volumeSubtitle":"六朝唐文","index":18,"title":{"t":"雜說一","s":"杂说一"},"book":{"t":"韓愈","s":"韩愈"},"sourceHead":{"t":"","s":""},"author":"韩愈","annotated":true,"paragraphs":[{"sentences":[{"tr":"龙吹气变成云，云本来并不比龙更灵异。","tokens":[{"t":"龍","s":"龙","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"噓","s":"嘘","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"氣","s":"气","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"成","s":"成","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"雲","s":"云","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"雲","s":"云","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"固","s":"固","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"弗","s":"弗","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"靈","s":"灵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"龍","s":"龙","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"可是龙乘着这股云气，在辽阔的天空里游到尽头，迫近太阳和月亮，遮住光辉，使雷电震动，使变化显出神妙，把雨水降到大地，淹没山陵溪谷，云也就灵异得出奇了。","tokens":[{"t":"然","s":"然","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"龍","s":"龙","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乘","s":"乘","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"是","s":"是","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"氣","s":"气","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"茫","s":"茫","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"洋","s":"洋","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"窮","s":"穷","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乎","s":"乎","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"玄","s":"玄","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"間","