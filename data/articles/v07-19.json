":"美","py":"","ctx":"美。","pos":"","extra":"","level":"sentence"},{"t":"不","s":"不","py":"","ctx":"表示否定。","pos":"","extra":"","level":"sentence"},{"t":"外","s":"外","py":"","ctx":"外面。","pos":"","extra":"","level":"sentence"},{"t":"見","s":"见","py":"","ctx":"看见。有时同“现”，表示出现；有时表示被。","pos":"","extra":"","level":"sentence"},{"t":"、","s":"、","punct":true},{"t":"且","s":"且","py":"","ctx":"况且，或将要。","pos":"","extra":"","level":"sentence"},{"t":"欲","s":"欲","py":"","ctx":"想要。","pos":"","extra":"","level":"sentence"},{"t":"與","s":"与","py":"","ctx":"和、跟。句末有时同“欤”，表示疑问。","pos":"","extra":"","level":"sentence"},{"t":"常","s":"常","py":"","ctx":"经常，或普通。","pos":"","extra":"","level":"sentence"},{"t":"馬","s":"马","py":"","ctx":"马。","pos":"","extra":"","level":"sentence"},{"t":"等","s":"等","py":"","ctx":"等、同样。","pos":"","extra":"","level":"sentence"},{"t":"不","s":"不","py":"","ctx":"表示否定。","pos":"","extra":"","level":"sentence"},{"t":"可","s":"可","py":"","ctx":"可以、能够。","pos":"","extra":"","level":"sentence"},{"t":"得","s":"得","py":"","ctx":"得到，或能够。","pos":"","extra":"","level":"sentence"},{"t":"、","s":"、","punct":true},{"t":"安","s":"安","py":"","ctx":"哪里，或安定。","pos":"","extra":"","level":"sentence"},{"t":"求","s":"求","py":"","ctx":"寻求。","pos":"","extra":"","level":"sentence"},{"t":"其","s":"其","py":"","ctx":"他的、它的，或那。","pos":"","extra":"","level":"sentence"},{"t":"能","s":"能","py":"","ctx":"能够。","pos":"","extra":"","level":"sentence"},{"t":"千","s":"千","py":"","ctx":"千。","pos":"","extra":"","level":"sentence"},{"t":"里","s":"里","py":"","ctx":"里面，或长度单位。","pos":"","extra":"","level":"sentence"},{"t":"也","s":"也","py":"","ctx":"句末语气词，表示判断或肯定。","pos":"","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"鞭策它不按照正确的方法，喂养它又不能让它的才力充分发挥，它嘶鸣时不能明白它的意思，却拿着马鞭对着它说：天下没有好马。","tokens":[{"t":"策","s":"策","py":"","ctx":"计策、鞭打。","pos":"","extra":"","level":"sentence"},{"t":"之","s":"之","py":"","ctx":"的。","pos":"","extra":"","level":"sentence"},{"t":"不","s":"不","py":"","ctx":"表示否定。","pos":"","extra":"","level":"sentence"},{"t":"以","s":"以","py":"","ctx":"用、拿。","pos":"","extra":"","level":"sentence"},{"t":"其","s":"其","py":"","ctx":"他的、它的，或那。","pos":"","extra":"","level":"sentence"},{"t":"道","s":"道","py":"","ctx":"道路，或道理、学说。","pos":"","extra":"","level":"sentence"},{"t":"、","s":"、","punct":true},{"t":"食","s":"食","py":"","ctx":"吃，或食物。","pos":"","extra":"","level":"sentence"},{"t":"之","s":"之","py":"","ctx":"的。","pos":"","extra":"","level":"sentence"},{"t":"不","s":"不","py":"","ctx":"表示否定。","pos":"","extra":"","level":"sentence"},{"t":"能","s":"能","py":"","ctx":"能够。","pos":"","extra":"","level":"sentence"},{"t":"盡","s":"尽","py":"","ctx":"完、全部。","pos":"","extra":"","level":"sentence"},{"t":"其","s":"其","py":"","ctx":"他的、它的，或那。","pos":"","extra":"","level":"sentence"},{"t":"材","s":"材","py":"","ctx":"木材、才能。","pos":"","extra":"","level":"sentence"},{"t":"、","s":"、","punct":true},{"t":"鳴","s":"鸣","py":"","ctx":"鸣叫。","pos":"","extra":"","level":"sentence"},{"t":"之","s":"之","py":"","ctx":"的。","pos":"","extra":"","level":"sentence"},{"t":"而","s":"而","py":"","ctx":"却。","pos":"","extra":"","level":"sentence"},{"t":"不","s":"不","py":"","ctx":"表示否定。","pos":"","extra":"","level":"sentence"},{"t":"能","s":"能","py":"","ctx":"能够。","pos":"","extra":"","level":"sentence"},{"t":"通","s":"通","py":"","ctx":"通、沟通。","pos":"","extra":"","level":"sentence"},{"t":"其","s":"其","py":"","ctx":"他的、它的，或那。","pos":"","extra":"","level":"sentence"},{"t":"意","s":"意","py":"","ctx":"意思、心意。","pos":"","extra":"","level":"sentence"},{"t":"、","s":"、","punct":true},{"t":"執","s":"执","py":"","ctx":"拿着。","pos":"","extra":"","level":"sentence"},{"t":"策","s":"策","py":"","ctx":"计策、鞭打。","pos":"","extra":"","level":"sentence"},{"t":"而","s":"而","py":"","ctx":"就、然后。连接两个动作或两种性状。","pos":"","extra":"","level":"sentence"},{"t":"臨","s":"临","py":"","ctx":"面对、来到。","pos":"","extra":"","level":"sentence"},{"t":"之","s":"之","py":"","ctx":"的。","pos":"","extra":"","level":"sentence"},{"t":"曰","s":"曰","py":"","ctx":"说，或叫做。","pos":"","extra":"","level":"sentence"},{"t":"、","s":"、","punct":true},{"t":"天","s":"天","py":"","ctx":"天空。也指自然界或上天。","pos":"","extra":"","level":"sentence"},{"t":"下","s":"下","py":"","ctx":"下面、往下，或地位低的一方。","pos":"","extra":"","level":"sentence"},{"t":"無","s":"无","py":"","ctx":"没有。","pos":"","extra":"","level":"sentence"},{"t":"馬","s":"马","py":"","ctx":"马。","pos":"","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"唉！难道真的没有千里马吗？其实是真的不识马啊。","tokens":[{"t":"嗚","s":"呜","py":"","ctx":"呜咽、哀叹。","pos":"","extra":"","level":"sentence"},{"t":"呼","s":"呼","py":"","ctx":"喊。","pos":"","extra":"","level":"sentence"},{"t":"、","s":"、","punct":true},{"t":"其","s":"其","py":"","ctx":"他的、它的，或那。","pos":"","extra":"","level":"sentence"},{"t":"真","s":"真","py":"","ctx":"真。","pos":"","extra":"","level":"sentence"},{"t":"無","s":"无","py":"","ctx":"没有。","pos":"","extra":"","level":"sentence"},{"t":"馬","s":"马","py":"","ctx":"马。","pos":"","extra":"","level":"sentence"},{"t":"邪","s":"邪","py":"","ctx":"不正当。句末语气词读 yé。","pos":"","extra":"","level":"sentence"},{"t":"、","s":"、","punct":true},{"t":"其","s":"其","py":"","ctx":"他的、它的，或那。","pos":"","extra":"","level":"sentence"},{"t":"真","s":"真","py":"","ctx":"真。","pos":"","extra":"","level":"sentence"},{"t":"不","s":"不","py":"","ctx":"表示否定。","pos":"","extra":"","level":"sentence"},{"t":"知","s":"知","py":"","ctx":"知道、了解。有时同“智”。","pos":"","extra":"","level":"sentence"},{"t":"馬","s":"马","py":"","ctx":"马。","pos":"","extra":"","level":"sentence"},{"t":"也","s":"也","py":"","ctx":"句末语气词，表示判断或肯定。","pos":"","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"《杂说四》是韩愈《杂说》的第四首，收在《昌黎先生集》，后人习称《马说》。伯乐是春秋时秦人孙阳，以相马出名，后来就用这个名字指能识别良马的人。韩愈于贞元八年进士及第，其后仍长期不得意，贞元十一年曾三次上书宰相。本篇不写年月，也不指名谁人，只借喂马、相马讨论识拔。它和《获麟解》《杂说一》一样，都是以物喻人的短文。","theme":"千里马被人称作千里马，是因为有识马的人。这种马常常有，伯乐却不常有，好马便在仆役手中受屈，和普通马一起死在槽枥之间，得不到千里的名称。它一顿有时要吃一石粟，喂马的人不知道，不肯按这个食量喂。吃不饱，力气不够，长处显不出来，连普通马的程度都达不到，自然无从日行千里。驾驭不得法，喂养不尽其才，鸣叫也无人听懂，养马的人却握着鞭子说天下没有马。文章的判断是：不是没有马，是不认识马。马比喻有才能的人，伯乐比喻识才并肯按其才任用的人。","technique":"开头两句先把关系说死：有伯乐，然后才有千里马；千里马常有，伯乐不常有。以下不再写伯乐怎样相马，只写没有识者时马的下场，用受辱、骈死、不以千里称，把名称的失去说完。中间专写饲养：一食或尽粟一石是马的需要，食不饱、力不足、才美不外见是错误喂养的结果。策之、食之、鸣之三个短句把养马人的无知排齐，然后让他自己说出天下无马。末了用邪字反问，用也字判断，把无马改成不知马。比喻一直不点破。","keyContentWords":[{"word":"伯乐","reading":"Bó Lè","note":"春秋时善于相马的孙阳。这里借指能识别人才的人。"},{"word":"槽枥","reading":"cáo lì","note":"马槽和马厩。骈死于槽枥之间，是和普通马一起死在养马的地方。"},{"word":"骈","reading":"pián","note":"并列。骈死，是混在普通马中一同死去，不能单独以千里被看待。"}],"keyFunctionWords":[{"word":"安","reading":"ān","note":"怎么。安求其能千里也，表示这种要求根本不能成立。"},{"word":"只","reading":"zhǐ","note":"只是。只辱于奴隶人之手，是说好马只落得在仆役手里受屈。繁体作祇，简体作只。"}],"ancientModern":[{"word":"等","note":"等同、一样。且欲与常马等不可得，是想和普通马达到同一程度都做不到。不是等待。"},{"word":"奴隶","note":"奴隶人指喂马、役使马的仆役。只辱于奴隶人之手。范围比今天所说的奴隶窄。"}],"phoneticLoans":[{"word":"见","loan":"现","note":"才美不外见，才能和长处不能向外表现出来。这个见后来写作现。"}],"flexibleUsage":[{"word":"策","note":"策之不以其道。策本是马鞭，这里用作动词，是用鞭驱赶。下文执策的策仍是名词。"},{"word":"食","note":"食马者、食之不能尽其材。这里的食读 sì，是喂养。一食或尽粟一石、食不饱的食读 shí，是吃。"}],"specialSyntax":[{"name":"反问句","note":"安求其能千里也，用安提出不能成立的要求。其真无马邪也是反问，其真不知马也才是回答。"}]},"classicComment":{"t":"此篇以馬取喻、謂英雄豪傑、必遇知己者、尊之以高爵、養之以厚祿、任之以重權、斯可展布其材。否則英雄豪傑、亦已埋沒多矣。而但謂之天下無才、然耶否耶、甚矣、知遇之難其人也。","s":"此篇以马取喻、谓英雄豪杰、必遇知己者、尊之以高爵、养之以厚禄、任之以重权、斯可展布其材。否则英雄豪杰、亦已埋没多矣。而但谓之天下无才、然耶否耶、甚矣、知遇之难其人也。"}}