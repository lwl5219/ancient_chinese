{"id":"v07-19","volume":7,"volumeTitle":"卷七","volumeSubtitle":"六朝唐文","index":19,"title":{"t":"雜說四","s":"杂说四"},"book":{"t":"韓愈","s":"韩愈"},"sourceHead":{"t":"","s":""},"author":"韩愈","annotated":true,"paragraphs":[{"sentences":[{"tr":"世上有了伯乐，然后才有千里马。","tokens":[{"t":"世","s":"世","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"伯","s":"伯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"樂","s":"乐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"然","s":"然","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"後","s":"后","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"千","s":"千","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"里","s":"里","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"馬","s":"马","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"千里马经常有，伯乐却不经常有。","tokens":[{"t":"千","s":"千","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"里","s":"里","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"馬","s":"马","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"常","s":"常","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"伯","s":"伯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"樂","s":"乐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"常","s":"常","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"所以即使有好马，也只是在仆役手里受屈辱，和普通的马一同死在槽枥之间，不被称作千里马。","tokens":[{"t":"故","s":"故","py":"","ctx":"","pos":"","extr