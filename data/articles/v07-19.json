{"id":"v07-19","volume":7,"volumeTitle":"卷七","volumeSubtitle":"六朝唐文","index":19,"title":{"t":"雜說四","s":"杂说四"},"book":{"t":"韓愈","s":"韩愈"},"sourceHead":{"t":"","s":""},"author":"韩愈","annotated":true,"paragraphs":[{"sentences":[{"tr":"世上有了伯乐，然后才有千里马。","tokens":[{"t":"世","s":"世","py":"","ctx":"世上，或一代。","pos":"","extra":"","level":"sentence"},{"t":"有","s":"有","py":"","ctx":"有、存在。","pos":"","extra":"","level":"sentence"},{"t":"伯","s":"伯","py":"","ctx":"兄弟里的老大，或尊称。","pos":"","extra":"","level":"sentence"},{"t":"樂","s":"乐","py":"","ctx":"快乐。音乐的乐读 yuè。","pos":"","extra":"","level":"sentence"},{"t":"、","s":"、","punct":true},{"t":"然","s":"然","py":"","ctx":"这样。","pos":"","extra":"","level":"sentence"},{"t":"後","s":"后","py":"","ctx":"以后。","pos":"","extra":"","level":"sentence"},{"t":"有","s":"有","py":"","ctx":"有、存在。","pos":"","extra":"","level":"sentence"},{"t":"千","s":"千","py":"","ctx":"千。","pos":"","extra":"","level":"sentence"},{"t":"里","s":"里","py":"","ctx":"里面，或长度单位。","pos":"","extra":"","level":"sentence"},{"t":"馬","s":"马","py":"","ctx":"马。","pos":"","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"千里马经常有，伯乐却不经常有。","tokens":[{"t":"千","s":"千","py":"","ctx":"千。","pos":"","extra":"","level":"sentence"},{"t":"里","s":"里","py":"","ctx":"里面，或长度单位。","pos":"","extra":"","level":"sentence"},{"t":"馬","s":"马","py":"","ctx":"马。","pos":"","extra":"","level":"sentence"},{"t":"常","s":"常","py":"","ctx":"经常，或普通。","pos":"","extra":"","level":"sentence"},{"t":"有","s":"有","py":"","ctx":"有、存在。","pos":"","extra":"","level":"sentence"},{"t":"、","s":"、","punct":true},{"t":"而","s":"而","py":"","ctx":"就、然后。连接两个动作或两种性状。","pos":"","extra":"","level":"sentence"},{"t":"伯","s":"伯","py":"","ctx":"兄弟里的老大，或尊称。","pos":"","extra":"","level":"sentence"},{"t":"樂","s":"乐","py":"","ctx":"快乐。音乐的乐读 yuè。","pos":"","extra":"","level":"sentence"},{"t":"不","s":"不","py":"","ctx":"表示否定。","pos":"","extra":"","level":"sentence"},{"t":"常","s":"常","py":"","ctx":"经常，或普通。","pos":"","extra":"","level":"sentence"},{"t":"有","s":"有","py":"","ctx":"有、存在。","pos":"","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"所以即使有好马，也只是在仆役手里受屈辱，和普通的马一同死在槽枥之间，不被称作千里马。","tokens":[{"t":"故","s":"故","py":"","ctx":"所以。也指旧。","pos":"","extra":"","level":"sentence"},{"t":"雖","s":"虽","py":"","ctx":"虽然。","pos":"","extra":"","level":"sentence"},{"t":"有","s":"有","py":"","ctx":"有、存在。","pos":"","extra":"","level":"sentence"},{"t":"名","s":"名","py":"","ctx":"名字、名声。有时用作动词，出名。","pos":"","extra":"","level":"sentence"},{"t":"馬","s":"马","py":"","ctx":"马。","pos":"","extra":"","level":"sentence"},{"t":"、","s":"、","punct":true},{"t":"祇","s":"只","py":"","ctx":"只。","pos":"","extra":"","level":"sentence"},{"t":"辱","s":"辱","py":"","ctx":"屈辱。","pos":"","extra":"","level":"sentence"},{"t":"於","s":"于","py":"","ctx":"在、向、对。","pos":"","extra":"","level":"sentence"},{"t":"奴","s":"奴","py":"","ctx":"奴仆。","pos":"","extra":"","level":"sentence"},{"t":"隸","s":"隶","py":"","ctx":"隶属、差役。","pos":"","extra":"","level":"sentence"},{"t":"人","s":"人","py":"","ctx":"人。","pos":"","extra":"","level":"sentence"},{"t":"之","s":"之","py":"","ctx":"的。","pos":"","extra":"","level":"sentence"},{"t":"手","s":"手","py":"","ctx":"手。","pos":"","extra":"","level":"sentence"},{"t":"、","s":"、","punct":true},{"t":"駢","s":"骈","py":"","ctx":"并列。","pos":"","extra":"","level":"sentence"},{"t":"死","s":"死","py":"","ctx":"死。","pos":"","extra":"","level":"sentence"},{"t":"於","s":"于","py":"","ctx":"在、向、对。","pos":"","extra":"","level":"sentence"},{"t":"槽","s":"槽","py":"","ctx":"喂牲口的器具。","pos":"","extra":"","level":"sentence"},{"t":"櫪","s":"枥","py":"","ctx":"马槽。","pos":"","extra":"","level":"sentence"},{"t":"之","s":"之","py":"","ctx":"的。","pos":"","extra":"","level":"sentence"},{"t":"間","s":"间","py":"","ctx":"中间。读 jiàn 时是隔开、参与或间隙。","pos":"","extra":"","level":"sentence"},{"t":"、","s":"、","punct":true},{"t":"不","s":"不","py":"","ctx":"表示否定。","pos":"","extra":"","level":"sentence"},{"t":"以","s":"以","py":"","ctx":"用、拿。","pos":"","extra":"","level":"sentence"},{"t":"千","s":"千","py":"","ctx":"千。","pos":"","extra":"","level":"sentence"},{"t":"里","s":"里","py":"","ctx":"里面，或长度单位。","pos":"","extra":"","level":"sentence"},{"t":"稱","s":"称","py":"","ctx":"称述、称为。","pos":"","extra":"","level":"sentence"},{"t":"也","s":"也","py":"","ctx":"句末语气词，表示判断或肯定。","pos":"","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"日行千里的马，一顿有时要吃完一石粟。喂马的人不知道它能日行千里，因而不按这个食量喂它。","tokens":[{"t":"馬","s":"马","py":"","ctx":"马。","pos":"","extra":"","level":"sentence"},{"t":"之","s":"之","py":"","ctx":"的。","pos":"","extra":"","level":"sentence"},{"t":"千","s":"千","py":"","ctx":"千。","pos":"","extra":"","level":"sentence"},{"t":"里","s":"里","py":"","ctx":"里面，或长度单位。","pos":"","extra":"","level":"sentence"},{"t":"者","s":"者","py":"","ctx":"……的人，或……的事物。","pos":"","extra":"","level":"sentence"},{"t":"、","s":"、","punct":true},{"t":"一","s":"一","py":"","ctx":"数目一。有时表示全、都，或一旦。","pos":"","extra":"","level":"sentence"},{"t":"食","s":"食","py":"","ctx":"吃，或食物。","pos":"","extra":"","level":"sentence"},{"t":"或","s":"或","py":"","ctx":"有的人，或也许。","pos":"","extra":"","level":"sentence"},{"t":"盡","s":"尽","py":"","ctx":"完、全部。","pos":"","extra":"","level":"sentence"},{"t":"粟","s":"粟","py":"","ctx":"粮食。","pos":"","extra":"","level":"sentence"},{"t":"一","s":"一","py":"","ctx":"数目一。有时表示全、都，或一旦。","pos":"","extra":"","level":"sentence"},{"t":"石","s":"石","py":"","ctx":"石头。","pos":"","extra":"","level":"sentence"},{"t":"、","s":"、","punct":true},{"t":"食","s":"食","py":"","ctx":"吃，或食物。","pos":"","extra":"","level":"sentence"},{"t":"馬","s":"马","py":"","ctx":"马。","pos":"","extra":"","level":"sentence"},{"t":"者","s":"者","py":"","ctx":"……的人，或……的事物。","pos":"","extra":"","level":"sentence"},{"t":"、","s":"、","punct":true},{"t":"不","s":"不","py":"","ctx":"表示否定。","pos":"","extra":"","level":"sentence"},{"t":"知","s":"知","py":"","ctx":"知道、了解。有时同“智”。","pos":"","extra":"","level":"sentence"},{"t":"其","s":"其","py":"","ctx":"他的、它的，或那。","pos":"","extra":"","level":"sentence"},{"t":"能","