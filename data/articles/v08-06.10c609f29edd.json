:"、","punct":true},{"t":"或","s":"或","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"舉","s":"举","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"管","s":"管","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"庫","s":"库","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"今","s":"今","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"布","s":"布","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"衣","s":"衣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"雖","s":"虽","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"賤","s":"贱","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"猶","s":"犹","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"足","s":"足","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"方","s":"方","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"此","s":"此","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"心情窘迫，言辞急促，不知道怎样剪裁，只希望您稍微给予怜惜。","tokens":[{"t":"情","s":"情","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"隘","s":"隘","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"辭","s":"辞","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"蹙","s":"蹙","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"知","s":"知","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"裁","s":"裁","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"亦","s":"亦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"惟","s":"惟","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"少","s":"少","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"垂","s":"垂","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"憐","s":"怜","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"焉","s":"焉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"韩愈再次行礼。","tokens":[{"t":"愈","s":"愈","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"再","s":"再","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"拜","s":"拜","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"这封信写于唐德宗贞元十一年二月十六日，是韩愈送给宰相的第二书。信里说上一封书和文章送出之后，等了十九天没有回音。他已经以乡贡进士的出身及第，仍没有得到官职，不敢把沉默当成答复，也不敢一走了之，只好再写一封，把自己放进可能被责罚的位置上。全文不铺陈所著文章的目录，只抓住一个比喻：人掉进水火，旁边只要还有人不盼他死，就该奔去救。穷和饿被说成另一场水火，宰相则被放进那个旁观者的位子。后面才转去驳「时机不到」。","theme":"韩愈承认自己是在呼救，但把呼救从私人的饥寒说成在位者该不该动手。落水的人不会先问救命的是不是亲人；旁观的人只要还没到希望他死，就该不顾嫌怨去救。以此衡量，看见有办法救却终于不救，就不能再称为仁人。所谓时机不到，他不接受。提拔谁，是居于上位的人自己决定的，不是天排定的。五六年前还有平民被荐上去，如今节度使、观察使乃至防御、营田等使职都能自己选用判官，不论对方做过官没有。宰相更被君主尊敬，反而说不可，这个不可就没有着落。古时取才甚至到了盗贼和管库小吏，一个布衣并没有卑贱到不能相比。","technique":"开头先把日期、旧日的出身和再拜写全，姿态放得很低，随即进入水火的设喻。喻体写成两遍，骨架几乎不动：陷进去的人怎样呼，旁边的人怎样奔。重复是为了把「不一定要有亲情」「即使有嫌怨」这两层条件钉死，再用「情势紧急、遭遇可悲」收成一句。然后把自身嵌进比喻：已经陷进穷饿，已经大声呼喊，对方也应当已经听见看见。接着用「前来保全」还是「安坐不救」的选择问，只留一个说得出口的答案。驳时机时不再抒情，改用眼前的官制和两件古事作比。最后一句只求稍微怜惜，把急迫重新收进求人的礼数里。","keyContentWords":[{"word":"合下","reading":"gé xià","note":"即「阁下」。文中的「合」是「閤」的写法，读 gé，不读 hé。不敢直呼宰相，称他阁阁之下。"},{"word":"诛","reading":"zhū","note":"责罚。不测之诛，是无法预料的处罚，未必就是杀头。"},{"word":"介","reading":"jiè","note":"处在。介于其侧，是站在他旁边，不是介绍。"},{"word":"亟","reading":"jí","note":"紧急。其既危且亟，是又危险又急迫。这里不读 qì，qì 才是「屡次」。"},{"word":"𦶟","reading":"ruò","note":"焚烧，就是「爇」。溺于水而𦶟于火，是眼看别人落水、遭火烧。"},{"word":"当","reading":"dāng","note":"配得上、承当。不足当吾贤相之举，是说才能够不上被宰相荐举。"},{"word":"抽擢","reading":"chōu zhuó","note":"选拔提升。自布衣蒙抽擢，是从平民身份受到提拔。"},{"word":"间","reading":"jiàn","note":"区分。无间于已仕未仕，是不论已经做官还是尚未做官。"},{"word":"方","reading":"fāng","note":"相比。犹足以方于此，是还可以和盗贼、管库之人并列。"},{"word":"蹙","reading":"cù","note":"急促。辞蹙，是话说得很紧，来不及从容修饰。情隘，是心情窘迫。"}],"keyFunctionWords":[{"word":"抑","reading":"yì","note":"还是，表选择。其将往而全之欤，抑将安而不救欤。"},{"word":"苟","reading":"gǒu","note":"如果、只要。苟不至乎欲其死者，把出手相救的条件压到最低：只要还不盼他死。"},{"word":"惟","reading":"wéi","note":"不惟，是「不只」。亦惟少垂怜，是「只希望」。同一个字要看上下文。"},{"word":"耳","reading":"ěr","note":"罢了。诚其材能不足当吾贤相之举耳，把唯一说得通的理由收住；在上位者之为耳，也是「只不过」。"},{"word":"将","reading":"jiāng","note":"将有介于其侧，是「如果有」。其将往而全之，是「将要」。"},{"word":"且","reading":"qiě","note":"况且。且今节度观察使，另起一层，用眼前的官制来比宰相。"}],"ancientModern":[{"word":"命","note":"古：吩咐、回复。不得命，是没有得到指示。今：多指生命，或口头发出的命令。"},{"word":"左右","note":"古：不直呼对方，称他身边的人，等于「您」。请命于左右。今：左边和右边。"},{"word":"诛","note":"古：责备、惩罚。不测之诛。今：多指杀死。"},{"word":"举","note":"古：荐举。当吾贤相之举、自举判官。今：多指举起、举例、举动。"},{"word":"方","note":"古：相比。方于此。今：多指方向、方法。"},{"word":"裁","note":"古：剪裁文辞。不知所裁，是不知道这封信该怎么删。今：多指裁衣服，或裁判、决定。"},{"word":"少","note":"古：稍微。少垂怜，读 shǎo。今：多指数量少，或读 shào 指年轻。"}],"phoneticLoans":[{"word":"彊","loan":"强","note":"彊学力行：彊通「强」，勉力，读 qiáng。不是倔强的 jiàng。"},{"word":"𦶟","loan":"爇","note":"𦶟就是爇，读 ruò，焚烧。观溺于水而𦶟于火，是看着别人被水淹、被火烧。"}],"flexibleUsage":[{"word":"大","note":"大其声：形容词的使动，把声音放大。"},{"word":"仁","note":"望其仁之：仁由名词转为动词，对他施行仁爱，也就是出手相救。"},{"word":"全","note":"往而全之：全由形容词转为动词，保全他。"},{"word":"安","note":"安而不救：安由形容词转为动词，安然坐着不动。"},{"word":"焦","note":"焦毛发：使动，使毛发烧焦。说的是救火的人自己受害，仍不去推辞。"}],"specialSyntax":[{"name":"宾语前置","note":"终莫之救：之是救的宾语，否定句里提前，等于「终于没有救他」。"},{"name":"选择问","note":"其将往而全之欤，抑将安而不救欤。用「其……抑……」把宰相放进两选，只留一个该选的答案。"},{"name":"固定格式","note":"如时不可何：如……何，是「对……又能怎么办」。对方用它推给时机，下文就专驳这个时。"},{"name":"层层条件","note":"不惟其父兄子弟之慈爱，然后呼而望之。先否定一个较高的条件，再说较低的条件也足够让人呼救、让人去救。"}]},"classicComment":{"t":"前幅設喻、中幅入正文、後幅再起一議。總以勢字時字作主。到底曲折、無一直筆。所見似悲戚、而文則宕逸可誦。","s":"前幅设喻、中幅入正文、后幅再起一议。总以势字时字作主。到底曲折、无一直笔。所见似悲戚、而文则宕逸可诵。"}}
