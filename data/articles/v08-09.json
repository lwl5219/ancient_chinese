:"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"逃","s":"逃","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"避","s":"避","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"不敢就此进见，便自己陈述其中的缘故，并献上近来所作《复志赋》以下十篇，合成一卷，卷上有题签和卷轴。","tokens":[{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"敢","s":"敢","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"遂","s":"遂","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"進","s":"进","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"輒","s":"辄","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"自","s":"自","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"疏","s":"疏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"并","s":"并","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"獻","s":"献","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"近","s":"近","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"復","s":"复","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"志","s":"志","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"賦","s":"赋","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"下","s":"下","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"十","s":"十","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"首","s":"首","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"一","s":"一","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"卷","s":"卷","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"卷","s":"卷","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"標","s":"标","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"軸","s":"轴","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"《送孟郊序》一篇，用生纸书写，没有加以装饰，上面都有涂改和添注的字，因为急于自我解释并向您谢罪，不能等到重新誊写。","tokens":[{"t":"送","s":"送","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"孟","s":"孟","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"郊","s":"郊","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"序","s":"序","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"一","s":"一","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"首","s":"首","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"生","s":"生","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"紙","s":"纸","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"寫","s":"写","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"加","s":"加","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"裝","s":"装","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"飾","s":"饰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"皆","s":"皆","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"揩","s":"揩","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"字","s":"字","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"註","s":"注","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"字","s":"字","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"處","s":"处","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"急","s":"急","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"自","s":"自","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"解","s":"解","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"謝","s":"谢","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"能","s":"能","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"竢","s":"竢","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"更","s":"更","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"寫","s":"写","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"阁下取我的心意，而忽略我礼数上的简慢，就可以了。","tokens":[{"t":"閤","s":"合","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"下","s":"下","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"取","s":"取","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"意","s":"意","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"略","s":"略","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"禮","s":"礼","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"可","s":"可","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"韩愈惶恐，再次叩拜。","tokens":[{"t":"愈","s":"愈","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"恐","s":"恐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"懼","s":"惧","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"再","s":"再","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"拜","s":"拜","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"陈给事是给事中陈京。给事中属门下省，可以封还诏书，在当时是清要的职位。这封信约写于贞元十九年。韩愈与陈京相识已经数年，早年曾得到一句称誉，后来自己为衣食奔走，不能常去，陈京门下候见的人又越来越多，两边就疏远了。去年春天他进谒一次，受到温和接待，随即往洛阳接取妻儿，回来再谒，却遇见冷淡的脸色和很少的话。信要说明这段空白，并送上《复志赋》以下十首和《送孟郊序》。","theme":"韩愈要挽回的是再去进见的资格。他先承认疏远有两面原因：对方地位越高，卑贱者越被隔开，门客越多，情意越难专一；自己道德没有进益，贤者就不肯结交，文章越有名，同进的人越嫉妒。四件事叠在一起，庭中便没有他的足迹。两次进谒一喜一惧。冷淡本可看成拒绝，他却改口说：面容疏远是恼自己来得不接连，话少是把这个意思表示出来。这么一解，责备仍说明关系未断，自己也承担了“不敏”的责备。献上未及重抄、留着涂改的文卷，是请对方看重用意，不计较礼数。","technique":"前半像在拆一件事的原因。先叙述不能常见，再用推论把对方的位尊和自己的文名分成两条，每条都从现象推出一个结果。四个因素最后收成“始之以、加之以、以、而听”一串，落到庭中没有足迹。后半不再抽象，用去年春和归来后两次进谒对照：面容是温和对冷淡，说话是连续对低微，自己是高兴对害怕。最用力的是“释然悟、翻然悔”以下几句，他把已经发生的冷脸重新解释一遍，解释本身就是道歉。结尾不掩饰生纸和改字，匆忙被留下来，证明这封信是急于自解。","keyContentWords":[{"word":"门墙","reading":"mén qiáng","note":"尊者或师长的门外。伺候于门墙，就是在对方门下等候进见。"},{"word":"属","reading":"zhǔ","note":"“属乎其言”的属，连续不断。这里形容第一次进谒时对方话很多，读 zhǔ，不读 shǔ。"},{"word":"邈","reading":"miǎo","note":"远。用来形容第二次进谒时对方的神色冷淡、显得疏远。"},{"word":"悄","reading":"qiǎo","note":"静、声音低微。“悄乎其言”与前面的“属乎其言”相对。"},{"word":"生纸","reading":"shēng zhǐ","note":"没有加工砑光的纸。唐代郑重的书信多用熟纸，这里说明稿子写得匆忙。"},{"word":"标轴","reading":"biāo zhóu","note":"卷轴以及轴上标明篇名的题签。“卷有标轴”是说十首已经装成一卷。"}],"keyFunctionWords":[{"word":"辱","reading":"rǔ","note":"“辱一言之誉”的辱是谦辞，表示承蒙对方降低身份来称赞，不是侮辱。"},{"word":"辄","reading":"zhé","note":"“辄自疏其所以”的辄，就、便。表示不敢进见，于是改用书信说明。"},{"word":"乃","reading":"nǎi","note":"“乃所以怒其来之不继”的乃，就是、正是，用来重释对方冷淡的用意。"}],"ancientModern":[{"word":"妻子","note":"“如东京取妻子”的妻子，指妻和子女，不单指配偶。东京是洛阳。"},{"word":"诛","note":"“不敏之诛”的诛，是责备、处罚，不是杀戮。不敏是谦称自己不聪敏。"},{"word":"加","note":"“若加其新”的加，是超过、更加看重，不是把一件东西添加上去。新指新交之时。"}],"phoneticLoans":[{"word":"闵","loan":"悯","note":"“若闵其穷”的闵通“悯”，怜悯。穷在这里是困窘。"}],"flexibleUsage":[{"word":"日","note":"“日益进”“贱者日隔”“文日益有名”的日用作状语，一天天、一天比一天。"},{"word":"新","note":"“若加其新”的新用作名词，指新结识时的那一份情分。"}],"specialSyntax":[{"name":"判断句","note":"“其邈也，乃所以怒其来之不继也”，用“也”说明冷淡的用意，不是描写脸色本身。"},{"name":"因果推论","note":"“夫位益尊，则贱者日隔”以“则”推出结果。四层推论叠完，才有“由是合下之庭无愈之迹”。"}]},"classicComment":{"t":"通篇以見字作主、上半篇從見說到不見。下半篇從不見說到要見。一路頓挫跌宕、波瀾層疊、姿態橫生、筆筆入妙也。","s":"通篇以见字作主、上半篇从见说到不见。下半篇从不见说到要见。一路顿挫跌宕、波澜层叠、姿态横生、笔笔入妙也。"}}
