,"py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"樂","s":"乐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"兮","s":"兮","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"樂","s":"乐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"且","s":"且","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"央","s":"央","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"虎豹远远离开，蛟龙逃避躲藏。","tokens":[{"t":"虎","s":"虎","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"豹","s":"豹","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"遠","s":"远","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"跡","s":"迹","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"兮","s":"兮","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"蛟","s":"蛟","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"龍","s":"龙","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"遁","s":"遁","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"藏","s":"藏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"鬼神守护着这里，喝止不祥的东西。","tokens":[{"t":"鬼","s":"鬼","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"神","s":"神","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"守","s":"守","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"護","s":"护","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"兮","s":"兮","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"呵","s":"呵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"禁","s":"禁","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"祥","s":"祥","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"有喝有吃，长寿而且安康；没有什么不满足，还盼望什么。","tokens":[{"t":"飲","s":"饮","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"且","s":"且","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"食","s":"食","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"兮","s":"兮","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"壽","s":"寿","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"康","s":"康","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"足","s":"足","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"兮","s":"兮","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"奚","s":"奚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"望","s":"望","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"给我的车轴上油，喂饱我的马，跟随你到盘谷，一辈子在那里自在徘徊。","tokens":[{"t":"膏","s":"膏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"吾","s":"吾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"車","s":"车","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"兮","s":"兮","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"秣","s":"秣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"吾","s":"吾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"馬","s":"马","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"從","s":"从","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"盤","s":"盘","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"兮","s":"兮","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"終","s":"终","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"吾","s":"吾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"生","s":"生","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"徜","s":"徜","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"徉","s":"徉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"盘谷在太行山南，约当今河南济源一带，泉水甘美，土地宜于耕种，两山环合，便于隐居。韩愈的朋友李愿将回到这里生活，韩愈作序送他。序的主体是李愿自己的话：先写受天子知遇的人如何进退百官、声势煊赫，再写不得志而能自处的人如何在山林中度日，最后写奔走于公卿之门的人如何卑琐。韩愈听完，称这番话豪壮，敬酒作歌，把盘谷写成可以终老之处。","theme":"李愿把世人羡慕的尊荣写得很满，随即归到命上，说明自己离开它，是因为知道不能侥幸得到。他愿意实行的是另一种过日子的办法：饮食取于山水，毁誉不入于心，车服和刀锯都够不着，治乱和升黜也不入耳。被这番话压到底下的，是在权势门口犹豫吞吐、身处污秽而不羞、还把一生押在万分之一上的人。看清了命，仍能自己作主，这就是韩愈所说的壮。","technique":"韩愈把话让给李愿，自己到末段才以昌黎韩愈的名字出现，赞成就藏在完整的转述里。三种人的句子各成一套。得志的人从旗旄、弓矢、喝道写到列屋闲居，动词密，场面热；隐居的人改用茂树、清泉和两组与其、孰若，节奏放缓；钻营的人只剩下趦趄、嗫嚅两个叠韵词，形貌已经萎缩。歌辞另换兮字，盘之中、盘之土、盘之泉、盘之阻反复四次，把议论收成可唱的送行，末句膏车秣马，作者才走进这片山谷。","keyContentWords":[{"word":"阳","reading":"yáng","note":"山的南面。太行之阳，就是太行山南麓。"},{"word":"便","reading":"pián","note":"清声而便体：体态轻盈闲雅。这个便读 pián，不读方便的 biàn。"},{"word":"形势","reading":"xíng shì","note":"权势和地位。奔走于形势之途，就是在有权势的人中间钻营。"},{"word":"趦趄","reading":"zī jū","note":"想往前走又不敢走。足将进而趦趄，写人在权门前的犹豫。"},{"word":"嗫嚅","reading":"niè rú","note":"想说话又说不出口。与趦趄相对，一写脚，一写口。"},{"word":"恶","reading":"wù","note":"吾非恶此而逃之：厌恶。读 wù，不读善恶的 è。"}],"keyFunctionWords":[{"word":"之","reading":"zhī","note":"惟适之安的之，帮助把适提前。这句话等于只安于适意。"},{"word":"孰","reading":"shú","note":"孰若，哪里比得上。与其引出放弃的一面，孰若引出所取的一面。"},{"word":"维","reading":"wéi","note":"维子之宫：句中语气词，有就是的意味。同篇车服不维的维则是束缚。"},{"word":"焉","reading":"yān","note":"是有命焉：语气词，表示这种情形确实存在。"}],"ancientModern":[{"word":"丈夫","note":"大丈夫指能自立、有所作为的人；今天多指女子的配偶。"},{"word":"怜","note":"争妍而取怜，怜是爱、宠爱；今天多指同情。"},{"word":"宫","note":"维子之宫，宫是住所；今天多指宫殿。"},{"word":"闲","note":"盘谷之闲、两山之闲，闲是中间，音 jiān；列屋而闲居，闲是闲散，音 xián。"},{"word":"理","note":"理乱不知的理，作用等于治。唐代避高宗李治的名讳，常把治写成理。"}],"phoneticLoans":[{"word":"畯","loan":"俊","note":"才畯满前，畯同俊，读 jùn，指才智出众的人。"},{"word":"惠","loan":"慧","note":"秀外而惠中，惠同慧，读 huì，指内心聪明。"},{"word":"藂","loan":"丛","note":"草木藂茂，藂同丛，读 cóng，指草木聚生。"},{"word":"儌","loan":"侥","note":"儌幸于万一，儌同侥，读 jiǎo，指非分地希求。"}],"flexibleUsage":[{"word":"壮","note":"闻其言而壮之：意动用法，认为这番话豪壮。"},{"word":"膏","note":"膏吾车：膏本指油脂，这里用作动词，给车轴上油，读 gào。"},{"word":"秣","note":"秣吾马：秣本指饲料，这里用作动词，喂马，读 mò。"}],"specialSyntax":[{"name":"宾语前置","note":"惟适之安：适是安所对待的对象，用之前置，意思是只求安于适意。"},{"name":"取舍句","note":"与其有誉于前，孰若无毁于其后。先说不足取的，再说更可取的，两句结构相同。"}]},"classicComment":{"t":"一節是形容得意人、一節是形容閒居人、一節是形容奔走伺候人。都結在人賢不肖何如也一句上。全舉李愿自己說話、自說只前數語寫盤谷、後一歌咏盤谷、別是一格。","s":"一节是形容得意人、一节是形容闲居人、一节是形容奔走伺候人。都结在人贤不肖何如也一句上。全举李愿自己说话、自说只前数语写盘谷、后一歌咏盘谷、别是一格。"}}
