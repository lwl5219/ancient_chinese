":"","pos":"","extra":"","level":"dict"},{"t":"卜","s":"卜","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"董生，你勉力去做吧。","tokens":[{"t":"董","s":"董","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"生","s":"生","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"勉","s":"勉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乎","s":"乎","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"哉","s":"哉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"我因此有了些感触。","tokens":[{"t":"吾","s":"吾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"因","s":"因","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"感","s":"感","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"矣","s":"矣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"请替我到望诸君的墓前哀吊，再看看那里的街市，还有从前那种以屠狗为生的豪士吗？","tokens":[{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"我","s":"我","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"弔","s":"吊","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"望","s":"望","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"諸","s":"诸","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"墓","s":"墓","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"觀","s":"观","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"市","s":"市","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"復","s":"复","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"昔","s":"昔","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"時","s":"时","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"屠","s":"屠","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"狗","s":"狗","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乎","s":"乎","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"替我转告他们：圣明的天子在上，可以出来做官了。","tokens":[{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"我","s":"我","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"謝","s":"谢","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"明","s":"明","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"天","s":"天","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"在","s":"在","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"上","s":"上","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"可","s":"可","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"出","s":"出","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"仕","s":"仕","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"矣","s":"矣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"董邵南多次应进士试，都没有被主管部门录取，于是带着才能离开长安，前往古称燕赵的河北。那里在人们口中仍是慷慨悲歌之地，当时的治军、用人却常常掌握在藩镇手里，不经由朝廷。韩愈写这篇短序送他，嘱他顺路凭吊望诸君乐毅的墓，到市井里看看还有没有古代屠狗一类的豪士，并代作者转告：天子圣明，可以出来做官了。","theme":"序先顺着董生的遭遇说。他有才而不遇，古时燕赵之士若还慕义强仁，就一定会爱惜他，所以说必有合。紧接着，风俗随教化而变这一句把把握抽掉，今天的河北未必仍是古人说的河北，必有合只成了有待此行验证的推测。两次董生勉乎哉因此轻重不同。真正的用意留在托辞里：若那边还有乐毅、屠狗者那样的人，该出来为天子效力。送他前往的话是热的，招回河北人材的意思放在最后。","technique":"篇幅短，转折全靠虚词。矧把燕赵之士抬高一层，然马上用恶知其今不异于古所云把话说虚，聊把判断改成以行卜之。两个为我把吊墓、观市、致辞连成一件可以实行的事，读者的视线从董生转到尚未出仕的当地人。韩愈不写风景，也不写离宴，通篇只有议论和嘱托。同一句董生勉乎哉前后各出现一次，词面仍是鼓励，所处的位置已经换了信心。","keyContentWords":[{"word":"感慨","reading":"gǎn kǎi","note":"情绪激昂。感慨悲歌之士，指不得意而慷慨高歌的人。"},{"word":"有司","reading":"yǒu sī","note":"主管某事的官吏。这里指主持进士考试的部门。"},{"word":"利器","reading":"lì qì","note":"比喻杰出的才能。怀抱利器，是说董生有才而未用。"},{"word":"有合","reading":"yǒu hé","note":"遇到能赏识自己、彼此投合的人。"},{"word":"望诸君","reading":"Wàng zhū jūn","note":"乐毅离开燕国后在赵国的封号。望诸本是泽名。墓在河北，所以托董生顺路凭吊。"},{"word":"屠狗","reading":"tú gǒu","note":"以宰狗为业。战国燕市有隐在屠狗行业里的豪杰，这里借指市井中的人材。"}],"keyFunctionWords":[{"word":"矧","reading":"shěn","note":"何况。承接上一句，把意思再推进一层。"},{"word":"恶","reading":"wū","note":"恶知，怎么知道。疑问代词，读 wū，不读厌恶的 wù。"},{"word":"聊","reading":"liáo","note":"姑且。聊以吾子之行卜之，表示先拿这次出行作一次测验。"},{"word":"焉","reading":"yān","note":"皆爱惜焉：指代董生。慕义强仁的人都会爱惜他。"}],"ancientModern":[{"word":"利器","note":"文中比喻人的才能；今天多指锋利的工具。"},{"word":"有司","note":"古代指主管其事的官吏；今天已经不用这个词称呼官署。"},{"word":"谢","note":"为我谢曰，是转告、致意；今天多指感谢或道歉。"},{"word":"士","note":"感慨悲歌之士，指有才气、有节概的人；今天多泛称某类人，或指士兵。"}],"phoneticLoans":[{"word":"彊","loan":"强","note":"慕义彊仁者，彊同强，读 qiǎng，指勉力去行仁。"}],"flexibleUsage":[{"word":"卜","note":"聊以吾子之行卜之：卜由占卜转为测验、判断，用这次北行看河北风俗还在不在。"}],"specialSyntax":[{"name":"反问","note":"吾恶知其今不异于古所云邪。恶提前，表示没有把握断定今昔相同。"},{"name":"是非问","note":"复有昔时屠狗者乎。用乎收住，问的是还有没有这样的人，下面的转告就寄在这个问号上。"}]},"classicComment":{"t":"董生憤己不得志、將往河北、求用于諸藩鎮、故公作此送之。始言董生之往必有合、中言恐未必合、終諷諸鎮之歸順、及董生不必往。文僅百十餘字、而有無限開闔、無限變化、無限含蓄、短章聖手。","s":"董生愤己不得志、将往河北、求用于诸藩镇、故公作此送之。始言董生之往必有合、中言恐未必合、终讽诸镇之归顺、及董生不必往。文仅百十余字、而有无限开阖、无限变化、无限含蓄、短章圣手。"}}
