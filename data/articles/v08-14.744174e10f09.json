":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"莫","s":"莫","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"加","s":"加","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"敬","s":"敬","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"誡","s":"诫","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"孫","s":"孙","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"楊","s":"杨","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"侯","s":"侯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"去","s":"去","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"鄉","s":"乡","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"法","s":"法","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"古人所说的乡先生，死后可以在社庙里受祭祀的，大概就是这个人吧，就是这个人吧。","tokens":[{"t":"古","s":"古","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"謂","s":"谓","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"鄉","s":"乡","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"先","s":"先","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"生","s":"生","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"沒","s":"没","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"可","s":"可","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"祭","s":"祭","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"社","s":"社","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"在","s":"在","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"斯","s":"斯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"歟","s":"欤","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"在","s":"在","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"斯","s":"斯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"歟","s":"欤","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"西汉疏广任太子太傅，侄儿疏受任少傅，年老后一同辞官。公卿在长安城外设帐饯行，观者叹息落泪，史书记载了这件事，后人又画下那个场面。国子司业杨巨源能诗，平日用诗教导后进，年满七十，向丞相请求回乡。丞相爱惜他，奏请让他担任故乡的少尹，俸禄不断，京城能诗的人也作诗唱和。韩愈当时生病，不能出门送行，便写序把杨侯和二疏放在一起看。","theme":"世人常说今人赶不上古人。韩愈用杨巨源的告老去碰这句话。二疏之贤，在于年老能退，而且退得被众人看见、被史书留下。杨侯同样因七十而归，韩愈却没见到城外有多少车马，也不敢保证史官还会为他作传，使事迹不至于冷落。另一面更切近：后来的士大夫往往以官为家，罢官便无处可去；杨侯能指着先人种的树、童年钓游的水丘走回本乡，乡人拿他教子孙。排场未必比得上二疏，作为死后可祭于社的乡先生，这篇序愿意把赞许放在他身上。","technique":"写二疏用实景：供张、车数百两、道路泣下、史传和图画，一层层都已发生。写杨侯改用问句，不知送者几人、车几两、观者是否知其贤，又问史官能不能张大其事、不落莫否。问句来自作者病不能出，也避免把听说写成亲见。后文补上少尹续禄和诗人唱和，再问二疏当年有没有这些，古今人不相及就被改成同不同未可知。末段不再比车马，改写归乡后指树、指丘的口吻。其在斯人欤说两遍，赞叹停在反复里。","keyContentWords":[{"word":"供张","reading":"gòng zhāng","note":"设置帷帐、备办酒食。供读 gòng。张的意义同帐。"},{"word":"祖道","reading":"zǔ dào","note":"出行前在路旁祭路神并设宴饯别。这里指在都门外送行。"},{"word":"司业","reading":"sī yè","note":"国子监的副长官，协助祭酒教导生徒。杨巨源当时担任此职。"},{"word":"少尹","reading":"shào yǐn","note":"唐代府的副职。少读 shào。让杨巨源以本乡少尹归去，俸禄仍在。"},{"word":"鹿鸣","reading":"lù míng","note":"《诗经·小雅》篇名。地方举送士子时歌唱它，后来便用歌鹿鸣指出乡应试。"},{"word":"乡先生","reading":"xiāng xiān shēng","note":"在乡里教学、为人所敬的前辈。古礼说这样的人死后可以配食于社。"}],"keyFunctionWords":[{"word":"岂","reading":"qǐ","note":"其意岂异也：反问，表示杨侯和二疏的心意不见得不同。"},{"word":"否","reading":"fǒu","note":"知其为贤与否、有是事否、不落莫否，都把句子收成疑问。"},{"word":"则","reading":"zé","note":"罢则无所于归：一罢官，紧接着就没有归处。则表示顺承的结果。"},{"word":"欤","reading":"yú","note":"其在斯人欤：推测兼感叹。重复一遍，判断不说死，语气已经坐实。"}],"ancientModern":[{"word":"白","note":"白丞相、白以为其都少尹，白是禀告、奏请；今天多指颜色，或明白。"},{"word":"没","note":"没而可祭于社，没是去世，读 mò；今天多读 méi，表示没有。"},{"word":"传","note":"汉史既传其事，传读 chuán，是记载、流传；为传的传读 zhuàn，是传记。"},{"word":"家","note":"以官为家，家指可以安身的地方。罢官无所归，是把官职当成了唯一的家。"}],"phoneticLoans":[{"word":"张","loan":"帐","note":"设供张的张，意义同帐，读 zhāng，指饯别时张设的帷帐。"},{"word":"莫","loan":"寞","note":"不落莫否，落莫同落寞，读 luò mò，冷落、寂寞。"},{"word":"见","loan":"现","note":"见今世无工画者，见同现，读 xiàn。见今就是现今。"},{"word":"两","loan":"辆","note":"车数百两、车几两，两同辆，读 liàng，是车的量词。"}],"flexibleUsage":[{"word":"冠","note":"杨侯始冠：冠由名词转为动词，举行冠礼，表示成年。读 guàn。"},{"word":"歌","note":"歌鹿鸣而来：歌用作动词，歌唱《鹿鸣》。"}],"specialSyntax":[{"name":"问句作叙述","note":"不知送者几人、车几两、马几匹、观者知其贤与否。一串问数包在不知里面，用未知代替亲见。"},{"name":"反复感叹","note":"其在斯人欤，其在斯人欤。推测句连说两遍，把乡先生的赞许落在杨侯身上。"}]},"classicComment":{"t":"巨源之去、未必可方二疏。公欲張大之、將來形容、又不可確言。特前說二疏所有、或少尹所無。後說少尹所有、或二疏所無。則巨源之美不可掩、而已亦不至失言。末托慨世之詞、寫出楊侯歸鄉、可敬可愛、情景宛然。","s":"巨源之去、未必可方二疏。公欲张大之、将来形容、又不可确言。特前说二疏所有、或少尹所无。后说少尹所有、或二疏所无。则巨源之美不可掩、而已亦不至失言。末托慨世之词、写出杨侯归乡、可敬可爱、情景宛然。"}}
