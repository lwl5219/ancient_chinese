,"level":"dict"},{"t":"軍","s":"军","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"門","s":"门","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"吾","s":"吾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"前","s":"前","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"稱","s":"称","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"天","s":"天","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"下","s":"下","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"賀","s":"贺","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"後","s":"后","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"稱","s":"称","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"吾","s":"吾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"致","s":"致","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"私","s":"私","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"怨","s":"怨","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"盡","s":"尽","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"取","s":"取","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"留守相公最先写了四韵诗来咏叹这件事，我便顺着他的意思推广开来，写成这篇序。","tokens":[{"t":"留","s":"留","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"守","s":"守","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"相","s":"相","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"公","s":"公","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"首","s":"首","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"四","s":"四","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"韻","s":"韵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"詩","s":"诗","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"歌","s":"歌","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"事","s":"事","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"愈","s":"愈","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"因","s":"因","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"推","s":"推","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"意","s":"意","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"序","s":"序","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"这篇序作于唐德宗贞元十六年。乌重胤以御史大夫出为河阳军节度使，到镇不久，先礼聘隐居洛水北岸的石洪入幕，又请石洪作介，把南岸的温造一并请去。洛阳是东都，闲居的才士不少，这两位平日深藏不售，忽然接连被聘走。韩愈当时身在东都官署，和留守、河南尹以及河南、洛阳两县的僚属同处一地，咨访、交游、问学所依靠的人眼看空了。东都留守先作四韵诗记这件事，韩愈推衍诗意，写成序文送温造赴军。","theme":"序文把送行写成一次人才归属的说明。乌公在短时间内接连收走东都最突出的处士，韩愈认为这正是将军替天子收罗文武的本分，朝廷内外因此才有望治理好。与此同时，他写出自己被职事绊住、原想依靠石、温二人伴到老年的私情。祝贺是公义，介然于怀是私怨，两层话都托温生带到军门，这篇序就不是只捧对方的客套。","technique":"开篇用伯乐走过冀北、马群遂空作比，先把「空」收成「没有良马」，再把东都说成士大夫的冀北，石生、温生就是被挑走的那两匹良马。后文朝取暮取、庐中无人，都顺着这个比喻往下推。北涯对南涯，相得人对将得士，为天下贺对致私怨，排比把公私两面夹在一起。直到结尾才露出作者被夺去倚靠的懊恼，前面的称赞因此有了分寸。","keyContentWords":[{"word":"伯乐","reading":"bó lè","note":"春秋时善于相马的人。文中借指能识拔人才的乌公。"},{"word":"冀北","reading":"jì běi","note":"冀州北部，古来以产良马著称。韩愈拿它比东都的人才渊薮。"},{"word":"处士","reading":"chǔ shì","note":"有才德而隐居不出的人。本篇指石洪、温造。"},{"word":"鈇钺","reading":"fū yuè","note":"斧钺，将帅出镇的仪仗，这里代表节度使的权威。"},{"word":"幕下","reading":"mù xià","note":"将帅的幕府。罗而致之幕下，就是请入军府任职。"},{"word":"尤","reading":"yóu","note":"特异、最突出的。拔其尤，选拔其中最杰出的人。"},{"word":"缙绅","reading":"jìn shēn","note":"把笏插在绅带间，代指做官的人。"},{"word":"介然","reading":"jiè rán","note":"耿耿于心、放不下的样子。"}],"keyFunctionWords":[{"word":"夫","reading":"fú","note":"句首发语词。夫冀北马多天下，引出对「马群遂空」的疑问。"},{"word":"苟","reading":"gǒu","note":"如果。苟无良，假如好的已经没有了。"},{"word":"焉","reading":"yān","note":"群无留良焉，相当于「于此」。奚所咨而处焉，则是疑问语气。"},{"word":"邪","reading":"yé","note":"疑问语气。安能空其群邪，等于说「怎么能呢」。"}],"ancientModern":[{"word":"空","note":"古：本篇作使动，使马群不再有良马。今：多指里面没有东西。"},{"word":"市","note":"古：动词，出卖、拿才能去换名利。深藏而不市。今：多指市场、城市。"},{"word":"信","note":"古：确实。东都虽信多才士。今：多指书信，或相信。"},{"word":"媒","note":"古：介绍的人。以石生为媒，让石洪做引荐。今：多指婚姻介绍人或传播工具。"},{"word":"资","note":"古：依靠。资二生以待老。今：多指钱财、资质。"}],"phoneticLoans":[{"word":"邪","loan":"耶","note":"安能空其群邪、其何能无介然于怀邪：邪读 yé，疑问语气，后来多写作「耶」。"}],"flexibleUsage":[{"word":"空","note":"马群遂空：形容词作使动，使马群空。"},{"word":"市","note":"不市：名词作动词，出卖、求售。"},{"word":"罗","note":"以礼为罗，罗是名词，捕鸟的网；罗而致之幕下，罗转为动词，网罗。"},{"word":"礼","note":"无所礼于其庐：名词作动词，行礼、拜访。"}],"specialSyntax":[{"name":"判断句","note":"东都，固士大夫之冀北也。用「……也」断定东都在人才上的地位。"},{"name":"反问","note":"安能空其群邪、岂不可也、其何能无介然于怀邪，都用反问把判断说死。"},{"name":"省略","note":"暮取一人焉，承上一句省去「东都」。读者仍知道取人的地点没变。"}]},"classicComment":{"t":"全篇無一語實說溫生之賢、而溫生已處處躍露。若是而稱曰數語、是結前半篇。其爲吾以前所稱、是結後半篇。然致私怨于盡取句、直挽到篇首空字、收盡通章。","s":"全篇无一语实说温生之贤、而温生已处处跃露。若是而称曰数语、是结前半篇。其为吾以前所称、是结后半篇。然致私怨于尽取句、直挽到篇首空字、收尽通章。"}}
