:"","pos":"","extra":"","level":"dict"},{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"臣","s":"臣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"邪","s":"邪","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"这不过是见识短小、喜欢耍小聪明的人做的事，不是周公该用的办法，所以不能相信。","tokens":[{"t":"是","s":"是","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"直","s":"直","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"小","s":"小","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"丈","s":"丈","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"夫","s":"夫","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"𡙇𡙇","s":"𡙇𡙇","punct":true},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"事","s":"事","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"非","s":"非","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"周","s":"周","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"公","s":"公","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"宜","s":"宜","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"用","s":"用","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"故","s":"故","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"可","s":"可","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"信","s":"信","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"有人说：封唐叔这件事，是史佚促成的。","tokens":[{"t":"或","s":"或","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"封","s":"封","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"唐","s":"唐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"叔","s":"叔","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"史","s":"史","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"佚","s":"佚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"成","s":"成","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"旧传周成王小时候和幼弟开玩笑，拿桐叶当玉珪，说用这个封你。周公进宫祝贺。成王说是戏言，周公说天子不能开玩笑，于是把幼弟封在唐。唐后来成为晋国，幼弟就是唐叔。柳宗元这篇辨，不考证封地沿革，只问这件事像不像周公做的。他认为弟弟该不该封，应当按正道在合适的时候对王说，不该等一句戏言，再用祝贺把它变成事实。篇末另记一说：促成封唐叔的是史佚。本文写到这里为止，没有再替这一说展开辩驳。","theme":"辨的中心是：君主的德看实际做得对不对，不看某一句话出口就算数。弟弟该封，周公就及时进言，不必靠戏言来促成；不该封，却把土地和人民交给幼弟做君主，周公就不能算圣人。君王的话不可随便，只是不可草率，不是每一句玩笑都要兑现。作者把妇人、宦官拿来作极端假设：桐叶若是戏给他们的，难道也全部照办？还没恰当，改十次也不算病；已经恰当，才不能再改。因为玩笑就一定实行，等于教成王把过错做完。周公辅佐应当让成王从容和乐，归到大中，不迎合过失，也不把成王捆起来赶着走。家人父子尚且不能用「说过的话一字不改」来约束自己，君臣更不该这样。所以「天子不可戏」若被做成小聪明式的执拗，这个传说就不可信。","technique":"开篇把传说压成五句：给桐叶、进宫祝贺、说是玩笑、说天子不能玩笑、封到唐。第五句刚落，就用「我的看法不是这样」截断，不再顺着故事讲。以下全是追问，而且两面都问到：应当封会怎样，不应当封又会怎样。问完周公本人，再加一个假设，把「不能开玩笑」推到宫中妇女和宦官身上，让这条原则自己露出破绽。正面主张只集中在一小段：德行看做得如何；未恰当可以改十次，已恰当才不可改。后面用把过错做完、迎合过失还替他找说辞、捆住驱赶得像牛马，三层比喻说明辅佐不是催君王兑现错话。篇末「有人说」另换一个促成的人，句子很短，和开篇的传说并置。","keyContentWords":[{"word":"桐叶","reading":"tóng yè","note":"桐树的叶子。成王拿它当珪，开玩笑说用来封弟弟。"},{"word":"小弱","reading":"xiǎo ruò","note":"幼小。小弱弟，年幼的弟弟，篇末称为唐叔。"},{"word":"不中","reading":"bù zhòng","note":"不合适。中读 zhòng。不中之戏，不合宜的玩笑。"},{"word":"妇寺","reading":"fù sì","note":"宫中妇女和宦官。寺是寺人，即宦官。作者用来把「天子不可戏」推到极端。"},{"word":"大中","reading":"dà zhōng","note":"不偏不倚的正道。要归之大中，辅佐的终点只在这个道理上。"},{"word":"唐叔","reading":"Táng shū","note":"成王的弟弟叔虞。封在唐，后来唐改称晋。"}],"keyFunctionWords":[{"word":"邪","reading":"yé","note":"句末疑问语气。当封邪、不当封邪，都是提出一面假设来问。"},{"word":"设","reading":"shè","note":"假使。设有不幸，设未得其当，都是先假定一种情况，再推出不能接受的结果。"},{"word":"直","reading":"zhí","note":"只是。是直小丈夫𡙇𡙇者之事，只不过是那种人做的事。"},{"word":"况","reading":"kuàng","note":"何况。而况以其戏乎；况号为君臣者邪。都是把前面的道理再推进一层。"}],"ancientModern":[{"word":"戏","note":"戏也、不可戏、以其戏：玩笑。今多指戏剧，或一般的游戏。"},{"word":"病","note":"不为病：毛病、害处。更改十次也不算害处。今多指疾病。"},{"word":"辞","note":"为之辞：托词、辩解的话。今多指言辞，或告别。"},{"word":"当","note":"得其当、要于其当：恰当，读 dàng。今「当」常读 dāng，表示应当、正在。"}],"phoneticLoans":[{"word":"𡙇","loan":"缺","note":"小丈夫𡙇𡙇者：𡙇通「缺」。缺缺，形容耍小聪明、器量狭小。"}],"flexibleUsage":[{"word":"主","note":"为之主：名词用作动词，做那里的君主。"},{"word":"易","note":"十易之、不可使易：更改。这里把改变做法说成「易」。"},{"word":"辞","note":"为之辞：名词用作动词，替他编说辞。"}],"specialSyntax":[{"name":"反问","note":"其得为圣乎、必从而成之邪、亦将举而从之乎，连续用反问否定周公一定要成全戏言。"},{"name":"假设","note":"设有不幸，王以桐叶戏妇寺，亦将举而从之乎：用极端假设检验「天子不可戏」。"},{"name":"判断","note":"是周公教王遂过也：用「也」判断，把实行戏言说成教君王把过错做完。"}]},"classicComment":{"t":"前輻連設數層翻駁、後輻連下數層斷案、俱以理勝、非尚口舌便便也。讀之反覆重疊愈不厭、如眺層巒、但見蒼翠。","s":"前辐连设数层翻驳、后辐连下数层断案、俱以理胜、非尚口舌便便也。读之反复重叠愈不厌、如眺层峦、但见苍翠。"}}
