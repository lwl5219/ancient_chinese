:"","level":"dict"},{"t":"庚","s":"庚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"念","s":"念","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"亂","s":"乱","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"圖","s":"图","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"存","s":"存","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"國","s":"国","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"誰","s":"谁","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"與","s":"与","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"興","s":"兴","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"理","s":"理","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"是","s":"是","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"固","s":"固","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"事","s":"事","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"或","s":"或","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"然","s":"然","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"那么，先生忍辱这样做，大概是有志于此吧。","tokens":[{"t":"然","s":"然","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"則","s":"则","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"先","s":"先","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"生","s":"生","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"隱","s":"隐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"忍","s":"忍","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"此","s":"此","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"志","s":"志","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"斯","s":"斯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乎","s":"乎","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"唐朝某年，在汲郡修建祠庙，每年按时祭祀。","tokens":[{"t":"唐","s":"唐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"某","s":"某","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"年","s":"年","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"作","s":"作","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"廟","s":"庙","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"汲","s":"汲","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"郡","s":"郡","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"歲","s":"岁","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"時","s":"时","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"致","s":"致","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"祀","s":"祀","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"赞美先生独自被写进《易》的卦象，于是作了这篇颂。","tokens":[{"t":"嘉","s":"嘉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"先","s":"先","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"生","s":"生","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"獨","s":"独","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"列","s":"列","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"易","s":"易","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"象","s":"象","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"作","s":"作","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"是","s":"是","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"頌","s":"颂","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"云","s":"云","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"箕子是殷末宗室，处在纣的时代。比干进谏而死，微子离开殷都，后来殷的祭祀得以保存。箕子两条路都不走。他藏起谋略，忍受囚奴的屈辱，外表昏暗，内心不改。周取代殷以后，他向周人陈述治国大法，书序把这件事写成因箕子归周而作《洪范》；又有封于朝鲜、用道理教诲当地风俗的传说。碑文说唐朝某年在汲郡为他建庙，每年按时祭祀。柳宗元把这些事迹收成三句：在患难里守正，把法授给圣王，使教化到达百姓。后半又推测他隐忍不去、不死，是因为殷祀还没断，万一国事还有转机，不能没有留下的人。","theme":"三句话是全文的骨架。正蒙难，对应他不取比干那种赴死捐命，也不取微子那种委屈自己以保存祭祀，而是保住明智，跟世道俯仰，把谋略法度隐藏起来，受囚奴的辱。《易》里的「箕子之明夷」用来证明这一层：明智受伤，却仍然守正。法授圣，对应天命改了、百姓走上正道之后，他拿出大法，周人才能整顿人伦、建立大典，《书》里「以箕子归，作《洪范》」就是依据。化及民，对应封朝鲜以后推行道理、教诲风俗：不因地方鄙陋、人民遥远而放弃，还要借此延续殷的祭祀，使边远之地变成华夏。三条都集于一身，作者才称他为大人。后半的「假如」不是改写已发生的历史，而是说明隐忍可能另有期待：比干已死，微子已去，国家若突然还有机会，不能没有人出来治理。","technique":"碑文先立三条，再让事实逐条归位。每条末尾用「这就是正蒙难」「这就是法授圣」「这就是化及民」收住，读者不必再等一段总括。他不走的两条路也写成对称：赴死捐命是仁，但对祭祀没有益处；委身保存祭祀是仁，却等于听任本国灭亡。否定都只有短短一句，把选择的理由说死。经典只引两处，一处《易》，一处《书》，各自贴住前两条；第三条不再引经，用朝鲜的事迹本身作证明。后半「唉」一转，时间拉回周的时运未到、殷祀未绝，用「假如」推出一个没有发生的局面，再问「大概有志于此吧」。问句不把动机说成定论，和前面三个判断句的把握正好不同。建庙和作颂放在最后，说明文章是为汲郡的祠庙而写。","keyContentWords":[{"word":"蒙难","reading":"méng nàn","note":"遭受患难。难读 nàn。正蒙难，在患难之中持守正道。"},{"word":"明夷","reading":"míng yí","note":"《易》的卦名，光明入于地下，象征明智受伤而隐藏。箕子之明夷是这一卦里的爻辞。"},{"word":"谟范","reading":"mó fàn","note":"谋略和法度。晦是谟范，把它们藏起来，不在纣的时代拿出来用。"},{"word":"彝伦","reading":"yí lún","note":"常理、人伦。序彝伦，把人与人之间的常道排列整齐。"},{"word":"洪范","reading":"hóng fàn","note":"《尚书》篇名，讲治国的大法。文中引书序：因为箕子归周，才有这一篇。"},{"word":"稔","reading":"rěn","note":"谷物成熟。纣恶未稔，罪恶还没有发展到头。"},{"word":"汲郡","reading":"Jí jùn","note":"唐代郡名，在今河南卫辉一带。碑文说这里为箕子建了祠庙。"}],"keyFunctionWords":[{"word":"用","reading":"yòng","note":"是用保其明哲、用广殷祀：因此、借此。用为圣师：因而成为，或被用为。"},{"word":"与","reading":"yǔ","note":"与亡吾国：听任、参与，听任自己的国家灭亡。与之俯仰：跟着。谁与兴理：和谁。"},{"word":"其","reading":"qí","note":"表推测。其大人欤，大概就是大人吧；其有志于斯乎，大概是有志于此吧。"},{"word":"俾","reading":"bǐ","note":"使。俾夷为华，使边远之人变为华夏。"}],"ancientModern":[{"word":"大人","note":"凡大人之道、其大人欤：德行完备的人。今多用作对成年人的称呼。"},{"word":"殷勤","note":"尤殷勤焉：恳切、反复致意。今多指招待周到。"},{"word":"生人","note":"生人以正：百姓。唐朝避太宗李世民的名讳，常把「民」写成「人」。今「人」不专指百姓。"},{"word":"先生","note":"先生隐忍而为此：对箕子的尊称。今多指教师。"}],"phoneticLoans":[{"word":"于虖","loan":"呜呼","note":"于虖通「呜呼」，感叹。读 wū hū。下面转入殷周之际那一种可能。"},{"word":"藂","loan":"丛","note":"藂于厥躬：藂通「丛」，聚集。大道集中在他一人身上。"},{"word":"㫖","loan":"旨","note":"六经之㫖：㫖通「旨」，意旨。"}],"flexibleUsage":[{"word":"序","note":"序彝伦：名词用作动词，排定次序。"},{"word":"晦","note":"晦是谟范：使动用法，把谋略和法度隐藏起来。"},{"word":"广","note":"用广殷祀：形容词的使动用法，使殷的祭祀得以延续、扩大。"}],"specialSyntax":[{"name":"判断","note":"正蒙难也、法授圣也、化及民也：三段事实之后各用「也」字判断，把开头的三条收回来。"},{"name":"假设","note":"向使纣恶未稔而自毙……谁与兴理：向使是假如，推想一种没有发生的局面。"},{"name":"宾语前置","note":"谁与兴理：等于「与谁兴理」。疑问代词「谁」放在介词「与」的前面。"}]},"classicComment":{"t":"前立三柱、真如天外三峯、卓然峭峙。於虖以下、忽然換筆、一往更有深情。","s":"前立三柱、真如天外三峰、卓然峭峙。于虖以下、忽然换笔、一往更有深情。"}}
