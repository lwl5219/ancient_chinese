t":"業","s":"业","py":"","ctx":"事业、学业。","pos":"","extra":"","level":"sentence"},{"t":"者","s":"者","py":"","ctx":"……的人，或……的事物。","pos":"","extra":"","level":"sentence"},{"t":"、","s":"、","punct":true},{"t":"其","s":"其","py":"","ctx":"他的、它的，或那。","pos":"","extra":"","level":"sentence"},{"t":"亦","s":"亦","py":"","ctx":"也。","pos":"","extra":"","level":"sentence"},{"t":"有","s":"有","py":"","ctx":"有、存在。","pos":"","extra":"","level":"sentence"},{"t":"類","s":"类","py":"","ctx":"种类，或类似。","pos":"","extra":"","level":"sentence"},{"t":"乎","s":"乎","py":"","ctx":"吗、呢，句末语气词。有时同“于”。","pos":"","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"问的人笑着说：这不是很好吗？","tokens":[{"t":"問","s":"问","py":"","ctx":"问。","pos":"","extra":"","level":"sentence"},{"t":"者","s":"者","py":"","ctx":"……的人，或……的事物。","pos":"","extra":"","level":"sentence"},{"t":"嘻","s":"嘻","py":"","ctx":"笑、惊叹。","pos":"","extra":"","level":"sentence"},{"t":"曰","s":"曰","py":"","ctx":"说，或叫做。","pos":"","extra":"","level":"sentence"},{"t":"、","s":"、","punct":true},{"t":"不","s":"不","py":"","ctx":"表示否定。","pos":"","extra":"","level":"sentence"},{"t":"亦","s":"亦","py":"","ctx":"也。","pos":"","extra":"","level":"sentence"},{"t":"善","s":"善","py":"","ctx":"好、擅长。","pos":"","extra":"","level":"sentence"},{"t":"夫","s":"夫","py":"","ctx":"成年男子，或丈夫。句首发语词读 fú。","pos":"","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"我问的是养树，得到的却是养民的方法，于是记下这件事，用来警戒做官的人。","tokens":[{"t":"吾","s":"吾","py":"","ctx":"我。","pos":"","extra":"","level":"sentence"},{"t":"問","s":"问","py":"","ctx":"问。","pos":"","extra":"","level":"sentence"},{"t":"養","s":"养","py":"","ctx":"供养、培养。","pos":"","extra":"","level":"sentence"},{"t":"樹","s":"树","py":"","ctx":"树。","pos":"","extra":"","level":"sentence"},{"t":"得","s":"得","py":"","ctx":"得到，或能够。","pos":"","extra":"","level":"sentence"},{"t":"養","s":"养","py":"","ctx":"供养、培养。","pos":"","extra":"","level":"sentence"},{"t":"人","s":"人","py":"","ctx":"人。","pos":"","extra":"","level":"sentence"},{"t":"術","s":"术","py":"","ctx":"方法。","pos":"","extra":"","level":"sentence"},{"t":"、","s":"、","punct":true},{"t":"傳","s":"传","py":"","ctx":"传递。传记读 zhuàn。","pos":"","extra":"","level":"sentence"},{"t":"其","s":"其","py":"","ctx":"他的、它的，或那。","pos":"","extra":"","level":"sentence"},{"t":"事","s":"事","py":"","ctx":"事情。","pos":"","extra":"","level":"sentence"},{"t":"以","s":"以","py":"","ctx":"认。","pos":"","extra":"","level":"sentence"},{"t":"爲","s":"为","py":"","ctx":"为、是。","pos":"","extra":"","level":"sentence"},{"t":"官","s":"官","py":"","ctx":"官、官府。","pos":"","extra":"","level":"sentence"},{"t":"戒","s":"戒","py":"","ctx":"警戒、告诫。","pos":"","extra":"","level":"sentence"},{"t":"也","s":"也","py":"","ctx":"句末语气词，表示判断或肯定。","pos":"","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"郭橐驼是长安西边丰乐乡的种树人，本名已经不传。他患驼背，背脊隆起，弯着身子走路，乡里把他比作骆驼，他自己也接受了这个称呼。豪门为了园圃观赏，卖果的人为了收成，都争着请他。柳宗元用传的体裁写下他的谈话：先记名字和手艺，再由客人把种树移到做官上。驼用乡里差吏催耕催织的喊话作答。篇末说，问养树得到的是养民的方法，写下来给官吏作警戒。文中“官理”“养人”，分别避开唐高宗李治、唐太宗李世民的名讳。","theme":"驼把树种活的原因说得很窄。他并不能让树活得更久、结得更多，只是不去妨碍它。根要舒展，土要用原来的，培土要平、要砸实；栽的时候小心，栽完就像放下，不再回头摇。别的人或者根是卷的、土是新换的，或者爱得太勤，早晚抚摸，抓开树皮看死活，树的本性反而一天天离开。后半把这层意思移到官府。差吏早晚敲鼓召集，耕种、收割、缫丝、织布、养孩子、喂鸡猪，样样都催。百姓连吃饭都要停下来接待，生计和心性都安定不了。政令看上去像怜惜，落到实处却和过分的爱树一样，成了祸害。","technique":"前半照传记的顺序来写：外号怎么来的，乡在哪里，主顾为什么争着请，别人为什么学不会。手艺高下不靠作者夸奖，用驼自己的话分成两面。“莳若子”和“置若弃”对举，“不害其长”和“爪其肤”对举，爱与害、忧与仇落在相邻的短句里。后半几乎不再写树，改成差吏的一串命令，句子短，事情密，烦令的密度靠节奏听得出来。驼不把结论说满，只问这和自己的行当是否相像。作者那句“官戒”留到最后，传记的外壳里装着对政事的劝戒。","keyContentWords":[{"word":"橐驼","reading":"tuó tuó","note":"骆驼。郭某背驼，乡里用它做外号，他自己后来也这样称呼。"},{"word":"偻","reading":"lǚ","note":"脊背弯曲。“病偻”是患了驼背。"},{"word":"蕃","reading":"fán","note":"多。“蚤实以蕃”是果实结得早，而且结得多。"},{"word":"莳","reading":"shì","note":"移栽。“其莳也若子”是栽种的时候像照顾孩子那样小心。"},{"word":"长人者","reading":"zhǎng rén zhě","note":"治理百姓的官。长是主管、统领。"},{"word":"飧饔","reading":"sūn yōng","note":"晚饭和早饭。“辍飧饔”是连吃饭都停下来。"}],"keyFunctionWords":[{"word":"焉尔","reading":"yān ěr","note":"两个语气词连用，罢了。“以致其性焉尔”是让本性得以实现就算了。"},{"word":"其","reading":"qí","note":"“其亦有类乎”的其表示推测，大概、恐怕。"}],"ancientModern":[{"word":"天","note":"“顺木之天”的天是树木天然的生长之理，不是天空。"},{"word":"理","note":"“官理”的理是治理。唐人避高宗李治的名讳，用理代替治。"},{"word":"人","note":"“养人术”的人指百姓。避太宗李世民的名讳，不用民字。"}],"phoneticLoans":[{"word":"蚤","loan":"早","note":"“蚤实”“蚤缲”的蚤通“早”，提早。"},{"word":"而","loan":"尔","note":"“缲而绪、织而缕、字而幼孩、遂而鸡豚”的而通“尔”，你们的。"}],"flexibleUsage":[{"word":"业","note":"“驼业种树”的业作动词，以种树为职业。"},{"word":"爪","note":"“爪其肤”的爪读 zhǎo，名词用作动词，用指甲抓树皮。"},{"word":"硕茂","note":"“硕茂之”是使动，之指树，使它高大茂盛。下文“蚤而蕃之”也是使动。"}],"specialSyntax":[{"name":"不我若","note":"否定句里代词宾语前置，等于“不若我”，比不上我。"},{"name":"何以蕃吾生","note":"何是介词以的宾语，提前，意思是靠什么。蕃、安都是使动，使生计兴旺、使性情安定。"}]},"classicComment":{"t":"前寫橐駝種樹之法、瑣瑣述來、涉筆成趣。純是上聖至理、不得看爲山家種樹方。末入官理一段、發出絕大議論、以規諷世道。守官者當深體此文。","s":"前写橐驼种树之法、琐琐述来、涉笔成趣。纯是上圣至理、不得看为山家种树方。末入官理一段、发出绝大议论、以规讽世道。守官者当深体此文。"}}