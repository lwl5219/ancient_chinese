level":"dict"},{"t":"、","s":"、","punct":true},{"t":"則","s":"则","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"貴","s":"贵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"游","s":"游","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"士","s":"士","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爭","s":"争","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"買","s":"买","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"日","s":"日","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"增","s":"增","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"千","s":"千","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"金","s":"金","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"愈","s":"愈","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"可","s":"可","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"得","s":"得","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"如今它被抛弃在这个州里，农夫和渔夫经过，也看不起它。","tokens":[{"t":"今","s":"今","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"棄","s":"弃","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"是","s":"是","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"州","s":"州","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"農","s":"农","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"夫","s":"夫","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"漁","s":"渔","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"父","s":"父","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"過","s":"过","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"陋","s":"陋","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"价钱只要四百，一连几年卖不出去。","tokens":[{"t":"價","s":"价","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"四","s":"四","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"百","s":"百","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"連","s":"连","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"歲","s":"岁","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"能","s":"能","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"售","s":"售","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"可是我和深源、克己偏偏高兴地得到它，这难道果真是它有了际遇吗？","tokens":[{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"我","s":"我","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"與","s":"与","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"深","s":"深","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"源","s":"源","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"克","s":"克","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"己","s":"己","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"獨","s":"独","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"喜","s":"喜","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"得","s":"得","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"是","s":"是","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"果","s":"果","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"遭","s":"遭","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乎","s":"乎","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"写在石头上，用来祝贺这座小丘遇上了知己。","tokens":[{"t":"書","s":"书","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"石","s":"石","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"賀","s":"贺","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"茲","s":"兹","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"丘","s":"丘","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"遭","s":"遭","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"这是柳宗元在永州写的西山一组游记中的一篇，上接他发现西山之后的第八天。他沿山口向西北走二百步，先看见钴鉧潭，再在潭西二十五步、鱼梁上方发现这座不足一亩的小丘。小丘原是唐氏丢弃的地，标价四百钱，连年卖不出去。柳宗元和同游的李深源、元克己把它买下，铲去杂草，烧掉恶木，奇石才露出来。钴鉧是熨斗，鉧读 mǔ，潭因形状得名；这篇记却把笔墨放在潭西的小丘上，写它如何因被弃而贱，又因遇见懂它的人而有了遭际。","theme":"小丘的美是在清理之后才被人看见的。石头有的像牛马下溪饮水，有的像熊罴登山，可是在唐氏手里它只是一块卖不掉的弃地，农夫渔夫走过也看不上。柳宗元用长安附近沣、镐、鄠、杜的贵游子弟作对比：同样的丘若在那里，每天加价千金也买不到；弃在永州，四百钱还无人问。价格的落差说明价值随地点和眼光改变，并不随景物本身改变。他和两位朋友高兴，是因为意外得到它，也因为自己正像这块被远州搁置的土地。结尾说写在石上是为了祝贺小丘有了遭际，贺的是丘，影的是人：埋没的美需要一次相遇，相遇本身却不能改变它长期被弃的事实。","technique":"开篇用步数把路线写死：西山后八日、西北二百步、再西二十五步，读者像跟着走进去。写石不直接说美，而用突怒、偃蹇、牛马饮水、熊罴登山，把静止的石头写成正在动作。买地的对话极短，问主、问价、止四百，贱得几乎不像话，和后面日增千金对着。铲刈、焚烧之后连用立、露、显三个字，表示美原来就在，只是被遮住。望和卧分成两组：望时山水云鸟都来丘下献技，卧时清泠、水声、虚、静依次进入目、耳、神、心。末段噫的一声把记游拉进感慨，书于石一句收回，祝贺写得很轻，分量留在遭这个字上。","keyContentWords":[{"word":"钴鉧","reading":"gǔ mǔ","note":"熨斗。文中写作钴𬭁，就是钴鉧。鉧读 mǔ。潭的形状像熨斗，所以叫钴鉧潭。"},{"word":"鱼梁","reading":"yú liáng","note":"横截水流、用来捕鱼的石堰。小丘在这道堰的上方。"},{"word":"偃蹇","reading":"yǎn jiǎn","note":"高耸而傲然屈曲的样子。用来写石头从土里拱出来的姿态。"},{"word":"嵚然","reading":"qīn rán","note":"高峻的样子。相累而下，是一层层叠着、势头向下，所以像牛马低头饮水。"},{"word":"罴","reading":"pí","note":"熊的一种。与牛马对举，写另一组向上冲的石头。"},{"word":"匝旬","reading":"zā xún","note":"满十天。不匝旬，是从发现西山到得到潭和丘，还不满十天。"},{"word":"沣镐鄠杜","reading":"Fēng Hào Hù Dù","note":"都在长安附近。沣、镐在西南，鄠在西，杜陵在东南，是贵人游赏的地方。"},{"word":"遭","reading":"zāo","note":"遇合、被赏识的机会。贺兹丘之遭，是祝贺小丘终于遇见懂它的人，不是遭遇灾祸。"},{"word":"瀯瀯","reading":"yíng yíng","note":"流水声。与清泠的视觉相对，进入耳朵。"}],"keyFunctionWords":[{"word":"寻","reading":"xún","note":"沿着。寻山口西北道，是顺着山口向西北走，不是后来才找到的那个寻找。"},{"word":"当","reading":"dāng","note":"面对着。当湍而浚者，正对着水流又急又深的地方。"},{"word":"殆","reading":"dài","note":"几乎。殆不可数，是奇石多到差不多数不清。"},{"word":"举","reading":"jǔ","note":"全都。举熙熙然，山、云、溪、鸟兽没有一样不来献巧。"},{"word":"兹","reading":"zī","note":"这。兹丘就是这座小丘。"}],"ancientModern":[{"word":"货","note":"这里是拿出出卖。今天的货多指货物，一般不再单独作卖讲。"},{"word":"售","note":"货而不售，是卖不出去。余怜而售之，是我把它买下，使这桩买卖做成。今天的售只指出售。"},{"word":"笼","note":"可以笼而有之，是全部包揽占有。今天的笼多指笼子。"},{"word":"遭","note":"这里是美的事物终于被人赏识。今天的遭多指遇上不幸的事。"},{"word":"谋","note":"与目谋、与耳谋，是景物和感官相接。今天的谋多指计谋、商量事情。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"道","note":"西北道二百步：名词用作动词，取道、行走。"},{"word":"货","note":"货而不售：名词用作动词，出卖。"},{"word":"售","note":"怜而售之：使动，使小丘卖出去，也就是买下来。"},{"word":"陋","note":"过而陋之：意动，经过时认为它鄙陋。"},{"word":"枕席","note":"枕席而卧：名词用作动词，设枕铺席躺下。"}],"specialSyntax":[{"name":"定语后置","note":"当湍而浚者为鱼梁。湍而浚者放到当的后面，指那处又急又深的水流。"},{"name":"被动意味","note":"今弃是州也。小丘是被抛弃在永州的，不是它自己离开原地。"},{"name":"所以……也","note":"书于石，所以贺兹丘之遭也。所以指出写在石上的用意，也字收住判断。"}]},"classicComment":{"t":"前幅平平寫來、意只尋常。而立名造語、自有別趣。至末從小丘上發出一段感慨、爲茲丘致賀。賀茲丘、所以自弔也。","s":"前幅平平写来、意只寻常。而立名造语、自有别趣。至末从小丘上发出一段感慨、为兹丘致贺。贺兹丘、所以自吊也。"}}
