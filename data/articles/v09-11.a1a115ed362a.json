"","pos":"","extra":"","level":"dict"},{"t":"災","s":"灾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"同","s":"同","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"位","s":"位","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"皆","s":"皆","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"相","s":"相","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"弔","s":"吊","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"许国不去吊慰受灾的国家，君子厌恶这种做法。","tokens":[{"t":"許","s":"许","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"弔","s":"吊","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"災","s":"灾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"惡","s":"恶","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"如今我所说的是这样，有和古代不同的地方，所以准备吊慰，却改成祝贺。","tokens":[{"t":"今","s":"今","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"吾","s":"吾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"陳","s":"陈","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"若","s":"若","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"是","s":"是","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"異","s":"异","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乎","s":"乎","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"古","s":"古","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"故","s":"故","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"將","s":"将","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"弔","s":"吊","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"更","s":"更","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"賀","s":"贺","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"像颜回、曾参那样奉养父母，其中的快乐已经很大了，又缺少什么呢？","tokens":[{"t":"顏","s":"颜","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曾","s":"曾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"養","s":"养","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"樂","s":"乐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"大","s":"大","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"矣","s":"矣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"又","s":"又","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"何","s":"何","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"闕","s":"阙","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"焉","s":"焉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"这是柳宗元离开御史、尚书郎的职位、贬在外地以后写给朋友王参元的一封信，一般系于永州时期。王参元中过进士，能读古书、写文章，又通文字训诂，家里却很富。京城人常说他家有积货，爱惜廉洁名声的士人因此不敢称赞他，怕一开口就被讥为收了重礼。杨八来信告知王家失火，积蓄烧光。柳宗元按常情应当吊慰，信里却说明自己由惊骇、怀疑转到大喜，并把吊改成贺。信中提到贞元十五年他已读到王的文章，后来自己做近臣时也曾在同僚中称道，仍有人偷笑。火灾被他说成一次把嫌疑烧干净的机会。","theme":"贺的不是灾祸本身，而是烧掉了挡住名声的财产。信的开头先怕两件事：朋友受惊，奉养父母的食物也许供应不上，所以骇。接着世人常说的盈虚倚伏、先苦后显，他觉得空阔，圣人也不能据此就断定必有后福，所以疑。真正让他大喜的理由很具体。王参元不能超出众士、取得显贵，不是因为没有才能，而是因为家富使人不敢说他的好。柳宗元承认自己也把公道憋了六七年，做了近臣仍然不能让称赞被人相信，这是自责。火把房子烧黑、墙烧红，众人眼里的财产没有了，疑虑也变成灰。才能可以清白地显出来，主考的人授给他名位也不必害怕。十年朋友比不上这一夜的火，话说得很重，重在世态，不在幸灾。结尾回到奉养：颜回、曾参家贫仍能养亲，快乐并不缺少，开头那一层骇也就有了着落。","technique":"始骇、中疑、终喜六字先立纲领，后面三段各自交代原因，末了用是以始而骇、是故中而疑、是以终乃大喜逐一关合。吊与贺的矛盾放到最后才用古礼说明：列国有灾，同位的应当相吊；许国不吊，君子厌恶。自己所以改贺，是因为这次火灾和普通损失不同。书信的锋芒在对比。众人衔忍不开口，对他奋舌称道仍有窃笑；十年相知不若一夕之火；积货在时公道难明，庐垣烧尽之后才能显白。黔其庐、赭其垣用两个颜色证明一无所有。祝融、回禄把火说成火神来帮忙，是修辞，不是把论证交给神。最后颜曾之养把语气放缓，让祝贺仍然顾到朋友奉养父母的心事。","keyContentWords":[{"word":"吊","reading":"diào","note":"慰问遭灾的人。柳宗元本该吊，却改成贺。"},{"word":"小学","reading":"xiǎo xué","note":"文字、音韵、训诂之学。善小学，是精通识字和解释字义，不是今天的小学校。"},{"word":"滫瀡","reading":"xiǔ suǐ","note":"用米汁调和、使食物滑软。脂膏滫瀡，指奉养父母的精美食物。"},{"word":"倚伏","reading":"yǐ fú","note":"互相依存、互相转化。盈虚倚伏，近于祸福相依的说法。"},{"word":"黔","reading":"qián","note":"黑色，这里使房屋变成黑色，指火烧。"},{"word":"赭","reading":"zhě","note":"红土的颜色，这里使墙壁变成赤色，也是火烧的结果。"},{"word":"祝融","reading":"Zhù róng","note":"火神。与回禄并提，把这场火说成火神来助成王参元的名声。"},{"word":"回禄","reading":"Huí lù","note":"火神名。与祝融同指这场天火。"},{"word":"喙","reading":"huì","note":"鸟嘴，借指人的嘴。开其喙，就是让原先不敢说的人开口称赞。"},{"word":"发策决科","reading":"fā cè jué kē","note":"拆开策问、判定科第。指主持考试、决定名次的人。"}],"keyFunctionWords":[{"word":"是","reading":"shì","note":"惟恬安无事是望的是，是把宾语提前的标志。只希望恬静平安。"},{"word":"盖","reading":"gài","note":"盖将吊而更以贺，说明原因，原来是要改吊为贺。盖无他焉，是大概没有别的缘故。"},{"word":"所","reading":"suǒ","note":"为天火之所涤荡、为世嫌之所加，与为呼应，组成被动。"},{"word":"诸","reading":"zhū","note":"不出于口的合音。不出诸口，就是不从嘴里说出来。"},{"word":"向","reading":"xiàng","note":"从前。如向之蓄缩，像过去那样退缩。"}],"ancientModern":[{"word":"小学","note":"这里是文字训诂。今天指对儿童实施初等教育的学校。"},{"word":"发明","note":"发明足下之郁塞，是阐发、使才名显明。今天的发明多指创造出新事物。"},{"word":"其实","note":"其实出矣，是您的真实才学显露出来。实是名词。今天的其实是副词，表示实际上。"},{"word":"左右","note":"震骇左右，是对对方的敬称，不直呼其名。今天的左右多指方位或身边的人。"},{"word":"给","note":"或以不给，读 jǐ，供给不上。今天的给多读 gěi，表示给予。"}],"phoneticLoans":[{"word":"向","loan":"嚮","note":"从前。如向之蓄缩受侮，向通嚮，指先前那种退缩。"},{"word":"栗","loan":"慄","note":"害怕。授子而不栗，把名位授给您也不恐惧。栗通慄。"},{"word":"阙","loan":"缺","note":"缺少。又何阙焉，奉养的快乐还缺什么呢。阙通缺。"}],"flexibleUsage":[{"word":"私","note":"私一身：形容词用作动词，只偏顾自己一个人。"},{"word":"黔","note":"黔其庐：形容词的使动用法，把房屋烧黑。"},{"word":"赭","note":"赭其垣：形容词的使动用法，把墙壁烧红。"},{"word":"相","note":"相吾子：读 xiàng，动词，辅助。不是互相的 xiāng。"}],"specialSyntax":[{"name":"宾语前置","note":"惟恬安无事是望，等于惟望恬安无事。是把宾语恬安无事提前。"},{"name":"被动句","note":"为天火之所涤荡、为世嫌之所加，都是为……所……的被动式。"},{"name":"反问","note":"其可得乎、又何阙焉，都用问句表示不可能再退缩、奉养也并不缺少。"}]},"classicComment":{"t":"聞失火而賀、大是奇事。然所以賀之之故、自創一段議論、自闢一番實理、絕非泛泛也。取徑幽奇險仄、快語驚人、可以破涕爲笑。","s":"闻失火而贺、大是奇事。然所以贺之之故、自创一段议论、自辟一番实理、绝非泛泛也。取径幽奇险仄、快语惊人、可以破涕为笑。"}}
