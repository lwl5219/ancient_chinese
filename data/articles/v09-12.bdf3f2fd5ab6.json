:"狱","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"投","s":"投","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"遠","s":"远","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"方","s":"方","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"非","s":"非","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"幸","s":"幸","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"亦","s":"亦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"宜","s":"宜","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"由此可知，一国的政事、万人的性命，都系在宰相身上，能够不谨慎吗？","tokens":[{"t":"是","s":"是","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"知","s":"知","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"一","s":"一","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"國","s":"国","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"政","s":"政","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"萬","s":"万","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"命","s":"命","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"懸","s":"悬","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"宰","s":"宰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"相","s":"相","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"可","s":"可","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"慎","s":"慎","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"歟","s":"欤","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"还有一种人，没有人毁谤也没有人称赞，跟着众人进也跟着众人退，窃据官位苟求俸禄，凑个数只求保全自己，这种人也没有什么可取。","tokens":[{"t":"復","s":"复","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"毀","s":"毁","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"譽","s":"誉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"旅","s":"旅","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"進","s":"进","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"旅","s":"旅","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"退","s":"退","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"竊","s":"窃","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"位","s":"位","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"苟","s":"苟","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"祿","s":"禄","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"備","s":"备","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"員","s":"员","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"全","s":"全","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"身","s":"身","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"亦","s":"亦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"取","s":"取","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"焉","s":"焉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"大理寺的小吏王禹偁写了这篇文章，请求把它记在待漏院的墙壁上，用来规劝执政的人。","tokens":[{"t":"棘","s":"棘","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"寺","s":"寺","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"小","s":"小","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"吏","s":"吏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"禹","s":"禹","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"偁","s":"偁","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"文","s":"文","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"請","s":"请","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"誌","s":"志","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"院","s":"院","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"壁","s":"壁","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"用","s":"用","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"規","s":"规","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"執","s":"执","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"政","s":"政","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"待漏院是宰相清晨上朝前歇脚的地方，设在丹凤门右侧。宫门未开、漏壶未尽，大臣先在这里等候，院名本身就含着勤政的意思。王禹偁写这篇记时官职不高，文末自称棘寺小吏，却请求把文章刻在院壁上，直接说给执政者听。他不记房屋如何建造，只借这个黎明前无人催促的片刻，追问宰相心里想的是国家还是自己。开篇由天道不说话而万物长成说起，是要先立下君逸臣劳的标准。","theme":"全文的分量在宰相的一念。同样是待漏，心里装的是百姓、边远部族、战争、田亩和贤佞，入朝之后能使风气清平、民生富足，高位厚禄是应当的；心里装的是私仇、旧恩、货财和党附，就会把政权和帝位一起拖向危险，获罪流放也是应当的。作者还扫开第三种人：无毁无誉，随班进退，只求保住俸禄和性命。一国之政、万人之命都悬在宰相身上，所以待漏时的思虑不能含糊。勤若没有公心，就只是早起，算不得贤相。","technique":"先用天道、圣人两段设问，推出君逸臣劳，再交代待漏院的来历，笔调平直。从“待漏之际，相君其有思乎”起，文章分成两扇几乎对称的门：一边忧心忡忡、待旦而入，一边私心慆慆、假寐而坐。句式两两相对，连“相君言焉”都重复一次，只把“纳”换成“惑”，吉凶不用另下判词。结尾忽然补出随众进退的庸臣，避免把人只分成好坏两类，仍用“亦无所取”收住。通篇少叙事，靠设问、排比和对照把规劝说满。","keyContentWords":[{"word":"待漏","reading":"dài lòu","note":"漏是计时的漏壶。百官天亮前在宫门边等候漏尽、门开，这个处所叫待漏院。"},{"word":"火城","reading":"huǒ chéng","note":"宰相夜行上朝，随从灯烛很多，远远望去像一座着火的城。"},{"word":"灾眚","reading":"zāi shěng","note":"灾祸。眚本指眼睛生翳，这里和灾连用，指接连到来的灾异。"},{"word":"棘寺","reading":"jí sì","note":"大理寺的别称。古代听讼于棘木之下，司法官署因此称棘寺。作者用小吏自称，表示位卑。"}],"keyFunctionWords":[{"word":"其或","reading":"qí huò","note":"或者、倘若。两段心理都用它领起，分别设想公心和私心。"},{"word":"焉","reading":"yān","note":"“于焉以息”的焉等于“于此”，在这里。“相君言焉”的焉则指代那些话。"},{"word":"乎","reading":"hū","note":"“法乎天”的乎等于“于”，取法于天。“其有思乎”的乎是疑问语气。"}],"ancientModern":[{"word":"一人","note":"指天子。以事一人，就是侍奉皇帝，不是随便侍奉某一个人。"},{"word":"子女","note":"和玉帛并举，偏指美女，不是儿女。"},{"word":"旅","note":"旅进旅退的旅是一同、随众，没有自己的主张，不是旅行。"},{"word":"复","note":"“私雠未复”的复是报复，不是反复，也不是恢复。"}],"phoneticLoans":[{"word":"咎","loan":"皋","note":"“自咎夔至房魏”的咎通“皋”，指皋陶，读 gāo，不读 jiù。夔是舜时的乐官。"}],"flexibleUsage":[{"word":"泰","note":"“思所泰之”的泰是使动，考虑怎样使百姓安宁。"},{"word":"来","note":"“思所来之”的来是使动，考虑怎样使四方部族前来归附。"},{"word":"荣","note":"“思所荣之”的荣是使动，考虑怎样使旧日的恩人得到荣宠。"}],"specialSyntax":[{"name":"宾语前置","note":"“何以弭之”“何以致之”的何以，就是以何。疑问代词作介词的宾语，放在介词前面。"},{"name":"对举","note":"公心、私心两段句式几乎逐句相对，纳与惑、富庶与危亡、非幸也与非不幸也互相照应，作者不必再另作评判。"}]},"classicComment":{"t":"將千古賢相奸相心事、曲曲描出。辭氣嚴正、可法可鑒。尤妙在先借勤字立說、後將慎字作收。蓋爲相者、一出于勤慎、則所思自有善而無惡。末又說出一種苟祿全身之庸相、其害正與奸相等。尤足以爲後世戒。雖名爲記、極似箴體。","s":"将千古贤相奸相心事、曲曲描出。辞气严正、可法可鉴。尤妙在先借勤字立说、后将慎字作收。盖为相者、一出于勤慎、则所思自有善而无恶。末又说出一种苟禄全身之庸相、其害正与奸相等。尤足以为后世戒。虽名为记、极似箴体。"}}
