":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"歲","s":"岁","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"除","s":"除","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"日","s":"日","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"齊","s":"齐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"安","s":"安","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"命","s":"命","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"己","s":"己","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"亥","s":"亥","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"閏","s":"闰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"三","s":"三","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"月","s":"月","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"到","s":"到","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"郡","s":"郡","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"这四年里奔走不停，不知道明年又在什么地方，哪里还怕竹楼容易朽坏呢？","tokens":[{"t":"四","s":"四","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"年","s":"年","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"間","s":"间","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"奔","s":"奔","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"走","s":"走","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"暇","s":"暇","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"未","s":"未","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"知","s":"知","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"明","s":"明","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"年","s":"年","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"又","s":"又","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"在","s":"在","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"何","s":"何","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"處","s":"处","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"豈","s":"岂","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"懼","s":"惧","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"竹","s":"竹","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"樓","s":"楼","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"易","s":"易","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"朽","s":"朽","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乎","s":"乎","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"后来的人如果和我志趣相同，接着修缮它，希望这座楼不至于朽掉。","tokens":[{"t":"後","s":"后","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"與","s":"与","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"我","s":"我","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"同","s":"同","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"志","s":"志","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"嗣","s":"嗣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"葺","s":"葺","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"庶","s":"庶","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"斯","s":"斯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"樓","s":"楼","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"朽","s":"朽","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"王禹偁在至道、咸平之间一再被外放。他自己记下行程：乙未年离开翰林到滁州，次年移往扬州，丁酉年回到中书，戊戌除夕接到齐安的任命，己亥闰三月才到黄州。这篇记写他到郡以后，在城西北角倒塌的女墙边修了两间小楼，与当地原有的月波楼相通。黄冈多竹，居民用剖开的竹子代替陶瓦，他又便宜又省工。作者就用这种材料，给贬谪中的日子安排了一处可坐、可听、可看的地方。","theme":"楼的可贵不在高大华丽。齐云、落星、井干、丽谯虽然高华，只用来安置歌舞，作者明确说自己不取。他要的是急雨、密雪、琴韵、棋声，以及酒醒茶歇之后送走夕阳、迎来明月的一点清静。竹瓦只能用十年，再盖一层也不过二十年，他却说并不害怕朽坏，因为四年里奔走不暇，明年在何处都不可知。楼可以朽，志趣相同的后来者若肯继续修补，这处谪居的意思就可以留下来。","technique":"前半几乎全是短句排列。夏宜急雨、冬宜密雪，接着宜琴、宜诗、宜棋、宜壶，声音一个接一个，竹楼像会回应主人。中间用鹤氅、华阳巾和一卷《周易》给自己画像，闲散，却并不颓唐。后半忽然拿齐云、落星来对照，再用竹匠所说的年数，把自己的迁谪年表接上去。材料的寿命和人的宦迹放在一处，感慨从竹瓦的易朽里长出来，不是另贴一段议论。结尾把不朽交给后来的人，语气轻，意思留得很远。","keyContentWords":[{"word":"比屋","reading":"bǐ wū","note":"房屋挨着房屋，就是家家户户。比屋皆然，是说当地用竹瓦盖屋很普遍。"},{"word":"雉堞","reading":"zhì dié","note":"城墙上排列如齿的矮墙，又叫女墙。圮毁，是说这段城墙已经倒塌。"},{"word":"𨶑","reading":"qù","note":"与“阒”同用，静得几乎没有声响。后面的“敻”读 xiòng，远。幽𨶑辽敻，是说竹楼四周又静又开阔。"},{"word":"丁丁","reading":"zhēng zhēng","note":"象声词，棋子落在棋盘上的声音。这里不读 dīng。"},{"word":"稔","reading":"rěn","note":"庄稼成熟一次叫一稔，借指一年。十稔就是十年。"},{"word":"西掖","reading":"xī yè","note":"中书省的别称，官署在宫廷西侧。又入西掖，指重新回到朝廷掌管诏命。"},{"word":"齐安","reading":"Qí ān","note":"黄州的古郡名。有齐安之命，就是接到贬往黄州的命令。"},{"word":"井干","reading":"jǐng hán","note":"汉代楼名，木材层层累起，像井上的栏杆。干读 hán，不读 gān。"},{"word":"丽谯","reading":"lì qiáo","note":"华丽的谯楼。与齐云、落星并举，都是以高华著名的楼，作者却说自己不取。"}],"keyFunctionWords":[{"word":"第","reading":"dì","note":"“第见风帆沙鸟”的第是范围副词，只、仅仅，不是次序。"},{"word":"庶","reading":"shù","note":"“庶斯楼之不朽”的庶表示希望，希望这座楼不朽。"},{"word":"因","reading":"yīn","note":"“因作小楼”的因是于是、就，承接城角荒废，于是在那里建楼。"},{"word":"重","reading":"chóng","note":"“若重覆之”的重是再、又一次。再盖一层竹瓦，可用二十年。不读轻重的 zhòng。"}],"ancientModern":[{"word":"予","note":"我。予城西北隅，点明楼在作者任所城墙的西北角。别本常作“子城”，指大城内附的小城；本篇作“予”。"},{"word":"同志","note":"志趣相同，不是后来所说的政治身份。与我同志，是说后来的人和作者想的一样。"},{"word":"公退","note":"办完公事退下来，不是退休。公退之暇，是办公之后的空闲。"},{"word":"骚人","note":"诗人、文人。屈原作《离骚》，后人因此称诗人为骚人。"}],"phoneticLoans":[{"word":"被","loan":"披","note":"“被鹤氅衣”的被通“披”，读 pī，把鹤氅披在身上。"},{"word":"闲","loan":"间","note":"“小楼二闲”的闲通“间”，读 jiān，两间屋子，不是空闲。"}],"flexibleUsage":[{"word":"吞","note":"远吞山光，把远望写成吞咽，山色像被楼收了进去。"},{"word":"挹","note":"平挹江濑，把平视写成舀取。濑是江边沙石上的急流。"}],"specialSyntax":[{"name":"排比","note":"宜鼓琴、宜咏诗、宜围棋、宜投壶四句句式相同，用声音把竹楼的好处逐项说全。"},{"name":"反问","note":"“岂惧竹楼之易朽乎”用反问把对竹瓦寿命的担心转回到自己迁谪不定的处境。"}]},"classicComment":{"t":"冷淡蕭疎、無意于安排措置、而自得之于景象之外。可以上追柳州得意諸記。起結搖曳生情、更覺蘊藉。","s":"冷淡萧疎、无意于安排措置、而自得之于景象之外。可以上追柳州得意诸记。起结摇曳生情、更觉蕴藉。"}}
