:"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"我仲淹来镇守这个地方，才建造祠堂祭奠他。","tokens":[{"t":"仲","s":"仲","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"淹","s":"淹","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"來","s":"来","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"守","s":"守","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"是","s":"是","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"邦","s":"邦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"始","s":"始","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"構","s":"构","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"堂","s":"堂","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"奠","s":"奠","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"焉","s":"焉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"又免除他后代四户人家的徭役，让他们掌管祭祀。","tokens":[{"t":"乃","s":"乃","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"復","s":"复","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"後","s":"后","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"四","s":"四","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"家","s":"家","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"奉","s":"奉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"祠","s":"祠","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"事","s":"事","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"接着又作歌：云山青苍一片，江水浩荡宽广。","tokens":[{"t":"又","s":"又","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"從","s":"从","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"歌","s":"歌","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"雲","s":"云","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"山","s":"山","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"蒼","s":"苍","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"蒼","s":"苍","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"江","s":"江","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"水","s":"水","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"泱","s":"泱","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"泱","s":"泱","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"先生的风节，像山一样高，像水一样长。","tokens":[{"t":"先","s":"先","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"生","s":"生","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"風","s":"风","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"山","s":"山","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"高","s":"高","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"水","s":"水","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"長","s":"长","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"严光字子陵，年轻时与刘秀一同游学。刘秀称帝后，他改名隐居，被征召到洛阳仍不肯做官，后来回到富春江边钓鱼。旧说他与光武同卧，脚压在皇帝腹上，次日太史报告客星侵犯帝座。范仲淹在景祐年间出知睦州，当地留有严光的遗迹，他修建祠堂，免除严氏后代四户的徭役，让他们主持祭祀，并写了这篇记。记文不铺陈钓台风景，只写光武与故人之间以道相尚的关系。","theme":"两边都写到极高，又互相成全。光武拥有亿兆臣民，是能顺应时势的圣人；严光把轩冕看成泥涂，是能保持清高的圣人。没有严光的节操，光武的尊贵就少了一个不被权势压倒的朋友；没有光武的礼遇，严光的隐退也无从被成全。作者引用《蛊》《屯》两卦，把“不事王侯”和“以贵下贱”说成同一件事的两面。这种关系若能使贪者知廉、弱者能立，就算有功于名教。歌里的山高水长，量的是先生留下的风节。","technique":"开篇只说故人、相尚以道，不讲故事细节。接着用两组几乎对称的句子：光武得圣人之时，天下谁能超过，只有先生以节操高出他；先生得圣人之清，天下谁能超过，只有光武以礼降低身份。易卦爻辞嵌进对偶，典故不单独讲解，直接充当人物的品格。后半才转到作者守郡、建祠、免除后裔徭役，露出作记的缘由。结尾四句歌把云山、江水和风节叠在一起，议论收成可以传唱的句子。","keyContentWords":[{"word":"赤符","reading":"chì fú","note":"赤伏符，新莽末年流传的谶记，说刘秀应当受命称帝。握赤符，就是取得称帝的符命。"},{"word":"六龙","reading":"liù lóng","note":"《易·乾》说时乘六龙以御天。乘六龙，指顺应时势登上帝位。"},{"word":"轩冕","reading":"xuān miǎn","note":"轩是有屏蔽的车，冕是礼冠，合起来指高官显位。泥涂轩冕，是把官位看得像泥土。"},{"word":"名教","reading":"míng jiào","note":"以名分和伦理教化世人的那套规矩。有功于名教，是说能使贪婪的人知廉耻、懦弱的人能自立。"},{"word":"屯","reading":"zhūn","note":"卦名。初九的象辞说以贵下贱，大得民心。屯作卦名时读 zhūn，不读聚集的 tún。"}],"keyFunctionWords":[{"word":"微","reading":"wēi","note":"如果没有。“微先生”“微光武”都是假设他们不存在，后面的成全便不能发生。"},{"word":"孰","reading":"shú","note":"谁。天下孰加焉，是说天下有谁能超过。"},{"word":"加","reading":"jiā","note":"超过。孰加不是谁去施加，是谁比他更高。"}],"ancientModern":[{"word":"时","note":"“圣人之时”指能按时机进取或退处。孟子称孔子为圣之时者，这里用来许光武。"},{"word":"清","note":"“圣人之清”指清白自守、不与浊世同流。孟子称伯夷为圣之清者，这里用来许严光。"},{"word":"复","note":"“乃复其为后者四家”的复是免除徭役赋税，不是再一次。为后者，指做严光后代的人家。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"臣妾","note":"名词用作动词。臣妾亿兆，是使亿万百姓成为臣民。"},{"word":"高","note":"“以节高之”的高是动词，凭节操高出光武之上。之指光武。"},{"word":"泥涂","note":"意动用法。泥涂轩冕，是把高官显位看成泥涂。"},{"word":"下","note":"“以礼下之”的下是动词，按礼节降低自己的身份去对待严光。"}],"specialSyntax":[{"name":"对举","note":"得时与得清两段句式相同，只把“以节高之”和“以礼下之”互换，写出双方互相成就。"},{"name":"介宾后置","note":"“相尚以道”就是以道相尚，用道义互相推重。介词结构放在动词后面。"},{"name":"使动","note":"“贪夫廉，懦夫立”承上面的“使”，是使贪婪的人廉洁、使懦弱的人自立。"}]},"classicComment":{"t":"題嚴先生、卻將光武兩兩相形、竟作一篇對偶文字。至末乃歸到先生、最有體格。且以歌作結、能使通篇生動、不失之板。妙甚。","s":"题严先生、却将光武两两相形、竟作一篇对偶文字。至末乃归到先生、最有体格。且以歌作结、能使通篇生动、不失之板。妙甚。"}}
