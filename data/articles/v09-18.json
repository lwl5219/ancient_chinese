:"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"范公的忠义充满朝廷，功业遍及边境，功名传遍天下，后世一定有史官来写，我可以不必记录。","tokens":[{"t":"公","s":"公","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"忠","s":"忠","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"義","s":"义","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"滿","s":"满","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"朝","s":"朝","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"廷","s":"廷","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"事","s":"事","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"業","s":"业","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"滿","s":"满","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"邊","s":"边","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"隅","s":"隅","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"功","s":"功","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"名","s":"名","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"滿","s":"满","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"天","s":"天","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"下","s":"下","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"後","s":"后","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"世","s":"世","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"必","s":"必","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"史","s":"史","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"官","s":"官","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"書","s":"书","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"予","s":"予","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"可","s":"可","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"錄","s":"录","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"我只是推崇他的这件义行，因此写下来留给后世。","tokens":[{"t":"獨","s":"独","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"高","s":"高","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"義","s":"义","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"因","s":"因","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"遺","s":"遗","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"世","s":"世","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"云","s":"云","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"钱公辅记的是范仲淹设置义田的事。范仲淹是苏州人，显贵以后在靠近城郭、收成稳定的地方买田一千亩，供给聚居族人的口粮、衣服、嫁娶和丧葬，并写明每人每天、每年的数目。文中说他在显贵以前就有这个打算，力量不够，过了二十年；后来到西部领兵，又回朝参与大政，才有俸禄和赏赐可以把志愿做成。他死后，子孙仍照原来的规矩办理。钱公辅认为范仲淹的边功和忠义自有史官去写，自己只把这件周济族人的事留下来。","theme":"文章称赞的不是官位，而是范仲淹把俸禄变成一族人的生计，自己却穷到去世时缺少棺殓。义田的规矩写得很细：口粮、衣料、初嫁、再嫁、娶妇、再娶、丧葬、幼殇各有数目；退职在家等候差遣的人仍给，正在做官的人停发。这样写，是要说明这件义举有边界、可实行，不是笼统的慷慨。后半用晏子破车瘦马的故事作对照。晏子把赏赐散给父族、母族、妻族和靠他吃饭的士人。钱公辅认为范仲淹的义田规模更远，再转过来责备那些身居高位、却只顾自家府第车马的人。","technique":"先用好施一句总起，再点出义田的名称，然后用数字把办法写实，避免空泛的赞美。九十口、八百斛、充裕有余，是用来证明制度可以长久。写志向时拉出时间：未贵时已经有志，二十年做不到，领兵和参政之后才完成，死后子孙仍在办。中间插入晏子与桓子、齐侯的对话，把仁爱的次序说成先亲后疏，再引孟子由亲人推到百姓、由百姓推到万物，然后才说范仲淹超过晏子。结尾故意不展开忠义和边功，只说那些自有史官，自己单记义田，让一件家族生计压过通常墓志里的功名。","keyContentWords":[{"word":"义田","reading":"yì tián","note":"为周济族人而设置的田产。收成不归范仲淹私家挥霍，而按规矩供给族人。"},{"word":"负郭","reading":"fù guō","note":"靠近外城。负是背靠。这种田离城近，又写明常年丰收，便于长久供养族人。"},{"word":"缣","reading":"jiān","note":"细绢。每年的衣服按每人一匹计算。"},{"word":"斛","reading":"hú","note":"容量单位。文中说每年用八百斛稻谷供给聚居的九十口人。"},{"word":"沟中瘠","reading":"gōu zhōng jí","note":"沟壑里饿瘦而死的人。用来写族人流落乞食、无人收留。"}],"keyFunctionWords":[{"word":"咸","reading":"xián","note":"全、都。亲近而穷的、疏远而贤的，都在施舍之列。"},{"word":"与","reading":"yù","note":"「俟代者与焉」的与，是参与其中、也得到供给，不是和、跟。"},{"word":"云","reading":"yún","note":"句末语气词。「遗其世云」表示把这件事留给后世，云本身没有实义。"}],"ancientModern":[{"word":"大较","note":"大致的情形、大体的办法。不是今天所说的比较。"},{"word":"钟","note":"「万钟禄」的钟是量器，万钟形容俸禄极厚。不是计时的钟。"},{"word":"稍","note":"「廪稍」的稍读 shào，指官府发给的粮食。不是稍微。"}],"phoneticLoans":[{"word":"敛","loan":"殓","note":"「无以为敛」的敛通殓，把遗体装入棺材。范仲淹死时连这笔费用都没有。"},{"word":"疎","loan":"疏","note":"疎是疏的异体，关系远。文中与亲相对，指血缘远但人品好的人。"}],"flexibleUsage":[{"word":"主","note":"「主其计」的主作动词，主持、掌管账目。"},{"word":"觞","note":"前一个觞是酒杯，后一个「觞桓子」作动词，罚他饮酒。"},{"word":"高","note":"「高其义」的高作动词，认为这件义行高、加以推崇。"},{"word":"活","note":"「活族」的活是使动，使族人活下去。"}],"specialSyntax":[{"name":"判断句","note":"「范文正公，苏人也」用「也」字判断籍贯，开篇先定人，再写他做的事。"},{"name":"反问","note":"「岂少也哉」「又岂少哉」连用，责备高官只顾自己，族人却进不了门、甚至饿死。"}]},"classicComment":{"t":"常見世之貴顯者、徒自肥而已、視親族不異路人。如公之義、不獨難以望之晚近、卽求之千古以上、亦不可多得。作是記者、非特以之高公之義、亦以望後世之相感而效公也。","s":"常见世之贵显者、徒自肥而已、视亲族不异路人。如公之义、不独难以望之晚近、即求之千古以上、亦不可多得。作是记者、非特以之高公之义、亦以望后世之相感而效公也。"}}
