py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"養","s":"养","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"疾","s":"疾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"琴","s":"琴","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"亦","s":"亦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"將","s":"将","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"得","s":"得","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"焉","s":"焉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"所以我写了这篇谈琴的文字，赠给他送行。","tokens":[{"t":"故","s":"故","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"予","s":"予","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"作","s":"作","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"琴","s":"琴","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"說","s":"说","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"贈","s":"赠","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"行","s":"行","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"并且邀请道滋来饮酒，献上琴，作为告别。","tokens":[{"t":"且","s":"且","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"邀","s":"邀","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"道","s":"道","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"滋","s":"滋","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"酌","s":"酌","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"酒","s":"酒","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"進","s":"进","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"琴","s":"琴","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"別","s":"别","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"杨寘是欧阳修的朋友，喜欢学习，也有文才，多次应进士试不能得志，后来按照恩荫调到剑浦做县尉。剑浦远在东南，约当今福建南平一带，当时南方医药不足，饮食和风俗也跟他原来的生活不一样，而他又从年轻时就多病。欧阳修自己曾经得过一种深藏的忧病，退居也治不好，后来向朋友孙道滋学琴，弹得久了，才觉得病意渐渐不在身上。送别时他写下这篇谈琴的序，并请道滋一起饮酒，把琴献上，作为临别的赠与。","theme":"这篇赠序关心的是怎样安顿一颗既不平又多病的心。琴作为技艺本来很小，弹到极处，宫音与羽音、急声与缓声，却能送出崩裂、夜雨、叹息和鸟鸣。忧深思远的部分通向舜、文王和孔子留下的声音，悲愁感愤的部分则像伯奇和屈原的叹息。作者认为这样的声音可以疏导郁结。杨君职位低微，身在远方，风俗不宜，若只是硬忍，难以长久，所以劝他借琴平心，再来养病。琴既是道理，也是临别时递到手里的物件。","technique":"文章从自己的病落笔，先不提杨君。学琴只写受了几支宫调，久而觉得愉悦，病还在不在身上用不知轻轻带过，把效果留在体会里。中间论琴，连续用崩崖裂石、高山出泉、风雨夜至、怨夫寡妇、雌雄和鸣作比，再升到先王圣贤的遗音，比喻由耳边的声音推进到历史上的忧患。后半才说出剑浦、疾病和风俗，并把身体、心境、习俗三项叠成反问。结尾回到道滋、酒和琴，与开头的学琴相接，送行的事实和前面的琴理合成一篇。","keyContentWords":[{"word":"幽忧","reading":"yōu yōu","note":"深藏在内心的忧愁病痛。退而闲居也不能治，所以后面才转到学琴。"},{"word":"引","reading":"yǐn","note":"琴曲、乐段。受宫声数引，从孙道滋那里学得几支宫调曲子。宫是五音之一，声音宏大。"},{"word":"羽","reading":"yǔ","note":"五音之一。细者为羽，指细而清的声音，和宏大的宫音相对，用来概括琴声的两端。"},{"word":"湮郁","reading":"yān yù","note":"忧闷堵塞、郁结不畅。道其湮郁，把这团郁结疏导出去。"},{"word":"剑浦","reading":"Jiàn pǔ","note":"县名，在今福建南平。为尉于剑浦，到那里做县尉，是远离京城的小官。"},{"word":"少","reading":"shào","note":"年轻。且少又多疾，年纪不大却常常生病。下一句南方少医药的少读 shǎo，是缺少。"}],"keyFunctionWords":[{"word":"既而","reading":"jì ér","note":"过后，表示事情接着发生。闲居不能治病，既而才转向学琴。"},{"word":"及","reading":"jí","note":"等到。及其至也，等到琴艺达到极致；及从荫调，等到依荫调官。"},{"word":"以","reading":"yǐ","note":"相当于而，或表示目的。凄然以促，凄凉而又急促；平其心以养其疾，使心平，用来养病。"},{"word":"焉","reading":"yān","note":"于此。于琴亦将有得焉，从琴上也将会有收获。"}],"ancientModern":[{"word":"引","note":"古义在这里是乐曲。今多指引领、引用。"},{"word":"写","note":"写其幽思，写是抒发、宣泄。今多指用笔书写。"},{"word":"区区","note":"区区在东南数千里外，指微小的职位远在东南。今多作自谦，或强调数量很少。"},{"word":"宜","note":"风俗饮食异宜，宜是适宜，异宜就是不相合。今多指应当。"}],"phoneticLoans":[{"word":"道","loan":"导","note":"道其湮郁。道读 dǎo，疏导。把心里的郁结导引出去，不是讲述。"}],"flexibleUsage":[{"word":"乐","note":"久而乐之。形容词意动，以弹琴为乐。乐读 lè。"},{"word":"平","note":"平其心以养其疾。形容词使动，使他的心平静下来。"},{"word":"急、缓","note":"急者、缓者，形容词作名词，指急促的曲子和舒缓的曲子。和者，指和谐的音调。"}],"specialSyntax":[{"name":"状语后置","note":"学琴于友人孙道滋，向朋友孙道滋学琴。为尉于剑浦，在剑浦做县尉。地点和对象都放在于的后面。"},{"name":"反问句","note":"其能郁郁以久乎。用问句说出远宦、多病和不平叠在一起，难以长久撑持。"},{"name":"省略句","note":"取其和者之前，承上省略弹琴的人。听之以耳、应之以手，也没有另出主语。"}]},"classicComment":{"t":"送友序，竟作一篇琴說，若與送友絕不相關者。及讀至末段，始知前幅極力寫琴處，正欲爲楊子解其鬱鬱耳。文能移情，此爲得之。","s":"送友序，竟作一篇琴说，若与送友绝不相关者。及读至末段，始知前幅极力写琴处，正欲为杨子解其郁郁耳。文能移情，此为得之。"}}
