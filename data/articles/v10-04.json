tra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"幸","s":"幸","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"悟","s":"悟","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"則","s":"则","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"禍","s":"祸","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"斯","s":"斯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"及","s":"及","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"矣","s":"矣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"假使他一旦醒悟，揪住并把他们除掉就可以了。","tokens":[{"t":"使","s":"使","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"一","s":"一","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"悟","s":"悟","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"捽","s":"捽","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"去","s":"去","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"可","s":"可","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"宦官造成的祸患，即使想悔悟，情势也往往不能把他们除去。","tokens":[{"t":"宦","s":"宦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"禍","s":"祸","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"雖","s":"虽","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"欲","s":"欲","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"悔","s":"悔","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"悟","s":"悟","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"勢","s":"势","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"得","s":"得","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"去","s":"去","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"唐昭宗的事情就是这样。","tokens":[{"t":"唐","s":"唐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"昭","s":"昭","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"宗","s":"宗","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"事","s":"事","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"是","s":"是","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"已","s":"已","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"所以说比女祸更深，指的就是这一点，怎么能不警戒呢？","tokens":[{"t":"故","s":"故","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"深","s":"深","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"女","s":"女","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"禍","s":"祸","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"謂","s":"谓","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"此","s":"此","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"可","s":"可","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"戒","s":"戒","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"哉","s":"哉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"这篇是欧阳修写在《新五代史·宦者传》后面的论。宦者就是宦官。他整理五代史事时看到一种反复出现的局面：宦官在起居饮食的近处侍候君主，用小恩小信取得信任，再借祸福把君主控制住，朝廷上的忠臣和博学之士反而显得疏远。祸患藏在宫帷里面，等到发觉，慢了会把祸养得更深，急了宦官又会挟持君主做人质。文中用唐昭宗作例：昭宗并非不想除去宦官，可是宦官已经能把皇帝掌握在手里，外廷一旦操切，就容易两败。这篇论说的是这一类祸患为什么难以除掉。","theme":"全文用女色之祸作比较，是为了显出宦官之祸更难摆脱。在作者的分析里，女色主要是迷惑，君主一旦醒悟，还可以揪住除去。宦官却参与办事，离得近、摸得熟，心又专一而残忍，信任是一点点积成的。君主并不是一开始就想在宫里养祸、把贤士隔在外面，而是亲近日深、外臣日疏、自身日孤，恐惧越重，把持就越牢。从前以为可靠的左右，正是祸患所从出的地方。说它比女祸更深，是因为造成之后，悔悟也往往去不掉。","technique":"首句先下比较，第二句把女祸收成色而已，第三句说宦官之害不止一端，轻重在开头三句里就已经定了。中间用日益亲、日益疏、日益孤、日益切、日益牢连续推进，每一步都从前一步生出来，像把一个圈套写紧。写到补救时，缓和急两条路都走不通，圣智之人也无从商量，两难就被说死。后幅再回到女色，用捽而去之可也对照势有不得而去。唐昭宗只点出事例，不再铺开情节。结尾可不戒哉，把史论转向在位者，警告落在渐渐积成的势上。","keyContentWords":[{"word":"女祸","reading":"nǚ huò","note":"旧史把王朝灾祸归于后妃、女宠的说法。欧阳修拿它和宦官之祸比较，认为后者的根源更深。"},{"word":"中","reading":"zhòng","note":"投合。小善中人之意，用小小的好处击中君主的心意。不读中间的 zhōng。"},{"word":"硕士","reading":"shuò shì","note":"学识渊博、德行出众的人。忠臣硕士并列，都指朝廷上可倚靠的臣子。"},{"word":"帷闼","reading":"wéi tà","note":"帷幕和小门，指君主日常起居的内廷。祸患伏于帷闼，灾祸藏在宫禁近处。"},{"word":"质","reading":"zhì","note":"人质。挟人主以为质，把君主抓住，当作要挟的资本。"},{"word":"捽","reading":"zuó","note":"揪住。捽而去之，一手揪住，随即把人除掉。去，除去。"}],"keyFunctionWords":[{"word":"盖","reading":"gài","note":"因为，引出解释。盖其用事也近而习，说明宦官之害为什么不止一端。"},{"word":"所以","reading":"suǒ yǐ","note":"用来造成某种结果的途径。乃所以为患，正是祸患得以产生的根由。"},{"word":"斯","reading":"sī","note":"就。不幸而不悟，则祸斯及矣，祸患于是到来。"},{"word":"使","reading":"shǐ","note":"假使。使其一悟，如果他一旦醒悟。"},{"word":"已","reading":"yǐ","note":"是已，相当于矣，表示确认。唐昭宗之事是已，就是这样的例子。"}],"ancientModern":[{"word":"硕士","note":"古义是贤能博学的人。今硕士是一种学位名称。"},{"word":"一端","note":"非一端也，一端是一个方面、一种由来。今多指物体的一头，或事情的一点。"},{"word":"去","note":"去己疎远，去是距离；捽而去之，去是除去。今多指前往。"},{"word":"质","note":"古义在这里是人质。今多指质量、本质，或质问。"},{"word":"向","note":"向之所谓可恃者，向是从前。今多指方向、朝向。"},{"word":"快","note":"尽杀以快天下之心，快是使痛快。今多指速度快。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"固","note":"小信固人之心。形容词使动，使君主的心稳定下来、信任坚定。"},{"word":"亲、疎","note":"日益亲、日益疎。形容词作动词，亲近和疏远。疎就是疏。"},{"word":"惧","note":"惧以祸福而把持之。动词使动，用祸福使他害怕，再借此控制。"}],"specialSyntax":[{"name":"判断句","note":"女、色而已。用而已把判断收窄，女祸在作者笔下只剩下容色一件事。"},{"name":"转折句","note":"非欲养祸于内，而疎忠臣硕士于外，盖其渐积而势使之然也。先撇开存心，再指出是积累和情势造成的。"},{"name":"状语后置","note":"列于朝廷，列在朝廷上；伏于帷闼，潜伏在内廷之中。处所都放在于的后面。"}]},"classicComment":{"t":"宦官之禍、之漢唐而極。篇中詳悉寫盡。凡作無數層次、轉折不窮、只是深于女禍一句意。名論卓然、可爲千古龜鑑。","s":"宦官之祸、之汉唐而极。篇中详悉写尽。凡作无数层次、转折不穷、只是深于女祸一句意。名论卓然、可为千古龟鉴。"}}
