ict"},{"t":"已","s":"已","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"这是前代史书所记载的宦官之祸常常如此的情形，不是某一代才有的。","tokens":[{"t":"此","s":"此","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"前","s":"前","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"史","s":"史","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"載","s":"载","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"宦","s":"宦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"禍","s":"祸","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"常","s":"常","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"如","s":"如","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"此","s":"此","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"非","s":"非","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"一","s":"一","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"世","s":"世","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"做君主的人，并不是想在宫内养着祸患，把忠臣贤士疏远在外面，实在是逐渐积累、情势迫使他这样。","tokens":[{"t":"夫","s":"夫","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"主","s":"主","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"非","s":"非","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"欲","s":"欲","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"