"","pos":"","extra":"","level":"dict"},{"t":"公","s":"公","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"堂","s":"堂","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"幸","s":"幸","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"嘗","s":"尝","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"竊","s":"窃","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"誦","s":"诵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"公","s":"公","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"詩","s":"诗","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"樂","s":"乐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"公","s":"公","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"志","s":"志","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"成","s":"成","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"喜","s":"喜","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"天","s":"天","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"下","s":"下","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"道","s":"道","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"因此写下这篇文章。","tokens":[{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"是","s":"是","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乎","s":"乎","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"書","s":"书","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"韩琦是相州安阳人，官至宰相，封卫国公。至和年间，他以武康军节度使的身份出知相州，在州治的后园建昼锦堂。堂名用的是一句旧话：项羽认为富贵而不回故乡，好比穿着锦绣在夜里行走，谁也看不见。乡里把衣锦还乡看成最大的体面，韩琦却把这个意思反过来，在刻石的诗里警戒自己不可快意恩怨、矜夸名誉。欧阳修写这篇记的时候人在朝廷，文中明说未曾登堂，只读过那首诗，便借建堂一事，写出士人对这位宰相的看法。相州在今河南北部的安阳一带。","theme":"文章先承认常情：穷困时被人轻贱，得志后用车马仪仗惊吓乡里，苏秦受嫂冷遇、朱买臣被妻子离弃，都是这种荣耀的样本。接着把韩琦从这批人里分开。将相富贵是他素来就该有的，高牙大纛和桓圭衮裳都算不上他的光荣；真正的志向是德泽百姓、功在社稷，并且刻于金石、传于声诗。后半落到昼锦堂，并不赞赏还乡的排场，只证明他能把前人羡慕的事当成警戒，所以出将入相而夷险同一节操。光荣属于国家，不属于闾里。","technique":"开篇用「人情之所荣」定下常情，再用季子、买臣把这种光荣写得又热闹又难堪，然后以「惟大丞相卫国公则不然」整句翻过。翻过之后，「不足为公荣」「不足为公贵」两句把仪仗和礼服压下去，「惟德被生民」才抬起正意。写到建堂，堂的梁柱景色一字不写，只转述刻石诗的用意，让韩琦自己的话完成对照。结尾「余虽不获登公之堂」收得很淡，颂扬落在「喜为天下道」，避免写成一篇只夸府第的应酬文字。","keyContentWords":[{"word":"昼锦","reading":"zhòu jǐn","note":"白天穿锦绣，让乡人看见。用项羽「富贵不归故乡，如衣锦夜行」的话。堂名取此，文意却把这种荣耀看作不足夸。"},{"word":"季子","reading":"Jì zǐ","note":"苏秦，字季子。未得志时，嫂子不肯以礼相待。这里只举受辱的一件事，和他后来的煊赫相对。"},{"word":"买臣","reading":"Mǎi chén","note":"朱买臣。家贫时妻子离去，后来做会稽太守，衣锦还乡。句中「一旦」以下的车马场面，就是这种得志。"},{"word":"高牙大纛","reading":"gāo yá dà dào","note":"高高的牙旗和军中大旗，指出行的仪仗，借指将相的威风。纛读 dào。"},{"word":"桓圭衮裳","reading":"huán guī gǔn cháng","note":"桓圭是公爵所执的玉圭，衮裳是绘有龙纹的礼服。裳读 cháng，指下衣，不读轻声。合指最高爵位的服饰。"},{"word":"武康之节","reading":"wǔ kāng zhī jié","note":"武康军节度使的旌节。节是节度使的符信。和后文「夷险一节」的节操不是同一个意思。"},{"word":"垂绅正笏","reading":"chuí shēn zhèng hù","note":"绅是束在腰间、下垂的大带，笏是朝见时拿的手板。形容大臣临朝从容、端庄不慌。"},{"word":"相","reading":"xiàng","note":"相州，韩琦的故乡，今河南安阳一带。「公，相人也」「来治于相」「以遗相人」的相都读 xiàng，不是互相的 xiāng。"}],"keyFunctionWords":[{"word":"盖","reading":"gài","note":"句首语气，表示推原。盖士方穷时，是解释前面所说的「荣」为什么会让人觉得可贵。"},{"word":"见","reading":"jiàn","note":"见弃于其妻，见表示被动，等于被妻子抛弃。于引出动作的主动者。"},{"word":"惟","reading":"wéi","note":"只、只有。惟大丞相卫国公则不然，把韩琦从前面那一类人里单立出来。惟德被生民，也是把荣耀收束到德和功。"},{"word":"遗","reading":"wèi","note":"以遗相人，留给。读 wèi，不读遗失的 yí。"},{"word":"所以","reading":"suǒ yǐ","note":"用来……的。丰功盛烈所以铭彝鼎而被弦歌者，指那些被拿来刻鼎、配乐的功业，不是现代汉语里「因此」的意思。"}],"ancientModern":[{"word":"穷","note":"古：不得志、困窘。士方穷时，说的是仕途和处境堵着，不单指缺少钱财。今多指贫困。"},{"word":"易","note":"古：轻视。皆得易而侮之，是看轻他并且侮辱他。今多作容易、改变。"},{"word":"令","note":"古：美好。世有令德，是世代有美德。今多作命令、使。"},{"word":"素","note":"古：一向、本来。皆公所宜素有，是平素就应当拥有。今多指朴素，或作素菜。"},{"word":"夷","note":"古：平坦，这里引申为平安。夷险一节，是顺境和险境。今多指破坏，或作族称。"}],"phoneticLoans":[{"word":"士","loan":"仕","note":"登显士，通行文本多作「显仕」。这里的士指登上显要的官职，与「仕」通用，不是泛称读书人。"},{"word":"雠","loan":"仇","note":"快恩雠，就是快意于恩与仇。雠是仇的异体。"}],"flexibleUsage":[{"word":"衣","note":"衣锦之荣：衣是名词作动词，穿上，读 yì。穿锦衣回乡，才叫衣锦。"},{"word":"荣","note":"荣一乡：形容词作动词，使一乡获得荣耀。不是「一乡很光荣」的简单陈述。"},{"word":"快","note":"快恩雠：形容词作意动，以报复恩怨为快。矜是夸耀，和快并列，都被韩琦看成可薄。"}],"specialSyntax":[{"name":"被动句","note":"买臣见弃于其妻，用「见……于……」表示被动。季子不礼于其嫂，是嫂子不以礼待他，主动者由「于」引出。"},{"name":"判断句","note":"公，相人也。用「……者，……也」的省略形式直接判断籍贯。此一介之士……者也，也是用「者」「也」包住一长串叙述来下判断。"},{"name":"反问","note":"岂止夸一时而荣一乡哉、而其志岂易量哉，都用「岂」把意思说成不容停在乡里荣耀上。"}]},"classicComment":{"t":"魏公永叔、豈皆以晝錦爲榮者。起手便一筆撇開、以後俱從第一層立議、此古人高占地步處。按魏公爲相、永叔在翰林、人曰、天下文章、莫大于是、卽晝錦堂記。以永叔之藻采、著魏公之光烈、正所謂天下莫大之文章。","s":"魏公永叔、岂皆以昼锦为荣者。起手便一笔撇开、以后俱从第一层立议、此古人高占地步处。按魏公为相、永叔在翰林、人曰、天下文章、莫大于是、即昼锦堂记。以永叔之藻采、著魏公之光烈、正所谓天下莫大之文章。"}}
