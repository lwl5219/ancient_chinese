","pos":"","extra":"","level":"dict"},{"t":"夫","s":"夫","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"纍","s":"累","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"纍","s":"累","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乎","s":"乎","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曠","s":"旷","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"野","s":"野","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"與","s":"与","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"荒","s":"荒","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"城","s":"城","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"唉，曼卿！盛衰的道理，我本来就知道是这样。","tokens":[{"t":"嗚","s":"呜","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"呼","s":"呼","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曼","s":"曼","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"卿","s":"卿","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"盛","s":"盛","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"衰","s":"衰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"理","s":"理","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"吾","s":"吾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"固","s":"固","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"知","s":"知","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"如","s":"如","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"此","s":"此","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"可是感念往昔，悲凉凄怆，不觉对着风流下眼泪，这就有愧于最高境界里那种忘掉感情的人。","tokens":[{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"感","s":"感","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"念","s":"念","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"疇","s":"畴","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"昔","s":"昔","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"悲","s":"悲","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"涼","s":"凉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"悽","s":"凄","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"愴","s":"怆","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"覺","s":"觉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"臨","s":"临","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"風","s":"风","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"隕","s":"陨","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"涕","s":"涕","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"愧","s":"愧","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"夫","s":"夫","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"太","s":"太","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"上","s":"上","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"忘","s":"忘","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"情","s":"情","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"请来享用这些祭品。","tokens":[{"t":"尚","s":"尚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"饗","s":"飨","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"石延年字曼卿，北宋诗人，性情豪迈，诗文在当时很有名声，死时不满五十。欧阳修和他交谊深，早年曾给他写过墓表。治平四年七月，距离曼卿去世已经二十多年，欧阳修派遣尚书都省令史李敡，带着酒和肴馔到葬地太清代自己祭墓。太清在宋时南京应天府一带，今河南商丘附近。这篇不是刚死时的哭辞，而是隔着漫长岁月仍不能平静的追念。开篇的年月日、具官、谨遣，和结尾的尚飨，都是祭文的固定格式。","theme":"文中三次呼唤曼卿。第一次把人分成两半：形体和万物一样会死，名声却可以像日星一样留在简册上，这是圣贤共同的归宿，也是对朋友最庄重的安慰。第二次不甘心停在这个道理上，希望埋在地下的轩昂磊落化为金玉，或者长出千尺青松、九茎灵芝；眼前却是荒烟、荆棘、磷火和牧童的歌声，再过千年，还可能成为狐貉鼯鼪的洞穴。第三次承认盛衰之理自己早就明白，仍然临风落泪，并说这样有愧于太上的忘情。愧的是不能忘，写下的却正是不能忘。","technique":"三声「呜呼曼卿」把文章分成道理、墓景和自责。写不朽时，用暂时聚合的形体对照后世的名声，句子整齐。写墓地时，荒烟、野蔓、荆棘、风露、磷火、飞萤、牧童、樵叟、惊禽、骇兽接连出现，和前面想象的金玉、长松、灵芝正好相反。「不然」先抬起一个美好的猜想，「奈何」马上把它按灭。句中的「兮」到墓景后半才出现，散文忽然带上挽歌的拖腔。收束不讲道理，只说流泪有愧于忘情，情感因此更重。","keyContentWords":[{"word":"具官","reading":"jù guān","note":"祭文里把作者的全部官衔从略，只写具官，表示官职另有全称。后面紧接欧阳修的名字。"},{"word":"清酌庶羞","reading":"qīng zhuó shù xiū","note":"清酒和多种肴馔。酌是酒，庶是众多，羞是精美的食物。这是带到墓前的祭品。"},{"word":"太清","reading":"Tài qīng","note":"曼卿墓所在。宋时属南京应天府，今在河南商丘一带。李敡是被派到这里代祭的吏员。"},{"word":"轩昂磊落","reading":"xuān áng lěi luò","note":"气度不凡、心地光明。加上突兀峥嵘，写的是曼卿的精神气质，不是墓地上的石头。"},{"word":"走燐","reading":"zǒu lín","note":"磷火游动。走是移动，燐是坟间的磷火。和飞萤并列，写墓地夜里的光。"},{"word":"鼯鼪","reading":"wú shēng","note":"鼯鼠和鼪鼠，都是在洞穴中出没的小兽。穴藏狐貉与鼯鼪，是想象坟墓日后更加荒秽。貉读 hé。"},{"word":"畴昔","reading":"chóu xī","note":"从前。感念畴昔，指想起和曼卿交往的那些日子。"},{"word":"尚飨","reading":"shàng xiǎng","note":"祭文的结束语。尚是希望，飨是请鬼神来享用祭品。"}],"keyFunctionWords":[{"word":"维","reading":"wéi","note":"祭文发语词，用来引出年月日。本身没有实在动作。"},{"word":"乎","reading":"hū","note":"相当于于。同乎万物生死，是和万物的生死相同。"},{"word":"意","reading":"yì","note":"料想、推测。意其不化为朽壤，是希望如此，并不是墓中已经看见金玉。"},{"word":"兮","reading":"xī","note":"舒缓的语气，接近楚歌。更千秋而万岁兮，让句子在荒凉的想象里拖长。"},{"word":"莫","reading":"mò","note":"没有谁。莫不皆然，是没有哪一位圣贤能避开形体消灭、名声存留这件事。"}],"ancientModern":[{"word":"灵","note":"古：神灵。死而为灵，是死后成为不灭的精魂。今多指灵活、灵验。"},{"word":"子","note":"古：对对方的尊称，这里指曼卿，等于你。吾不见子久矣。今多指儿子。"},{"word":"简册","note":"古：史书、典籍。著在简册，是名字被写进书里。今已少用，简多指简单。"},{"word":"城","note":"古：这里指坟墓。累累乎旷野与荒城，是旷野和荒坟上密密的坟堆。今指城市。"},{"word":"欲","note":"本句「致祭欲亡友之墓下」，通行文本作「于」。按祭文的文意，是到亡友墓前致祭，不取想要的意思。"},{"word":"羞","note":"古：精美的食物。庶羞就是多种肴馔，后来这种意思写作馐。今多指害羞。"}],"phoneticLoans":[{"word":"唫","loan":"吟","note":"歌唫就是歌吟。唫这里读 yín，不取闭口义的 jìn。"},{"word":"燐","loan":"磷","note":"走燐的燐，就是磷火的磷，读 lín。"},{"word":"髣髴","loan":"仿佛","note":"犹能髣髴子之平生，是还能依稀记起你的生平。髣髴即仿佛，读 fǎng fú。"}],"flexibleUsage":[{"word":"英","note":"生而为英：英是名词，成为杰出的人物。和死而为灵相对，一个说生前，一个说死后。"},{"word":"穴","note":"穴藏狐貉与鼯鼪：穴是名词作动词，打洞。说的是野兽在墓中掘穴藏身。"},{"word":"吊","note":"吊之以文：吊是动词，祭奠、哀悼。以文是用这篇文章。今吊多指悬挂。"}],"specialSyntax":[{"name":"判断句","note":"同乎万物生死而复归于无物者，暂聚之形；不与万物共尽者，后世之名。用「者」把哪一部分会朽、哪一部分不朽判断清楚。"},{"name":"祭文格式","note":"维年月日、具官、谨遣某人至于某地、以某物致祭、而吊之以文，是祭文的起笔；尚飨是固定的收束。中间的呜呼才进入私情。"},{"name":"反问","note":"安知其不穴藏狐貉与鼯鼪、独不见夫累累乎旷野与荒城，用反问打破前面金玉长松的希望，承认墓地终究会同于荒坟。"}]},"classicComment":{"t":"篇中三提曼卿、一歎其聲名、卓然不朽。一悲其墳墓、滿目淒涼。一敍己交情、傷感不置。文亦軒昂磊落、突兀崢嶸之甚。","s":"篇中三提曼卿、一叹其声名、卓然不朽。一悲其坟墓、满目凄凉。一敍己交情、伤感不置。文亦轩昂磊落、突兀峥嵘之甚。"}}
