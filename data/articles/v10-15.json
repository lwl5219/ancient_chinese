,"extra":"","level":"dict"},{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"已","s":"已","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"亂","s":"乱","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"豈","s":"岂","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"異","s":"异","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"術","s":"术","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"哉","s":"哉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"？","s":"？","punct":true}]},{"tr":"不过是节制自己的喜和怒，不离开仁罢了。","tokens":[{"t":"制","s":"制","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"喜","s":"喜","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"怒","s":"怒","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"失","s":"失","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乎","s":"乎","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"仁","s":"仁","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"已","s":"已","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"矣","s":"矣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"《春秋》的原则是：设立法度贵在严厉，责备具体的人贵在宽厚。依照它褒贬的原则来制定赏罚，也是忠厚到了极点。","tokens":[{"t":"《","s":"《","punct":true},{"t":"春","s":"春","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"秋","s":"秋","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"》","s":"》","punct":true},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"義","s":"义","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"立","s":"立","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"法","s":"法","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"貴","s":"贵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"嚴","s":"严","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"責","s":"责","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"貴","s":"贵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"寬","s":"宽","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"因","s":"因","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"褒","s":"褒","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"貶","s":"贬","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"義","s":"义","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"制","s":"制","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"賞","s":"赏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"罰","s":"罚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"亦","s":"亦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"忠","s":"忠","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"厚","s":"厚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"至","s":"至","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"《刑赏忠厚之至论》是苏轼嘉祐二年应礼部试写的文章，主考是欧阳修，参与评卷的有梅尧臣。题目要求说明赏和罚怎样才算忠厚到极点。苏轼从尧舜写到成王、康王，再落到《尚书》里罪疑从轻、功疑从重的话，主张可赏可不赏时偏向赏，可罚可不罚时不要硬罚。文中“皋陶三次说杀、尧三次说宽赦”不见于经传，是他按经书的用意自己编的事例。梅尧臣后来问出处，苏轼说这是想当然。这篇试文使他得到欧阳修的识拔，但文中的故事不能当成上古实录。","theme":"忠厚在这篇文章里不是放松法度，而是遇到疑惑时把分量加到人的一边。赏错了，仍是君子多给了一点；罚错了，就会从公正滑进残忍。所以仁可以过，义不可以过。爵位俸禄和刀锯都只能碰到一部分人，天下的善赏不完，恶也罚不完，先王才把疑惑一律收回到仁上，让天下跟着学这种做法。皋陶坚持杀、尧坚持赦，四岳荐鲧、尧先拒绝后又试用，两件事都用来说明：对人的处置有疑，就从宽。结尾的喜和怒也一样，可以有，只是不能离开仁。","technique":"开头用八个圣王的名字堆成一声感叹，让“君子长者之道”先站稳，再用赏与罚两排长句对照：一边是歌咏赞叹，一边是哀怜惩戒。中间三次把“疑”说满，先引“赏疑从与、罚疑从去”，再排皋陶和四岳两段叙事，然后用《尚书》的原句收住。后半换成判断：仁可过、义不可过，接着用爵禄和刀锯做另一组排比，说明器物够不到的地方要靠待人的厚道。结尾引《诗》和《春秋》，不再另起主张，只把前面的仁收成“节制喜怒”和“立法严、责人宽”。","keyContentWords":[{"word":"祥刑","reading":"xiáng xíng","note":"善用刑罚，见于《尚书·吕刑》。祥是善，不是吉祥的祥瑞。穆王把这套道理告诉吕侯。"},{"word":"皋陶","reading":"Gāo Yáo","note":"传说中尧舜时的刑官。陶在这个名字里读 yáo，不读 táo。文中说他三次坚持杀人，是用来衬托尧的宽。"},{"word":"不经","reading":"bù jīng","note":"不合通常的法度。“宁失不经”是宁可自己承担失于过宽的过失，也不杀掉无罪的人。"},{"word":"祉","reading":"zhǐ","note":"喜，这里指君子喜好贤人并给予好处。《诗经》的意思是：这样，祸乱差不多很快停止。遄读 chuán，是快。"}],"keyFunctionWords":[{"word":"乎","reading":"hū","note":"“过乎仁”的乎等于“于”，超过在仁这一边。同篇“无失乎仁”也是不在仁上有缺失。"},{"word":"其","reading":"qí","note":"“何其爱民之深”的其加强感叹，相当于“多么”。它不代替某一个具体的人。"}],"ancientModern":[{"word":"士","note":"“皋陶为士”的士是掌管刑狱的官，不是读书人，也不是士兵。"},{"word":"劝","note":"“不足以劝”的劝是劝勉、鼓励人向善，不是用言语劝阻。"}],"phoneticLoans":[{"word":"方","loan":"放","note":"“方命”的方通“放”，放弃、违背上面的命令。后面的“圮”读 pǐ，是毁坏。"}],"flexibleUsage":[{"word":"已","note":"“已乱”的已是动词，止息祸乱。同篇“乱庶遄已”的已也是停止，不是“已经”。"},{"word":"乐","note":"“乐其始”的乐读 lè，是动词，为他有好的开头而高兴，并由此勉励他走到终了。"}],"specialSyntax":[{"name":"主谓之间加“之”","note":"“何尧之不听皋陶之杀人”在主语和谓语之间加“之”，把整句收成疑问的内容，重点落在“为什么”。"},{"name":"省略","note":"“赏疑从与”“罪疑惟轻”都省掉了“有”和“则”，补全是赏若有疑则从给予，罪若有疑则从轻。"}]},"classicComment":{"t":"此長公應試文也。只就本旨，從「疑」上全寫其忠厚之至。每段述事，而斷以婉言警語。天才燦然，自不可及。","s":"此长公应试文也。只就本旨，从「疑」上全写其忠厚之至。每段述事，而断以婉言警语。天才灿然，自不可及。"}}
