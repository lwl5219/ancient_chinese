:"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"危","s":"危","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"日","s":"日","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"夜","s":"夜","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"淬","s":"淬","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"礪","s":"砺","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"東","s":"东","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"向","s":"向","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"待","s":"待","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"使","s":"使","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"至","s":"至","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"累","s":"累","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"則","s":"则","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"天","s":"天","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"將","s":"将","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"恃","s":"恃","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"恐","s":"恐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"即使有一百个袁盎，又能从中离间得了吗？","tokens":[{"t":"雖","s":"虽","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"百","s":"百","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"盎","s":"盎","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"可","s":"可","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"得","s":"得","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"間","s":"间","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"哉","s":"哉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"？","s":"？","punct":true}]}]},{"sentences":[{"tr":"唉，可叹啊！","tokens":[{"t":"嗟","s":"嗟","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"夫","s":"夫","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"！","s":"！","punct":true}]},{"tr":"世上的君子想求不寻常的功业，就不要致力于保全自己的办法。","tokens":[{"t":"世","s":"世","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"欲","s":"欲","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"求","s":"求","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"非","s":"非","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"常","s":"常","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"功","s":"功","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"則","s":"则","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"務","s":"务","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"自","s":"自","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"全","s":"全","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"計","s":"计","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"假如晁错亲自率军讨伐吴、楚，未必不能成功。","tokens":[{"t":"使","s":"使","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"錯","s":"错","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"自","s":"自","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"將","s":"将","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"討","s":"讨","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"吳","s":"吴","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"楚","s":"楚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"未","s":"未","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"必","s":"必","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"功","s":"功","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"只因为他想让自己站稳、不受危险，天子心里不高兴，奸臣才得以钻这个空子。","tokens":[{"t":"惟","s":"惟","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"欲","s":"欲","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"自","s":"自","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"固","s":"固","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"身","s":"身","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"天","s":"天","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"悅","s":"悦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"奸","s":"奸","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"臣","s":"臣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"得","s":"得","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乘","s":"乘","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"隙","s":"隙","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"晁错用来保全自己的办法，竟成了他给自己招祸的原因啊！","tokens":[{"t":"錯","s":"错","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"自","s":"自","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"全","s":"全","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"乃","s":"乃","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"自","s":"自","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"禍","s":"祸","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"歟","s":"欤","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"！","s":"！","punct":true}]}]}],"lesson":{"background":"篇题“鼌错”就是晁错，鼌、鼂、晁是同一姓氏的不同写法，正文里写作晁错。他是西汉景帝时的御史大夫。文帝时已屡次上书言事，景帝即位后更主张削夺诸侯封地。吴、楚等七国以清君侧为名起兵。《汉书》记载，变起之后晁错建议景帝亲自带兵，自己留守长安。袁盎与他有隙，乘机说杀掉晁错就可以平息叛乱。景帝让他穿着朝服，在东市把他处死。叛乱并没有因此停止，后来靠周亚夫等人用兵才被平定。苏轼承认他尽忠，却不把这事只写成一桩冤案。","theme":"天下最难办的，是外表太平、里面却有无法预料的忧患。看着不管，会不可救；急着动手，习惯了安逸的人又不信。能成大功的人，必须自己惹出的大难自己收场。晁错削藩的方向，苏轼并不否定。七国强大，骤然削减，作乱并不奇怪。他的失策在于：自己是发难的人，变起之后却想留守，让天子亲征，把最危险的位置让给君主，自己挑最安全的。忠臣义士所以不平，正在这里。即便没有袁盎，景帝心里已经为难，又难于驳回他的主张，谗言才钻得进去。假如晁错亲自面向东方承担危局，天子依靠他，许多个袁盎也离间不成。他用来自全的办法，正是他自取杀身的原因。","technique":"前九句完全不提晁错，先讲太平之世如何发难、如何收场，立下一条通则：自己发动的事，自己要能收拾，才对天下说得过去；事情来了却想抽身，祸就会集到自己身上。然后再用“昔者晁错”进入史事，读者已经带着这条通则去看削藩。大禹治水是正面的比照：功未成时也有溃决，可贵的是预先知道必然之势，事到了不惧。七国骤削以下转入责备，亲自统兵的危险和留守的安全反复对举。袁盎出现得很晚，而且立刻被“即使没有袁盎也未必能免祸”压住，不把责任全部推给一个进谗的人。末段用假设再写一遍：若晁错自己带兵，未必没有功。最后一句把自全和自祸扣成一个判断。","keyContentWords":[{"word":"鼌错","reading":"cháo cuò","note":"即晁错。篇题用鼌，也写作鼂，正文用晁，指景帝时力主削藩的御史大夫。"},{"word":"期月","reading":"jī yuè","note":"一整月。这里与后文的坚忍对举，指很短的时间。期不读 qī。"},{"word":"山东","reading":"shān dōng","note":"崤山以东，指关东诸侯，不是今天的山东省。七国之乱的诸王多在这一带。"},{"word":"淬砺","reading":"cuì lì","note":"淬火和磨刀，比喻日夜锻炼、认真准备。这里指晁错若亲自迎战，就该这样对待危局。"},{"word":"重违","reading":"zhòng wéi","note":"难以违背。重读 zhòng，是难的意思。景帝既已觉得亲征为难，又难于驳回晁错的建议。"}],"keyFunctionWords":[{"word":"所","reading":"suǒ","note":"不为之所的所，是处置的地方、办法。所以自全者的所，和以连用，表示用来自全的办法。"},{"word":"焉","reading":"yān","note":"循循焉的焉是词尾，附在形容状态的词后面，表示那种样子。"},{"word":"乃","reading":"nǎi","note":"乃其所以自祸欤的乃，是竟然、就是。把自全和自祸说成同一件事。"}],"ancientModern":[{"word":"当然","note":"前知其当然，指预先知道事情必然如此。今天的当然多是“理所应当、那还用说”。"},{"word":"说","note":"以错为之说、袁盎之说，都读 shuō，指说法、建议、向人交代的话。不是喜悦，也不读游说的 shuì。"},{"word":"捐","note":"捐其身是舍弃自己的生命。今天的捐多指捐钱、捐物。"},{"word":"冲","note":"当大难之冲的冲读 chōng，是要冲、冲突的最前方。今天多作冲向、冲动。"},{"word":"非常","note":"非常之功是不寻常的功业。今天的非常多作程度副词，表示很。"},{"word":"安","note":"安所逃其患的安是哪里。居守之至安的安才是安全。同一个字在篇中两读两义。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"弱","note":"谋弱山东之诸侯的弱，形容词使动，使诸侯的力量变弱，也就是削藩。"},{"word":"难","note":"天子固已难之的难读 nán，意动用法，以亲征这件事为难。"},{"word":"东向","note":"东向而待之，名词用作状语，面向东方。吴、楚在关东，所以向东等待叛军。"},{"word":"固","note":"自固其身的固，使动用法，使自身稳固、安全。"}],"specialSyntax":[{"name":"否定句代词宾语前置","note":"不吾信等于不信吾，不之察等于不察之。否定句里，代词宾语吾、之放到动词前面。"},{"name":"判断句","note":"此忠臣义士所以愤怨而不平者也。错之所以自全者，乃其所以自祸欤。用者、也、乃把原因说成判断。"},{"name":"假设复句","note":"使吴楚反、使错自将，两处的使都是假如。后面的则推出天子无恐、未必无功，不是已经发生的事。"}]},"classicComment":{"t":"此篇先立冒頭，然後入事，又是一格。晁錯之死，人多嘆息，然未有説出被殺之由者。東坡之論，發前人所未發，有寫錯罪狀處，有代錯畫策處，有爲錯致惜處，英雄失足，千古興嗟。任大事者，尙其思堅忍不拔之義哉！","s":"此篇先立冒头，然后入事，又是一格。晁错之死，人多叹息，然未有说出被杀之由者。东坡之论，发前人所未发，有写错罪状处，有代错画策处，有为错致惜处，英雄失足，千古兴嗟。任大事者，尙其思坚忍不拔之义哉！"}}
