"","level":"dict"},{"t":"粟","s":"粟","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"一场雨下了三天，这是谁的力量？","tokens":[{"t":"一","s":"一","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"雨","s":"雨","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"三","s":"三","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"日","s":"日","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"伊","s":"伊","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"誰","s":"谁","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"力","s":"力","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"？","s":"？","punct":true}]},{"tr":"百姓说是太守。","tokens":[{"t":"民","s":"民","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"太","s":"太","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"守","s":"守","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"太守不把功劳据为己有，把它归给天子。","tokens":[{"t":"太","s":"太","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"守","s":"守","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"歸","s":"归","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"天","s":"天","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"天子说并非如此，把它归给造物。","tokens":[{"t":"天","s":"天","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"然","s":"然","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"歸","s":"归","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"造","s":"造","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"物","s":"物","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"造物不认为是自己的功劳，把它归给太空。","tokens":[{"t":"造","s":"造","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"物","s":"物","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"自","s":"自","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"功","s":"功","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"歸","s":"归","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"太","s":"太","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"空","s":"空","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"太空幽远昏昧，没有办法给它命名。","tokens":[{"t":"太","s":"太","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"空","s":"空","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"冥","s":"冥","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"冥","s":"冥","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"可","s":"可","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"得","s":"得","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"名","s":"名","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"我就用雨来给我的亭子命名。","tokens":[{"t":"吾","s":"吾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"名","s":"名","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"吾","s":"吾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"亭","s":"亭","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"歌到这里结束。","tokens":[{"t":"」","s":"」","punct":true}]}]}],"lesson":{"background":"嘉祐六年，苏轼到凤翔府任签书判官，文中的扶风是凤翔的旧称。到任的第二年，他修治官舍，在堂北建亭，亭南凿池。那年春天先有天降麦子的兆头，被人看成丰年；跟着却整整一个月不下雨，百姓由盼望转为忧虑。三月里乙卯、甲子两场雨仍嫌不足，到丁卯才大雨三日。雨停时亭子正好完工。苏轼在亭上设酒，把游乐是否可能，直接系在麦子和禾苗的有无上，并因此把亭子命名为喜雨。","theme":"喜的不是亭，而是雨保住了一年的收成，人才能在亭中休息。开篇说古人有喜就用来给事物命名，是为了不忘。酒宴上的问答把这个意思说透：五日无麦，十日无禾，接着就是饥荒、讼狱和盗贼，亭中的优游也就无从谈起。歌辞再把功劳一层层送出去，太守不占，天子不居，造物也不自居，最后推到无从命名的太空。太空既然不能命名，苏轼就把这份不能忘记的喜记在亭名上。一场地方上的及时雨，写成了官与民共同的庆幸。","technique":"先立通例，再用三件古事垫高命名的分量：周公以禾名书，汉武帝以鼎名年，叔孙得臣以胜敌给儿子取名。三件事大小悬殊，不忘这一点相同，喜雨亭因而有了着落。叙事严格按节气和干支推进，乙卯、甲子、丁卯越下越大，官、商、农三组庆贺排在一起，亭的落成只用适成二字带出。对话用五日、十日步步收紧，把快乐建立在麦禾之上。结尾改用歌，雨珠、雨玉接上前面的雨麦，归功的句子短而整齐，直到不可得而名，才落回吾以名吾亭。","keyContentWords":[{"word":"有年","reading":"yǒu nián","note":"丰年。有是丰足。天降麦子之后，占测认为年成会好。"},{"word":"荐饥","reading":"jiàn jī","note":"接连发生的饥荒。荐是一再、重复。无麦又无禾，所以说岁且荐饥。"},{"word":"忭","reading":"biàn","note":"拍手欢喜。农夫相与忭于野，和官吏庆于庭、商贾歌于市并列。"},{"word":"造物","reading":"zào wù","note":"生成万物的天地。歌里天子不居功，把雨归给造物。"}],"keyFunctionWords":[{"word":"志","reading":"zhì","note":"记载。亭以雨名，志喜也，是用亭名把这场喜记下来。"},{"word":"伊","reading":"yī","note":"语助词。伊谁之力，就是谁的力量，伊没有实在意义。"}],"ancientModern":[{"word":"志","note":"记下。今多指志向、意志。志喜是把喜悦记录下来。"},{"word":"适","note":"恰好。而吾亭适成，是亭子正好在这时建成。今多指适合、舒适。"},{"word":"属","note":"劝人饮酒。以属客而告之，是举酒劝客，再把道理告诉他们。读 zhǔ，今多指隶属、类别。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"雨","note":"雨麦、雨珠、雨玉的雨都作动词，读 yù，意思是从天上落下。麦、珠、玉是落下的东西。"},{"word":"名","note":"以名其书、以名其年、以名其子、以名吾亭，名都由名词用作动词，是命名。"}],"specialSyntax":[{"name":"判断句","note":"亭以雨名，志喜也。也字判断，说明用雨命名是为了记喜。其示不忘一也，也是同一句式。"},{"name":"状语后置","note":"为亭于堂之北、举酒于亭上、庆于庭、歌于市、忭于野，都把处所补在动词后面。"}]},"classicComment":{"t":"只就「喜雨亭」三字，分寫、合寫、倒寫、順寫、虛寫、實寫，即小見大，以無化有。意思愈出而不窮，筆態輕舉而蕩漾，可謂極才人之雅致矣。","s":"只就「喜雨亭」三字，分写、合写、倒写、顺写、虚写、实写，即小见大，以无化有。意思愈出而不穷，笔态轻举而荡漾，可谓极才人之雅致矣。"}}
