其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"可","s":"可","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"得","s":"得","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"耶","s":"耶","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"？","s":"？","punct":true}]},{"tr":"现在上天不抛弃这里的百姓，干旱刚刚开始就赐下雨水，使我和你们能够一起在这座亭里从容游乐，这都是雨的恩赐。","tokens":[{"t":"今","s":"今","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"天","s":"天","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"遺","s":"遗","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"斯","s":"斯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"民","s":"民","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"始","s":"始","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"旱","s":"旱","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"賜","s":"赐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"雨","s":"雨","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"使","s":"使","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"吾","s":"吾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"與","s":"与","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"二","s":"二","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"三","s":"三","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"得","s":"得","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"相","s":"相","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"與","s":"与","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"優","s":"优","py":"","ct