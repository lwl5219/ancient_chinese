extra":"","level":"dict"},{"t":"復","s":"复","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"擊","s":"击","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"独自在涧谷之间过一整天啊，啄着青苔，踩着白石。","tokens":[{"t":"獨","s":"独","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"終","s":"终","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"日","s":"日","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"澗","s":"涧","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"穀","s":"谷","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"間","s":"间","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"兮","s":"兮","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"啄","s":"啄","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"蒼","s":"苍","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"苔","s":"苔","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"履","s":"履","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"白","s":"白","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"石","s":"石","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"鹤归来啊，回到东山的北坡。","tokens":[{"t":"鶴","s":"鹤","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"歸","s":"归","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"來","s":"来","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"兮","s":"兮","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"東","s":"东","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"山","s":"山","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"陰","s":"阴","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"那下面有一个人啊，头戴黄冠，脚穿草鞋，披着葛衣弹琴。","tokens":[{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"下","s":"下","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"兮","s":"兮","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"黃","s":"黄","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"冠","s":"冠","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"草","s":"草","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"履","s":"履","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"葛","s":"葛","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"衣","s":"衣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"鼓","s":"鼓","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"琴","s":"琴","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"亲自耕种来吃啊，剩下的用来喂饱你。","tokens":[{"t":"躬","s":"躬","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"耕","s":"耕","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"食","s":"食","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"兮","s":"兮","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"餘","s":"余","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"汝","s":"汝","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"飽","s":"饱","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"归来吧，归来吧，西山不可以久留。","tokens":[{"t":"歸","s":"归","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"來","s":"来","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"歸","s":"归","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"來","s":"来","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"兮","s":"兮","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"西","s":"西","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"山","s":"山","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"可","s":"可","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"久","s":"久","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"留","s":"留","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"歌到这里结束。","tokens":[{"t":"」","s":"」","punct":true}]}]}],"lesson":{"background":"熙宁十年秋天，徐州大水，文中称彭城。云龙山人张天骥的草堂被水淹到半扇门。第二年春天水退，他迁到旧居以东的东山脚下，对着西面山环的缺口建亭。他养两只鹤，早晨朝缺口放出去，傍晚向东山飞回，亭因此叫放鹤亭。苏轼当时做徐州知州，常带宾客僚属到亭中饮酒。这篇记先写山水和鹤，再借太守对山人的一番话，比较人主之乐和隐居之乐，最后用山人的放鹤、招鹤之歌收束。","theme":"同样的事物，落在君主和隐士身上，结果完全不同。鹤清远闲放，《易》和《诗》都拿它比贤人君子，隐士亲近它，似乎有益无损；卫懿公却因为好鹤亡了国。酒被周公的《酒诰》、卫武公的《抑》看成最能荒惑败乱的东西，刘伶、阮籍却靠它保全真性，名留后世。因此面南而王的人，连鹤也不能爱好；遁世的人，连酒也不能加害，何况鹤。两种快乐不能同日而语。苏轼以郡守的身份说出这番话，把更高的快乐让给山人。歌里先放鹤远去，再招它回到黄冠草履、躬耕鼓琴的人身边。","technique":"记事很短，山水只用大环缺其西一面来定亭的位置，春夏、秋冬和风雨晦明三层写景，都为后面的放鹤准备去处。鹤的行踪晨出暮归，本身就是放和招。议论放在饮酒时的对话里，先引《易》《诗》把鹤说成贤者，随即用卫懿公翻出祸事；再说酒的败乱，随即用刘伶、阮籍翻出全真。两翻之后才推出南面之君不得好鹤、山林之士酒不能害的结论。山人只答有是哉，不再辩理，用歌词把西山之缺、东山之阴和亭下之人连成一次放与招。","keyContentWords":[{"word":"南面","reading":"nán miàn","note":"面朝南坐。古代君主听政面向南方，南面之君就是称君的人。"},{"word":"九皋","reading":"jiǔ gāo","note":"深远的沼泽。九表示极深。鹤鸣于九皋，声闻于天，出《诗经·小雅·鹤鸣》。"},{"word":"傃","reading":"sù","note":"朝着、向着。暮则傃东山而归，是傍晚向东山飞回来。"},{"word":"黄冠","reading":"huáng guān","note":"隐士的装束。歌中山人黄冠草履、葛衣鼓琴，在东山北坡耕种并喂鹤。"}],"keyFunctionWords":[{"word":"及","reading":"jí","note":"到达。水及其半扉，是洪水涨到门板的一半，及不是和。"},{"word":"如","reading":"rú","note":"往、到。纵其所如，是任凭鹤飞到它想去的地方。这里不是如同。"}],"ancientModern":[{"word":"阴","note":"背阴的地方，山的北面也叫阴。鸣鹤在阴，是鹤在阴蔽处；东山之阴，是东山北坡。不是阴险。"},{"word":"易","note":"交换。未可与易，是不能拿君主的地位去换隐居的快乐。今多指容易，或改变。"},{"word":"集","note":"鸟停落。宛将集兮，是鹤仿佛就要降落。不是今天的集合、集市。"},{"word":"适","note":"往、到。择所适，是选择要飞去的地方。今多指适合、舒服。"}],"phoneticLoans":[{"word":"挹","loan":"揖","reading":"yì","note":"作揖。挹山人而告之，是向山人行礼，然后把这番话说给他听。"}],"flexibleUsage":[{"word":"饱","note":"其余以汝饱。饱是使动用法，把吃剩的粮食用来使鹤吃饱。"},{"word":"放","note":"望西山之缺而放焉。放是放开、放飞，鹤早晨被放到山外，亭名的放鹤即由此而来。"}],"specialSyntax":[{"name":"状语后置","note":"饮酒于斯亭、鹤鸣于九皋、立于陂田、翔于云表，都把处所放在动词后面。"},{"name":"固定句式","note":"未可以同日而语，意思是两类事物相差很远，不能放在一起比较。这里比较的是人主之乐和隐居之乐。"}]},"classicComment":{"t":"記放鶴亭，卻不實寫隱士之好鶴。乃於題外尋出「酒」字，與「鶴」字作對。兩兩相較，真見得南面之樂無以易隱居之樂。其得心應手處，讀之最能發人文機。","s":"记放鹤亭，却不实写隐士之好鹤。乃于题外寻出「酒」字，与「鹤」字作对。两两相较，真见得南面之乐无以易隐居之乐。其得心应手处，读之最能发人文机。"}}
