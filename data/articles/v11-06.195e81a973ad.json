l":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"能","s":"能","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"言","s":"言","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"此","s":"此","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"世","s":"世","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"傳","s":"传","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"浅陋的人竟用斧头敲打去寻求，自己以为得到了真相。","tokens":[{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"陋","s":"陋","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乃","s":"乃","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"斧","s":"斧","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"斤","s":"斤","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"考","s":"考","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"擊","s":"击","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"求","s":"求","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"自","s":"自","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"得","s":"得","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"實","s":"实","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"我因此记下这件事，是叹惜郦道元写得简略，并且笑话李渤的浅陋。","tokens":[{"t":"餘","s":"余","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"是","s":"是","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"記","s":"记","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"蓋","s":"盖","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"嘆","s":"叹","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"酈","s":"郦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"元","s":"元","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"簡","s":"简","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"笑","s":"笑","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"李","s":"李","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"渤","s":"渤","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"陋","s":"陋","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"元丰七年六月，苏轼由齐安前往临汝，送长子苏迈赴饶州德兴县尉，路过鄱阳湖口。石钟山在湖口附近，分上下两山。北魏郦道元在《水经注》里说，山下深潭里风浪击石，声音像大钟。唐代李渤亲自寻访，只在潭上找到两块石头，用敲击的清浊来解释山名。苏轼夜里乘小舟到绝壁下，听见水从石穴和中流大石的孔窍里进出，才写下这篇记。","theme":"这篇记要辨的是名称从哪里来，凭据必须是亲眼看见、亲耳听到。郦道元听到的大体不错，错在说得太少，后人无法复核；李渤用斧头敲石头，把随处都有的石声当成这座山独有的理由。苏轼并不把古人一笔抹掉，夜游之后他说古人没有骗自己，叹的是简，笑的是陋。士大夫不肯夜泊绝壁，渔夫知道却写不出，两种人合在一起，真相就断了。","technique":"前半先摆出两说，再用短句驳倒。钟磬放进水里也不会自己响，用来堵住“水石相搏就如洪钟”的类比；铿然有声的石头到处都是，用来堵住双石命名的办法。后半才写月夜：绝壁、栖鹘、山谷里的咳笑把人的恐惧垫高，然后声音出现，考察才开始。噌吰与窾坎镗鞳前后应和，对苏迈说的无射、歌钟是戏语，随即收束到不可臆断。景物承担了论证。","keyContentWords":[{"word":"彭蠡","reading":"Péng Lǐ","note":"鄱阳湖的古名。石钟山在湖口，正当湖水入江的地方。"},{"word":"郦元","reading":"Lì Yuán","note":"郦道元，北魏人，《水经注》的作者。文中称郦元。"},{"word":"李渤","reading":"Lǐ Bó","note":"唐代人，曾寻访石钟山并写过辨名的文字。不是诗人李白。"},{"word":"函胡","reading":"hán hú","note":"声音浑浊含糊。指南边那块石头被敲时的声音。"},{"word":"清越","reading":"qīng yuè","note":"清脆，余韵传得远。指北边那块石头的声音。"},{"word":"噌吰","reading":"chēng hóng","note":"宏大厚重的响声，苏轼用来比钟鼓。"},{"word":"窾坎镗鞳","reading":"kuǎn kǎn tāng tà","note":"窾坎是击物声，镗鞳是钟鼓声。出在中流大石的孔窍里。"},{"word":"无射","reading":"wú yì","note":"周景王所铸大钟的名字。射在这里读 yì，不读 shè。"}],"keyFunctionWords":[{"word":"焉","reading":"yān","note":"有石钟山焉：兼有“在那里”和语气停顿。微波入焉的焉指石穴石缝。"},{"word":"而况","reading":"ér kuàng","note":"何况，把语气再推进一层。而况石乎。"},{"word":"固","reading":"gù","note":"本来。余固笑而不信也，笑的是寺僧用斧头敲石。"},{"word":"殆","reading":"dài","note":"大概。郦元之所见闻殆与余同。"},{"word":"是以","reading":"shì yǐ","note":"因此。余是以记之。"},{"word":"盖","reading":"gài","note":"表示解释原因。盖叹郦元之简。"}],"ancientModern":[{"word":"适","note":"舟行适临汝：到、前往。现在多指合适、舒服。"},{"word":"搏","note":"水石相搏、森然欲搏人：撞击、扑打。现在常见的是搏斗、脉搏。"},{"word":"识","note":"汝识之乎：知道，读 shí。不把“识”理解成现代的“认识某个人”就够了。"},{"word":"考","note":"斧斤考击：敲打。现在“考”多指考试、考察。"}],"phoneticLoans":[{"word":"函胡","loan":"含糊","note":"声音浑浊不清。南声函胡。"},{"word":"扣","loan":"叩","note":"扣而聆之：敲击。读 kòu。"}],"flexibleUsage":[{"word":"鼓","note":"微风鼓浪：动词，鼓动、掀起波浪。"},{"word":"名","note":"此独以钟名：名词用作动词，命名。"},{"word":"舟","note":"舟行适临汝：名词作状语，乘船走。"},{"word":"目、耳","note":"目见耳闻：名词作状语，用眼睛看、用耳朵听。"}],"specialSyntax":[{"name":"定语后置","note":"石之铿然有声者，等于“铿然有声之石”。之、者标出后置的修饰语。"},{"name":"否定句代词宾语前置","note":"古之人不余欺也，就是“不欺余”。否定句里代词宾语放在动词前。"},{"name":"判断句","note":"噌吰者，周景王之无射也。用“者……也”判断声音对应哪一口古钟。"}]},"classicComment":{"t":"世人不曉石鍾命名之故，始失於舊注之不詳，繼失於淺人之俗見。千古奇勝，埋沒多少！坡公身歷其境，聞之眞，察之晰，從前無數疑案，一一破明。悅心快目！","s":"世人不晓石钟命名之故，始失于旧注之不详，继失于浅人之俗见。千古奇胜，埋没多少！坡公身历其境，闻之真，察之晰，从前无数疑案，一一破明。悦心快目！"}}
