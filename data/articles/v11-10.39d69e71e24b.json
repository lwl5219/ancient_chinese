,"py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"呼","s":"呼","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"噫","s":"噫","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"嘻","s":"嘻","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"！","s":"！","punct":true}]},{"tr":"我明白了！","tokens":[{"t":"我","s":"我","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"知","s":"知","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"矣","s":"矣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"！","s":"！","punct":true}]},{"tr":"「昨天夜里，边飞边叫从我身旁过去的，不就是你吗？","tokens":[{"t":"「","s":"「","punct":true},{"t":"疇","s":"畴","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"昔","s":"昔","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"夜","s":"夜","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"飛","s":"飞","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"鳴","s":"鸣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"過","s":"过","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"我","s":"我","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"非","s":"非","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"耶","s":"耶","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"？","s":"？","punct":true}]},{"tr":"道士回头笑了笑，我也从梦中惊醒。","tokens":[{"t":"」","s":"」","punct":true},{"t":"道","s":"道","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"士","s":"士","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"顧","s":"顾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"笑","s":"笑","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"予","s":"予","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"亦","s":"亦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"驚","s":"惊","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"寤","s":"寤","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"打开门看去，已经看不见他在哪里。","tokens":[{"t":"開","s":"开","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"戶","s":"户","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"視","s":"视","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"見","s":"见","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"處","s":"处","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"元丰五年十月十五，苏轼从黄州雪堂步行回临皋，两位客人同行，途中再次夜游赤壁。他因乌台诗案贬居黄州，临皋靠江，雪堂筑在东坡。同年七月十六已经游过一次，写成前一篇赤壁赋。三个月后霜露降下，树叶落尽，江水退落，石头露出，夏夜的清旷换成初冬的峭冷。黄州赤壁在江岸，就是赤鼻矶。苏轼用这一段夜色安顿贬谪里的心情，地名取的是眼前的江山。","theme":"前一篇在船上把水与月的变和不变说通，收在旷达。这一夜的乐很短：缺酒的慨叹刚被鱼和藏酒补上，江岸就变得不能久留。登山是独自上去的，长啸引出风和水的回应，作者自己也又悲又恐。孤鹤横江而过，睡后道士入梦，醒来开门，无处可寻。快乐、恐惧和空幻发生在同一夜里，苏轼把它们依次记下，恐惧还留在纸上。","technique":"全文顺着步行、觅酒、复游、登山、回船、入梦来写，景物跟着心境换。平地一段是霜露、人影和明月，亮而且轻。江上一段多用对句，断岸千尺对着山高月小，水落石出把冬日水位写死。登山连用履、披、踞、登、攀、俯，石、草、树、巢、水宫连成一条险路，虎豹和虬龙都是眼前事物的比喻。鹤的黑裙白衣预先合上道士的羽衣，结尾只说看不见去处，梦的真假留给读者。","keyContentWords":[{"word":"望","reading":"wàng","note":"月望，农历每月十五。是岁十月之望，就是这一年十月十五夜。"},{"word":"阪","reading":"bǎn","note":"山坡。黄泥阪在雪堂和临皋之间，主客是步行经过这里。"},{"word":"肴","reading":"yáo","note":"下酒的荤菜。有酒无肴，是说酒就算有了，也没有佐酒的菜。"},{"word":"薄暮","reading":"bó mù","note":"傍晚。薄是迫近，读 bó。客人说鱼是今天黄昏撒网得到的。"},{"word":"斗","reading":"dǒu","note":"酒器，也是容量。斗酒指存着的一斗酒，读 dǒu，不是争斗的 dòu。"},{"word":"不时","reading":"bù shí","note":"预料不到的时候。以待子不时之需，是预备苏轼忽然要用。"},{"word":"蒙茸","reading":"méng róng","note":"丛生缠结的杂草。披蒙茸，是用手把它拨开。"},{"word":"冯夷","reading":"píng yí","note":"水神名。冯读 píng。幽宫指水神所在的深水，作者低头看见的是江的深处。"},{"word":"玄裳","reading":"xuán cháng","note":"黑色的下裳。裳读 cháng，指裙裳。缟衣是白色上衣。鹤身白、尾黑，所以用白衣黑裙来写，也合道士的装束。"},{"word":"畴昔","reading":"chóu xī","note":"从前。畴昔之夜在这里指昨夜，也就是孤鹤飞过的那一夜。"}],"keyFunctionWords":[{"word":"顾","reading":"gù","note":"这篇里顾有两用。顾而乐之、道士顾笑，是回头看、转身看。顾安所得酒乎的顾，是不过、可是。"},{"word":"诸","reading":"zhū","note":"之于的合音。谋诸妇，就是把这件事向妻子商量。"},{"word":"盖","reading":"gài","note":"句首语气，带出原因。盖二客不能从焉，是说明为什么只剩作者一个人往上爬。"},{"word":"曾","reading":"céng","note":"才，表示时间很短。曾日月之几何，才过了多少日子。前一次游是七月，这次是十月。"},{"word":"适","reading":"shì","note":"恰好、正巧。适有孤鹤，鹤来得正好，接上后面的梦。"},{"word":"听","reading":"tīng","note":"任凭。听其所止而休焉，船停在哪里，人就在哪里歇，不是用耳朵听。"}],"ancientModern":[{"word":"几何","note":"多少，问日子长短。今天几何多指数学里的几何学。"},{"word":"危","note":"高。栖鹘之危巢，是隼鸟歇在高处的巢。今天危多指危险。"},{"word":"披","note":"拨开。披蒙茸是分开草丛。今天披多指搭在肩上。"},{"word":"白","note":"明亮。月白风清的白，是月色亮。今天白多指白色。"},{"word":"适","note":"恰好、正巧。今天适多指适合、舒适。"}],"phoneticLoans":[{"word":"反","loan":"返","note":"反而登舟的反通返，回到船上。这里还不是转折用的反而。"},{"word":"俛","loan":"俯","note":"俛而不答的俛同俯，读 fǔ，低下头，不回答姓名。"}],"flexibleUsage":[{"word":"履","note":"履巉岩：履本是鞋，这里作动词，踩着险岩走。"},{"word":"西","note":"掠予舟而西：西是方位名词作动词，向西飞去。"},{"word":"东","note":"横江东来：东作状语，从东边来。"}],"specialSyntax":[{"name":"宾语前置","note":"顾安所得酒乎：安所是何处，作得的宾语，放在动词前面。"},{"name":"固定句式","note":"如此良夜何：如……何，把……怎么样。良夜无法安排，所以用这句发问。"},{"name":"介词结构后置","note":"复游于赤壁之下：于赤壁之下放在游的后面，表示游的处所。"}]},"classicComment":{"t":"前篇寫實情實景，從「樂」字領出歌來。此篇作幻境幻想，從「樂」字領出歎來。一路奇情逸致，相逼而出。與前賦同一機軸，而無一筆相似。讀此兩賦，勝讀《南華》一部。","s":"前篇写实情实景，从「乐」字领出歌来。此篇作幻境幻想，从「乐」字领出叹来。一路奇情逸致，相逼而出。与前赋同一机轴，而无一笔相似。读此两赋，胜读《南华》一部。"}}
