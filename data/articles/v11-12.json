y":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"用","s":"用","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"兵","s":"兵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"及","s":"及","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"古","s":"古","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"今","s":"今","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"成","s":"成","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"敗","s":"败","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"自","s":"自","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"謂","s":"谓","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"一","s":"一","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"時","s":"时","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"豪","s":"豪","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"士","s":"士","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"到现在仿佛没过多久，那股精明强悍的神色还留在眉宇之间，他难道会是山里的寻常人吗？","tokens":[{"t":"今","s":"今","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"幾","s":"几","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"日","s":"日","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"耳","s":"耳","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"精","s":"精","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"悍","s":"悍","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"色","s":"色","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"猶","s":"犹","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"見","s":"见","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"眉","s":"眉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"間","s":"间","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"豈","s":"岂","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"山","s":"山","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"中","s":"中","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"哉","s":"哉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"？","s":"？","punct":true}]},{"tr":"然而方山子家世有功勋门第，本来有资格得到官职；假如让他在那个位置上做事，现在已经名声在外了。","tokens":[{"t":"然","s":"然","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"方","s":"方","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"山","s":"山","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"世","s":"世","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"勳","s":"勋","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"閥","s":"阀","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"當","s":"当","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"得","s":"得","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"官","s":"官","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"使","s":"使","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"從","s":"从","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"事","s":"事","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"間","s":"间","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"今","s":"今","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"已","s":"已","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"顯","s":"显","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"聞","s":"闻","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"他的家在洛阳，园囿住宅宏伟华丽，和公侯一样；河北还有田产，每年可得丝帛上千匹，也足够过富足安乐的日子。","tokens":[{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"家","s":"家","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"在","s":"在","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"洛","s":"洛","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"陽","s":"阳","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"園","s":"园","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"宅","s":"宅","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"壯","s":"壮","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"麗","s":"丽","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"與","s":"与","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"公","s":"公","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"侯","s":"侯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"等","s":"等","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"；","s":"；","punct":true},{"t":"河","s":"河","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"北","s":"北","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"田","s":"田","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"歳","s":"歳","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"得","s":"得","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"帛","s":"帛","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"千","s":"千","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"匹","s":"匹","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"亦","s":"亦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"足","s":"足","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"富","s":"富","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"樂","s":"乐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"这些他全都抛弃不要，偏偏来到荒山里。如果心里没有所得，难道会这样吗？","tokens":[{"t":"皆","s":"皆","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"棄","s":"弃","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"取","s":"取","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"獨","s":"独","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"來","s":"来","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"窮","s":"穷","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"山","s":"山","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"中","s":"中","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"此","s":"此","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"豈","s":"岂","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"得","s":"得","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"然","s":"然","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"哉","s":"哉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"？","s":"？","punct":true}]},{"tr":"我听说光州、黄州一带多有奇异的人，往往假装癫狂，蓬头垢面，不容易见到。方山子或许见过他们吧！","tokens":[{"t":"余","s":"余","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"聞","s":"闻","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"光","s":"光","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"黃","s":"黄","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"間","s":"间","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"多","s":"多","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"異","s":"异","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"往","s":"往","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"往","s":"往","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"佯","s":"佯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"狂","s":"狂","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"垢","s":"垢","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"汙","s":"污","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"可","s":"可","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"得","s":"得","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"見","s":"见","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"方","s":"方","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"山","s":"山","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"儻","s":"傥","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"見","s":"见","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"歟","s":"欤","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"！","s":"！","punct":true}]}]}],"lesson":{"background":"方山子是陈慥，字季常，苏轼的旧友。苏轼贬居黄州时路过岐亭遇见他。岐亭在光州和黄州之间，陈慥晚年住在那里，戴一顶又方又高的帽子，别人用汉代方山冠的名字称呼他。文中写十九年前在岐山看见他骑射出猎。岐山指苏轼早年在凤翔做官的那一带。这篇传记记下的是一次意外重逢，以及朋友从侠士变成山中人的样子。","theme":"同一个人被写成两截。少年时乡里侠士尊他为首领，挥金、好剑，马上能一箭射中飞鹊，自许豪士。晚年庵居蔬食，弃车马、毁冠服，洛阳的园宅和河北的田产都不要了，空屋里的妻子儿女却各自安然。精悍的神色还在眉间，说明隐居是把豪气收进另一种生活。苏轼追问：若心里没有所得，怎么会做这样的选择。结尾说到光黄之间那些佯狂垢面、不肯见人的异人，把方山子放在他们旁边。","technique":"传记先给外号，再倒回少年、壮年和隐居，姓名放到苏轼自己喊出来的时候才出现。重逢之后不写长篇对话，只用俯而不答、仰而笑、留宿三个动作。屋里的穷和家人的自得放在同一句里。随即用十九年前的射猎把眉间的精悍落到一件事上，再用洛阳园宅、河北帛千匹把舍弃写实。最后一句不判断他是不是异人，只说或许见过，收得轻。","keyContentWords":[{"word":"光黄","reading":"guāng huáng","note":"光州、黄州。光州在今河南潢川一带，黄州在今湖北黄冈。岐亭在两州之间。"},{"word":"朱家","reading":"zhū jiā","note":"和郭解都是《史记·游侠列传》里的汉初游侠。郭解的「解」读 xiè。少年陈慥仰慕的是这种救人急难的人。"},{"word":"折节","reading":"zhé jié","note":"改变平日的志节和做派。这里指从任侠转到读书。"},{"word":"方山冠","reading":"fāng shān guān","note":"汉代的一种帽子，方形而高。方山子的外号来自他的帽子像这种旧式。"},{"word":"遗像","reading":"yí xiàng","note":"留传下来的样式。此岂古方山冠之遗像乎，问的是帽子的形制，不是今天说的遗像、照片。"},{"word":"使酒","reading":"shǐ jiǔ","note":"喝酒之后任性使气。和好剑、用财如粪土连在一起，写他年轻时的豪纵。"},{"word":"勋阀","reading":"xūn fá","note":"有功勋的门第。当得官，是按家世荫补本来可以得到官职。阀读 fá。"},{"word":"精悍","reading":"jīng hàn","note":"精明强悍。苏轼觉得这神色还在眉间，和山中隐者的淡泊外表同时存在。"}],"keyFunctionWords":[{"word":"稍","reading":"shāo","note":"渐渐。稍壮，是年纪渐渐大起来，不是程度很轻的稍微一下。"},{"word":"适","reading":"shì","note":"恰好。过岐亭，适见焉，是路上正好遇见。"},{"word":"所以","reading":"suǒ yǐ","note":"……的原因。问余所以至此者，问我为什么来到这里。"},{"word":"使","reading":"shǐ","note":"假使。使从事于其间，是假如让他在官场里做事，下面今已显闻是设想的结果。"},{"word":"岂","reading":"qǐ","note":"难道。此岂古方山冠之遗像乎、而岂山中之人哉、此岂无得而然哉，都是反问。"}],"ancientModern":[{"word":"稍","note":"渐渐。今天稍多作稍微。"},{"word":"妻子","note":"妻子和儿女。环堵萧然，而妻子奴婢皆有自得之意，家里几代人都在场。今天妻子只指配偶。"},{"word":"所以","note":"原因。今天所以多作因果连词。"},{"word":"从事","note":"在官职上办事。使从事于其间，指假如进入仕途。今天从事多指投身某种工作。"},{"word":"河北","note":"黄河以北。今天河北是省名。"},{"word":"遗像","note":"遗留下来的法式、样子。今天遗像多指死者的画像。"}],"phoneticLoans":[{"word":"遯","loan":"遁","note":"晚乃遯于光黄间的遯通遁，读 dùn，隐去。"},{"word":"见","loan":"现","note":"犹见于眉间的见通现，读 xiàn，显露出来。精悍之色还出现在眉宇之间。"},{"word":"傥","loan":"倘","note":"方山子傥见之欤的傥通倘，读 tǎng，或许。"},{"word":"歳","loan":"岁","note":"歳得帛千匹的歳是岁的异体，读 suì，每年得到丝帛上千匹。"}],"flexibleUsage":[{"word":"宗","note":"闾里之侠皆宗之：宗由宗主转为动词，尊奉他为首领。"},{"word":"怒","note":"怒马独出：怒作使动，让马兴奋起来，催马独自冲出。"},{"word":"从","note":"从两骑的从读 zòng，使两名骑手跟随。二客从予、不能从焉的从读 cóng，是跟随。"}],"specialSyntax":[{"name":"判断句","note":"方山子，光黄间隐人也，用也字判断身份。前面先给外号，再下这个判断。"},{"name":"宾语前置","note":"何为而在此：何是为的宾语，提前，意思是为什么会在这里。"},{"name":"反问","note":"此岂无得而然哉：用岂和哉把弃富隐居收束成问句，答案落在他心里必有所得。"}]},"classicComment":{"t":"前幅自其少而壮而晚，一一顺叙出来。中间独念方山子一转，由后追前，写得十分豪纵，亦不见与前重复，笔墨高绝。末言舍富贵而甘隐遁，为有得而然，乃可称为真隐人。","s":"前幅自其少而壮而晚，一一顺叙出来。中间独念方山子一转，由后追前，写得十分豪纵，亦不见与前重复，笔墨高绝。末言舍富贵而甘隐遁，为有得而然，乃可称为真隐人。"}}
