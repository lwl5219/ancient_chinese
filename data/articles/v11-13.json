"level":"dict"},{"t":"何","s":"何","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"為","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"哉","s":"哉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"？","s":"？","punct":true}]},{"tr":"六国不懂得拿出这个办法，却去贪图边境上尺寸大小的利益，背叛盟约，自相残杀。秦兵还没有出动，天下诸侯自己已经困乏了。","tokens":[{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"知","s":"知","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"出","s":"出","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"此","s":"此","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乃","s":"乃","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"貪","s":"贪","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"疆","s":"疆","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"埸","s":"埸","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"尺","s":"尺","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"寸","s":"寸","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"利","s":"利","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"背","s":"背","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"盟","s":"盟","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"敗","s":"败","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"約","s":"约","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"自","s":"自","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"相","s":"相","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"屠","s":"屠","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"滅","s":"灭","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"秦","s":"秦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"兵","s":"兵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"未","s":"未","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"出","s":"出","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"天","s":"天","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"下","s":"下","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"諸","s":"诸","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"侯","s":"侯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"已","s":"已","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"自","s":"自","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"困","s":"困","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"矣","s":"矣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"以至于让秦人能够趁着空隙夺取他们的国家，怎么能不叫人悲伤！","tokens":[{"t":"至","s":"至","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"使","s":"使","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"秦","s":"秦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"得","s":"得","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"伺","s":"伺","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"隙","s":"隙","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"取","s":"取","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"國","s":"国","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"可","s":"可","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"悲","s":"悲","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"哉","s":"哉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"！","s":"！","punct":true}]}]}],"lesson":{"background":"这篇《六国论》是苏辙写的，和他父亲苏洵的《六国论》立论不同。苏洵着眼在赂秦，说诸侯把土地送给秦国，自己先失去了斗志。苏辙着眼在地理：韩、魏夹在秦和东方诸侯中间，对秦是心腹之患，对诸侯是西边的屏障。他读《史记》的六国世家，追问五倍的土地、十倍的人口为什么仍然挡不住千里之秦，认为当时的士人没有看清这层形势。","theme":"六国的失败在苏辙笔下是形势看错了。韩、魏堵住秦的出路，也掩护崤山以东。秦国自己清楚这一点：范雎主政就收韩，商鞅主政就收魏，昭王没得到韩、魏的心就去打齐国的刚、寿，范雎反而忧虑。后来秦打燕、赵而没有后顾之忧，是因为韩、魏已经附秦。东方四国本该厚待韩、魏，让两国专力挡秦，自己在后面接应。实际发生的是诸侯为边界上的尺寸之地互相攻杀，秦兵未出，自己先困。文章的悲，悲在自困。","technique":"开头用一长句摊开读史的困惑，接着用两句排比把要害从齐、楚、燕、赵收窄到韩、魏的郊和野。腹心之疾和诸侯之障是同一块土地的两面，范雎、商鞅、昭王攻齐三件事都用来证明秦自己也忌惮这里。后半由批评转入设想：四国辅助当寇的韩、魏，二国承担对秦，四国阴助其急。设想说完，末段只写背盟败约、自相屠灭，用可不悲哉收住，不再另起议论。","keyContentWords":[{"word":"世家","reading":"shì jiā","note":"《史记》里诸侯的传记。六国世家，指齐、楚、燕、赵、韩、魏六国的家世记载。"},{"word":"山西","reading":"shān xī","note":"崤山以西，指秦国那块千里之地。今天山西是省名，范围不同。"},{"word":"山东","reading":"shān dōng","note":"崤山以东，韩、魏所要掩护的诸侯在这一边。今天山东是省名。"},{"word":"冲","reading":"chōng","note":"交通要道。韩、魏塞秦之冲，是堵住秦向东进出的咽喉。"},{"word":"范雎","reading":"fàn jū","note":"秦昭王时的宰相，主张远交近攻，先收服近处的韩国。雎读 jū。"},{"word":"刚寿","reading":"gāng shòu","note":"齐国的刚邑和寿邑。昭王还没得到韩、魏的归心就攻打这两处，所以范雎担忧。"},{"word":"疆埸","reading":"jiāng yì","note":"边境。埸读 yì，是田地的边界。贪疆埸尺寸之利，贪的是边界上很小一块地，不是战场的场。"},{"word":"出身","reading":"chū shēn","note":"挺身而出。为天下出身以当秦兵，是韩、魏亲自站到前面去挡秦军。今天出身多指履历。"},{"word":"委","reading":"wěi","note":"委区区之韩、魏，是把小小的两国丢下，让它们单独挡秦。以二国委秦，是把对付秦的事交托给两国。前一处是抛弃，后一处是委托。"}],"keyFunctionWords":[{"word":"窃","reading":"qiè","note":"私下。窃怪，是自己心里感到奇怪，带着读书人自言的口气。"},{"word":"夫","reading":"fú","note":"句首发语。夫秦之所与诸侯争天下者、夫韩魏诸侯之障，都是另起一层议论。"},{"word":"莫如","reading":"mò rú","note":"没有什么比得上。故莫如厚韩亲魏以摈秦，是在比较之后选定的办法。"},{"word":"安得","reading":"ān dé","note":"怎么能。彼安得不折而入于秦哉，反问韩、魏在孤立时不能不屈服。"},{"word":"然则","reading":"rán zé","note":"既然如此，那么。承接范雎的忧虑，推出秦所顾忌的对象。"}],"ancientModern":[{"word":"山西","note":"崤山以西的秦地。今天指山西省。"},{"word":"山东","note":"崤山以东。今天指山东省。"},{"word":"出身","note":"挺身站出来。今天指出身、履历、家庭背景。"},{"word":"休息","note":"休养生息。四国休息于内，是在后方恢复力量。今天休息多指停下工作歇一歇。"},{"word":"完","note":"保全，使自己完整。自完于其间，是在这个安排里保住自己。今天完多指结束。"},{"word":"无事","note":"没有战事、不在前线受苦。四无事之国，指齐、楚、燕、赵。今天无事多指没有事情。"}],"phoneticLoans":[{"word":"葢","loan":"盖","note":"句首的葢同盖，读 gài，发语词，引出责怪当时之士的判断。"},{"word":"疎","loan":"疏","note":"虑患之疎的疎同疏，读 shū，粗疏，考虑不周密。"},{"word":"闲","loan":"间","note":"出入于其闲、自完于其闲的闲同间，读 jiān，指韩、魏所在的中间地带。"},{"word":"徧","loan":"遍","note":"天下徧受其祸的徧同遍，读 biàn，到处。"},{"word":"藉","loan":"借","note":"藉之以蔽其西的藉通借，读 jiè，依靠。诸侯要靠韩、魏挡住西边。"}],"flexibleUsage":[{"word":"西","note":"发愤西向：西作状语，向西。蔽其西的西仍是方位名词。"},{"word":"厚","note":"厚韩：厚由形容词转为动词，厚待韩国。亲魏的亲同样是亲近魏国。"},{"word":"阴","note":"阴助其急：阴作状语，暗中援助韩、魏的急难。"},{"word":"完","note":"自完：完作动词，保全自己，使国家保持完整。"}],"specialSyntax":[{"name":"被动句","note":"范雎用于秦、商鞅用于秦：于引出任用他们的秦国，两人是被秦国任用。"},{"name":"判断句","note":"秦之有韩、魏，譬如人之有腹心之疾也，用也字下比喻判断。秦之危事也、此危道也，也是判断。"},{"name":"反问","note":"此岂知天下之势邪、彼安得不折而入于秦哉、可不悲哉，三处反问分别落在不识形势、不得不降和作者的悲痛。"}]},"classicComment":{"t":"是論只在不知天下之勢一句。蘇秦之說六國，意正如此。當時六國之策，萬萬無出於親韓、魏者。計不出此，而自相屠滅。六國之愚，何至於斯。讀之可發一笑。","s":"是论只在不知天下之势一句。苏秦之说六国，意正如此。当时六国之策，万万无出于亲韩、魏者。计不出此，而自相屠灭。六国之愚，何至于斯。读之可发一笑。"}}
