t"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"清","s":"清","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"風","s":"风","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"照","s":"照","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"明","s":"明","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"月","s":"月","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"此","s":"此","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"皆","s":"皆","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"騷","s":"骚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"思","s":"思","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"士","s":"士","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"悲","s":"悲","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"傷","s":"伤","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"憔","s":"憔","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"悴","s":"悴","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"能","s":"能","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"勝","s":"胜","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"又从哪里看得出它们是畅快的呢？","tokens":[{"t":"烏","s":"乌","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"睹","s":"睹","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"為","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"快","s":"快","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"哉","s":"哉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"？","s":"？","punct":true}]}]}],"lesson":{"background":"苏辙写这篇记时，兄长苏轼贬在黄州，他自己也因诗案牵连被安置到外地。友人张梦得同样以贬官的身份住在齐安，齐安就是黄州。他在住宅西南临江修亭，苏轼取名为“快哉”。亭下江面，是苏氏兄弟常常当作赤壁来凭吊的那段江岸，和史书里的古战场不必一一坐实。苏辙没有停在亭台名胜上，而是由峡口的水势写到眼前的山光，再写到曹操、孙权、周瑜、陆逊的遗迹，最后用楚襄王当风的旧事，说明畅快不在风，而在人能不能把心放平。","theme":"题眼是一个“快”字，却分成两层。一层是景物和史迹本身带来的痛快：江面像海，山冈可数，沙洲废城又牵出三国人物的驰骋。另一层是贬谪之后还能不能痛快。心中若先有委屈，清风明月也只是愁的材料；心中若坦然，不让外物伤害本性，那么蓬门瓮窗也同样无所不快。张梦得能在簿书之余纵情山水，正被用来证明他的内心有超过常人的地方。","technique":"开篇三叠，把长江从西陵写到赤壁，声势先铺满，再轻轻交代建亭和命名。中间把“快”拆成两扇：一扇是几席上就能看尽的江山，一扇是足以让世俗称快的遗迹，两扇都收回到亭名。后幅忽然插入宋玉谈雄风的故事，先承认其中有讽意，再用“风何与焉”把雌雄之分推开。两组“将何往而非”“将何适而非”的反问，把议论落到“其中”二字。结尾若翻过来说，同样的林泉只能使骚人憔悴，与前面的“不可久视”对照，亭的意义才完整。","keyContentWords":[{"word":"西陵","reading":"xī líng","note":"西陵峡，长江出三峡的东口，在今湖北宜昌一带。出峡之后江面才开阔。"},{"word":"肆","reading":"sì","note":"放纵、不受约束。奔放肆大，是说水势又急又阔。"},{"word":"一舍","reading":"yī shè","note":"古代行军三十里为一舍。东西一舍，是说东西方向大约三十里。"},{"word":"开阖","reading":"kāi hé","note":"散开又合拢，形容风云变化不定。阖，闭合。"},{"word":"几席","reading":"jī xí","note":"几案和坐席，指人坐在亭里。几读 jī，是小桌，不是数目的几。"},{"word":"指数","reading":"zhǐ shǔ","note":"用手指着点数。数读 shǔ。形容山光屋舍都看得清清楚楚。"},{"word":"睥睨","reading":"bì nì","note":"斜着眼看。这里指曹操、孙权彼此窥伺、争雄。"},{"word":"骋骛","reading":"chěng wù","note":"驰骋奔走。骛，乱跑、疾驰。指周瑜、陆逊在这一带往来用兵。"},{"word":"会稽","reading":"kuài jī","note":"会读 kuài，总计；稽读 jī，考核。合起来指钱粮簿书一类公务，不是绍兴的会稽山。余功，公务做完后剩下的时间精力。"},{"word":"瓮牗","reading":"wèng yǒu","note":"用破瓮做窗户，和蓬户连用，形容极简陋的住所。牗是牖的异体。"},{"word":"挹","reading":"yì","note":"舀取。挹西山之白云，是说像用手捧住似的欣赏、揽取。"}],"keyFunctionWords":[{"word":"葢","reading":"gài","note":"同“盖”，句首发语词，表示推原或大概，没有实在意义。"},{"word":"即","reading":"jí","note":"就着、靠近。即其庐之西南为亭，是就住房西南的位置建亭。"},{"word":"使","reading":"shǐ","note":"假如。使其中不自得，不是“派遣”。"},{"word":"与","reading":"yù","note":"参与、相干。风何与焉：风又干涉了什么呢。这里不读 yǔ。"},{"word":"将","reading":"jiāng","note":"将蓬户瓮牗：即使、就算。下文“将何往”的将，才是“还、会”。"},{"word":"乌","reading":"wū","note":"哪里、怎么。乌睹，哪里看得出。"}],"ancientModern":[{"word":"胜","note":"古：美景。江流之胜、耳目之胜。今：多指胜利，或作动词表示超过。"},{"word":"病","note":"古：困苦、不痛快。何往而非病。今：多指疾病。"},{"word":"快","note":"古：畅快、痛快。亭名“快哉”用的是这个意思。今：多指速度快。"},{"word":"适","note":"何适而非快：适读 shì，是“往、到”。自适的适，是安适。今：多指适合。"},{"word":"窃","note":"古：私下、谦辞，表示自己抽空去做。今：多指偷窃。"},{"word":"中","note":"其中的中，指内心。今：多指中间、里面。"}],"phoneticLoans":[{"word":"葢","loan":"盖","note":"句首发语词。字体作“葢”，用法与“盖”相同。"},{"word":"牗","loan":"牖","note":"窗户。瓮牗就是瓮牖，用破瓮口做窗。"},{"word":"閒","loan":"闲","note":"山水之閒的閒，指闲暇，不是间隔。原文用的是这个字。"}],"flexibleUsage":[{"word":"名","note":"名之曰快哉：名词用作动词，命名、起名。"},{"word":"南、北、西、昼、夜","note":"南合、北合、西望、昼则、夜则，方位词和时间词放在动词前作状语，表示朝哪个方向、在什么时候。"},{"word":"动、骇","note":"动心骇目：使动用法。使心震动，使眼睛吃惊。"},{"word":"振、照","note":"振之以清风、照之以明月：清风使林木振动，明月把林木照亮，也是使动。"}],"specialSyntax":[{"name":"定语后置","note":"有风飒然至者，等于“有飒然而至之风”。者字把修饰语挪到中心词后面。"},{"name":"状语后置","note":"振之以清风、照之以明月，等于“以清风振之、以明月照之”。以字结构放在动词后面。"},{"name":"判断句","note":"此其之所以为快哉者也。者也呼应，说明亭子得名的原因。"},{"name":"反问句","note":"将何往而非病、将何适而非快、乌睹其为快也哉，都用反问把意思说死：无处不苦，或无处不快。"}]},"classicComment":{"t":"前幅握定快哉二字洗發，後幅俱從謫居中生意。文勢汪洋，筆力雄壯。讀之令人心胸曠達，寵辱都忘。","s":"前幅握定快哉二字洗发，后幅俱从谪居中生意。文势汪洋，笔力雄壮。读之令人心胸旷达，宠辱都忘。"}}
