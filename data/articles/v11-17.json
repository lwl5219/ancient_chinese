":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"耳","s":"耳","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"患","s":"患","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"笑","s":"笑","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"里","s":"里","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"至于我的迂可就大了。假如你拿着我的话回去，将会更加得罪乡人，难道仅仅是被嘲笑吗？","tokens":[{"t":"若","s":"若","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"予","s":"予","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"迂","s":"迂","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"大","s":"大","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"矣","s":"矣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"使","s":"使","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"生","s":"生","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"持","s":"持","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"吾","s":"吾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"言","s":"言","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"歸","s":"归","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"且","s":"且","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"重","s":"重","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"得","s":"得","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"罪","s":"罪","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"庸","s":"庸","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"詎","s":"讵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"止","s":"止","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"笑","s":"笑","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乎","s":"乎","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"？","s":"？","punct":true}]},{"tr":"那么，像我这样的人对于你们，还能说什么呢？","tokens":[{"t":"然","s":"然","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"則","s":"则","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"若","s":"若","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"予","s":"予","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"生","s":"生","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"將","s":"将","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"何","s":"何","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"言","s":"言","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"哉","s":"哉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"？","s":"？","punct":true}]},{"tr":"如果认为我的迂是好的，那么它带来的麻烦就是这样。","tokens":[{"t":"謂","s":"谓","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"予","s":"予","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"迂","s":"迂","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"善","s":"善","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"則","s":"则","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"患","s":"患","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"若","s":"若","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"此","s":"此","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"如果认为它不好，那么有办法迎合当世，就必定违背古人；有办法混同世俗，就必定离开道了。","tokens":[{"t":"謂","s":"谓","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"善","s":"善","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"則","s":"则","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"合","s":"合","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乎","s":"乎","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"世","s":"世","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"必","s":"必","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"違","s":"违","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乎","s":"乎","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"古","s":"古","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"；","s":"；","punct":true},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"同","s":"同","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乎","s":"乎","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"俗","s":"俗","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"必","s":"必","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"離","s":"离","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乎","s":"乎","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"道","s":"道","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"矣","s":"矣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"你们还是不要急着解除乡里人的疑惑，那么在这件事上一定能够自己选择、自己取舍。","tokens":[{"t":"生","s":"生","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"急","s":"急","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"解","s":"解","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"里","s":"里","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"惑","s":"惑","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"則","s":"则","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"是","s":"是","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"焉","s":"焉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"必","s":"必","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"能","s":"能","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"擇","s":"择","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"取","s":"取","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]},{"sentences":[{"tr":"于是写下这些话赠给两位青年，并交给苏君去看，问他觉得怎么样。","tokens":[{"t":"遂","s":"遂","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"書","s":"书","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"贈","s":"赠","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"二","s":"二","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"生","s":"生","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"并","s":"并","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"示","s":"示","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"蘇","s":"苏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"何","s":"何","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"如","s":"如","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"苏轼从蜀地写信到京城，向曾巩推荐同乡青年黎生和安生，并让他们带着文章来访。后来黎生补了江陵府司法参军，临行请曾巩写赠序，理由是乡里人笑他们的文章迂阔，希望借曾巩的话替自己辩解。曾巩没有顺着这个请求去夸奖他们，反而说自己比他们更迂：只信古、只志道，所以在当世困顿。文章写于黎生将赴任之时，是一篇临别赠言，题目里的“序”是赠序，不是书前的序言。","theme":"曾巩要两位青年想清楚：被人笑，不一定是文章的失败。他们的迂只在文辞不近俗，不过是小迂；倘若为了让乡人不再笑，就去迎合时俗，结果一定离开自己原来相信的古和道。作者把自己的困顿摆出来，不是自嘲了事，而是说明选择有代价。信古则不合世，合世则违古，两条路不能同时走通。所以与其急着解乡人之惑，不如先在这上面自己拿定。","technique":"开头用苏轼的推荐和两次携带文章，先把二生的才力写足，也把“善知人”送给苏轼，后面的劝告才不是居高临下的教训。黎生一求赠言，作者先反问“还要向外求言语吗”，把乡人的笑引出来。接着“自顾而笑”，同一句“孰有甚于予乎”说了两遍：第一遍后面接自己的信古志道，第二遍后面接二生只是小迂。比较一旦成立，赠言就变成一道选择：说我的迂好，就要准备得罪；说它不好，就要准备离道。结尾不代他们决定，只把话写给他们，并送回苏轼，形成呼应。","keyContentWords":[{"word":"同年","reading":"tóng nián","note":"同一年考中进士的人。曾巩与苏轼同榜，所以称同年友。"},{"word":"遗","reading":"wèi","note":"送给、致送。自蜀以书至京师遗予，是把信送到京城给我。不读 yí。"},{"word":"言","reading":"yán","note":"数十万言的言，是字。几十万字、几千字，不是几十万句话。"},{"word":"顾","reading":"gù","note":"拜访。辱以顾予，是谦辞，说对方降低身份来看自己。自顾则是回头看自己。"},{"word":"迂阔","reading":"yū kuò","note":"不切近时俗，言谈好高远、不入世务。里人用来嘲笑二生，作者却拿来自称。"},{"word":"补","reading":"bǔ","note":"补授官职，填上缺额。不是今天说的补课、补充。"},{"word":"司法参军","reading":"sī fǎ cān jūn","note":"州府里掌管刑狱的属官。黎生将到江陵府就任这一职务。"},{"word":"庸讵","reading":"yōng jù","note":"难道、哪里。庸讵止于笑，难道只是被嘲笑吗。"}],"keyFunctionWords":[{"word":"既而","reading":"jì ér","note":"不久、接着。用来把苏轼来信和二生登门接上。"},{"word":"邪","reading":"yé","note":"疑问语气，吗。相求于外邪，等于问“吗”。"},{"word":"特","reading":"tè","note":"只、仅仅。特以文不近俗，只是因为文章不接近流俗。"},{"word":"乎","reading":"hū","note":"信乎古、志乎道的乎，相当于“于”，在、对于。"},{"word":"其","reading":"qí","note":"生其无急：还是、希望，表示委婉的劝告，不是代词。"},{"word":"为","reading":"wéi","note":"患为笑于里之人的为，读 wéi，表示被。担心被乡里人笑。"}],"ancientModern":[{"word":"顾","note":"古：拜访，也可指回头看。今：多指照顾，或作顾客。"},{"word":"极","note":"古：尽头。若不可极，好像到不了头。今：常作程度副词，极其。"},{"word":"里","note":"古：乡里。里人，同乡。今：多作长度单位。"},{"word":"信","note":"知信乎古的信，是相信。今：多指书信；信任一义虽然还在，书信义已更常见。"},{"word":"序","note":"本文的序是临别赠言。今：多指顺序，或书前的序言。"},{"word":"斯文","note":"学于斯文，指他们所习的这种文章，也带有儒者文章传统的意思。今：常指斯文、文雅的样子。"}],"phoneticLoans":[{"word":"邪","loan":"耶","note":"句末疑问词。相求于外邪，就是“吗”。"}],"flexibleUsage":[{"word":"笑","note":"笑以为迂阔：认为迂阔而加以嘲笑。笑在这里是动词，不是单纯的表情。"},{"word":"迂","note":"今生之迂、予之迂：迂由形容词转成名词，指迂阔这件事、这种毛病。"}],"specialSyntax":[{"name":"判断句","note":"赵郡苏轼，予之同年友也。二生固可谓魁奇特起之士。用“也”和“可谓……者”下判断。"},{"name":"被动","note":"患为笑于里之人。为，被。担心的是被乡里人嘲笑。"},{"name":"反问","note":"乃将以言相求于外邪、孰有甚于予乎、庸讵止于笑乎、将何言哉，连续用问句把劝告说重。"},{"name":"介词“乎”","note":"信乎古、合乎世、志乎道、同乎俗，乎都相当于于，表示在某一方面如何。"}]},"classicComment":{"t":"文之近俗者，必非文也。故里人皆笑，則其文必佳。子固借迂闊二字，曲曲引二生入道。讀之，覺文章聲氣，去聖賢名教不遠。","s":"文之近俗者，必非文也。故里人皆笑，则其文必佳。子固借迂阔二字，曲曲引二生入道。读之，觉文章声气，去圣贤名教不远。"}}
