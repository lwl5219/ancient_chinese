a":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"存","s":"存","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"後","s":"后","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"世","s":"世","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"謬","s":"谬","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"傳","s":"传","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"莫","s":"莫","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"能","s":"能","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"名","s":"名","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"何","s":"何","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"可","s":"可","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"勝","s":"胜","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"道","s":"道","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"哉","s":"哉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"！","s":"！","punct":true}]},{"tr":"这就是求学的人不能不深入思考、谨慎选取的缘故。","tokens":[{"t":"此","s":"此","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"學","s":"学","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"可","s":"可","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"深","s":"深","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"思","s":"思","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"慎","s":"慎","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"取","s":"取","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]},{"sentences":[{"tr":"同游的四个人是：庐陵人萧君圭，字君玉；长乐人王回，字深父；我的弟弟安国，字平父，安上，字纯父。","tokens":[{"t":"四","s":"四","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"：","s":"：","punct":true},{"t":"廬","s":"庐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"陵","s":"陵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"蕭","s":"萧","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"圭","s":"圭","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"玉","s":"玉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"長","s":"长","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"樂","s":"乐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"回","s":"回","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"深","s":"深","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"父","s":"父","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"予","s":"予","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"弟","s":"弟","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"安","s":"安","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"國","s":"国","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"平","s":"平","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"父","s":"父","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"安","s":"安","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"上","s":"上","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"純","s":"纯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"父","s":"父","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"这篇记写于宋仁宗至和元年。王安石当时在舒州做通判，和庐陵萧君圭、长乐王回，以及两个弟弟王安国、王安上一起游褒禅山。山在今安徽含山北面。唐代僧人慧褒曾在山脚筑屋，死后又葬在那里，后人因此把山叫做褒禅，读 bāo chán：褒是慧褒的名字，禅取僧人、禅院之义，不读禅让的 shàn。篇首的「襃」是「褒」的异体。洞有前后之分，前洞平旷，后洞深寒。他们举火进入后洞，没走多远就退了出来。文章由这次半途而返写起，地点、同伴和年份都可以从文中和写作时间对上。","theme":"游山没有走到底，被写成做事情和做学问都绕不开的几层条件。平坦近便的地方人容易到，奇特的景象却多在险远处，没有志向就到不了；有志而不肯盲从，力气不够也到不了；志向和力气都具备，进了幽暗迷惑的地方，若没有火把这类外物帮助，仍然到不了。条件说完，他转回来责备自己：当时力气还够，火把也还亮，退出去是跟着别人停步，所以别人可以讥笑，自己更会后悔。只要把心志用尽，即使仍未到达，也就无可后悔。倒卧的石碑又把话推进一层。碑上写的是「花山」，后人却把山名读错。古书失传以后，以讹传讹、叫不出本来名称的事多得说不完，求学的人必须想得深，取舍也必须谨慎。","technique":"前半按路程记叙：山名的来历、慧空禅院、倒碑、前洞、后洞，然后是拥火而入和中途退出。前洞题名的人很多，后洞越深到达的人越少，自己所到还不及好游者的十分之一，洞壁上的题记已经稀少，这些都是亲眼所见，后面的道理就从这里长出来。「于是予有叹焉」把记叙接到议论，不是另起一篇。「有志」「有力」「有物以相」三次都收在「不能至」上，一句比一句要求更高，再用「力足以至焉」把省掉的「却没有到」显出来，悔就有了根据。碑文好像是旁支，其实用一个读错的音，证明传说会走样。四人的籍贯、名和字放在末尾，交代同游的人，也让这次游览落在实处。","keyContentWords":[{"word":"褒禅","reading":"bāo chán","note":"山名。褒是僧人慧褒，禅读 chán，指僧人和禅院，不读 shàn。篇首「襃」是「褒」的异体。山在今安徽含山北，不要和西岳华山混成一处。"},{"word":"浮图","reading":"fú tú","note":"梵语音译，可以指佛塔，也可以指僧人。这里「唐浮图慧褒」指唐代和尚慧褒，不是一座塔。"},{"word":"华","reading":"huā","note":"指这座山的名字。碑上作「花山」，作者认为应与「花」同音，读 huā。「华实」的「华」读 huá，是开花。把山名读成 huá，被他说成读错了音。"},{"word":"窈然","reading":"yǎo rán","note":"幽深的样子。后洞「有穴窈然」，一进去就很冷，和前洞的平旷正好相反。"},{"word":"相","reading":"xiàng","note":"帮助、辅助。「无物以相之」是没有外物来帮助。这里的物，指火把、向导一类条件。不能读成互相的 xiāng。"},{"word":"胜","reading":"shēng","note":"尽、全部。「何可胜道」是哪里说得完。读 shēng，不读胜利的 shèng。"}],"keyFunctionWords":[{"word":"其","reading":"qí","note":"「既其出」的其是助词，没有实在意义，作用是凑足音节。同篇「悔其随之」的其才是代词，指自己。"},{"word":"以","reading":"yǐ","note":"「夷以近」「险以远」的以相当于「而」，连接两种性状。平坦和近便连在一起，艰险和遥远连在一起。"},{"word":"且","reading":"qiě","note":"将要。「火且尽」是火把快要烧完了，不是并且、而且。"},{"word":"所以","reading":"suǒ yǐ","note":"表示原因，等于「……的缘故」。「此所以学者不可以不深思而慎取之也」，是在解释为什么必须深思慎取。"}],"ancientModern":[{"word":"非常","note":"「非常之观」是不同寻常的景象。今天「非常」多作程度副词，相当于「很」。"},{"word":"十一","note":"「不能十一」是不到十分之一。今天「十一」是数字十一，不再表示这个分数。"},{"word":"学者","note":"「学者不可以不深思」里的学者，是求学的人。今天多指在某一领域有专门成就的人。"},{"word":"仆","note":"「有碑仆道」「仆碑」的仆读 pū，是向前倒下。今天「仆」常指仆人，读 pú。"}],"phoneticLoans":[{"word":"父","loan":"甫","note":"「深父」「平父」「纯父」的父通「甫」，读 fǔ，用在男子的表字后面，不是父亲的 fù。"}],"flexibleUsage":[{"word":"舍","note":"「始舍于其址」的舍读 shè，本是房屋，这里用作动词，筑屋定居。不要读成舍弃的 shě。"},{"word":"名","note":"「名之曰褒禅」的名是名词用作动词，给它取名。"},{"word":"明","note":"「火尚足以明」的明是形容词用作动词，照明。火把还亮着，还能够照路。"},{"word":"穷","note":"「好游者不能穷」的穷是形容词用作动词，走到尽头。不是贫穷。"}],"specialSyntax":[{"name":"判断句","note":"「今所谓慧空禅院者，褒之庐冢也」用「者……也」表示判断。慧空禅院就是慧褒的屋舍和坟墓，庐是房子，冢是坟墓。"},{"name":"介词结构后置","note":"「始舍于其址」是在山脚筑屋。「于其址」放在动词后面作补语，译成白话时要提到动词前面。"},{"name":"省略","note":"「然力足以至焉」后面省去了「而不至」。没有这层省略，下文的「可讥」和「有悔」就没有对象。"}]},"classicComment":{"t":"借遊華山洞，發揮學道。或敍事，或詮解，或摹寫，或道故，意之所至，筆亦隨之。逸興滿眼，餘音不絕。可謂極文章之樂。","s":"借游华山洞，发挥学道。或敍事，或诠解，或摹写，或道故，意之所至，笔亦随之。逸兴满眼，余音不绝。可谓极文章之乐。"}}
