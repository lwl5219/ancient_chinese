","extra":"","level":"dict"},{"t":"往","s":"往","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"倚","s":"倚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"天","s":"天","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"塹","s":"堑","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"如今南北成了一家，把它看作平静的水流，不再有战争的事了。","tokens":[{"t":"今","s":"今","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"則","s":"则","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"南","s":"南","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"北","s":"北","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"一","s":"一","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"家","s":"家","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"視","s":"视","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"安","s":"安","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"流","s":"流","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"事","s":"事","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乎","s":"乎","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"戰","s":"战","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爭","s":"争","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"矣","s":"矣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"那么，这究竟是谁的力量呢？","tokens":[{"t":"然","s":"然","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"則","s":"则","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"果","s":"果","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"誰","s":"谁","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"力","s":"力","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"歟","s":"欤","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"？","s":"？","punct":true}]},{"tr":"穿着宽袖儒服的读书人，有登上这座楼观看这条江的，应当想到圣上的恩德像天一样，浩大得难以称说，和神禹疏导河流、开凿山崖的功劳同样没有穷尽。","tokens":[{"t":"逢","s":"逢","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"掖","s":"掖","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"士","s":"士","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"登","s":"登","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"斯","s":"斯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"樓","s":"楼","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"閱","s":"阅","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"斯","s":"斯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"江","s":"江","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"當","s":"当","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"思","s":"思","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"聖","s":"圣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"德","s":"德","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"如","s":"如","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"天","s":"天","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"蕩","s":"荡","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"蕩","s":"荡","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"難","s":"难","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"名","s":"名","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"與","s":"与","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"神","s":"神","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"禹","s":"禹","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"疏","s":"疏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"鑿","s":"凿","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"功","s":"功","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"同","s":"同","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"一","s":"一","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"罔","s":"罔","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"極","s":"极","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"忠于君主、报答皇上的心，难道会有不自然而然生出来的吗？","tokens":[{"t":"忠","s":"忠","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"報","s":"报","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"上","s":"上","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"心","s":"心","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"油","s":"油","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"然","s":"然","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"興","s":"兴","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"耶","s":"耶","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"？","s":"？","punct":true}]}]},{"sentences":[{"tr":"我不够聪敏，承受旨意撰写这篇记。","tokens":[{"t":"臣","s":"臣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"敏","s":"敏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"奉","s":"奉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"旨","s":"旨","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"撰","s":"撰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"記","s":"记","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"想要向上推求皇上起早贪黑、谋划治理的功劳，就把这些话刻在坚美的石碑上。","tokens":[{"t":"欲","s":"欲","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"上","s":"上","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"推","s":"推","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"宵","s":"宵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"旰","s":"旰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"圖","s":"图","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"治","s":"治","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"功","s":"功","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"勒","s":"勒","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"諸","s":"诸","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"貞","s":"贞","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"珉","s":"珉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"其他像流连风光景物的文辞，都省略不写，是怕亵渎了。","tokens":[{"t":"他","s":"他","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"若","s":"若","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"留","s":"留","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"連","s":"连","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"光","s":"光","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"景","s":"景","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"辭","s":"辞","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"皆","s":"皆","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"略","s":"略","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"陳","s":"陈","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"懼","s":"惧","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"褻","s":"亵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"金陵从六朝到南唐多次做过偏安政权的都城。明太祖朱元璋把帝业定在这里，宋濂便把这座城写成才足以承当山川王气的一统之都。狮子山在京城西北，山势从卢龙一带蜿蜒而来，长江盘绕山下。太祖认为地势雄胜，下诏在山顶建楼，和百姓同游，赐名阅江，并命宋濂作记。宋濂是开国文臣，这篇记是奉旨写成的。文中的法驾登临，是设想皇帝来到楼上，不是作者自己游完以后补写的游记。临春、结绮是陈后主的楼阁，齐云、落星也是前代以高华著名的楼，被他拿来作对照。","theme":"楼如果只为了看江，宋濂认为不值得专门去写。他替皇帝设想了三层目光：看见江河归海、诸侯述职和关塞坚固，就要想到保住中原；看见外国船只和进贡的珍宝，就要想到用怀柔对待远方；看见农夫皮肤晒裂、农妇采桑送饭，就要想到让百姓过上安稳的日子。诏令里的理由是与民同乐，文章把同乐再推进为保境、柔远、安民。前代那些又华又高的楼，藏的是音乐和美女，转眼就只剩感慨。长江在六朝被当成天堑，如今南北一家，江水被看成平静的河流。读书人登楼，应当想到难以称说的功德。作者明说流连光景的话从略，是怕亵渎这层用意。","technique":"文章先用六朝、南唐的偏安，衬出明初定鼎才与王气相当，建楼的理由就放在一统上面。「登览之顷」把地理转到设想中的皇帝登临，再用三次「必曰」把所见和所思配成一组，每组后面都接「益思有以」如何，依次是保、柔、安。写完正面，立刻用临春、结绮、齐云、落星作反衬：那些楼不是不华、不是不高，不能长久只因为它们供的是享乐。同一条长江，分裂的时代叫天堑，一统的时代叫安流，对照以后用「果谁之力」把风景归到人事。结尾声明不写光景，等于给整篇记定了取舍。","keyContentWords":[{"word":"定鼎","reading":"dìng dǐng","note":"定都。古人用九鼎代表政权，迁都也就移动重器。这里指明太祖把都城定在金陵。"},{"word":"卢龙","reading":"lú lóng","note":"南京西北的山名，狮子山的山脉从这一带延伸过来。不要理解成河北边塞的卢龙塞。"},{"word":"栉风沐雨","reading":"zhì fēng mù yǔ","note":"用风梳头，用雨洗脸，形容在外奔波劳苦。皇帝用它来说自己南征北战才得到眼前的江山。"},{"word":"逢掖","reading":"péng yè","note":"腋下宽大的袖子，指儒生的衣服。「逢掖之士」就是读书人。逢在这里读 péng，是大的意思。"},{"word":"宵旰","reading":"xiāo gàn","note":"宵衣旰食的省略。天没亮就穿衣起身，天晚了才吃饭，指勤于政事。宋濂要把这层功劳刻到碑上。"},{"word":"委蛇","reading":"wēi yí","note":"联绵词，弯弯曲曲、连绵很长，和「逶迤」是同一个词。长江从岷山曲折流出七千多里，用的就是这个意思。"}],"keyFunctionWords":[{"word":"类","reading":"lèi","note":"大抵、大都。「类皆偏据一方」是说六朝到南唐的政权大体都只占据一方，不是个个都完全相同。"},{"word":"所以","reading":"suǒ yǐ","note":"用来。「皇上所以发舒精神」是皇上用这座楼来振奋精神。这里不是「因此」。"},{"word":"云","reading":"yún","note":"句末语气词。「遂锡嘉名为阅江云」的云没有云朵的意思，只表示话说到这里。"},{"word":"诸","reading":"zhū","note":"「之于」的合音。「勒诸贞珉」就是勒之于贞珉，把文章刻在坚美的石碑上。贞珉指碑石。"}],"ancientModern":[{"word":"虽然","note":"「虽然，长江发源岷山」是虽说如此，下面另起一件事。今天「虽然」要带出让步的分句，不能单独一顿就另讲新事。"},{"word":"幸","note":"「法驾幸临」的幸是皇帝驾到。今天幸多指幸运、侥幸。"},{"word":"法","note":"「可为天下后世法」的法是法则、榜样。今天法多指法律、方法。"},{"word":"阅","note":"楼名「阅江」的阅是观看、视察。今天阅常指阅读文字，范围窄了很多。"}],"phoneticLoans":[{"word":"锡","loan":"赐","note":"「遂锡嘉名」的锡通「赐」，读 cì，是赏赐。不是金属锡的 xī。"},{"word":"闲","loan":"间","note":"「不旋踵闲」的闲通「间」，读 jiān，指极短的时间。转身还没完成，感慨就已经跟着来了。不读空闲的 xián。"}],"flexibleUsage":[{"word":"柔","note":"「益思有以柔之」的柔是形容词用作动词，用怀柔的办法对待远方，使边境安定下来。"},{"word":"安","note":"「益思有以安之」的安是形容词的使动用法，使百姓安定。和「视为安流」里形容水流平静的安，用法不同。"},{"word":"名","note":"「荡荡难名」的名用作动词，用语言称说。圣德广大，难以说得出。"}],"specialSyntax":[{"name":"层进排比","note":"三次「必曰」分别从江山、朝贡和农事写起，后面都用「益思有以」接住，依次落到保、柔、安。所见不同，皇帝的自责却是同一种格式。"},{"name":"反问收束","note":"「岂非天造地设……欤」「然则果谁之力欤」「其有不油然而兴耶」都用问句逼出肯定。最后一问是说忠心一定会自然生出来。"},{"name":"反衬","note":"临春、结绮、齐云、落星用「非不华」「非不高」先让一步，再指出它们只供声色，转眼就令人感慨。正面写阅江楼之前，先把这类楼否定掉。"}]},"classicComment":{"t":"奉旨撰記，故篇中多規頌之言，而爲壯重之體，真臺閣應制文字。明初朝廷大制作，皆出先生之手，洵堪稱爲一代文宗。","s":"奉旨撰记，故篇中多规颂之言，而为壮重之体，真台阁应制文字。明初朝廷大制作，皆出先生之手，洵堪称为一代文宗。"}}
