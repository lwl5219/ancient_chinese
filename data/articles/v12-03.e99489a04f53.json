"","pos":"","extra":"","level":"dict"},{"t":"日","s":"日","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"蜀","s":"蜀","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"錦","s":"锦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"齊","s":"齐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"紈","s":"纨","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"从前没有的，今天有了不算过分；从前有的，今天没有了也不算不足。","tokens":[{"t":"昔","s":"昔","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"日","s":"日","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"今","s":"今","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"日","s":"日","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"過","s":"过","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"；","s":"；","punct":true},{"t":"昔","s":"昔","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"日","s":"日","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"今","s":"今","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"日","s":"日","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"足","s":"足","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"所以一昼一夜之间，开放的花会凋谢；一春一秋过去，陈旧的事物会更新。","tokens":[{"t":"是","s":"是","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"故","s":"故","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"一","s":"一","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"晝","s":"昼","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"一","s":"一","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"夜","s":"夜","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"華","s":"华","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"開","s":"开","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"謝","s":"谢","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"；","s":"；","punct":true},{"t":"一","s":"一","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"春","s":"春","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"一","s":"一","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"秋","s":"秋","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"物","s":"物","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"故","s":"故","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"新","s":"新","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"湍急的水流下面，一定有深潭；高高的山丘下面，一定有深谷。","tokens":[{"t":"激","s":"激","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"湍","s":"湍","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"下","s":"下","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"必","s":"必","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"深","s":"深","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"潭","s":"潭","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"；","s":"；","punct":true},{"t":"高","s":"高","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"丘","s":"丘","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"下","s":"下","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"必","s":"必","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"浚","s":"浚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"谷","s":"谷","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"君侯也已经知道了，还要占卜做什么呢？","tokens":[{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"侯","s":"侯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"亦","s":"亦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"知","s":"知","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"矣","s":"矣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"何","s":"何","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"卜","s":"卜","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"？","s":"？","punct":true}]},{"tr":"」季主的话到这里说完。","tokens":[{"t":"」","s":"」","punct":true}]}]}],"lesson":{"background":"司马季主是西汉在长安卖卜的人，《史记·日者列传》写过他。东陵侯是秦朝的邵平，秦亡后失去爵位，在长安城东种瓜。两人的时代可以相接，但这篇问答不是史传，而是刘基写进《郁离子》的寓言。刘基在元末放弃官职，隐居青田，用虚构的对话讨论盛衰。东陵侯的废黜，很容易让人想到一个旧朝崩溃以后失位者的处境；季主不肯替他占卜，是因为发问的人自己已经把物极必反说出来了。文章借古人的名字，谈的是变动中的命运。","theme":"久卧想起来，久伏想打开，积到极点就会泄漏、通达。东陵侯带来的是这套循环，心里盼的却是自己废黜已久，运势应当转向。季主承认循环，却认为道理既然已经明白，就不必再问枯草和枯骨。天道只亲近有德的人，鬼神的灵验也来自人；人比占卜的器物更灵，却去听器物，是把主从弄反了。后文用昔日和今日对照：歌楼会变成断墙，苦菜会出现在曾经摆着珍馐的地方。从前没有的，今天有了不算过分；从前有的，今天没有也不算不足。深潭藏在急流下面，深谷藏在高丘下面，盛和衰本来就挨在一起。知道这一点，占卜不能再给人额外的答案。","technique":"通篇用对话推进。东陵侯先用排比把「极则反」讲到一半，季主立刻接过他的话，反问「又何卜为」，占卜从一开场就显得多余。东陵侯请求把奥妙讲完，季主才正式展开。展开时几乎不讲故事，只用对句：碎瓦对歌楼，荒榛对玉树，虫鸣对笙笛，磷火对华烛，苦菜对珍馐，枫荻对锦纨。其中「秋荼春荠」在原文里被逗号截住，下一句才补出它对应的象脂和驼峰，衰和盛仍是一对。昼与夜、春与秋、急流与深潭、高丘与深谷，把同一个必定转向说了四次，最后回到开场的问题：你已经知道了，还卜什么。","keyContentWords":[{"word":"东陵侯","reading":"dōng líng hóu","note":"秦朝邵平的封号。秦亡后他失爵，成为平民。文中以他的废黜起头，问的是久处下位之后还会不会转向。"},{"word":"司马季主","reading":"sī mǎ jì zhǔ","note":"西汉长安的占卜者。刘基借他的嘴说蓍草、龟甲没有灵性，不必把命运交给物件。"},{"word":"蓍","reading":"shī","note":"占卜用的草。季主说它不过是枯草，和枯骨做成的龟甲一样，都是物，不是比人更高的主宰。"},{"word":"象白","reading":"xiàng bái","note":"象身上的白脂，古代当作珍馐，常和驼峰并称。它用来对「秋荼春荠」那些微贱的野菜。"},{"word":"琼蕤","reading":"qióng ruí","note":"美好的花。蕤是花朵下垂的样子。琼蕤玉树代表从前园囿里的华美草木，对照眼前的荒榛断梗。"},{"word":"浚","reading":"jùn","note":"深。「必有浚谷」是高丘下面一定有深谷。高和深连在一起，用来说明盛衰互相依存。"},{"word":"荼","reading":"tú","note":"「秋荼」的荼是苦菜，读 tú，不是茶。春荠读 jì，是春天的荠菜。二者都是微贱的野菜；句子在这里被逗号截断，下一句才补出对应的象脂和驼峰。"}],"keyFunctionWords":[{"word":"靡","reading":"mǐ","note":"没有。「靡屈不伸」是没有只弯曲而不伸展的。和「无往不复」一样，都是用双重否定说必定转向。"},{"word":"为","reading":"wéi","note":"句末语气词。「又何卜为」「何以卜为」就是「为什么还要占卜呢」。这里的为不担任动词。"},{"word":"是故","reading":"shì gù","note":"因此、所以。用来引出碎瓦歌楼一类对照，也用来引出花开会谢、旧物更新。"},{"word":"且","reading":"qiě","note":"况且。「且君侯何不思昔者也」是把话推进一层，叫东陵侯先回想从前，不必急着占卜。"}],"ancientModern":[{"word":"过","note":"「过司马季主」的过是拜访。「今日有之不为过」的过是过分。今天过多指经过，或者和「错」连用，不再单独表示登门访人。"},{"word":"仆","note":"「仆窃有疑」的仆是说话人的谦称，等于「我」。今天仆多指仆人。"},{"word":"物故","note":"「物故者新」的故是旧，整句说陈旧的事物会更新。今天「物故」常常专指人去世，用在这里会把意思读窄。"}],"phoneticLoans":[{"word":"华","loan":"花","note":"「华开者谢」的华同「花」，读 huā，指花朵开放以后会凋谢。不要读成华丽的 huá。"},{"word":"缸","loan":"釭","note":"「金缸华烛」的缸通「釭」，读 gāng，指灯。金缸华烛是华美的灯烛，用来对照后来的磷火和萤火。"}],"flexibleUsage":[{"word":"灵","note":"「因人而灵」的灵是形容词用作动词，显出灵验。「灵于物」则是比物件灵慧。两处都不是今天名词「灵魂」的用法。"},{"word":"新","note":"「物故者新」的新是形容词用作动词，变新、更新。旧的事物会重新生长出来。"}],"specialSyntax":[{"name":"宾语前置","note":"「惟德之亲」是只亲近德。德是「亲」的宾语，借「之」提到动词前面，强调天道所亲的是德，不是权势。"},{"name":"反问固定格式","note":"「何卜为」「何以卜为」是「为什么还要……」的反问。季主两次用它，把东陵侯自己已经说出的道理交还给他。"},{"name":"判断句","note":"「蓍，枯草也；龟，枯骨也」用「……也」直接判断。先把占卜工具降成枯草、枯骨，后面「听于物」才显得没有道理。"}]},"classicComment":{"t":"通篇只說得一個循環道理。吃緊喚醒東陵處，全在「何不思昔者」一句。以下總發明此意。世之人，類多時命之感，讀此可以曉然矣。","s":"通篇只说得一个循环道理。吃紧唤醒东陵处，全在「何不思昔者」一句。以下总发明此意。世之人，类多时命之感，读此可以晓然矣。"}}
