"","level":"sentence"},{"t":"哉","s":"哉","py":"","ctx":"啊，语气词。","pos":"","extra":"","level":"sentence"},{"t":"！","s":"！","punct":true}]},{"tr":"现在您不察看这些，却来察看我的柑子！","tokens":[{"t":"今","s":"今","py":"","ctx":"现在，或这。","pos":"","extra":"","level":"sentence"},{"t":"子","s":"子","py":"","ctx":"对人的敬称，也指儿女。","pos":"","extra":"","level":"sentence"},{"t":"是","s":"是","py":"","ctx":"这，或判断词“是”。","pos":"","extra":"","level":"sentence"},{"t":"之","s":"之","py":"","ctx":"的。","pos":"","extra":"","level":"sentence"},{"t":"不","s":"不","py":"","ctx":"表示否定。","pos":"","extra":"","level":"sentence"},{"t":"察","s":"察","py":"","ctx":"察看。","pos":"","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"而","s":"而","py":"","ctx":"就、然后。连接两个动作或两种性状。","pos":"","extra":"","level":"sentence"},{"t":"以","s":"以","py":"","ctx":"用、拿。","pos":"","extra":"","level":"sentence"},{"t":"察","s":"察","py":"","ctx":"察看。","pos":"","extra":"","level":"sentence"},{"t":"吾","s":"吾","py":"","ctx":"我。","pos":"","extra":"","level":"sentence"},{"t":"柑","s":"柑","py":"","ctx":"柑橘一类的果子。","pos":"","extra":"","level":"sentence"},{"t":"！","s":"！","punct":true}]},{"tr":"卖柑人的回答到此结束。","tokens":[{"t":"」","s":"」","punct":true}]}]},{"sentences":[{"tr":"我沉默着，没有话可以回答。","tokens":[{"t":"予","s":"予","py":"","ctx":"我。","pos":"","extra":"","level":"sentence"},{"t":"默","s":"默","py":"","ctx":"沉默。","pos":"","extra":"","level":"sentence"},{"t":"默","s":"默","py":"","ctx":"沉默。","pos":"","extra":"","level":"sentence"},{"t":"無","s":"无","py":"","ctx":"没有。","pos":"","extra":"","level":"sentence"},{"t":"以","s":"以","py":"","ctx":"用来。","pos":"","extra":"","level":"sentence"},{"t":"應","s":"应","py":"","ctx":"应当。应答读 yìng。","pos":"","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"回来以后想想他的话，很像东方朔那一类用诙谐来讽谏的人。","tokens":[{"t":"退","s":"退","py":"","ctx":"退。","pos":"","extra":"","level":"sentence"},{"t":"而","s":"而","py":"","ctx":"就、然后。连接两个动作或两种性状。","pos":"","extra":"","level":"sentence"},{"t":"思","s":"思","py":"","ctx":"想、思念。","pos":"","extra":"","level":"sentence"},{"t":"其","s":"其","py":"","ctx":"他的、它的，或那。","pos":"","extra":"","level":"sentence"},{"t":"言","s":"言","py":"","ctx":"话，或说。","pos":"","extra":"","level":"sentence"},{"t":"，","s":"，","punct":true},{"t":"類","s":"类","py":"","ctx":"种类，或类似。","pos":"","extra":"","level":"sentence"},{"t":"東","s":"东","py":"","ctx":"东。","pos":"","extra":"","level":"sentence"},{"t":"方","s":"方","py":"","ctx":"方正、方法，或正要。","pos":"","extra":"","level":"sentence"},{"t":"生","s":"生","py":"","ctx":"生命、活着，或生长。","pos":"","extra":"","level":"sentence"},{"t":"滑","s":"滑","py":"","ctx":"滑，或滑国。","pos":"","extra":"","level":"sentence"},{"t":"稽","s":"稽","py":"","ctx":"考核、拖延。","pos":"","extra":"","level":"sentence"},{"t":"之","s":"之","py":"","ctx":"的。","pos":"","extra":"","level":"sentence"},{"t":"流","s":"流","py":"","ctx":"水流，或流动、流传。","pos":"","extra":"","level":"sentence"},{"t":"。","s":"。","punct":true}]},{"tr":"难道他是愤恨世道、憎恶邪僻的人吗？","tokens":[{"t":"豈","s":"岂","py":"","ctx":"难道。","pos":"","extra":"","level":"sentence"},{"t":"其","s":"其","py":"","ctx":"他的、它的，或那。","pos":"","extra":"","level":"sentence"},{"t":"忿","s":"忿","py":"","ctx":"愤怒。","pos":"","extra":"","level":"sentence"},{"t":"世","s":"世","py":"","ctx":"世上，或一代。","pos":"","extra":"","level":"sentence"},{"t":"嫉","s":"嫉","py":"","ctx":"嫉妒。","pos":"","extra":"","level":"sentence"},{"t":"邪","s":"邪","py":"","ctx":"不正当。句末语气词读 yé。","pos":"","extra":"","level":"sentence"},{"t":"者","s":"者","py":"","ctx":"……的人，或……的事物。","pos":"","extra":"","level":"sentence"},{"t":"耶","s":"耶","py":"","ctx":"吗，或父亲。","pos":"","extra":"","level":"sentence"},{"t":"？","s":"？","punct":true}]},{"tr":"是借着柑子来寄托讽刺吗？","tokens":[{"t":"而","s":"而","py":"","ctx":"连词，连接前后两项。","pos":"","extra":"","level":"sentence"},{"t":"託","s":"托","py":"","ctx":"寄托。","pos":"","extra":"","level":"sentence"},{"t":"於","s":"于","py":"","ctx":"在、向、对。","pos":"","extra":"","level":"sentence"},{"t":"柑","s":"柑","py":"","ctx":"柑橘一类的果子。","pos":"","extra":"","level":"sentence"},{"t":"以","s":"以","py":"","ctx":"用、拿。","pos":"","extra":"","level":"sentence"},{"t":"諷","s":"讽","py":"","ctx":"用言语讥刺。","pos":"","extra":"","level":"sentence"},{"t":"耶","s":"耶","py":"","ctx":"吗，或父亲。","pos":"","extra":"","level":"sentence"},{"t":"？","s":"？","punct":true}]}]}],"lesson":{"background":"刘基，字伯温，元末明初青田人。这篇短文从杭州一个卖水果的人写起。他把柑子藏过寒暑，拿出来仍然光泽如玉、颜色如金，切开却干得像破絮。作者抓住这只柑质问，卖柑人却把话头转到佩虎符、坐皋比的武将和峨大冠、拖长绅的文臣身上。元末冠服、车马和俸禄都还齐整，御盗、救民、整饬法度的事却常常落空。文章不罗列官职，只借一场买卖，说明最体面的外表最经不起剖开。","theme":"主旨不在柑子能不能吃，而在「欺」有大小。卖柑人承认自己靠藏柑谋生，随即指出世上为欺的并不少：武将看起来是干城之具，却未必有孙吴之略；文臣看起来是庙堂之器，却未必建得成伊皋之业。盗起、民困、吏奸、法坏，四件事都「不知」，他们却坐耗廪粟而不知耻。坐高堂、骑大马、醉醇醴、饫肥鲜，姿态越可畏、可象，越像那只烨然的柑。作者最后无话可答，把卖柑人看成忿世嫉邪的人，讽刺就留在两个问句里。","technique":"全文先立实物，再转入对话。藏柑、出柑、剖柑三句完成对照，质问用「将……乎？将……乎？」把祭祀之用和炫外惑人分成两路。卖柑人不辩柑子，用笑接住怒气，先说「业是有年」，再反问「而独我也乎」。武将、文臣两句对仗，接着四个「不知」排成一串，最后用「金玉其外、败絮其中」把柑和人扣在一起。「甚矣哉为欺也」把谓语提前，「是之不察」把宾语提前，情绪和矛头都抢在动词前面。结尾不直接判罪，只说像东方朔一类滑稽的人，再用两问收住。","keyContentWords":[{"word":"涉","reading":"shè","note":"经历。柑子经过整个寒天和暑天仍不腐烂。"},{"word":"溃","reading":"kuì","note":"腐烂、溃烂。"},{"word":"烨然","reading":"yè rán","note":"光彩鲜明的样子。"},{"word":"败絮","reading":"bài xù","note":"破旧的棉絮。形容柑子里面已经干枯。"},{"word":"笾豆","reading":"biān dòu","note":"盛食物的礼器。笾是竹制，豆是木制，用于祭祀和宴客。"},{"word":"皋比","reading":"gāo pí","note":"虎皮。武将的坐席。《左传》有「蒙皋比而先犯之」。"},{"word":"干城","reading":"gān chéng","note":"盾牌和城墙，比喻保卫国家的人。语出《诗经·兔罝》。"},{"word":"斁","reading":"dù","note":"败坏。法斁，法度废坏。"},{"word":"縻","reading":"mí","note":"耗费。坐縻廪粟，白白消耗官仓里的粮食。"},{"word":"滑稽","reading":"gǔ jī","note":"言辞诙谐、能在笑谈里进谏。东方生指汉武帝时的东方朔。"}],"keyFunctionWords":[{"word":"若","reading":"ruò","note":"你。「若所市于人者」就是你卖给人的东西。"},{"word":"将","reading":"jiāng","note":"选择问里的「还是」。前一句「将以」是打算用来，后一句「将衒外」转入另一面。"},{"word":"食","reading":"sì","note":"养活。「食吾躯」是靠这个养活自己。"},{"word":"所","reading":"suǒ","note":"「不足子所」的所，指你要求所在之处，也就是你的标准。"},{"word":"夫","reading":"fú","note":"「今夫」的夫放在句首，引出要议论的那一类人。"}],"ancientModern":[{"word":"市","note":"这里是卖。「所市于人」即卖给别人的。今多指集市、城市。"},{"word":"是","note":"「业是」「是之不察」的是，都是「这个」。今常用作判断词。"},{"word":"类","note":"「类东方生」是类似、像。今多指种类。"},{"word":"坐","note":"「坐縻廪粟」的坐是白白地、空空地。今多指坐下这个动作。"}],"phoneticLoans":[{"word":"食","loan":"饲","note":"「食吾躯」的食读 sì，通「饲」，给人吃、养活。"},{"word":"衒","loan":"炫","note":"「衒外」的衒通「炫」，炫耀外表。"}],"flexibleUsage":[{"word":"实","note":"「实笾豆」的实是装满，形容词用作动词。"},{"word":"业","note":"「吾业是」的业是以……为职业，名词用作动词。"},{"word":"峨","note":"「峨大冠」的峨是高高地戴着，形容词用作动词。"},{"word":"金玉","note":"「金玉其外」是使外表像金玉，名词用作动词。"}],"specialSyntax":[{"name":"主谓倒装","note":"「甚矣哉为欺也」等于「为欺甚矣哉」，把「太过分了」提前，加重责备。"},{"name":"宾语前置","note":"「未之思」是「未思之」；「是之不察」是「不察是」。否定句和「之」都把宾语提前。"}]},"classicComment":{"t":"青田此言，爲世人盜名者發，而借賣柑影喻。滿腔憤世之心，而以痛哭流涕出之。士之金玉其外而敗絮其中者，聞賣柑之言，亦可以少愧矣。","s":"青田此言，为世人盗名者发，而借卖柑影喻。满腔愤世之心，而以痛哭流涕出之。士之金玉其外而败絮其中者，闻卖柑之言，亦可以少愧矣。"}}