level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"所以他的子孙虽然有愚昧到极点、不成器、足以使国家灭亡的人，上天终究不忍心立刻让国家灭亡。这才是考虑得深远的做法。","tokens":[{"t":"故","s":"故","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"孫","s":"孙","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"雖","s":"虽","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"至","s":"至","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"愚","s":"愚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"肖","s":"肖","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"足","s":"足","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"亡","s":"亡","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"國","s":"国","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"天","s":"天","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"卒","s":"卒","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"忍","s":"忍","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"遽","s":"遽","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"亡","s":"亡","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"此","s":"此","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"慮","s":"虑","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"遠","s":"远","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"如果不能自己和天结下这份关系，却想用一点点智巧去笼络当代的事务，还认定后世一定不会危亡，这在道理上绝对不会有，又哪里算得上天道呢！","tokens":[{"t":"夫","s":"夫","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"苟","s":"苟","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"能","s":"能","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"自","s":"自","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"結","s":"结","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"天","s":"天","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"欲","s":"欲","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"區","s":"区","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"區","s":"区","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"智","s":"智","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"籠","s":"笼","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"絡","s":"络","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"當","s":"当","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"世","s":"世","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"務","s":"务","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"必","s":"必","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"後","s":"后","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"世","s":"世","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"危","s":"危","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"亡","s":"亡","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"此","s":"此","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"理","s":"理","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"必","s":"必","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"豈","s":"岂","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"天","s":"天","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"道","s":"道","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"哉","s":"哉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"！","s":"！","punct":true}]}]}],"lesson":{"background":"方孝孺，字希直，宁海人，明初学者，文章收入《逊志斋集》。本篇讨论治国的远虑。他看到一个反复出现的情形：新朝代总是盯着前朝灭亡的那一个原因，把防备做得很密，祸乱却从没有防到的地方起来。秦防诸侯，汉防孤立，武帝以后防藩国，唐防一个武姓的预言，宋防藩镇，都是同一类心思。文章写在明初，关心的不是某一朝的掌故，而是人的智谋能不能覆盖后世的变化。","theme":"篇首先立一个判断：人总是图难忽易，备其所畏，遗其所不疑，祸乱偏偏从被忽略、被看作无可疑的地方出来。下面一串史事都在证明这一点。秦以为周亡于诸侯强大，改封建为郡县，刘邦却从陇亩兴起。汉以为秦亡于孤立，大封同姓，七国反而生变；削藩以后又以为无事，王莽改了汉祚。光武、曹魏、晋各自防着前代的死因，灭亡仍出在防备之外。唐太宗要除掉疑似的武氏，真正的武氏就在左右；宋太祖解除方镇兵权，子孙却困于敌国。由此推出「智可以谋人，而不可以谋天」。良医、良巫的比喻说明，擅长对付眼前的人事，并不等于能掌握自家命运。远虑不是再多设一条法令，而是积至诚、用大德去结天心，使天不忍立刻弃绝。靠区区智巧笼络当世，还要保证后世永不危亡，文章认为这在道理上不可能。","technique":"开头用两组对句把「难与易」「可畏与不疑」摆开，马上用「然而」翻过来说祸乱的来处。秦、汉、武宣、光武与魏晋、唐、宋六层史事，句法都是「以为如此，而不知……」或「各惩其所由亡，而其亡也皆出其外」，读者还没读到结论，已经感到防备永远慢一拍。史事写完，忽然换成两句极短的比喻：「良医之子多死于病，良巫之子多死于鬼。」长句之后的短句，把「谋人」和「谋天」分开。正面主张留到后部，用慈母保赤子作比，语气从责备转为期望。末句「岂天道哉」不是再讲一则历史，而是把那种必求后世无危亡的想法，直接判在天道之外。","keyContentWords":[{"word":"遗","reading":"yí","note":"遗漏、丢下。「遗其所不疑」是把不觉得可疑的事放在防备之外。"},{"word":"天道","reading":"tiān dào","note":"超出人的智力、不能用权谋算尽的那一层变化。文中与「人事」相对。"},{"word":"封建","reading":"fēng jiàn","note":"分封土地、建立诸侯。秦把这一制度改成郡县。"},{"word":"庶孽","reading":"shù niè","note":"本指妾生的旁支子弟。这里指汉初大量封立的刘姓宗室。"},{"word":"祚","reading":"zuò","note":"帝位、国运。「移汉祚」是汉家的皇位被王莽夺走。"},{"word":"几","reading":"jī","note":"细微的苗头。「治乱存亡之几」是兴亡还没显露时的征兆。"},{"word":"赤子","reading":"chì zǐ","note":"婴儿。用来比上天眷顾有德之君，像母亲不忍放开孩子。"},{"word":"遽","reading":"jù","note":"立刻、匆忙。「不忍遽亡之」是不忍马上让它灭亡。"}],"keyFunctionWords":[{"word":"与","reading":"yú","note":"句末疑问语气，同「欤」。「岂其虑之未周与」即难道考虑得还不周到吗。"},{"word":"盖","reading":"gài","note":"承接上文，解释原因。相当于「原来」。"},{"word":"卒","reading":"zú","note":"终于。「卒亡秦之社稷」「王莽卒移汉祚」都是最后的结果。"},{"word":"惩","reading":"chéng","note":"以……为警戒。不是惩罚本人，而是针对前代灭亡的原因预先防备。"},{"word":"苟","reading":"gǒu","note":"如果。「夫苟不能自结于天」引出作者否定的那种做法。"}],"ancientModern":[{"word":"封建","note":"古义是分封诸侯、建立邦国。今多指封建社会这一历史阶段，范围大得多。"},{"word":"遗","note":"这里是遗漏。今多指遗留、遗传、遗嘱。"},{"word":"工","note":"「工于活人」是擅长。今多指工人、工程、工艺。"},{"word":"几","note":"这里读 jī，是征兆。今多读 jǐ，表示询问数量，或读 jī，表示几乎。"}],"phoneticLoans":[{"word":"与","loan":"欤","note":"「岂其虑之未周与」的与通「欤」，表示疑问。"},{"word":"彊","loan":"强","note":"「诸侯之彊」的彊通「强」，读 qiáng，势力强大。"}],"flexibleUsage":[{"word":"一","note":"「一天下」的一用作动词，统一。"},{"word":"活","note":"「活人」「活己之子」的活是使动，使……活下去。"},{"word":"亡","note":"「不忍遽亡之」的亡是使动，使它灭亡。"}],"specialSyntax":[{"name":"判断句","note":"「出于智力之所不及者，天道也。」用「……者，……也」判断那超出智力的部分就是天道。"},{"name":"反问","note":"「岂其虑之未周与」「终至乱亡者何哉」「而岂天道哉」都用问句推出作者自己的解释。"}]},"classicComment":{"t":"天道爲智力之所不及，然盡人事以合天心，即天亦有可謀處。此文歸到積至誠、用大德，正是祈天永命工夫。古今之論天道人事者多，得此乃見透快。","s":"天道为智力之所不及，然尽人事以合天心，即天亦有可谋处。此文归到积至诚、用大德，正是祈天永命工夫。古今之论天道人事者多，得此乃见透快。"}}
