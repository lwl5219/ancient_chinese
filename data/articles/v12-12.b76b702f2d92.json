":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"自","s":"自","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"歲","s":"岁","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"時","s":"时","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"伏","s":"伏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"臘","s":"腊","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"一","s":"一","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"刺","s":"刺","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"外","s":"外","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"即","s":"即","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"經","s":"经","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"年","s":"年","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"往","s":"往","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"偶尔路过他的门口，也捂住耳朵、闭上眼睛，催马飞快跑过去，好像有人在后面追赶似的。","tokens":[{"t":"間","s":"间","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"道","s":"道","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"經","s":"经","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"門","s":"门","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"則","s":"则","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"亦","s":"亦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"掩","s":"掩","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"耳","s":"耳","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"閉","s":"闭","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"目","s":"目","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"躍","s":"跃","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"馬","s":"马","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"疾","s":"疾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"走","s":"走","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"過","s":"过","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"若","s":"若","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"追","s":"追","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"逐","s":"逐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"这就是我心胸狭隘的地方。","tokens":[{"t":"斯","s":"斯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"則","s":"则","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"僕","s":"仆","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"褊","s":"褊","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"衷","s":"衷","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"因此我长期不被长官喜欢，我就更加不管这些了。","tokens":[{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"此","s":"此","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"長","s":"长","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"見","s":"见","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"悅","s":"悦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"長","s":"长","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"吏","s":"吏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"僕","s":"仆","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"則","s":"则","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"愈","s":"愈","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"益","s":"益","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"顧","s":"顾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"我常常夸口说：「人生各有命运，我只是守住自己的本分罢了。","tokens":[{"t":"每","s":"每","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"大","s":"大","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"言","s":"言","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"：「","s":"：「","punct":true},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"生","s":"生","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"命","s":"命","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"吾","s":"吾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"惟","s":"惟","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"守","s":"守","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"分","s":"分","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"已","s":"已","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"您老人家听了，该不会讨厌我这个人太迂腐吧？","tokens":[{"t":"」","s":"」","punct":true},{"t":"長","s":"长","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"聞","s":"闻","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"得","s":"得","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"厭","s":"厌","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"迂","s":"迂","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乎","s":"乎","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"？","s":"？","punct":true}]}]}],"lesson":{"background":"宗臣字子相，兴化人，嘉靖年间进士，与李攀龙、王世贞等人同被后人称作后七子。这封信是回复父亲老友刘一丈的。一丈是对长辈的敬称。对方从很远的地方寄信，还送了礼物，并用「上下相孚，才德称位」勉励他。宗臣没有顺着这八个字作客套的自谦，而是把当时求见权贵的全过程写成一封回信。严嵩长期执政的嘉靖后期，京师请托成风，权门前挤满了求官的人。信里始终不点名，只把一套拜谒的仪式摊开给长者看，再声明自己除了年节投一张名帖，整年不去那些门口。","theme":"全文就扣住来信里的「上下相孚」。宗臣先承认自己的才德未必配得上职位，再把话转到「不孚」：如今所谓上下投合，并不是德行上的彼此信任，而是门房、贿赂和当面假意推让串起来的一出戏。客人用屈辱换来一句「某也贤」，再拿这句话去吓唬同辈，这就是世人羡慕的相孚。与这幅图相对的是写信人自己：路过权门便掩耳策马，宁可被长官看成迂阔，也只说守住本分。他要长者明白，自己做不到那种孚，也不肯做。","technique":"文章的力量在叙事，不在抽象地斥骂。干谒按时间排成短剧：投帖、守候、吃闭门羹、第二天再来、跪献寿金、出门向门房作揖、马上向熟人夸口。对话都很短，门房的怒、主人的「进」、客人的「厚我」却各有声口。同一动作写两次，例如故意不起来、故意不收礼金，把虚伪写成可以听见的节奏。后半突然换笔，用「经年不往」和「跃马疾走」把前面的热络冷下来。结尾问长者会不会嫌自己迂，语气放软，讽刺却已经完成。","keyContentWords":[{"word":"长者","reading":"zhǎng zhě","note":"对长辈的尊称，这里指刘一丈。"},{"word":"馈遗","reading":"kuì wèi","note":"赠送财物。遗在这里读 wèi，是赠给，不是遗失。"},{"word":"相孚","reading":"xiāng fú","note":"互相信任、彼此投合。孚，信用。"},{"word":"称位","reading":"chèn wèi","note":"与职位相称。称在这里读 chèn，不是 chēng。"},{"word":"刺","reading":"cì","note":"名帖、拜帖。持刺、一刺，都是投名片求见。"},{"word":"寿金","reading":"shòu jīn","note":"献给尊者的礼金。寿，用钱财进献，不是年龄。"},{"word":"官人","reading":"guān rén","note":"这里是对看门人的敬称，不是指做官的人。"},{"word":"相公","reading":"xiàng gōng","note":"对宰相一类权贵的称呼。"},{"word":"伏腊","reading":"fú là","note":"夏天的伏日和冬天的腊日，泛指一年里的祭祀节日。"},{"word":"褊衷","reading":"biǎn zhōng","note":"狭隘的心胸。字面上是自责，实际表示不肯屈从。"}],"keyFunctionWords":[{"word":"即","reading":"jí","note":"就、便。即亦甚幸矣，是就已经很幸运。即门者持刺入，近于即便。"},{"word":"故","reading":"gù","note":"故意。门者故不入、主者故不受，都不是所以。"},{"word":"固","reading":"gù","note":"坚决。则固请、故固不受。另有「本来」一义，固自知之矣。"},{"word":"间","reading":"jiàn","note":"偶尔。间道经其门。不读 jiān，也不是中间。"},{"word":"向","reading":"xiàng","note":"从前、先前。又立向所立厩中。"},{"word":"得无","reading":"dé wú","note":"揣测语气，该不会、莫非。得无厌其为迂乎。"}],"ancientModern":[{"word":"书","note":"古：书信。时赐一书。今多指书籍、书写。"},{"word":"殷","note":"古：深厚。情意甚殷。今多指殷实、殷勤，或朝代名。"},{"word":"私","note":"古：私下赠送、买通。袖金以私之。今多指私人、自私。"},{"word":"报","note":"古：答复，也指报答。报客曰、何以报焉。今多指报告、报纸。"},{"word":"顾","note":"古：关照、眷顾。幸顾我。今多指回头看、顾客。"},{"word":"厚","note":"古：看重、优待。相公厚我。今多指厚度、厚道。"},{"word":"适","note":"古：刚才。适自相公家来。今多指适合。"},{"word":"稍稍","note":"古：渐渐。稍稍语人。今多指稍微。"},{"word":"分","note":"古：本分，读 fèn。守分而已。今多指分开、分数。"},{"word":"迂","note":"古：拘执、不合时宜。厌其为迂。今多指曲折绕路。"}],"phoneticLoans":[{"word":"彊","loan":"强","note":"彊忍而与言：勉强忍耐。彊通「强」，这里读 qiǎng。"},{"word":"亡","loan":"无","note":"亡奈何矣：没有办法。亡通「无」，读 wú。"}],"flexibleUsage":[{"word":"袖","note":"名词作动词。袖金，把金银藏进袖子。"},{"word":"私","note":"活用为动词。私之，私下买通看门人。"},{"word":"策","note":"名词作动词。策马，用马鞭赶马。"},{"word":"南面","note":"名词作状语。南面召见，面朝南坐着召见，表示主人居尊。"},{"word":"上","note":"方位词活用为动词。上寿金，把礼金献上去。"},{"word":"入","note":"使动。起而入之，让他进去。"}],"specialSyntax":[{"name":"被动句","note":"长不见悦于长吏。见……于，表示被长官喜欢；长，是长久。"},{"name":"宾语前置","note":"何客之勤也。之把宾语提前，等于说客人怎么这样勤快。"},{"name":"判断句","note":"此世所谓上下相孚也。斯则仆之褊衷。也、则都用来下判断。"},{"name":"固定句式","note":"得无……乎，表示委婉揣测。何至、何以，用何提出反问。"}]},"classicComment":{"t":"是時嚴介溪攬權，俱是乞哀昏暮、驕人白日一輩人，摹寫其醜形惡態，可爲盡情。末說出自己之氣骨，兩兩相較，薰蕕不同，清濁異質。有關世教之文。","s":"是时严介溪揽权，俱是乞哀昏暮、骄人白日一辈人，摹写其丑形恶态，可为尽情。末说出自己之气骨，两两相较，薰莸不同，清浊异质。有关世教之文。"}}
