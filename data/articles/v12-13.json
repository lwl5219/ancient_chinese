不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"能","s":"能","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"自","s":"自","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"忘","s":"忘","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]},{"sentences":[{"tr":"魏君如今离开吴县已经三年了。有一天和我同在宫廷里，拿出这幅图，展开赏玩，长声叹息，于是让我为它写一篇记。","tokens":[{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"今","s":"今","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"去","s":"去","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"縣","s":"县","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"已","s":"已","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"三","s":"三","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"年","s":"年","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"矣","s":"矣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"一","s":"一","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"日","s":"日","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"與","s":"与","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"余","s":"余","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"同","s":"同","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"在","s":"在","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"內","s":"内","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"庭","s":"庭","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"出","s":"出","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"示","s":"示","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"此","s":"此","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"圖","s":"图","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"展","s":"展","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"玩","s":"玩","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"太","s":"太","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"息","s":"息","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"因","s":"因","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"命","s":"命","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"余","s":"余","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"記","s":"记","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"唉！","tokens":[{"t":"噫","s":"噫","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"！","s":"！","punct":true}]},{"tr":"魏君对我们吴地有这样的情意，怎么能让我们的百姓忘掉他呢？","tokens":[{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"吾","s":"吾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"吳","s":"吴","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"情","s":"情","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"如","s":"如","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"此","s":"此","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"如","s":"如","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"何","s":"何","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"使","s":"使","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"吾","s":"吾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"民","s":"民","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"能","s":"能","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"忘","s":"忘","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"？","s":"？","punct":true}]}]}],"lesson":{"background":"归有光字熙甫，昆山人，后人称他震川先生。他和魏用晦是同一榜的进士，所以称同年。魏用晦做吴县知县不到三年，考课列入优等，被召入朝担任给事中。离任时百姓留不住他，有人画了一幅《吴山图》作为赠别。三年以后，魏君在宫廷里把这幅图拿给归有光看，展开把玩，叹息不止，嘱他作记。当时吴县、长洲同在苏州府城分界而治，府西的山和水大多属于吴县。归有光自己是吴人，写的却不是一本山水目录，而是一位离任县令为什么还该留在这幅图里。","theme":"这篇记要说的是贤明的县令与地方之间的关系。县令若贤，山川草木也显得有光；若不贤，山川也跟着蒙羞。魏君在任时对百姓有恩，离开三年仍然对着图叹息，可见他没有把吴县当成路过的一级官阶。归有光由此再推进一步：贤者所到之处，不但当地人不忍忘记他，他自己也无法忘掉当地人。图是送行的礼物，也是这份情意的凭据。百姓将来在佛寺道观里纪念他，作者认为理所当然；眼前这一篇记，则是替还不能相忘的双方把情意留住。","technique":"开篇先把吴县的山和水铺开，穹窿、灵岩、虎丘、太湖接连出现，好像一篇地志。写到魏君，句子立刻收到人身上：任期、召入、百姓挽留、绘图相赠，都只用几笔。中间用贤与不贤对照，把山水的荣辱系在县令身上，前面的地名这才有了着落。又借苏轼称道韩琦久别黄州仍不能忘作旁证，使「不能自忘」不全是吴人的私情。结尾一声「噫」，再用反问收住，感情比写景的句子重。","keyContentWords":[{"word":"郡治","reading":"jùn zhì","note":"府城官署所在地，这里指苏州府。"},{"word":"同年","reading":"tóng nián","note":"同一年考中科举的人。"},{"word":"高第","reading":"gāo dì","note":"考课成绩列入优等。第，等第。"},{"word":"给事中","reading":"jǐ shì zhōng","note":"明代谏官，掌管封驳章奏。给读 jǐ。"},{"word":"惠爱","reading":"huì ài","note":"恩惠和爱护，指县令对待百姓的德政。"},{"word":"尸祝","reading":"shī zhù","note":"祭祀。尸本是代受祭的人，祝是司祭告的人。"},{"word":"浮屠","reading":"fú tú","note":"佛，这里指佛寺。老子之宫，指道观。"},{"word":"惓惓","reading":"quán quán","note":"恳切不忘、念念于心的样子。"},{"word":"内庭","reading":"nèi tíng","note":"宫廷之内。魏君已入朝为官，所以在内庭出示图。"},{"word":"增重","reading":"zēng zhòng","note":"增加分量、提高声望。重读 zhòng。"}],"keyFunctionWords":[{"word":"焉","reading":"yān","note":"在那里。吴之故宫在焉，等于说宫殿在这座山上。"},{"word":"以","reading":"yǐ","note":"因为。以高第召入。也有用来一义，绘《吴山图》以为赠。"},{"word":"诚","reading":"chéng","note":"果真、如果确实。令诚贤也、令诚不贤也，都是假设。"},{"word":"盖","reading":"gài","note":"大概、原来。君于吴之山川，盖增重矣。"},{"word":"固","reading":"gù","note":"本来。固宜，本来就应当。"},{"word":"既","reading":"jì","note":"已经。君则亦既去矣，是说人已经离开。"}],"ancientModern":[{"word":"为","note":"古：担任。为吴县，是做吴县知县。今多指做、为了、认为。"},{"word":"第","note":"古：等第、名次。高第。今多指次序、住宅。"},{"word":"泽","note":"古：恩泽。被其泽。今多指沼泽、光泽。"},{"word":"殃","note":"古：祸害。被其殃。今口语里很少单用。"},{"word":"宫","note":"古：屋舍、神庙。老子之宫指道观。今多指宫殿。"},{"word":"去","note":"古：离开。去县已三年。今多指前往某处。"},{"word":"图","note":"古：图画。出示此图。今多指图谋、图表。"},{"word":"胜","note":"古：优美的景色。择胜。今多指胜利、胜过。"},{"word":"被","note":"古：蒙受。被其泽、被其殃。今多指被子，或被动标记。"},{"word":"令","note":"古：县令。令之于民。今多指命令、使、让。"}],"phoneticLoans":[{"word":"扳","loan":"攀","note":"百姓扳留之不能得：挽留。扳通「攀」，读 pān。"}],"flexibleUsage":[{"word":"为","note":"动词，担任。为吴县，后面省去县令一类官名。"},{"word":"荣","note":"有荣：显出光彩。与下文有辱相对，都是受县令影响的结果。"},{"word":"增重","note":"使动。使吴县的山川更有分量。"},{"word":"尸祝","note":"名词性的职事活用为动词，立位祭祀。"}],"specialSyntax":[{"name":"判断句","note":"皆胜地也。则海内之奇观矣。夫令之于民诚重矣。用也、矣表示判断和确认。"},{"name":"假设复句","note":"令诚贤也……有荣也；令诚不贤也……有辱也。诚字领起两种相反的结果。"},{"name":"反问句","note":"何复惓惓于此山哉。如之何而使吾民能忘之也。用何、如之何把感慨说成问句。"},{"name":"省略","note":"为吴县，承上文省去令。绘《吴山图》以为赠，省去赠给魏君的对象。"}]},"classicComment":{"t":"因令贈圖，因圖作記，因贈圖而知令之不能忘情于民，因記圖而知民之不能忘情于令。婉轉情深，筆墨在山水之外。","s":"因令赠图，因图作记，因赠图而知令之不能忘情于民，因记图而知民之不能忘情于令。婉转情深，笔墨在山水之外。"}}
