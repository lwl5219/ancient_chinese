:"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"乃","s":"乃","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"釋","s":"释","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"欽","s":"钦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"重","s":"重","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"如","s":"如","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"此","s":"此","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"由此可见，士人想让名声传到千年以后，不跟消融的流水一同灭尽，是另有所凭依的。","tokens":[{"t":"可","s":"可","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"見","s":"见","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"士","s":"士","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"慾","s":"欲","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"垂","s":"垂","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"名","s":"名","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"千","s":"千","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"載","s":"载","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"與","s":"与","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"澌","s":"澌","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"然","s":"然","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"俱","s":"俱","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"盡","s":"尽","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"則","s":"则","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"在","s":"在","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"矣","s":"矣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]},{"sentences":[{"tr":"文瑛读书，喜欢诗，和我们这些人来往，人们称呼他为沧浪僧。","tokens":[{"t":"文","s":"文","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"瑛","s":"瑛","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"讀","s":"读","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"書","s":"书","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"喜","s":"喜","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"詩","s":"诗","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"與","s":"与","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"吾","s":"吾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"徒","s":"徒","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"遊","s":"游","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"呼","s":"呼","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"滄","s":"沧","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"浪","s":"浪","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"僧","s":"僧","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"云","s":"云","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"沧浪亭在苏州，本来是北宋苏舜钦的园亭。苏舜钦字子美，庆历年间被废后退居吴中，买下近水的一块地，筑亭取名沧浪，自己写过一篇记。亭后来荒废，遗址上建起大云庵。僧人文瑛住在庵里，寻访旧事，在残址上把亭重新造起来，几次请归有光再写一记。归有光没有重复子美已经写过的水石之胜，改写这块地的沿革：吴越镇守苏州的广陵王在子城西南建南园，外戚孙承佑又在旁边筑园；吴越向宋室献地以后园子还在，后来才成为子美的亭，又变成僧寺，再由文瑛恢复为亭。","theme":"文章比较的是两种盛。钱氏趁乱保有吴越，四代国富兵强，子弟亲戚把宫馆园林修到极点，这些都过去了。一座被贬诗人的小亭，却被两百年后的僧人郑重修复。作者登上姑苏台，看见太伯、阖闾、夫差、伍子胥、文种、范蠡的事业都已无痕，于是反问庵和亭算什么。紧接着用「虽然」转回来：声名要传到千年以后，不跟事物一起消尽，靠的不是一时的奢侈，而是后人还愿意记住的那一点。文瑛读书喜诗，所以这座亭在他手里不只是一处房产。","technique":"结构是两次易名。先说沧浪亭怎样变成大云庵，再说大云庵怎样变回沧浪亭，每一层都用「此……也」收束，沿革清楚，句子却短。第三段把视角拉到姑苏台和五湖，一连串「之所建」「之所争」「之所经营」，用排比把吴地旧史压成「今皆无有」。第四段不顺着感慨滑下去，而用钱氏的富贵反衬子美的亭，结论落在「有在矣」，故意不把那个「在」说死。末句称文瑛为沧浪僧，人与亭合成一个称呼，记文也就停住。","keyContentWords":[{"word":"浮图","reading":"fú tú","note":"僧人。浮图文瑛，是法名文瑛的和尚，不是佛塔。"},{"word":"亟","reading":"qì","note":"屡次。亟求余作记。这个意义不读 jí。"},{"word":"子城","reading":"zǐ chéng","note":"大城里面的小城，内城。"},{"word":"外戚","reading":"wài qī","note":"帝王的母族、妻族。这里指吴越王室的姻亲孙承佑。"},{"word":"纳土","reading":"nà tǔ","note":"献出土地归顺。文中淮南纳土，指吴越钱氏向宋室献地。"},{"word":"构","reading":"gòu","note":"建造的房屋。复子美之构，恢复苏舜钦原来的建筑。"},{"word":"朝市","reading":"cháo shì","note":"朝廷和集市，合起来指世事的变迁。"},{"word":"释子","reading":"shì zǐ","note":"僧人，释迦的弟子。"},{"word":"澌然","reading":"sī rán","note":"像冰消水尽一样消失的样子。"},{"word":"吾徒","reading":"wú tú","note":"我们这些人，指读书人。不是徒弟。"}],"keyFunctionWords":[{"word":"即","reading":"jí","note":"就是。即苏子美沧浪亭之地也，用来判断地点。"},{"word":"迨","reading":"dài","note":"等到。迨淮南纳土。"},{"word":"始","reading":"shǐ","note":"才。苏子美始建沧浪亭，强调亭是到他手里才建的。"},{"word":"虽然","reading":"suī rán","note":"虽然如此。先承认历史都已消尽，再把话转回来。"},{"word":"乃","reading":"nǎi","note":"却、竟然。乃为释子所钦重如此，表示出乎寻常。"},{"word":"云","reading":"yún","note":"句末语气词。呼之为沧浪僧云，表示如此称呼、如此罢了。"}],"ancientModern":[{"word":"记","note":"古：记事的文章，也指记述。作《沧浪亭记》。今多指记忆、记录。"},{"word":"偏","note":"古：旁边。治园于其偏。今多指偏差、偏向。"},{"word":"废","note":"古：废弃、荒废。此园不废。今多指废除制度。"},{"word":"胜","note":"古：优美。记亭之胜。今多指胜利、胜过。"},{"word":"垂","note":"古：延续、流传。垂及四世，垂名于千载。今多指下垂。"},{"word":"盛","note":"古：兴盛。极一时之盛。今多指茂盛、丰盛。"},{"word":"徒","note":"古：同类的人。吾徒。今多指徒弟，或徒然。"},{"word":"有国","note":"古：建立并占有国家。吴越有国时。今不这样说。"},{"word":"经营","note":"古：筹划治理。种、蠡之所经营。今多指经商办事。"},{"word":"钦","note":"古：敬重。钦重。今多见于钦佩，口语较少单用。"}],"phoneticLoans":[{"word":"彊","loan":"强","note":"国富兵彊：军队强大。彊通「强」，读 qiáng。"}],"flexibleUsage":[{"word":"环","note":"动词，环绕。环水，四面被水围住。"},{"word":"治","note":"动词，修筑。治南园、治园，不是治理国家的泛称。"},{"word":"居","note":"动词，居住。禅者居之，僧人住进这处旧园。"},{"word":"复","note":"动词，恢复。复子美之构，把已经荒废的建筑重新造起来。"}],"specialSyntax":[{"name":"判断句","note":"即苏子美沧浪亭之地也。此沧浪亭为大云庵也。此大云庵为沧浪亭也。也字三次下判断。"},{"name":"被动句","note":"为释子所钦重。为……所，表示被僧人敬重。"},{"name":"反问句","note":"庵与亭何为者哉。何为者，算什么、有什么意义。"},{"name":"排比","note":"太伯、虞仲之所建，阖闾、夫差之所争，子胥、种、蠡之所经营。三个所字句把历代事业并列后，一笔抹倒。"}]},"classicComment":{"t":"忽爲大雲庵，忽爲滄浪亭，時時變易，已足喚醒世人。中間一段點綴，憑弔之感，黯然動色。至末一轉，言士之垂名不朽者，固自有在，而不在乎亭之猶存也。此意開人智識不淺。","s":"忽为大云庵，忽为沧浪亭，时时变易，已足唤醒世人。中间一段点缀，凭吊之感，黯然动色。至末一转，言士之垂名不朽者，固自有在，而不在乎亭之犹存也。此意开人智识不浅。"}}
