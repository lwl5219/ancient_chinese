":"","extra":"","level":"dict"},{"t":"：","s":"：","punct":true},{"t":"「","s":"「","punct":true},{"t":"是","s":"是","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"軹","s":"轵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"深","s":"深","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"井","s":"井","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"里","s":"里","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"聶","s":"聂","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"政","s":"政","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"因为我还活着，他才狠心毁坏自己的身体，好切断牵连到亲人的线索。","tokens":[{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"妾","s":"妾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"尚","s":"尚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"在","s":"在","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"故","s":"故","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"重","s":"重","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"自","s":"自","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"刑","s":"刑","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"絕","s":"绝","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"從","s":"从","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"我怎么能害怕自己被处死，结果把好弟弟的名字埋没掉！」","tokens":[{"t":"妾","s":"妾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"奈","s":"奈","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"何","s":"何","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"畏","s":"畏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"歿","s":"殁","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"身","s":"身","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"誅","s":"诛","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"終","s":"终","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"滅","s":"灭","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"賢","s":"贤","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"弟","s":"弟","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"名","s":"名","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"！","s":"！","punct":true},{"t":"」","s":"」","punct":true}]},{"tr":"于是她死在聂政尸体的旁边。","tokens":[{"t":"遂","s":"遂","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"死","s":"死","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"政","s":"政","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"尸","s":"尸","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"旁","s":"旁","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"周安王五年，公元前397年。编年先记日食，再记三月韩国的一场刺杀。韩相侠累和濮阳严仲子有仇。严仲子想用一百镒黄金结交轵人聂政，聂政因为母亲还在而拒绝。母亲死后，聂政刺死侠累，并毁坏自己的面容和身体。韩国把尸体放在市上，没有人认得。姐姐嫈说破他的名字，死在尸体旁边。","theme":"这段要记住的不是韩相死了本身，而是聂政为什么先拒绝、后赴死，以及姐姐为什么偏要说出他的名字。母亲在，他就不敢把身子许给人；母亲不在，他才去行刺，并用毁容断绝追查。嫈认为弟弟是为了保护自己才自残，所以她不肯为了活命而让弟弟无名。","technique":"开头仍是编年，日有食之和三月给出天象和时间。从有恶起转入叙事，有起因、拒绝、等待、行刺、毁容、暴尸、姐姐认尸。对话只留聂政一句和嫈一段，严仲子没有答话。司马光不另加评论，判断放在两段话里。细节集中在毁容和悬赏认尸，不写韩国后来如何处置严仲子。","keyContentWords":[{"word":"有恶","reading":"yǒu è","note":"彼此有仇。恶读 è。"},{"word":"镒","reading":"yì","note":"称量黄金的单位。百镒是一份很重的礼。"},{"word":"皮面","reading":"pí miàn","note":"划破脸皮，让人认不出容貌。皮在这里是动词。"},{"word":"抉","reading":"jué","note":"挖出。抉眼是挖掉眼珠。"},{"word":"绝从","reading":"jué zòng","note":"切断被人追查、牵连的线索。从读 zòng。"},{"word":"妾","reading":"qiè","note":"嫈自称的谦词，不是说她的身份是侍妾。"}],"keyFunctionWords":[{"word":"乃","reading":"nǎi","note":"这才。母亲死后，严仲子才把行刺付诸行动。"},{"word":"因","reading":"yīn","note":"欲因以报仇的因，是借着送礼这件事。因自皮面的因，是接着就毁容。"}],"ancientModern":[{"word":"暴","note":"暴尸的暴读 pù，是陈尸示众，不是残暴。"},{"word":"购","note":"购问的购是悬赏征求，不是拿钱买东西。"},{"word":"食","note":"日有食之的食，指日食，不是谁把太阳吃掉的故事。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"寿","reading":"shòu","note":"名词用作动词。为政母寿，是给聂政的母亲送寿礼。"},{"word":"皮","reading":"pí","note":"皮面的皮由名词转成动词，意思是毁坏面部皮肤。"}],"specialSyntax":[{"name":"莫能识","note":"莫是无定代词，意思是没有人，不是不要。"},{"name":"身未敢以许人","note":"未敢以身许人的身提到前面，强调这条命还不能交给别人。"}]}}
