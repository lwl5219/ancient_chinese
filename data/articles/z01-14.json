unct":true},{"t":"國","s":"国","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"復","s":"复","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"立","s":"立","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"烈","s":"烈","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"侯","s":"侯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"太","s":"太","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"章","s":"章","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"是","s":"是","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"為","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"敬","s":"敬","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"侯","s":"侯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]},{"sentences":[{"tr":"韩烈侯去世，他的儿子文侯继位。","tokens":[{"t":"韓","s":"韩","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"烈","s":"烈","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"侯","s":"侯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"薨","s":"薨","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"文","s":"文","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"侯","s":"侯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"立","s":"立","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"周安王十五年，公元前387年。秦国攻蜀，取得南郑。魏文侯去世，太子击即位，就是武侯。武侯沿西河乘船下行，和吴起讨论山河能不能当宝贝。随后魏用田文为相。这里的田文是魏国的相，不是后来齐国的孟尝君。吴起和他论功，田文用主少国疑压过他。又过了很久，相公叔娶了公主，设计让吴起推辞婚事。武侯不再信任吴起，吴起逃到楚国，被悼王用为相。他裁官强兵，楚的兵力向外伸展，贵戚却怨他。这些后来的事被连着写在本年。同年秦惠公死，出公继位；赵武侯死，国人改立烈侯的太子章，就是敬侯；韩烈侯死，儿子文侯继位。","theme":"本年最该记住的是两段对话。武侯夸山河，吴起举三苗、夏桀、商纣，说明险要救不了失德的人，同船的人也会变成敌人。吴起的军功、治民、守边都强过田文，田文却说新君年少、人心未附的时候，国政要交给能安定大臣和百姓的人。吴起承认了。后面公叔用婚姻把他算计出魏国。楚国变强和贵戚怨恨写在一起，他本人还没有在本年死去。","technique":"司马光把一段人物故事嵌进编年。文侯之死、武侯初立是这一年；久之已经标明公叔的事在后；吴起相楚、向南向北用兵也一并提前写完，并不等于都发生在同一年。对话承担判断，没有另加臣光曰。和田文论功用三问三答，最后由田文反问该把国政托付给谁。公叔的计谋用仆人的话完整说出，再写果然推辞。年末三句恢复丧事套式，把编年拉回其他国家。","keyContentWords":[{"word":"固","reading":"gù","note":"险要坚固。武侯夸的是山河能守。"},{"word":"险","reading":"xiǎn","note":"地形险要。吴起认为这不是立国的根本。"},{"word":"中流","reading":"zhōng liú","note":"河道正中。武侯在这里回头跟吴起说话。"},{"word":"属","reading":"zhǔ","note":"托付。不读亲属的 shǔ。属之是把国政交出去。"},{"word":"宾从","reading":"bīn cóng","note":"归附跟随。韩、赵听从魏。这里的从读 cóng。"},{"word":"从横","reading":"zòng héng","note":"合纵连横。从读 zòng。"},{"word":"捐","reading":"juān","note":"裁掉、舍弃。捐的是不急需的官职。"},{"word":"却","reading":"què","note":"打退。北却三晋，是向北击退韩、赵、魏。"}],"keyFunctionWords":[{"word":"盍","reading":"hé","note":"何不。君盍试延以女，是建议国君试着用女儿去招揽。"},{"word":"孰","reading":"shú","note":"谁。子孰与起，是拿田文和吴起比较。"},{"word":"素","reading":"sù","note":"一向。素闻其贤，是早就听说他贤能。"}],"ancientModern":[{"word":"尚","note":"尚主是娶公主。臣子娶国君的女儿，用尚，表示向上缔结婚姻。"},{"word":"害","note":"害吴起的害，这里是忌恨，不是已经把他害死。"}],"phoneticLoans":[{"word":"乡","loan":"向","note":"东乡的乡读 xiàng，通向。秦兵不敢向东进逼。"},{"word":"从","loan":"纵","note":"从横的从读 zòng，通纵，指合纵。同篇宾从的从读 cóng，是跟随，不是这个借字。"}],"flexibleUsage":[{"word":"相","reading":"xiàng","note":"相田文的相是动词，任用他做相。"},{"word":"实","reading":"shí","note":"实府库的实是动词，使府库装满。"},{"word":"贱","reading":"jiàn","note":"贱子的贱是动词，看不起、轻慢。"},{"word":"中","reading":"zhòng","note":"计中的中读 zhòng，指计策得逞。不读中间的 zhōng。"},{"word":"乐","reading":"lè","note":"乐死是心甘情愿去死。不读音乐的 yuè。"}],"specialSyntax":[{"name":"在德不在险","note":"用在与不在对照两件事：德行是根本，险要不是。"},{"name":"子孰与起","note":"孰与用来比较双方谁更强。"},{"name":"主少国疑","note":"国君年轻是一层，国中人心不定又是一层。"}]}}
