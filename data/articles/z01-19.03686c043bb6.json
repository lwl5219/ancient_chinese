,"pos":"","extra":"","level":"dict"},{"t":"起","s":"起","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"徒","s":"徒","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"因","s":"因","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"射","s":"射","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"刺","s":"刺","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"起","s":"起","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"並","s":"并","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"中","s":"中","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"尸","s":"尸","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"安葬完毕以后，肃王即位。","tokens":[{"t":"既","s":"既","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"葬","s":"葬","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"肅","s":"肃","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"即","s":"即","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"位","s":"位","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"肃王派令尹把作乱的人全部杀掉。因为吴起这件事被灭族的，有七十多家。","tokens":[{"t":"使","s":"使","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"令","s":"令","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"尹","s":"尹","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"盡","s":"尽","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"誅","s":"诛","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"為","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"亂","s":"乱","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"坐","s":"坐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"起","s":"起","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"夷","s":"夷","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"宗","s":"宗","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"七","s":"七","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"十","s":"十","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"餘","s":"余","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"家","s":"家","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"周安王二十一年，公元前381年。楚悼王去世。安王十五年写过楚国贵戚怨恨吴起，本年他们作乱攻吴起。吴起逃到悼王尸体旁，伏在上面。攻他的人射刺吴起，同时打中王尸。葬事结束，肃王即位，命令令尹诛灭作乱的人。因这件事被灭族的有七十多家。吴起自己也死在这场乱里。","theme":"吴起的死法是本年的中心。他不是在战场上被敌国杀死，而是在悼王刚死时被楚国贵戚围攻。他伏在王尸上，攻他的人无法避免伤到王尸。肃王即位后追究作乱和伤尸，把这些家族灭掉。吴起死了，怨他的许多家族也灭了宗。","technique":"叙事很密，仍然没有对话。作乱、攻、跑、伏连在一句里，下一句写射刺和中尸，然后才写安葬和即位。肃王的处理放在即位之后。坐说明定罪和吴起有关，夷宗和七十余家写出处罚的规模。没有臣光曰，因果靠次序自己显出来。","keyContentWords":[{"word":"伏","reading":"fú","note":"趴伏。伏之是趴在悼王的尸体上。"},{"word":"中","reading":"zhòng","note":"射中、刺中。并中王尸，是连国王的尸体也打中了。"},{"word":"坐","reading":"zuò","note":"因某事被定罪。坐起是因为吴起这场乱获罪。"},{"word":"夷宗","reading":"yí zōng","note":"灭掉整个宗族。"},{"word":"令尹","reading":"lìng yǐn","note":"楚国执政大臣的官名。肃王派他执行诛杀。"}],"keyFunctionWords":[{"word":"者","reading":"zhě","note":"为乱者和夷宗者的者，指那一类人。"}],"ancientModern":[{"word":"坐","note":"不是坐下，是获罪、连坐。"},{"word":"走","note":"起走之王尸的走是奔跑，不是慢慢行走。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"之","reading":"zhī","note":"走之王尸的之是动词，意思是到。伏之的之是代词，指王尸。"}],"specialSyntax":[{"name":"走之王尸而伏之","note":"前一个之是到，后一个之指尸体。同一个字在一句里两种用法。"}]}}
