"s":"『","punct":true},{"t":"具","s":"具","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"予","s":"予","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"聖","s":"圣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"誰","s":"谁","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"知","s":"知","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"烏","s":"乌","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"雌","s":"雌","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"雄","s":"雄","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"？","s":"？","punct":true},{"t":"』","s":"』","punct":true}]},{"tr":"这情形，不也像您宫廷里这些君臣吗？」","tokens":[{"t":"抑","s":"抑","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"亦","s":"亦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"似","s":"似","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"臣","s":"臣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乎","s":"乎","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"？","s":"？","punct":true},{"t":"」","s":"」","punct":true}]}]},{"sentences":[{"tr":"韩文侯去世，他的儿子哀侯继位。","tokens":[{"t":"韓","s":"韩","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"文","s":"文","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"侯","s":"侯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"薨","s":"薨","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"哀","s":"哀","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"侯","s":"侯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"立","s":"立","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"周安王二十五年，公元前377年。蜀攻楚，取得兹方。本年的长文在卫国。子思是孔子的孙子孔伋，当时在卫，向卫侯推荐苟变。卫侯知道苟变能带兵，但因他做吏时吃过百姓两个鸡蛋，不肯用。子思用工匠用木作比，劝他不要因为两个鸡蛋丢掉大将。随后又写卫侯的计策并不对，群臣却用同一个口径附和。子思向公丘懿子解释，这是国君自夸、臣子讨好。他又直接对卫侯说国事会一天天变坏，并引《诗》作比。年末韩文侯去世，儿子哀侯继位。","theme":"两段话要一起记。第一段把两个鸡蛋和五百辆兵车的将才对看，子思认为交战之世用人该取长处、弃短处，这种挑剔不能让邻国知道。第二段说，错误的计策如果得到全体附和，国君会更觉得自己对，下面就不敢纠正。百姓不会亲附这样的君臣。诗里人人自称圣明，连乌鸦雌雄都分不清，被他用来比卫国分不清对错。","technique":"军事和韩的丧事仍是短句，中间是完整对话。司马光没有另写评论，道理都从子思口中说出。第一段用比喻：授官如同用木，粗大的杞梓有几尺朽也不扔，再落到两个鸡蛋和守城之将的大小对比。卫侯拜了两次，表示接受。第二段先写群臣像一张嘴，再让子思下判断。公丘懿子只问一句。后面换一个场合，对卫侯本人说政事会一天天变坏，用上下都不敢纠正来解释，最后用《诗》收住。","keyContentWords":[{"word":"将","reading":"jiàng","note":"统领军队，动词。可将五百乘，是能够带领这么多兵车。"},{"word":"乘","reading":"shèng","note":"兵车的计量单位。不读乘车的 chéng。"},{"word":"赋","reading":"fù","note":"征收赋税。苟变做吏时，在收税的事上出过差错。"},{"word":"鸡子","reading":"jī zǐ","note":"鸡蛋。"},{"word":"爪牙","reading":"zhǎo yá","note":"得力的武士。这里是能护卫国家的人，不是后世骂人的话。"},{"word":"干城","reading":"gān chéng","note":"干是盾，城是城墙，合起来指能捍卫国家的将领。"},{"word":"矫","reading":"jiǎo","note":"纠正。没有人敢矫其非，就是不敢指出错误。"},{"word":"无类","reading":"wú lèi","note":"没有遗留下来的人。国无类是国家灭亡、人也存不住。"}],"keyFunctionWords":[{"word":"也","reading":"yě","note":"变也的也用在人名后面，只作停顿，不是也曾经。"},{"word":"所","reading":"suǒ","note":"所长、所短的所，加在动词前，指长处和短处本身。"},{"word":"安","reading":"ān","note":"善安从生的安，问从哪里。"},{"word":"与","reading":"yǔ","note":"民不与的与，是亲附、赞同，不是和某人一起。"}],"ancientModern":[{"word":"鸡子","note":"鸡蛋。下文的二卵就是这两个鸡蛋。"},{"word":"爪牙","note":"这里是褒义，指护卫国君的人才。"},{"word":"干城","note":"用盾和城墙比喻能守国的将领。"},{"word":"卵","note":"蛋。二卵就是前面说的两个鸡蛋。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"官","reading":"guān","note":"官人的官是动词，授予官职。"},{"word":"和","reading":"hè","note":"附和。群臣和者，是跟着国君的话说。不读和平的 hé。"},{"word":"长","reading":"zhǎng","note":"长恶的长读 zhǎng，是使坏事滋长。所长的长读 cháng，指长处，两个读音不要混。"},{"word":"贤","reading":"xián","note":"自贤、贤之的贤是动词，把自己或别人看成贤人。"},{"word":"日","reading":"rì","note":"日非的日是一天比一天，名词用作状语。"},{"word":"度","reading":"duó","note":"衡量。不度理之所在，是不估量道理在哪一边。不读 dù。"},{"word":"臧","reading":"zāng","note":"好。自臧是自以为好。"}],"specialSyntax":[{"name":"善安从生","note":"疑问词安放在从生前面，问好的意见从哪里产生。"},{"name":"君不君","note":"后一个君用作动词，指不尽国君的本分。臣不臣的后一个臣也是动词。"}]}}
