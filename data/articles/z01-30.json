","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"分","s":"分","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"魏国分成两半以后，力量强不过宋国和卫国，那么我们终究不会再有魏国这个祸患了。」","tokens":[{"t":"魏","s":"魏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"分","s":"分","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"為","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"兩","s":"两","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"強","s":"强","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"宋","s":"宋","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"衛","s":"卫","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"則","s":"则","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"我","s":"我","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"終","s":"终","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"魏","s":"魏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"患","s":"患","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"矣","s":"矣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true},{"t":"」","s":"」","punct":true}]},{"tr":"赵国一方不肯答应。","tokens":[{"t":"趙","s":"赵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"聽","s":"听","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"懿侯心里不满，连夜率领自己的军队撤走。","tokens":[{"t":"懿","s":"懿","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"侯","s":"侯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"悅","s":"悦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"兵","s":"兵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"夜","s":"夜","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"去","s":"去","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"赵成侯也撤兵离开。","tokens":[{"t":"趙","s":"赵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"成","s":"成","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"侯","s":"侯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"亦","s":"亦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"去","s":"去","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"䓨接着杀掉公中缓，自己即位，这就是惠王。","tokens":[{"t":"罃","s":"䓨","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"遂","s":"遂","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"殺","s":"杀","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"公","s":"公","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"中","s":"中","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"緩","s":"缓","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"立","s":"立","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"是","s":"是","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"為","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"惠","s":"惠","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]},{"sentences":[{"tr":"太史公说：魏惠王本人没有被杀死、魏国也没有被拆开，是因为韩、赵两国的计谋没有合到一处。","tokens":[{"t":"太","s":"太","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"史","s":"史","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"公","s":"公","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"：","s":"：","punct":true},{"t":"魏","s":"魏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"惠","s":"惠","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"身","s":"身","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"死","s":"死","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"國","s":"国","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"分","s":"分","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"二","s":"二","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"國","s":"国","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"謀","s":"谋","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"和","s":"和","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"如果照着其中一家的计谋去做，魏国一定会被分裂。","tokens":[{"t":"若","s":"若","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"從","s":"从","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"一","s":"一","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"家","s":"家","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"謀","s":"谋","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"魏","s":"魏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"必","s":"必","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"分","s":"分","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"矣","s":"矣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"所以说：「国君死了，又没有嫡子，他的国家就可以被攻破。」","tokens":[{"t":"故","s":"故","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"：","s":"：","punct":true},{"t":"「","s":"「","punct":true},{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"終","s":"终","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"適","s":"适","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"國","s":"国","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"可","s":"可","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"破","s":"破","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true},{"t":"」","s":"」","punct":true}]}]}],"lesson":{"background":"周烈王七年是公元前369年。这一年发生日食，周烈王去世，弟弟扁继位，就是显王。魏国内部正在争君位，大夫王错逃到韩国。公孙颀劝韩懿侯趁乱攻魏。韩懿侯和赵成侯合兵，在浊泽大破魏军，把魏国包围起来。两国对如何处置魏君意见相反，先后撤兵。䓨杀掉公中缓，即位为魏惠王。","theme":"最要记住的是韩、赵本可以决定魏国的君位，甚至把魏分成两半，可是计谋不合。赵成侯要杀䓨、立公中缓，再割地退兵。韩懿侯认为杀君是暴、割地是贪，主张把魏分成两块，让它强不过宋、卫。赵国不听，懿侯连夜撤军，成侯也走了。䓨因此没死，魏国也没有分裂，他自己做了惠王。太史公把原因归成一句：二国之谋不和。","technique":"司马光先用短句记下日食和周王去世，再转入魏乱。公孙颀、成侯、懿侯的话都用「曰」引出。懿侯的话拆开几句，把「暴也」「贪也」和「两分之」对照着写。撤兵只用「夜去」「亦去」，显得仓促。结尾不写「臣光曰」，改引「太史公曰」，用「之所以……者……也」说明惠王为什么能活、魏国为什么没被拆开。","keyContentWords":[{"word":"崩","reading":"bēng","note":"天子死叫崩。这一年去世的王是周烈王，所以用崩，和诸侯的薨不同。"},{"word":"出奔","reading":"chū bēn","note":"逃出国去投靠别国。王错出奔韩，是从魏国逃到韩国。"},{"word":"浊泽","reading":"zhuó zé","note":"韩、赵合兵大破魏军的战场。正文没有写它属于哪一郡。"},{"word":"太史公","reading":"tài shǐ gōng","note":"司马迁在《史记》里的自称。这里是司马光引用那段评论，不是司马光自己开口。"}],"keyFunctionWords":[{"word":"乃","reading":"nǎi","note":"于是，表示紧接着这么做。懿侯乃与赵成侯合兵，是听了公孙颀的话以后才出兵。"},{"word":"也","reading":"yě","note":"判断句末的语气。可取也、暴也、贪也、二国之利也，都是先说一件事，再用也字断定它是什么。"},{"word":"之","reading":"zhī","note":"大破之、两分之的之是代词，分别指魏军和魏国。二国之利、二国之谋的之放在名词之间，相当于「的」。"}],"ancientModern":[{"word":"食","note":"日有食之的食，指太阳亏缺，也就是日食。不是把食物吃下去。"},{"word":"终","note":"君终的终，是国君去世，说得比较委婉。现代「终」多半指结束、终于。"}],"phoneticLoans":[{"word":"适","loan":"嫡","note":"无适子的适读 dí，通「嫡」，指正妻所生、应当继位的儿子。不是合适、舒适的适。"},{"word":"中","loan":"仲","note":"公中缓的中读 zhòng，同「仲」，是他的排行。不是方位上的中间。"}],"flexibleUsage":[{"word":"夜","reading":"yè","note":"名词放在动词前面，表示时间。以其兵夜去，是带着自己的军队连夜撤走。"}],"specialSyntax":[{"name":"杀魏君，暴也","note":"「……也」判断句。杀魏君被断成「暴」。下一分句「割地而退，贪也」句式相同，两件事并列。"},{"name":"魏惠王之所以身不死，国不分者","note":"「之所以……者……也」用来解释原因。者字收住前面的现象，也字后面的「二国之谋不和」才是原因。"}]}}
