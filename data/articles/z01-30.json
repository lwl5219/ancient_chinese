,"s":"。","punct":true}]},{"tr":"公孙颀对韩懿侯说：「魏国内部正乱，可以趁机夺取。」","tokens":[{"t":"公","s":"公","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"孫","s":"孙","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"頎","s":"颀","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"謂","s":"谓","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"韓","s":"韩","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"懿","s":"懿","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"侯","s":"侯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"：","s":"：","punct":true},{"t":"「","s":"「","punct":true},{"t":"魏","s":"魏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"亂","s":"乱","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"可","s":"可","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"取","s":"取","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true},{"t":"」","s":"」","punct":true}]},{"tr":"懿侯于是和赵成侯把军队合在一起攻打魏国，在浊泽交战，把魏军打得大败，接着包围了魏国。","tokens":[{"t":"懿","s":"懿","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"侯","s":"侯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乃","s":"乃","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"與","s":"与","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"趙","s":"赵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"成","s":"成","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"侯","s":"侯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"合","s":"合","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"兵","s":"兵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"伐","s":"伐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"魏","s":"魏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"