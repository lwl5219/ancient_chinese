e},{"t":"泗","s":"泗","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"間","s":"间","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"小","s":"小","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"國","s":"国","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"十","s":"十","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"餘","s":"余","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"楚","s":"楚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"魏","s":"魏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"與","s":"与","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"秦","s":"秦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"接","s":"接","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"界","s":"界","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"魏国修筑长城，从郑地沿着洛水往北占有上郡；楚国从汉中往南占有巴和黔中；这些国家都把秦国当作夷狄看待，排斥它，不让它参加中原诸侯的会盟。","tokens":[{"t":"魏","s":"魏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"築","s":"筑","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"長","s":"长","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"城","s":"城","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"自","s":"自","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"鄭","s":"郑","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"濱","s":"滨","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"洛","s":"洛","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"北","s":"北","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"上","s":"上","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"郡","s":"郡","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"；","s":"；","punct":true},{"t":"楚","s":"楚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"自","s":"自","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"漢","s":"汉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"中","s":"中","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"南","s":"南","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"巴","s":"巴","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"黔","s":"黔","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"中","s":"中","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"；","s":"；","punct":true},{"t":"皆","s":"皆","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"夷","s":"夷","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"翟","s":"翟","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"遇","s":"遇","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"秦","s":"秦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"擯","s":"摈","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"斥","s":"斥","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"得","s":"得","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"與","s":"与","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"中","s":"中","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"國","s":"国","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"會","s":"会","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"盟","s":"盟","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"于是孝公心有不甘，奋发起来，推广德政、整顿政务，要使秦国变得强盛。","tokens":[{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"是","s":"是","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"孝","s":"孝","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"公","s":"公","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"發","s":"发","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"憤","s":"愤","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"布","s":"布","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"德","s":"德","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"修","s":"修","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"政","s":"政","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"欲","s":"欲","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"強","s":"强","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"秦","s":"秦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"周显王七年是公元前362年。魏国在浍打败韩、赵，俘虏乐祚。秦与魏在少梁交战，魏军溃败，公孙痤被秦俘获。卫声公、燕桓公、秦献公同年去世，分别由成侯速、文公、孝公继位。孝公当时二十一岁。河、山以东有六个强国，淮、泗之间还有十几个小国，楚、魏与秦接界。魏筑长城，从郑沿洛水北到上郡；楚从汉中向南据有巴、黔中。各国把秦当成夷狄，不许它参加中原会盟。孝公因此发愤，要修政使秦强盛。","theme":"表面上是几场胜负和几国换君，真正要记住的是秦孝公即位时的处境。秦被挡在会盟之外，他却已经决定修政图强。魏国虽然在浍打赢韩、赵，却在少梁丢掉公孙痤。东边的胜利和西边的失败写在同一年，强弱正在转换。","technique":"前半仍是一句一条的短编年，战役和丧葬交替出现。「孝公生二十一年矣」以后，笔法改成形势说明：先数强国和小国，再写魏、楚的疆界如何把秦隔在外面，最后用「于是」把孝公的发愤接上。这一年没有对话，也没有「臣光曰」。议论藏在地理和「摈斥」里，为下一年的求贤令做准备。","keyContentWords":[{"word":"河","reading":"hé","note":"黄河。河、山以东，是这道屏障以东的中原，六个强国都在那边。"},{"word":"山","reading":"shān","note":"和黄河并举，指秦国东边的华山一带。河、山以东，就是这道山河屏障以东的中原。"},{"word":"败绩","reading":"bài jì","note":"军队溃败，队列垮了。魏师败绩，比单说一个败更重。"},{"word":"获","reading":"huò","note":"俘获。获魏公孙痤，是秦军在战场上捉住了这个人，不是一般的得到。"},{"word":"乐祚","reading":"yuè zuò","note":"浍这一仗里被魏军俘虏的人。乐作姓时读 yuè，不读 lè。"},{"word":"夷翟","reading":"yí dí","note":"中原诸侯对边地部族的称呼，翟同狄。以夷翟遇秦，是把秦国看成未开化的外族。"},{"word":"中国","reading":"zhōng guó","note":"指中原各诸侯。不得与中国之会盟，是不许秦国参加中原的盟会。"},{"word":"发愤","reading":"fā fèn","note":"因为不甘心而振作。孝公发愤，是被排斥之后下决心把秦国做强。"}],"keyFunctionWords":[{"word":"以","reading":"yǐ","note":"皆以夷翟遇秦的以，是用某种态度。欲以强秦的以，是凭借这个办法。两个以都不是「以及」。"},{"word":"之","reading":"zhī","note":"中国之会盟的之，相当于的。摈斥之的之是代词，指秦国。"}],"ancientModern":[{"word":"中国","note":"这里是中原、华夏诸侯，不是现代作为国名的中国。范围和意思都不同。"},{"word":"遇","note":"以夷翟遇秦的遇，是对待，不是路上遇见。"}],"phoneticLoans":[{"word":"翟","loan":"狄","note":"夷翟的翟同狄，读 dí，指边地部族。不是野鸡那个意思。"}],"flexibleUsage":[{"word":"强","reading":"qiáng","note":"欲以强秦的强，是形容词用作使动，使秦国变得强盛。这里不读勉强的 qiǎng。"}],"specialSyntax":[{"name":"皆以夷翟遇秦","note":"以字把看待秦国的态度提前，遇字后面才是被对待的秦。下面的摈斥之、不得与中国之会盟，是这种态度带来的结果。"}]}}
