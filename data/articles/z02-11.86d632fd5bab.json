:"哉","s":"哉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"！","s":"！","punct":true},{"t":"」","s":"」","punct":true}]},{"tr":"魏惠王脸上露出惭愧的神色。","tokens":[{"t":"惠","s":"惠","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"慚","s":"惭","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"色","s":"色","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]},{"sentences":[{"tr":"秦孝公和魏惠王在杜平会面。","tokens":[{"t":"秦","s":"秦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"孝","s":"孝","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"公","s":"公","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"魏","s":"魏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"惠","s":"惠","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"會","s":"会","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"于","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"杜","s":"杜","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"平","s":"平","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"周显王十四年，齐威王与魏惠王在郊外一同打猎，并比较两国的宝物。魏惠王夸耀能照亮车队的珠子，齐威王举出檀子、盻子、黔夫、种首四名守土之臣。同年，秦孝公与魏惠王在杜平相会。周天子没有出现在这两条纪事里，舞台全在诸侯之间。","theme":"这一年最该记住两种宝。魏惠王的宝是十枚径寸之珠，每枚照亮前后各十二乘；齐威王的宝是使楚人不敢侵犯、赵人不敢东渔、燕赵祭门、道不拾遗的四个臣子。惠王听完有惭色。杜平之会则提醒读者，同一年秦、魏仍在边境上彼此会面。","technique":"主体是对话。惠王先问，威王先答「无有」，等对方把珠子说满，再抛出四名臣子，一句比一句长，最后用「岂特十二乘哉」回扣珠子的光。作者只用「有惭色」收束，不下评语。杜平之会另起一条短编年，和前面的辞令对照。没有「臣光曰」。","keyContentWords":[{"word":"会田","reading":"huì tián","note":"约在一起打猎。田在这里是打猎，不是农田。"},{"word":"径寸","reading":"jìng cùn","note":"直径一寸。魏惠王用珠子不大却能照车来夸耀。"},{"word":"道不拾遗","reading":"dào bù shí yí","note":"路上掉了东西没有人捡走。这是种首防备盗贼以后的效果。"},{"word":"惭色","reading":"cán sè","note":"脸上显出惭愧。对话不再往下写，用这个神情作结束。"}],"keyFunctionWords":[{"word":"所以","reading":"suǒ yǐ","note":"「所以为宝者」里，所以表示「用来当作宝物的东西」，不是今天「因此」的意思。"},{"word":"岂","reading":"qǐ","note":"「岂以齐大国而无宝乎」「岂特十二乘哉」都是反问，意思是不该如此、不止如此。"}],"ancientModern":[{"word":"田","note":"「会田」的田是打猎。不能按今天的田地、种田来理解。"},{"word":"乘","note":"十二乘的乘读 shèng，是兵车的量词，一乘指一辆配备齐整的车，不是乘车的 chéng。"},{"word":"河","note":"「东渔于河」的河专指黄河，不是泛称任何河流。"},{"word":"朝","note":"「皆来朝」是来朝见、表示归服，不是早晨。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"渔","reading":"yú","note":"「东渔于河」的渔是捕鱼，名词用作动词。"},{"word":"朝","reading":"cháo","note":"「皆来朝」的朝是前来朝见，名词用作动词。"},{"word":"东","reading":"dōng","note":"「东渔」的东是向东，方位名词用作状语。"},{"word":"寇","reading":"kòu","note":"「不敢为寇」的寇是入侵、劫掠，名词用作动词。"}],"specialSyntax":[{"name":"状语后置","note":"「会田于郊」是在郊野会合打猎，表示地点的「于郊」放在动词后面。"},{"name":"固定句式","note":"「岂……乎」「岂……哉」都是反问。前一句逼齐国不该没有宝，后一句说四名臣子的作用远超过十二乘。"}]}}
