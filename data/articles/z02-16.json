:"内","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"息","s":"息","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"禁","s":"禁","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"把许多小乡合并聚集起来组成县，每县设置令和丞，一共三十一个县。","tokens":[{"t":"並","s":"并","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"諸","s":"诸","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"小","s":"小","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乡","s":"乡","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"聚","s":"聚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"集","s":"集","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"一","s":"一","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"縣","s":"县","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"縣","s":"县","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"置","s":"置","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"令","s":"令","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"丞","s":"丞","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"凡","s":"凡","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"三","s":"三","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"十","s":"十","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"一","s":"一","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"縣","s":"县","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"废除井田，开辟阡陌，并把斗、甬、权、衡、丈、尺这些度量统一起来。","tokens":[{"t":"廢","s":"废","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"井","s":"井","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"田","s":"田","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"開","s":"开","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"阡","s":"阡","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"陌","s":"陌","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"平","s":"平","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"斗","s":"斗","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"甬","s":"甬","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"權","s":"权","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"衡","s":"衡","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"丈","s":"丈","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"尺","s":"尺","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]},{"sentences":[{"tr":"秦国和魏国在彤地会面。","tokens":[{"t":"秦","s":"秦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"魏","s":"魏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"會","s":"会","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"于","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"彤","s":"彤","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]},{"sentences":[{"tr":"赵成侯去世，公子谍和太子争夺君位。","tokens":[{"t":"趙","s":"赵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"成","s":"成","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"侯","s":"侯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"薨","s":"薨","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"公","s":"公","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"諜","s":"谍","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"與","s":"与","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"太","s":"太","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爭","s":"争","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"拥立公子谍的企图失败了，公子谍逃奔到韩国。","tokens":[{"t":"立","s":"立","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"諜","s":"谍","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"敗","s":"败","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"奔","s":"奔","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"韓","s":"韩","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"周显王十九年，秦孝公任用的商鞅把政治中心迁到咸阳，建造冀阙和宫庭。此前秦都在栎阳。同一年还禁止父子兄弟同室居住，把小乡合并为三十一个县，废除井田、开阡陌，并统一度量衡。秦、魏在彤相会。赵成侯死后，公子谍与太子争位，立谍失败，谍逃往韩国。正文没有在这一年写下继位者的谥号。","theme":"秦国这一年是第二次大改制度：迁都、分户居住、设县、改田制、统一斗甬权衡丈尺。数字上要记住三十一县。赵国这边则是国君去世后的内争，公子谍失败奔韩。一年之中，西边是秦的制度，北边是赵的君位危机。","technique":"制度部分用排句，一件接一件，几乎不写理由，只在设县时给出「三十一」这个数目。度量衡把六种器具名连在一起。外交只剩「会于彤」一句。赵国的君位之争用薨、争、败、奔几个动词收住，没有对话，也没有「臣光曰」。全年都是短编年的罗列。","keyContentWords":[{"word":"冀阙","reading":"jì què","note":"宫殿前面两侧的高台门楼。商鞅在咸阳修筑的就是这种门阙，并连同宫庭一起建造。"},{"word":"井田","reading":"jǐng tián","note":"把田地划成井字形的旧制度。废井田，就是不再按这套办法分配土地。"},{"word":"阡陌","reading":"qiān mò","note":"田间的道路。南北叫阡，东西叫陌。开阡陌是打破旧田界，重划土地。"},{"word":"内息","reading":"nèi xī","note":"在内室里居住、歇息。父子兄弟同室内息被禁止，是要他们分开立户。"}],"keyFunctionWords":[{"word":"于","reading":"yú","note":"「于咸阳」「于彤」都引出地点，相当于「在」，位置在动词后面。"},{"word":"之","reading":"zhī","note":"「徙都之」的之指咸阳，是把国都迁到那里。"}],"ancientModern":[{"word":"平","note":"「平斗、甬、权、衡、丈、尺」的平，是把度量统一划齐，不是平坦。"},{"word":"甬","note":"量粮食的器具，这里和斗并列，不是今天「甬道」的甬。"},{"word":"薨","note":"诸侯去世叫薨。赵成侯是诸侯，所以用薨，和一般说的死、以及天子的崩，等级不同。"},{"word":"令","note":"「令民」的令是下令；「县置令、丞」的令是一县的长官。同一个字，在这一年里两种用法都有。"}],"phoneticLoans":[],"flexibleUsage":[],"specialSyntax":[{"name":"状语后置","note":"「筑冀阙宫庭于咸阳」是在咸阳修筑冀阙宫庭，地点短语放在动宾之后。"},{"name":"省略句","note":"「立谍败，奔韩」的「奔」承前省去主语。失败以后逃往韩国的，是公子谍。"}]}}
