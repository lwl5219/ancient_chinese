s":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"和","s":"和","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"他叹息说：「我悔恨没有采用公叔的话！」","tokens":[{"t":"歎","s":"叹","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"：","s":"：","punct":true},{"t":"「","s":"「","punct":true},{"t":"吾","s":"吾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"恨","s":"恨","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"用","s":"用","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"公","s":"公","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"叔","s":"叔","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"言","s":"言","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"！","s":"！","punct":true},{"t":"」","s":"」","punct":true}]}]},{"sentences":[{"tr":"秦国把商于的十五座城邑封给卫鞅，给他的称号是商君。","tokens":[{"t":"秦","s":"秦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"封","s":"封","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"衞","s":"衞","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"鞅","s":"鞅","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"商","s":"商","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"十","s":"十","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"五","s":"五","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"邑","s":"邑","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"號","s":"号","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"商","s":"商","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]},{"sentences":[{"tr":"齐国和赵国都发兵攻打魏国。","tokens":[{"t":"齊","s":"齐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"趙","s":"赵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"伐","s":"伐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"魏","s":"魏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]},{"sentences":[{"tr":"楚宣王去世，他的儿子威王商继位。","tokens":[{"t":"楚","s":"楚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"宣","s":"宣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"薨","s":"薨","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"威","s":"威","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"商","s":"商","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"立","s":"立","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"周显王二十九年，公元前340年。马陵之战的下一年，魏国新败，诸侯离心。卫鞅向秦孝公建议趁机伐魏，把魏逼到东边，秦国才能占住河山、面向东方。魏将是公子卬，他和卫鞅旧日相识。公叔早先向魏惠王谈过如何对待卫鞅，惠王没有照办。","theme":"这一年要记住卫鞅用假盟约俘虏公子卬，大破魏军，魏惠王献出河西求和，并后悔没听公叔。秦把商于十五邑封给卫鞅，称他商君。齐、赵也攻魏。同年楚宣王去世，儿子威王商继位。秦由此拿到河西，东进的门户打开了。","technique":"司马光先用卫鞅的一段话把秦、魏不能并存说透，连用非、即两面，再落到帝王之业。叙事很短：从之、对峙、赠书、会盟、伏甲、献地，一层一层收紧。惠王只有一句叹息。封邑、称号和楚君的死讯，都用编年短句接在战事后面，没有臣光曰。","keyContentWords":[{"word":"腹心","reading":"fù xīn","note":"心腹。卫鞅用来比喻致命的祸患：秦和魏像体内的重病，不能长期并存。"},{"word":"河西","reading":"hé xī","note":"黄河以西的土地。魏军大败后，魏惠王把它献给秦国求和。"},{"word":"商于","reading":"shāng wū","note":"地名，于读 wū。秦把这一带的十五个城邑封给卫鞅，因此称他为商君。"},{"word":"公叔","reading":"gōng shū","note":"魏国先前的大臣。惠王叹息的是河西丢掉以后，才悔恨没听他的劝告。"}],"keyFunctionWords":[{"word":"以","reading":"yǐ","note":"今以君之贤圣的以，是凭着。献地于秦以和的以，是用来。同一个以，在这一年里引出凭借和目的。"}],"ancientModern":[{"word":"遗","note":"遗公子卬书的遗读 wèi，是送信给，不是遗失，也不是遗留。"},{"word":"山东","note":"山岭以东的地区，魏国独自占有那里的便利。不是后来的山东省。"},{"word":"病","note":"病则东收地的病，是形势不利、处境困窘，不是人身上的疾病。"},{"word":"恨","note":"吾恨不用公叔之言的恨，是悔恨、遗憾，重点在后悔，不单是仇恨。"},{"word":"薨","note":"诸侯死称薨。楚宣王是国君，所以写薨，不用大夫的卒，也不用天子的崩。"}],"phoneticLoans":[{"word":"乡","loan":"向","note":"东乡的乡读 xiàng，借作向，脸朝着。东乡以制诸侯，是面向东方控制列国。"},{"word":"畔","loan":"叛","note":"畔借作叛。诸侯畔之，是诸侯背离魏国。"}],"flexibleUsage":[{"word":"界","note":"名词用作动词，以……为界。与秦界河，是和秦国隔着黄河相接。"}],"specialSyntax":[{"name":"非……即……","note":"非魏并秦，秦即并魏，表示两面必居其一，用来说明秦、魏不能长久对峙。"},{"name":"使使","note":"使使献河西之地，前一个使是动词，派遣；后一个使是名词，使者。"}]}}
