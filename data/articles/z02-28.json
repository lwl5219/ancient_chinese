,"py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"敗","s":"败","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"乘","s":"乘","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"勝","s":"胜","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"盡","s":"尽","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"取","s":"取","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"呉","s":"呉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"故","s":"故","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"地","s":"地","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"東","s":"东","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"至","s":"至","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"于","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"浙","s":"浙","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"江","s":"江","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"越国因此离散，各支公族争着自立，有的称王，有的称君，分布在海边，向楚国称臣朝见。","tokens":[{"t":"越","s":"越","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"此","s":"此","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"散","s":"散","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"諸","s":"诸","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"公","s":"公","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"族","s":"族","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爭","s":"争","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"立","s":"立","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"或","s":"或","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"或","s":"或","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"濱","s":"滨","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"海","s":"海","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"上","s":"上","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"朝","s":"朝","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"服","s":"服","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"楚","s":"楚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"周显王三十五年，公元前334年。齐、魏两王在徐州相会，互相承认王号。韩国这时由韩昭侯在位，前年宜阳刚被秦国攻下，这一年又遇旱灾，他却动工修建高门，屈宜臼出面劝阻。越王无疆本要攻齐，被齐人说动去打楚，结果大败。","theme":"这一年并记三件事。徐州相王，是齐、魏彼此承认王号。屈宜臼批评韩昭侯：顺利的时候不建高门，宜阳失守、又逢大旱，反倒更奢侈，这叫时诎举赢，所以断定他走不出这道门。越王无疆改去攻楚，楚人夺回吴国旧地，直到浙江；越因此散成许多小邦，散居海边，向楚称臣。","technique":"司马光用三段短编年拼成一年。第一段只写相会和目的。第二段几乎全是屈宜臼的话，先抛出“君必不出此门”，再自问自答，把时和时日拆开，最后用时诎举赢收束。第三段写越王改道、楚人追击和越族分散，没有对话收尾，也没有臣光曰。","keyContentWords":[{"word":"相王","reading":"xiāng wàng","note":"互相承认王号。齐王、魏王在徐州见面，就是为了这件事。这里的王读 wàng，是动词。"},{"word":"时诎举赢","reading":"shí qū jǔ yíng","note":"诎是困窘，赢是富余。时机已经很紧，还去办奢侈的工程，屈宜臼用这四个字概括修高门。"},{"word":"高门","reading":"gāo mén","note":"韩昭侯修建的高大城门。屈宜臼说他一定不能从这个门走出去。"},{"word":"浙江","reading":"zhè jiāng","note":"水名，指钱塘江一带。楚军乘胜向东，把吴国旧地夺到这条水为止。"}],"keyFunctionWords":[{"word":"顾","reading":"gù","note":"转折，反而。而顾益奢，是说韩昭侯不救民困，反而更加奢侈。"},{"word":"以","reading":"yǐ","note":"以相王的以，表示用来、为了。不以此时的以，表示在、趁。都是介词。"}],"ancientModern":[{"word":"说","note":"使人说之的说，读 shuì，是劝说，不是一般的说话。齐王派人去劝越王改打楚国。"},{"word":"时","note":"屈宜臼自己说明：他讲的时不是时辰和日子，而是对人有利或不利的时机。"},{"word":"朝服","note":"朝读 cháo。朝服于楚，是向楚国称臣、前往朝见，不是早晨穿衣服。"}],"phoneticLoans":[{"word":"诎","loan":"屈","note":"诎借作屈，屈曲、困窘。时诎就是时势窘迫，和举赢的铺张相对。"}],"flexibleUsage":[{"word":"王","note":"相王的王用作动词，读 wàng，表示尊对方为王。齐王、魏王、越王里的王则是名词，读 wáng。"}],"specialSyntax":[{"name":"此所谓……者也","note":"“此所谓时诎举赢者也”用此和者也构成判断，把修高门归到这句现成的话上。"}]}}
