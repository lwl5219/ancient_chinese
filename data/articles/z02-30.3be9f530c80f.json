"pos":"","extra":"","level":"dict"},{"t":"灌","s":"灌","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"齊","s":"齐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"魏","s":"魏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"師","s":"师","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"齊","s":"齐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"魏","s":"魏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"師","s":"师","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乃","s":"乃","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"去","s":"去","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]},{"sentences":[{"tr":"魏国拿出阴晋交给秦国，作为讲和的条件。阴晋其实就是华阴。","tokens":[{"t":"魏","s":"魏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"陰","s":"阴","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"晉","s":"晋","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"和","s":"和","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"秦","s":"秦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"實","s":"实","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"華","s":"华","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"陰","s":"阴","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]},{"sentences":[{"tr":"齐王攻打燕国，夺下十座城，不久又把这些城归还了。","tokens":[{"t":"齊","s":"齐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"伐","s":"伐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"燕","s":"燕","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"取","s":"取","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"十","s":"十","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"城","s":"城","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"已","s":"已","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"復","s":"复","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"歸","s":"归","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"这一年是周显王三十七年，公元前332年。前一年苏秦刚把六国说进合纵，自己做了从约长。秦惠王不肯让这条盟约站住，派犀首去骗齐、魏，三国一起打赵。赵肃侯责备苏秦。苏秦请求出使燕国，说要向齐国算账，人一离开，盟约就散了。赵国放黄河水灌退齐、魏军队。魏国用阴晋向秦求和，齐国则攻燕，夺取十城后又送还。","theme":"合纵说成容易，散掉也快。苏秦答应要向齐国追究，可他一走，从约就全部解体。齐、魏本是被秦国骗来攻赵的，赵人却靠决开河水把这两支军队逼退。各国刚结盟，转眼又为了自保割城、夺城。阴晋送出去换和平，十座城拿了又还，都说明盟约并没有变成共同进退。","technique":"司马光这一年不再铺陈说辞，六件事各用一两句记完：谁去骗人，谁受责备，盟约怎样解散，河水怎样退兵，哪座城拿去求和，十座城如何取得又归还。阴晋下面加实华阴，是在编年里顺手点明地名。没有对话，也没有臣光曰。","keyContentWords":[{"word":"从约","reading":"zòng yuē","note":"六国合纵订立的盟约。从读作纵。"},{"word":"犀首","reading":"xī shǒu","note":"秦惠王派去齐、魏活动的将领，这里用作他的名号。"},{"word":"阴晋","reading":"yīn jìn","note":"魏国拿来向秦国讲和的城，作者随即说明它就是华阴。"}],"keyFunctionWords":[{"word":"以","reading":"yǐ","note":"以败从约、以灌的以表示目的，相当于用来。"},{"word":"而","reading":"ér","note":"去赵而从约皆解的而连接先后，人一离开，盟约就散。"},{"word":"乃","reading":"nǎi","note":"齐、魏之师乃去的乃，表示河水灌到军队以后，他们这才撤走。"}],"ancientModern":[{"word":"让","reading":"rǎng","note":"赵肃侯让苏秦的让是责备，不是谦让。"},{"word":"报","reading":"bào","note":"必报齐的报是追究、报复，不是向上报告。"},{"word":"决","reading":"jué","note":"决河水的决是挖开堤防放水，不是做出决定。"},{"word":"实","reading":"shí","note":"实华阴的实是其实就是，作者用来点明地名，不是充实。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"和","reading":"hé","note":"为和于秦的和是讲和，动词，不是连词。"}],"specialSyntax":[{"name":"目的句","note":"以败从约、以灌都用以来说明这样做想达到什么：破坏盟约，或者用水灌退敌军。"}]}}
