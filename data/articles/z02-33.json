os":"","extra":"","level":"dict"},{"t":"蒲","s":"蒲","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"陽","s":"阳","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"復","s":"复","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"與","s":"与","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"魏","s":"魏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"使","s":"使","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"公","s":"公","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"繇","s":"繇","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"質","s":"质","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"魏","s":"魏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"张仪趁这个机会劝魏王说：“秦国待魏国非常宽厚，魏国不能对秦国失礼。”","tokens":[{"t":"儀","s":"仪","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"因","s":"因","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"説","s":"说","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"魏","s":"魏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"：","s":"：","punct":true},{"t":"「","s":"「","punct":true},{"t":"秦","s":"秦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"遇","s":"遇","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"魏","s":"魏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"甚","s":"甚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"厚","s":"厚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"魏","s":"魏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"可","s":"可","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"禮","s":"礼","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"秦","s":"秦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true},{"t":"」","s":"」","punct":true}]},{"tr":"魏国于是把上郡十五个县全部送上，用来向秦国表示谢意。","tokens":[{"t":"魏","s":"魏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"因","s":"因","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"盡","s":"尽","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"入","s":"入","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"上","s":"上","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"郡","s":"郡","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"十","s":"十","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"五","s":"五","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"縣","s":"县","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"謝","s":"谢","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"焉","s":"焉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"张仪回到秦国，做了秦国的相。","tokens":[{"t":"張","s":"张","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"儀","s":"仪","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"歸","s":"归","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"相","s":"相","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"秦","s":"秦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"这一年是周显王四十一年，公元前328年。张仪已经在秦国做事。他和公子华攻下魏国的蒲阳，随即劝秦王把城还给魏国，并派公子繇去魏国做人质，换取魏国的信任。魏王觉得秦国待自己宽厚，把上郡十五县全部献上道谢。张仪因此回到秦国担任相。","theme":"这一年的关键是一还一取。蒲阳看起来还给了魏国，人质也送去了，上郡十五县却进了秦国。礼貌和退城都是诱饵，魏国用一大片土地换来的只是一时的体面。张仪靠这次交易回到秦国做相，秦国向东取地的办法从硬攻变成了先给后取。","technique":"叙事先写攻取，再写张仪向秦王献计，然后只用一句劝辞把魏王说动，最后用尽入上郡十五县点破代价，用归而相秦收住。说辞很短，分量放在还城、送人质和割郡这几个行动的先后上。","keyContentWords":[{"word":"蒲阳","reading":"pú yáng","note":"魏国城邑。秦军攻下以后，又按张仪的主意还给魏国。"},{"word":"上郡","reading":"shàng jùn","note":"魏国北部的一郡。魏王把这里的十五县全部献给秦国。"},{"word":"相","reading":"xiàng","note":"相秦的相是担任秦国的相，不是互相。"}],"keyFunctionWords":[{"word":"因","reading":"yīn","note":"仪因说魏王的因是趁着还城、送人质这件事，接着开口。"},{"word":"以","reading":"yǐ","note":"以蒲阳复与魏的以是把；以谢焉的以是用来。"},{"word":"于","reading":"yú","note":"言于秦王是向秦王说，质于魏是到魏国去。"}],"ancientModern":[{"word":"复","reading":"fù","note":"复与魏是再还给魏国，不是反复无常。"},{"word":"谢","reading":"xiè","note":"以谢焉是用土地认错、回报秦国，不只是口头道谢。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"质","reading":"zhì","note":"使公子繇质于魏的质是去做质子，名词用作动词。"}],"specialSyntax":[{"name":"连动句","note":"请以蒲阳复与魏，而使公子繇质于魏，还城和送人质是同一计策里接连的两步。"}]}}
