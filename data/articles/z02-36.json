rue}]},{"tr":"嗣君说：“这不是你能懂得的。","tokens":[{"t":"嗣","s":"嗣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"：","s":"：","punct":true},{"t":"「","s":"「","punct":true},{"t":"非","s":"非","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"知","s":"知","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"要把国家治好，就没有小到可以放过的事；祸乱要起来，也不是等它变大了才算数。","tokens":[{"t":"夫","s":"夫","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"治","s":"治","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"小","s":"小","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"亂","s":"乱","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"大","s":"大","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"法令立不起来，惩罚又不能说到做到，就算拥有十座左氏，也没有好处。","tokens":[{"t":"法","s":"法","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"立","s":"立","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"誅","s":"诛","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"必","s":"必","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"雖","s":"虽","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"十","s":"十","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"左","s":"左","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"氏","s":"氏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"益","s":"益","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"法令立住了，惩罚一定执行，丢掉十座左氏，也没有损害。”","tokens":[{"t":"法","s":"法","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"立","s":"立","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"誅","s":"诛","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"必","s":"必","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"失","s":"失","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"十","s":"十","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"左","s":"左","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"氏","s":"氏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"害","s":"害","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true},{"t":"」","s":"」","punct":true}]},{"tr":"魏王听到以后说：“国君想要的，若不依从，就不吉利。”","tokens":[{"t":"魏","s":"魏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"聞","s":"闻","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"：","s":"：","punct":true},{"t":"「","s":"「","punct":true},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"主","s":"主","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"欲","s":"欲","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"聽","s":"听","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"祥","s":"祥","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true},{"t":"」","s":"」","punct":true}]},{"tr":"于是用车子把这个人送去，白白地献给嗣君。","tokens":[{"t":"因","s":"因","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"載","s":"载","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"往","s":"往","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"徒","s":"徒","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"獻","s":"献","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"这一年是周显王四十四年，公元前325年。夏天四月戊午，秦国国君开始称王。卫平侯去世，儿子嗣君继位。卫国有一名服劳役的胥靡逃到魏国，给魏王的王后治病。嗣君要用五十金买回他，往返五次魏国都不给，于是提出用城邑左氏交换。左右觉得不值，嗣君却用法令回答。","theme":"秦国称王，说明西方的名号又升了一级。更值得记住的是嗣君对法令的看法。他宁可准备丢掉左氏，也要把一名逃亡的刑徒追回来，因为法若立不住、惩罚若不能必行，城再多也没有用。左右只算城和人的贵贱，魏王却认为违逆国君的愿望不吉利，最后连代价都不要，把人白白送回。","technique":"开篇用夏，四月，戊午把秦初称王钉在具体一天，这是短编年。卫国这件事改用对话展开：左右先问一座城换一个胥靡是否值得，嗣君用治乱和法令两组对句回答，魏王再用一句不祥把人送回。问答本身就是评论，不必再加臣光曰。","keyContentWords":[{"word":"胥靡","reading":"xū mí","note":"罚去服劳役的刑徒。卫国这名胥靡逃到了魏国。"},{"word":"左氏","reading":"zuǒ shì","note":"卫君提出来交换刑徒的城邑。左右称之为一都。"},{"word":"称王","reading":"chēng wáng","note":"秦国国君这一年开始自称王，不再沿用原来的名号。"}],"keyFunctionWords":[{"word":"乃","reading":"nǎi","note":"乃以左氏易之的乃是买不回来之后才改用城交换，相当于于是。"},{"word":"虽","reading":"suī","note":"虽有十左氏的虽是即使，用来把城再多也没用说满。"},{"word":"之","reading":"zhī","note":"买之、易之、献之的之都指那名胥靡，是代词。"}],"ancientModern":[{"word":"亡","reading":"wáng","note":"亡之魏是逃到魏国，不是死在魏国。"},{"word":"金","reading":"jīn","note":"五十金是当时买人的货币数量，不是泛泛地说黄金。"},{"word":"后","reading":"hòu","note":"魏王之后的后指王后，不是前后的后。"},{"word":"反","reading":"fǎn","note":"五反是使者往返了五次，不是反对。"},{"word":"徒","reading":"tú","note":"徒献之是白白地献上，不要报酬，不是门徒，也不是步行。"},{"word":"易","reading":"yì","note":"以左氏易之的易是交换，不是容易。"}],"phoneticLoans":[],"flexibleUsage":[],"specialSyntax":[{"name":"反问句","note":"可乎并不真的等待回答，左右用问句表示拿一座城换一个犯人不值得。"},{"name":"正反对照","note":"法不立，诛不必和无益相对；法立，诛必和无害相对。两句一反一正，把法令是否必行说透。"}]}}
