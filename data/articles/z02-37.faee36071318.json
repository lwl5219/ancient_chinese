level":"dict"},{"t":"室","s":"室","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"大","s":"大","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"苑","s":"苑","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"囿","s":"囿","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"明","s":"明","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"得","s":"得","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"意","s":"意","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"欲","s":"欲","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"敝","s":"敝","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"齊","s":"齐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"燕","s":"燕","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"这一年是周显王四十五年，公元前324年。张仪率秦军攻魏，夺取陕。苏秦这一年陷在燕国的宫廷是非里：他和燕文公的夫人私通，被易王发觉。他害怕了，劝易王让自己假装获罪逃到齐国，说留在燕不能使燕被看重，到了齐反而能使燕加重分量。齐宣王收留他做客卿。","theme":"表面上苏秦是在为燕国找一条出路，实际上他要到齐国去消耗齐国。他劝齐王把宫室造高、把苑囿扩大，显得志得意满，目的是拖垮齐国，好替燕国出力。私通惹出的危机，被他说成了离间齐国的机会。读者要记住的不是宫室有多高，而是敝齐而为燕这句动机。","technique":"前一句仍是攻城的短记，只写张仪取陕。后面苏秦的事用恐，乃说接上一段自辩，易王只写一个许字。结尾不写齐王是否真的大兴土木，只点明苏秦劝人奢侈，是为了耗损齐国、有利于燕。动机收在最后一句，不再另加评论。","keyContentWords":[{"word":"陕","reading":"shǎn","note":"魏国的城。张仪这一年率军把它攻取，不要理解成后来的省名。"},{"word":"客卿","reading":"kè qīng","note":"别国出身而在本国任高官。齐宣王用这个职位安置苏秦。"},{"word":"苑囿","reading":"yuàn yòu","note":"养禽兽、供游观的园林。苏秦劝齐王把它扩建。"},{"word":"伪","reading":"wěi","note":"伪得罪是假装获罪，说明逃往齐国是做出来的。"}],"keyFunctionWords":[{"word":"乃","reading":"nǎi","note":"苏秦恐，乃说的乃表示因为害怕，这才开口劝易王。"},{"word":"于","reading":"yú","note":"通于夫人、得罪于燕的于引出涉及的人和处所。"},{"word":"而","reading":"ér","note":"而奔齐连接假装获罪和出逃；而为燕表示耗损齐国是为了燕国。"}],"ancientModern":[{"word":"通","reading":"tōng","note":"通于燕文公之夫人是私通，不是道路通达，也不是通信。"},{"word":"说","reading":"shuì","note":"说易王、说齐王的说是开口劝人，读游说的说，不是普通的说话。"},{"word":"重","reading":"zhòng","note":"使燕重的重是分量加重、被人看重，不是重复。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"高","reading":"gāo","note":"高宫室是把宫室加高，形容词的使动用法。"},{"word":"大","reading":"dà","note":"大苑囿是把苑囿扩大，形容词的使动用法。"},{"word":"敝","reading":"bì","note":"敝齐是使齐国疲敝、被消耗，动词带宾语。"},{"word":"明","reading":"míng","note":"以明得意的明是把得志显出来，这里用作展示。"}],"specialSyntax":[{"name":"目的句","note":"以明得意、欲以敝齐而为燕都用以来指出劝齐王奢侈想达到的结果。"}]}}
