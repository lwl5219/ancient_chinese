tra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"烏","s":"乌","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"足","s":"足","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"尚","s":"尚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"哉","s":"哉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"！","s":"！","punct":true}]},{"tr":"《书》里说：「受成了普天下逃亡者投靠的主人，成了他们汇聚的深潭和草泽。」","tokens":[{"t":"《","s":"《","punct":true},{"t":"書","s":"书","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"》","s":"》","punct":true},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"：","s":"：","punct":true},{"t":"「","s":"「","punct":true},{"t":"受","s":"受","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"天","s":"天","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"下","s":"下","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"逋","s":"逋","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"逃","s":"逃","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"主","s":"主","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"萃","s":"萃","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"淵","s":"渊","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"藪","s":"薮","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true},{"t":"」","s":"」","punct":true}]},{"tr":"这句话说的就是这种人。","tokens":[{"t":"此","s":"此","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"謂","s":"谓","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"周显王四十七年，是公元前322年。张仪从啮桑回秦，相位被免，改到魏国为相，想让魏先服从秦，魏王不听。秦于是攻魏，夺取曲沃、平周，暗中却对张仪更加优厚。齐国这一年把田婴封在薛，号靖郭君。通鉴接着写下门客以海中大鱼劝他不要筑薛城，又写贱妾之子文继位为孟尝君、广招食客，最后加上司马光的评论。","theme":"这一年要连着看两层。张仪名虽免相，秦仍在暗中厚待他，他的任务是让魏带头事秦。孟尝君靠散财养士得到盛名，司马光却认为他不问贤愚、不分好坏，用国君的俸禄养私党，名声再响也不值得推崇。","technique":"前半是几句短叙事，把张仪免相、相魏和秦的暗中优待连在一起。后半改用门客的比喻，把齐国比作大鱼离不开的水，再说田文如何被立为继承人。篇末用臣光曰先引《易》说明养贤的本意，再逐层反衬孟尝君，最后用《书》里收容逃亡者的话收住。","keyContentWords":[{"word":"靖郭君","reading":"jìng guō jūn","note":"田婴的封号。齐王把他封在薛之后，就用这个称号称呼他。"},{"word":"曲沃","reading":"qū wò","note":"魏地城邑。这一年秦攻魏，曲沃与平周一同被秦军夺取。"},{"word":"食客","reading":"shí kè","note":"寄食在权贵门下的宾客。孟尝君门下经常有几千人。"},{"word":"臧否","reading":"zāng pǐ","note":"好坏、善恶。否读 pǐ，不读 fǒu。不择臧否，就是不辨别人品。"},{"word":"臣光","reading":"chén guāng","note":"司马光自称。臣光曰是他插入的评论，要译成司马光评论说。"},{"word":"受","reading":"shòu","note":"引文里的受是商王的名字，不是接受。司马光用他收容逃亡者，来比孟尝君招纳罪人。"}],"keyFunctionWords":[{"word":"奚","reading":"xī","note":"疑问代词，相当于何。奚以薛为，就是要薛做什么。"},{"word":"庸","reading":"yōng","note":"反问副词，相当于岂。庸足恃乎，是难道靠得住吗。"},{"word":"乌","reading":"wū","note":"疑问代词，相当于何。乌足尚哉，是哪里值得推崇。"},{"word":"果","reading":"guǒ","note":"成为事实。不果城，是筑城最终没有实行，不是水果，也不是果然。"}],"ancientModern":[{"word":"五官","reading":"wǔ guān","note":"齐国分职办事的各个官府，不是五官感觉，也不是后来的官署名。"},{"word":"亲戚","reading":"qīn qī","note":"这里泛指宾客的家人亲属。不要只理解成现代口语里家室以外的远亲。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"相","reading":"xiàng","note":"相魏的相，名词用作动词，是做相。上文免相的相仍是名词，指相位。"},{"word":"城","reading":"chéng","note":"欲城薛、不果城的城，名词用作动词，是筑城。薛之城的城仍是城墙。"},{"word":"厚","reading":"hòu","note":"阴厚张仪的厚，形容词用作动词，是优厚地对待。"},{"word":"烛","reading":"zhú","note":"烛微的烛，名词用作动词，是像烛火一样照见。"},{"word":"富","reading":"fù","note":"丰禄以富之的富，形容词使动，是使他们富足。"},{"word":"尊","reading":"zūn","note":"隆爵以尊之的尊，形容词使动，是使他们地位尊贵。"}],"specialSyntax":[{"name":"宾语前置","note":"奚以薛为里，疑问代词奚做介词以的宾语，提到以的前面，意思是用薛做什么。"},{"name":"判断句","note":"今夫齐，亦君之水也，用亦……也表示判断，把齐国比作靖郭君赖以生存的水。"}]}}
