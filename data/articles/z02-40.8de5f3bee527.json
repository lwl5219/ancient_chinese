,"ctx":"","pos":"","extra":"","level":"dict"},{"t":"兩","s":"两","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"用","s":"用","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"多","s":"多","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"力","s":"力","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"内","s":"内","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"樹","s":"树","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"黨","s":"党","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"寡","s":"寡","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"力","s":"力","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"藉","s":"藉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"外","s":"外","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"權","s":"权","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"臣子有的在朝内结党从而傲视君主，有的对外结交从而割走土地，您的国家就危险了！」","tokens":[{"t":"群","s":"群","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"臣","s":"臣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"内","s":"内","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"樹","s":"树","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"黨","s":"党","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"驕","s":"骄","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"主","s":"主","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"外","s":"外","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爲","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"交","s":"交","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"削","s":"削","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"地","s":"地","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"國","s":"国","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"危","s":"危","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"矣","s":"矣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"！","s":"！","punct":true},{"t":"」","s":"」","punct":true}]}]}],"lesson":{"background":"周显王四十八年，是公元前321年。周显王去世，儿子定继位，就是慎靓王。燕易王也在这一年去世，儿子哙继位。通鉴随后记孟尝君聘楚，楚王赠象牙床，公孙戌受登徒直之托劝他拒收；又记韩宣惠王想同时任用公仲、公叔，缪留用晋、齐、魏的旧事加以劝阻。","theme":"象床一段要记住：孟尝君能拒绝重礼，而且发现公孙戌脚步得意之后追问实情。劝谏即使夹着私心，只要话说得对，他仍然采纳，还把这个态度写上门板。韩事要记住：两个权臣同时执政，强的在国内结党，弱的借助外国，国家就会危险。","technique":"这一年先用崩、薨各记一次君位更替，再用完整对话写象床。孟尝君把公孙戌叫回来，事情才从私赠宝剑转到门板上的公开告示。司马光因此插入臣光曰，并引《诗》说明不要因一点毛病丢掉有用的话。后半写韩国，全靠缪留连举三件旧事，不再另加评论。","keyContentWords":[{"word":"崩","reading":"bēng","note":"天子去世。这里的王指周显王，所以用崩，不用诸侯之死的说法。"},{"word":"薨","reading":"hōng","note":"诸侯去世。燕易王之死用薨，和周王的崩区分开。"},{"word":"象床","reading":"xiàng chuáng","note":"用象牙装饰的床。公孙戌说它价值千金，损伤一点就赔不起。"},{"word":"六卿","reading":"liù qīng","note":"晋国后期分掌国政的六家世卿。缪留用他们把晋国分掉的事，劝韩王不要两用权臣。"},{"word":"犀首","reading":"xī shǒu","note":"公孙衍的称号。缪留说魏国同时任用犀首和张仪，西河以外的土地因而丢失。"},{"word":"臣光","reading":"chén guāng","note":"司马光自称。这里是他评论孟尝君能采纳劝谏，不是另一位名叫光的大臣在说话。"}],"keyFunctionWords":[{"word":"见","reading":"jiàn","note":"见杀的见是被动记号，齐简公被杀。同篇入见的见是进见，读音相同，意思不同。"},{"word":"所以","reading":"suǒ yǐ","note":"小国所以……者，用来提出原因，相当于……的缘故，不是现代连词所以。"}],"ancientModern":[{"word":"妻子","reading":"qī zǐ","note":"妻子和儿女。卖妻子不足偿，是连妻带子都卖掉还不够赔偿，不是只指出卖配偶。"},{"word":"下体","reading":"xià tǐ","note":"植物地下的根部。诗句说采葑采菲时不要因为根不好就整棵丢掉，不是现代口语里的身体下部。"},{"word":"足下","reading":"zú xià","note":"对对方的敬称。登徒直这样称呼公孙戌，不是脚下的意思。"}],"phoneticLoans":[{"word":"直","reading":"zhí","note":"象床之直的直通值，指价值。登徒直的直是人名用字，不要读成价钱。"}],"flexibleUsage":[{"word":"书","reading":"shū","note":"书门版的书是动词，书写。后面《书》曰的书则是《尚书》，二者不要混成一件事。"},{"word":"骄","reading":"jiāo","note":"骄主的骄，形容词用作动词，是对君主傲慢、不把君主放在眼里。"}],"specialSyntax":[{"name":"被动句","note":"见杀用见表示被动。齐简公同时任用陈成子和阚止，结果是自己被杀。"},{"name":"何……之……","note":"子何足之高，志之扬也，是用何加上名词和之来加强感叹，问他为什么脚步那样高、神气那样扬。"}]}}
