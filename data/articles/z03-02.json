l":"dict"},{"t":"槁","s":"槁","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"矣","s":"矣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"天上云气密密升起，大雨痛快地落下来，禾苗便猛地活过来、长上去。","tokens":[{"t":"天","s":"天","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"油","s":"油","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"然","s":"然","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"作","s":"作","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"雲","s":"云","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"沛","s":"沛","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"然","s":"然","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"下","s":"下","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"雨","s":"雨","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"則","s":"则","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"苗","s":"苗","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"浡","s":"浡","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"然","s":"然","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"興","s":"兴","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"矣","s":"矣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"到了这一步，谁还拦得住？』」","tokens":[{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"如","s":"如","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"是","s":"是","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"孰","s":"孰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"能","s":"能","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"禦","s":"御","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"？","s":"？","punct":true},{"t":"』","s":"』","punct":true},{"t":"」","s":"」","punct":true}]}]}],"lesson":{"background":"周慎靓王二年，是公元前319年。秦国攻魏，夺取鄢。魏惠王去世，儿子襄王继位。孟子进见这位新君，出来后对人说，他看上去不像国君，也没有令人敬畏的地方。襄王问天下怎样才能安定，孟子答以统一，并说能统一的是不喜好杀人的人，又用旱后得雨的禾苗说明民心不可阻挡。","theme":"这一年的重心在孟子对魏襄王的印象。天下要安定，必须统一；能统一的，不是更会杀人的人，而是不把杀人当嗜好的人。百姓归向这样的君主，会像枯苗遇上大雨，谁也挡不住。秦取鄢和惠王之死，只是这次见面的背景。","technique":"司马光把孟子的话几乎整段采入编年，前面只用两句交代秦攻魏和惠王去世。见襄王的场面不再另写，全从孟子出门后对旁人的转述里看出。问和答一层层套在引语中，禾苗的比喻放在答话末尾，用来收束不嗜杀人才能统一的判断。","keyContentWords":[{"word":"恶乎","reading":"wū hū","note":"相当于于何、怎样。恶读 wū，是疑问词，不是善恶的恶。天下恶乎定，是问天下靠什么安定。"},{"word":"语","reading":"yù","note":"语人的语读 yù，是告诉。孟子出来以后把见襄王的情形告诉别人。"},{"word":"浡然","reading":"bó rán","note":"蓬勃兴起的样子。雨下下来以后，枯苗一下子重新长起。"},{"word":"槁","reading":"gǎo","note":"枯干。七八月干旱，禾苗就枯萎了。"}],"keyFunctionWords":[{"word":"于","reading":"yú","note":"定于一的于，相当于在。安定落在统一这件事上。"},{"word":"之","reading":"zhī","note":"望之、就之、一之的之，都是代词，指襄王或天下，相当于他、它。"}],"ancientModern":[{"word":"与","reading":"yǔ","note":"孰能与之、莫不与的与，是归附、亲附，不是连词和，也不是给予。"}],"phoneticLoans":[{"word":"卒","reading":"cù","note":"卒然的卒通猝，是突然。这一年不要把卒读成士兵的 zú，也不要理解成终于。"}],"flexibleUsage":[{"word":"一","reading":"yī","note":"一之的一，数词用作动词，是统一。定于一的一仍是数目上的单一，指统一到一处。"}],"specialSyntax":[{"name":"所字结构","note":"所畏等于所敬畏的地方。就之而不见所畏，是走近了也看不到让人害怕、敬重的东西。"},{"name":"比喻","note":"孟子用七八月旱苗遇雨重新生长，比喻不嗜杀人的君主一旦出现，天下归附的势头无法阻挡。"}]}}
