"ctx":"","pos":"","extra":"","level":"dict"},{"t":"師","s":"师","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"皆","s":"皆","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"敗","s":"败","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"走","s":"走","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]},{"sentences":[{"tr":"宋国从这一年开始自称王。","tokens":[{"t":"宋","s":"宋","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"初","s":"初","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"稱","s":"称","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"周慎靓王三年，是公元前318年。楚、赵、魏、韩、燕五国联合攻秦，兵锋指向函谷关。秦国出兵迎击，五国军队都败走。同一年，宋国第一次把国君称作王。齐国没有列在这支联军里。","theme":"这一年要记住合纵攻秦的一次失败。五国能够一同打到函谷关，却挡不住秦军出关迎击，盟约并没有变成可以取胜的军队。宋也在大国称王之后开始称王，名号还在继续升格。","technique":"这一年仍是短编年。攻秦、战败、宋称王，三句并列，不用说辞，也不发臣光曰。逆之写秦军主动迎上去，败走写五国溃退，胜负只用两个动词就收住了。","keyContentWords":[{"word":"函谷关","reading":"hán gǔ guān","note":"秦国东边的关隘。五国此年攻秦，打到这里。"},{"word":"师","reading":"shī","note":"军队。五国之师就是五国派出的军队，不是老师。"},{"word":"初","reading":"chū","note":"开始、第一次。宋国从此使用王的称号。"}],"keyFunctionWords":[{"word":"皆","reading":"jiē","note":"范围副词，全都。五国军队没有一支站住。"}],"ancientModern":[{"word":"逆","reading":"nì","note":"这里是迎击、迎战，不是叛逆，也不是现代口语里的不顺。"},{"word":"走","reading":"zǒu","note":"战败后逃跑。古代走是跑，不是现代所说的步行。"}],"phoneticLoans":[],"flexibleUsage":[],"specialSyntax":[]}}
