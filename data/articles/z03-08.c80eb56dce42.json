level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"攻","s":"攻","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"齊","s":"齐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"是","s":"是","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"我","s":"我","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"亡","s":"亡","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"地","s":"地","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"秦","s":"秦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"取","s":"取","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"償","s":"偿","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"齊","s":"齐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"如今大王已经和齐国绝交，又去追究秦国的欺骗，这等于我们自己撮合了秦、齐的邦交，还把天下的军队都招了来，国家一定伤得很重！」","tokens":[{"t":"今","s":"今","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"已","s":"已","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"絕","s":"绝","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"齊","s":"齐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"責","s":"责","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"欺","s":"欺","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"秦","s":"秦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"是","s":"是","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"吾","s":"吾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"合","s":"合","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"秦","s":"秦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"齊","s":"齐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"交","s":"交","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"來","s":"来","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"天","s":"天","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"下","s":"下","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"兵","s":"兵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"國","s":"国","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"必","s":"必","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"大","s":"大","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"傷","s":"伤","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"矣","s":"矣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"！","s":"！","punct":true},{"t":"」","s":"」","punct":true}]},{"tr":"楚王不听劝告，派屈匄统领军队攻打秦国。","tokens":[{"t":"楚","s":"楚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"聽","s":"听","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"使","s":"使","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"屈","s":"屈","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"匄","s":"匄","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"帥","s":"帅","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"師","s":"师","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"伐","s":"伐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"秦","s":"秦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"秦国也派出军队，命令庶长章迎击楚军。","tokens":[{"t":"秦","s":"秦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"亦","s":"亦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"發","s":"发","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"兵","s":"兵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"使","s":"使","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"庶","s":"庶","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"長","s":"长","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"章","s":"章","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"擊","s":"击","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"周赧王二年，秦王准备攻齐，顾忌齐、楚仍合纵相亲，派张仪到楚国游说。张仪许诺割让商于六百里，并让秦女嫁到楚国，条件是楚国闭关、与齐废约。楚王贪这块地，不听陈轸，把相印交给张仪。张仪回秦后假装坠车，三个月不上朝，直到楚国派宋遗借宋国符节去辱骂齐王、齐秦结好，才用六里应付楚使。楚王发怒，派屈匄攻秦，秦派庶长章迎战。同一年，秦国右更疾攻赵，攻下蔺，俘虏庄豹。","theme":"这一年的中心是一场用空头土地拆散盟约的欺诈。楚国君臣都在庆贺不战而得六百里，陈轸却来哀悼，因为秦看重楚，看重的是楚背后的齐。齐一断，楚就成了孤国，六百里不会到手。楚王后来派人把齐王骂得倒向秦国，正好把陈轸所说的北边断齐、西边生患走完。陈轸第二次劝楚送出一座名都，换取秦的联合转攻齐国，楚王仍然不听，屈匄就此出师。","technique":"司马光这一年主要靠对话推进。张仪的说辞、陈轸的两次分析、楚王的怒拒，都一句一句对着写。君臣皆贺和陈轸独吊先形成对照；张仪佯装坠车、三月不朝，再由楚使之口把六百里收成六里。楚王的话短，陈轸的话长，得失在问答里自己显出来。年底只留庶长章出兵一句，把胜负押到下一年的丹阳。","keyContentWords":[{"word":"右更","reading":"yòu gēng","note":"秦国的爵位名。疾是人名，右更疾指爵为右更、名叫疾的将领，不要把疾理解成疾病。"},{"word":"从亲","reading":"zòng qīn","note":"从在这里通「纵」，指合纵。从亲就是合纵结盟、彼此亲近。秦王担心齐、楚这层关系还在，所以派张仪去拆。"},{"word":"广袤","reading":"guǎng mào","note":"东西的距离称广，南北的距离称袤，合指一块地的长和宽。张仪把先前许诺的六百里说成广袤六里。"},{"word":"吊","reading":"diào","note":"哀悼，把一件事当成丧事来看。群臣庆贺不战得地，陈轸偏来吊，是认定这场交易会带来灾祸。"},{"word":"相印","reading":"xiàng yìn","note":"相国的印信。楚王把它交给张仪，是用相位和厚赐把张仪笼络住。"}],"keyFunctionWords":[{"word":"奚","reading":"xī","note":"疑问代词，相当于为什么、怎么。「秦奚贪夫孤国」是说秦为什么要贪图一个孤立的国家。"},{"word":"苟","reading":"gǒu","note":"假设连词，相当于如果、假如。「苟与吾地」是说如果秦国真把土地交给楚国。"}],"ancientModern":[{"word":"说","note":"「楚王说而许之」的说是高兴，读 yuè，后来写作悦。「说楚王」的说是游说，读 shuì。「有说乎」的说才是说法、解释，读 shuō。同一个字在这一年里三个意思都出现了。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"北","reading":"běi","note":"「北骂齐王」的北用作动词，表示向北去。同篇「王北绝齐交」的北则是方位名词，指北边。"},{"word":"阴","reading":"yīn","note":"「阴合」的阴是暗中。陈轸建议楚国表面上和齐国断交，暗地里仍保持联合。"}],"specialSyntax":[{"name":"反问","note":"「何吊也」和「秦奚贪夫孤国，而与之商于之地六百里」都用问句把反对的意思说死。楚王不是在征求解释，陈轸也不是在向秦国提问。"}]}}
