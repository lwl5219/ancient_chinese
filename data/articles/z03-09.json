","s":"里","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"哉","s":"哉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"？","s":"？","punct":true},{"t":"」","s":"」","punct":true}]},{"tr":"于是昭王为隗改建宫室，用对待老师的礼节侍奉他。","tokens":[{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"是","s":"是","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"昭","s":"昭","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"為","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"隗","s":"隗","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"改","s":"改","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"築","s":"筑","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"宮","s":"宫","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"師","s":"师","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"事","s":"事","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"于是士人们争先恐后地赶往燕国。","tokens":[{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"是","s":"是","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"士","s":"士","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爭","s":"争","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"趣","s":"趣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"燕","s":"燕","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"乐毅从魏国前来，剧辛从赵国前来。","tokens":[{"t":"樂","s":"乐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"毅","s":"毅","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"自","s":"自","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"魏","s":"魏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"往","s":"往","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"劇","s":"剧","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"辛","s":"辛","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"自","s":"自","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"趙","s":"赵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"往","s":"往","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"昭王任命乐毅做亚卿，把国家政务交给他掌管。","tokens":[{"t":"昭","s":"昭","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"樂","s":"乐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"毅","s":"毅","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"為","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"亞","s":"亚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"卿","s":"卿","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"任","s":"任","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"國","s":"国","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"政","s":"政","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]},{"sentences":[{"tr":"韩宣惠王去世，他的儿子仓继位，称为襄王。","tokens":[{"t":"韓","s":"韩","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"宣","s":"宣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"惠","s":"惠","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"薨","s":"薨","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"襄","s":"襄","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"倉","s":"仓","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"立","s":"立","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"周赧王三年，上一年楚将屈匄伐秦的战事在丹阳见了分晓。秦军大破楚师，斩杀甲士八万，俘虏屈匄和列侯、执珪七十余人，夺取汉中郡。楚王倾国内全部兵力再战蓝田，再次失败。韩、魏趁楚国困窘向南打到邓，楚国割让两城向秦求和。燕国这边，太子平在国破之后即位为昭王，向郭隗求贤，为他改建宫室并以师礼相待，乐毅、剧辛相继到来。韩国则是宣惠王去世，曾经到秦国做人质的太子仓继位为襄王。","theme":"这一年一边是楚国连败，大将、爵臣和汉中郡一起失去，最后只能割城求和；一边是燕昭王在破国之后放下身份求士。郭隗不先举荐远方的人，而是讲千金买死马的故事，让昭王从自己做起，用看得见的礼遇证明求贤是真的。乐毅被任为亚卿并交给国政，燕国后来重整的班底从这里写起。韩国的王位也在同一年从宣惠王交到襄王仓手里。","technique":"司马光前半用战役编年来写。丹阳、蓝田、袭邓三次战事句子都很短，八万、七十余、两城这些数字压得很实。写到燕昭王，节奏放开，先记即位、吊死问孤和卑身厚币，再把郭隗讲的买马故事整段录入。故事讲完，用士人奔赴燕国和乐毅、剧辛来投几句收住效果。结尾另起一句写韩宣惠王去世、襄王仓继位，把另一国的君位交代在同一年里。","keyContentWords":[{"word":"甲士","reading":"jiǎ shì","note":"披甲的战士。丹阳一战里被斩杀的八万人，指的就是这些甲士。"},{"word":"执珪","reading":"zhí guī","note":"楚国的高等爵位，受爵的人可以持珪朝见。这里和列侯一起被秦军俘虏。"},{"word":"涓人","reading":"juān rén","note":"国君身边担任洒扫的近侍。郭隗故事里，国君派他拿着千金去找千里马。"},{"word":"期年","reading":"jī nián","note":"满一整年叫期年，期读 jī，不读 qī。不期年是还不满一年。"},{"word":"趣","reading":"qū","note":"同「趋」，是奔赴。士争趣燕，说的是士人争着赶往燕国，不是兴趣、趣味。"},{"word":"亚卿","reading":"yà qīng","note":"位次于正卿的高官。燕昭王用这个职位把国政交给乐毅。"}],"keyFunctionWords":[{"word":"及","reading":"jí","note":"「秦师及楚战于丹阳」的及连接交战双方，相当于和、同。「屈匄及列侯」的及也是连词和。"}],"ancientModern":[{"word":"薨","note":"诸侯死亡称薨。韩宣惠王是诸侯，所以用薨。周天子之死则称崩，两者不能互换。"},{"word":"平","note":"「请平」的平是讲和、订立和约。这一年的「太子平」是人名，两个平不要混成一个意思。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"师","reading":"shī","note":"「师事之」的师表示用对老师的礼数，是名词用作状语。同篇「秦师」「楚师」的师则是军队。"}],"specialSyntax":[{"name":"是为判断","note":"「是为昭王」用「是为」把新立的太子平判定为后来的谥号昭王。这是史家追书时的判断句，他即位之时还没有这个谥号。"},{"name":"且况递进","note":"「死马且买之，况生者乎」先用且托出较低的一件事，再用况把意思推进一步。问句本身就是结论：活马更应该被送上门来。"}]}}
