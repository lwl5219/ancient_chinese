ns":[{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"：","s":"：","punct":true},{"t":"「","s":"「","punct":true},{"t":"昔","s":"昔","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"在","s":"在","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"任","s":"任","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"帝","s":"帝","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"難","s":"难","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"才","s":"才","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"矣","s":"矣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"才啊才，那不是我们这一派所要的才。」","tokens":[{"t":"才","s":"才","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乎","s":"乎","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"才","s":"才","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"非","s":"非","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"吾","s":"吾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"徒","s":"徒","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"才","s":"才","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true},{"t":"」","s":"」","punct":true}]}]},{"sentences":[{"tr":"秦王派甘茂去诛杀蜀相庄。","tokens":[{"t":"秦","s":"秦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"使","s":"使","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"甘","s":"甘","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"茂","s":"茂","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"誅","s":"诛","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"蜀","s":"蜀","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"相","s":"相","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"莊","s":"庄","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]},{"sentences":[{"tr":"秦王和魏王在临晋相会。","tokens":[{"t":"秦","s":"秦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"魏","s":"魏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"會","s":"会","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"于","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"臨","s":"临","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"晉","s":"晋","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]},{"sentences":[{"tr":"赵武灵王把吴广的女儿孟姚娶进宫，孟姚受到宠爱，她就是惠后。","tokens":[{"t":"趙","s":"赵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"武","s":"武","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"靈","s":"灵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"納","s":"纳","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"吳","s":"吴","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"廣","s":"广","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"女","s":"女","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"孟","s":"孟","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"姚","s":"姚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"有","s":"有","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"寵","s":"宠","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"是","s":"是","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"為","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"惠","s":"惠","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"后","s":"后","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"生下了儿子何。","tokens":[{"t":"生","s":"生","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"何","s":"何","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"周赧王五年，公元前310年，秦武王刚即位。张仪不受新君喜欢，便请求到梁国去，故意引齐来攻，好让秦趁空攻韩、进入三川。计策刚一发动，他又借楚使把齐兵说退。张仪在魏做了一年相就死了。同年秦王派甘茂诛杀上年杀掉蜀侯的蜀相庄，又和魏王在临晋相会。赵武灵王纳吴广之女孟姚，生下儿子何。","theme":"这一年前半是张仪最后一次为秦布局：用自己当诱饵，让齐、梁打得不能脱身，秦再去取三川、挟天子。人死之后，司马光借《孟子》和《法言》把纵横家重新称量一遍。能让诸侯恐惧，不等于大丈夫；能说会道，也不是这一派所要的才。年尾的蜀相庄、临晋之会、孟姚生何，都是短短一笔，却分别接上蜀地、秦魏和赵国后来的事。","technique":"开篇全是对话，把张仪的计策和借楚使退兵写完，接着只用「相魏一岁，卒」五个字交代死亡。后面忽然离开编年，大段抄《孟子》和扬子《法言》，用前人的问答代替臣光曰。引文结束，又回到一句一句的编年：诛蜀相、会临晋、纳孟姚、生子何。长段议论夹在短纪事中间，褒贬落在纵横家身上，不打乱年份。","keyContentWords":[{"word":"三川","reading":"sān chuān","note":"黄河、伊水、洛水一带，当时多在韩的境内，又靠近周天子。张仪说秦可以趁齐、梁交兵打进这里。"},{"word":"图籍","reading":"tú jí","note":"地图和户籍。案图籍是查看土地和人口，意思是把这一带的统治拿到手里。"},{"word":"犀首","reading":"xī shǒu","note":"公孙衍的号。犀首本是魏国的武官名，他做过这个官，后来人们就用官号称呼他。"},{"word":"鬼谷","reading":"guǐ gǔ","note":"鬼谷子，传说是苏秦、张仪的老师。问话的人说他们学的是鬼谷术、讲的是纵横之言。"},{"word":"惠后","reading":"huì hòu","note":"孟姚得宠以后的称号。她的父亲吴广是赵国人，不是秦末起义的吴广。她生的儿子何，就是后来的赵王。"}],"keyFunctionWords":[{"word":"诸","reading":"zhū","note":"相当于之。圣人恶诸，是厌恶他们；子贡耻诸，是以此为耻。"},{"word":"恶","reading":"wū","note":"「是恶足以为大丈夫」的恶读乌，是哪里、怎么。同篇「圣人恶诸」的恶读务，是厌恶。"},{"word":"间","reading":"jiàn","note":"「王以其间伐韩」的间是空隙，读去声。趁齐、梁打得脱不开身的那段空子去攻韩。"}],"ancientModern":[{"word":"卒","note":"大夫或一般士人死叫卒。张仪相魏一岁，卒。比诸侯的薨低一等。"},{"word":"中国","note":"「安中国」的中国指中原列国，不是现代这个国家的专名。"},{"word":"丈夫","note":"大丈夫在《孟子》这段话里指守得住正道的人，不是夫妻关系里的丈夫。"},{"word":"淫","note":"「富贵不能淫」的淫，是使放纵、搅乱心志，不是后来专指的淫秽。"},{"word":"梁","note":"魏迁都大梁后的称呼。本篇前半写伐梁，写张仪为相时又说相魏，是同一个国家。"},{"word":"去","note":"「不能相去」是不能撤开。张仪之去秦，也是离开秦国，不是前往。"}],"phoneticLoans":[{"word":"诎","loan":"屈","note":"威武不能诎的诎借作屈，是屈服。威武不能使他弯下腰。"},{"word":"任","loan":"壬","note":"昔在任人的任借作壬。壬人是巧言谄媚的人。扬雄说帝王对这种人也并不凭才来任用。"}],"flexibleUsage":[{"word":"安","note":"「安中国」的安是使安定，动词的使动用法。不是疑问词「哪里」。"},{"word":"耻","note":"「子贡耻诸」「仪、秦耻诸」是把那样的结果当作耻辱，形容词的意动用法。"},{"word":"信","note":"「以信仪于秦王」的信是使秦王信任张仪，动词的使动用法。"},{"word":"高","note":"「务以辩诈相高」的高是互比高下，形容词用作动词。"}],"specialSyntax":[{"name":"谓语前置","note":"「甚矣，王之托仪于秦也」把「甚矣」提前，强调过分。顺着说是「王之托仪于秦，甚矣」。"},{"name":"判断句","note":"「诈人也」用也字下判断。「是之谓大丈夫」用「是之谓」下判断，意思是这样才叫做大丈夫。"}]}}
