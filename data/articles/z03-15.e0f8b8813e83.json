","ctx":"","pos":"","extra":"","level":"dict"},{"t":"液","s":"液","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"韓","s":"韩","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"賁","s":"贲","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"楚","s":"楚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"富","s":"富","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"丁","s":"丁","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"魏","s":"魏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"趙","s":"赵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爵","s":"爵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"齊","s":"齐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"代相赵固主管胡人的事务，并把他们的军队招引过来。","tokens":[{"t":"代","s":"代","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"相","s":"相","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"趙","s":"赵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"固","s":"固","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"主","s":"主","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"胡","s":"胡","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"致","s":"致","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"兵","s":"兵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]},{"sentences":[{"tr":"楚王同齐国、韩国结成了合纵。","tokens":[{"t":"楚","s":"楚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"與","s":"与","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"齊","s":"齐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"韓","s":"韩","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"合","s":"合","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"從","s":"从","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"周赧王九年是公元前306年，上接宜阳攻克、昭襄王初立。秦昭王派向寿去安定宜阳，又派樗里子、甘茂伐魏。甘茂主张把武遂归还韩国，向寿和公孙奭争不过，转而谗毁他。甘茂停攻蒲阪，逃到齐国，樗里子与魏讲和收兵。赵武灵王继续略取中山和胡地，林胡王献马，楼缓等人分使各国，代相赵固负责招引胡兵。楚王则与齐、韩合纵。","theme":"这一年紧跟着宜阳之战。秦臣因归还武遂分裂，甘茂出走，伐魏半途停止。赵国把胡服之后的经营落到地面：中山方向到宁葭，西边到榆中，又同时向秦、韩、楚、魏、齐派出使者。楚与齐、韩结成合纵，则为后来三国指责楚背约埋下由头。宜阳打下以后，秦的内部先不和，赵的北边却在伸展。","technique":"写法仍是编年短句，没有「臣光曰」，也没有长篇对话。先写秦的两路差遣，再用「争之，不能得，由此怨谗」把甘茂逃亡的原因压进一句因果。赵事用地名铺开，接着用楼缓之秦、仇液之韩这一串「之」字把五国使者排齐，使人看见武灵王外交和收编胡兵同时进行。末句单独记下楚的合纵，不加解释。","keyContentWords":[{"word":"平","reading":"píng","note":"平定、安抚。向寿去安定刚攻下的宜阳，不是和宜阳讲和。"},{"word":"略","reading":"lüè","note":"攻取、侵占土地。赵王既略中山，又西略胡地。"},{"word":"合从","reading":"hé zòng","note":"南北方向的联合。从读去声。楚与齐、韩结成这种盟约。"},{"word":"武遂","reading":"wǔ suì","note":"地名，原在韩、秦之间易手。甘茂主张把它交还韩国。"}],"keyFunctionWords":[{"word":"之","reading":"zhī","note":"「楼缓之秦」的之是动词，意思是前往。同篇「争之」的之才是代词。"},{"word":"以","reading":"yǐ","note":"「以武遂复归之韩」的以表示把武遂交还韩国。"}],"ancientModern":[{"word":"讲","note":"「与魏讲」是讲和、谈判停战，不是今天的讲课、讲解。"},{"word":"亡","note":"「亡去」是逃走，不是死亡。甘茂是怕谗言才离开秦国。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"西","note":"「西略胡地」的西表示向西，方位词用来修饰攻取的方向。"},{"word":"主","note":"「主胡」是主持、掌管胡人事务，不是君主的意思。"}],"specialSyntax":[{"name":"茂惧","note":"承前省略姓氏，只称茂，仍指甘茂。"},{"name":"楼缓之秦","note":"之在这里是前往，后面直接接秦、韩、楚、魏、齐五个目的地。"}]}}
