:"","pos":"","extra":"","level":"dict"},{"t":"冉","s":"冉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"皆","s":"皆","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"滅","s":"灭","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"昭王年纪还小，宣太后亲自处理国事，把政务交给魏冉，威势震动了秦国。","tokens":[{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"少","s":"少","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"宣","s":"宣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"太","s":"太","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"后","s":"后","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"自","s":"自","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"治","s":"治","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"事","s":"事","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"任","s":"任","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"魏","s":"魏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"冉","s":"冉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"為","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"政","s":"政","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"威","s":"威","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"震","s":"震","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"秦","s":"秦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"國","s":"国","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"周赧王十年是公元前305年。天上出现彗星。赵武灵王再次攻中山，连取丹丘、爽阳、鸿之塞，以及鄗、石邑、封龙、东垣，中山献出四邑求和。秦国一边，昭王年纪还小，宣太后亲自听政。太后异父弟魏冉就是穰侯，同父弟芈戎是华阳君，昭王的同母弟是高陵君和泾阳君。庶长壮与大臣、公子作乱，被魏冉诛灭；惠文后不得好死，悼武王后送回魏国。","theme":"对外是赵国继续削平中山，鄗等城转入赵手，中山用四邑换和平。对内是秦政权落到宣太后和魏冉手里。武王死后诸弟争立，能把昭王扶上位的是魏冉，所以他既守咸阳，又清洗反对者。记住：昭襄王初年办事的人，是太后和穰侯，不是年少的王自己。","technique":"开篇只用「彗星见」记下异象，不说吉凶。赵的战事一句罗列地名，一句写下献邑求和，随即停住。重心转到秦的亲属：先用「曰」标出魏冉、芈戎和高陵君、泾阳君的血缘，再追述魏冉从惠王、武王时就任职，然后写争立、平乱、放归和诛灭。这是短编年里插入一段权臣来历，为后来穰侯掌权做准备。没有「臣光曰」。","keyContentWords":[{"word":"彗星","reading":"huì xīng","note":"扫帚形的星。这里只记它出现，没有解释祸福。"},{"word":"用事","reading":"yòng shì","note":"执掌政事。魏冉在惠王、武王时就已经当权办事。"},{"word":"良死","reading":"liáng sǐ","note":"正常善终。不得良死，就是死于非命。"},{"word":"异父","reading":"yì fù","note":"父亲不是同一个人。魏冉是宣太后异父所生的弟弟。"}],"keyFunctionWords":[{"word":"及","reading":"jí","note":"「及惠文后」的及是连及，把惠文后也算进未能善终的人里。"},{"word":"为","reading":"wéi","note":"「以冉为将军」的为是做、担任。"}],"ancientModern":[{"word":"见","note":"「彗星见」的见是出现，后来常写作现，不是用眼睛看见。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"出","note":"「出归于魏」的出是送出、遣返。悼武王后被送回娘家所在的魏国。"}],"specialSyntax":[{"name":"异父弟曰穰侯魏冉","note":"曰在这里用来介绍身份，等于说这个人就是穰侯魏冉。"},{"name":"不得良死","note":"编年用四个字写下惠文后的结局，不另写她怎样死。"}]}}
