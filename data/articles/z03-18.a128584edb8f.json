x":"","pos":"","extra":"","level":"dict"},{"t":"通","s":"通","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"將","s":"将","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"兵","s":"兵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"救","s":"救","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"楚","s":"楚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"三","s":"三","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"國","s":"国","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"引","s":"引","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"兵","s":"兵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"去","s":"去","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"周赧王十二年是公元前303年。彗星再次出现。秦夺取魏的蒲阪、晋阳、封陵，又夺取韩的武遂。齐、韩、魏认为楚背叛了先前的合纵，联合伐楚。楚怀王把太子横送到秦国做人质，请秦出兵。客卿通率军救楚，三国撤走。黄棘之盟在这一年被楚拿来救急，代价是太子入质。","theme":"关键是楚在秦和旧盟友之间失信。齐、韩、魏因楚负从亲而来攻，楚不向他们解释，反而把太子横押给秦。秦刚从韩、魏手里夺地，转眼又出兵救楚，三国只好退走。记住太子横：他下一年会在秦国与人私斗，杀人后逃回，成为秦楚破裂的由头。","technique":"仍是因果很紧的短编年，没有言论，也没有「臣光曰」。天象一句带过，接着写秦取魏地又取韩地。三国出兵的理由用一个「以」字交代，楚的应对只有太子为质、请秦来救。客卿通一出兵，三国「引兵去」就收束。人质、救兵和撤军连成一条线。","keyContentWords":[{"word":"从亲","reading":"zòng qīn","note":"合纵诸国之间的盟好。从读去声。楚背弃的就是这层关系。"},{"word":"质","reading":"zhì","note":"人质。太子横到秦国，用自己换取秦兵。"},{"word":"客卿","reading":"kè qīng","note":"别国出身而在秦担任的卿。通是这个客卿的名字。"},{"word":"负","reading":"fù","note":"背叛、辜负。「负其从亲」是说楚背弃了与齐、韩、魏的盟约。"}],"keyFunctionWords":[{"word":"以","reading":"yǐ","note":"因为。「以楚负其从亲」说明三国伐楚的原因。"}],"ancientModern":[{"word":"去","note":"「引兵去」是撤军离开，不是往某处去。"},{"word":"负","note":"这里是背弃盟约，不是用背驮东西，也不是胜负的负。"}],"phoneticLoans":[],"flexibleUsage":[],"specialSyntax":[{"name":"以楚负其从亲","note":"用「以」把原因放在出兵之前，先说明为什么伐楚。"}]}}
