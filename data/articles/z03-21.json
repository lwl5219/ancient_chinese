level":"dict"},{"t":"疾","s":"疾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"卒","s":"卒","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"趙","s":"赵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"樓","s":"楼","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"緩","s":"缓","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"為","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"丞","s":"丞","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"相","s":"相","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]},{"sentences":[{"tr":"赵武灵王喜爱小儿子何，想趁自己还活着就把他立为国君。","tokens":[{"t":"趙","s":"赵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"武","s":"武","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"靈","s":"灵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"愛","s":"爱","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"少","s":"少","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"何","s":"何","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"欲","s":"欲","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"及","s":"及","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"生","s":"生","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"立","s":"立","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"周赧王十五年是公元前300年。秦把泾阳君送到齐国做人质。华阳君芈戎攻楚，斩首三万，杀死景缺，夺取襄城。楚怀王恐惧，改把太子送到齐国以求和。秦相樗里疾去世，秦改用赵人楼缓为丞相。赵武灵王喜爱小儿子何，想在自己还活着时把君位传给他。这是下一年东宫传国的预告。","theme":"楚连续大败，主将景缺战死，太子不再留在秦，而改送到齐，说明怀王已经不敢把继承人放在秦国。秦同时把泾阳君送去齐国，又用赵人楼缓为相，齐、秦、赵的人事连在一起。赵的一句「欲及其生而立之」，则把明年主父传位直接引出来。楚的危局和赵的内禅写在同一年。","technique":"五句都是记事，没有引语，也没有「臣光曰」。先记泾阳君到齐国做人质，再记华阳君大破楚军、杀死景缺，然后用一个「恐」字把怀王送太子入齐接上。第四句以樗里疾之死换上楼缓，并点明新丞相来自赵。末句只写武灵王的心意，不写朝仪，把「及其生」留作悬念。","keyContentWords":[{"word":"破","reading":"pò","note":"「大破」是把楚军打垮，不是普通的破坏。"},{"word":"质","reading":"zhì","note":"人质。泾阳君到齐国，楚太子随后也到齐国，都是这个身份。"},{"word":"卒","reading":"zú","note":"去世。这里记樗里疾死亡，不是士兵，也不是完毕。"}],"keyFunctionWords":[{"word":"及","reading":"jí","note":"「及其生」的及是趁着、赶上，指趁武灵王自己还活着。"},{"word":"以","reading":"yǐ","note":"「以请平」的以表示目的，太子入齐是用来请求讲和。"}],"ancientModern":[{"word":"卒","note":"读作去世。不要按现代的士兵或仓促讲。"},{"word":"平","note":"「请平」是求和，不是平坦，也不是平时。"}],"phoneticLoans":[],"flexibleUsage":[],"specialSyntax":[{"name":"及其生而立之","note":"其承前指武灵王自己，之指少子何。想在父亲活着时完成传位。"}]}}
