},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"庶","s":"庶","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"宜","s":"宜","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"！","s":"！","punct":true},{"t":"」","s":"」","punct":true}]},{"tr":"于是派人到齐国，假称楚王已经去世。","tokens":[{"t":"乃","s":"乃","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"詐","s":"诈","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"赴","s":"赴","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"齊","s":"齐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"齐湣王召集群臣商量这件事，有人说：「不如扣留太子，用来索取楚国的淮北。」","tokens":[{"t":"齊","s":"齐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"湣","s":"湣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"召","s":"召","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"群","s":"群","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"臣","s":"臣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"謀","s":"谋","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"或","s":"或","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"：","s":"：","punct":true},{"t":"「","s":"「","punct":true},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"若","s":"若","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"留","s":"留","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"太","s":"太","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"求","s":"求","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"楚","s":"楚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"淮","s":"淮","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"北","s":"北","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true},{"t":"」","s":"」","punct":true}]},{"tr":"齐国的相说：「不能这么做。","tokens":[{"t":"齊","s":"齐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"相","s":"相","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"：","s":"：","punct":true},{"t":"「","s":"「","punct":true},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"可","s":"可","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"郢都若另立了王，那我们就是空抱着一个人质，又在天下人面前做了不义的事。」","tokens":[{"t":"郢","s":"郢","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"中","s":"中","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"立","s":"立","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"是","s":"是","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"吾","s":"吾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"抱","s":"抱","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"空","s":"空","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"質","s":"质","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"行","s":"行","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"義","s":"义","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"天","s":"天","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"下","s":"下","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true},{"t":"」","s":"」","punct":true}]},{"tr":"刚才那人接着说：「不是这个道理。","tokens":[{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"：","s":"：","punct":true},{"t":"「","s":"「","punct":true},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"然","s":"然","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"郢都若另立了王，就可以跟他们的新王做交易，说：『把下东国给我，我替大王杀掉太子。","tokens":[{"t":"郢","s":"郢","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"中","s":"中","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"立","s":"立","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"因","s":"因","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"與","s":"与","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"新","s":"新","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"市","s":"市","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"：","s":"：","punct":true},{"t":"『","s":"『","punct":true},{"t":"予","s":"予","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"我","s":"我","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"下","s":"下","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"東","s":"东","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"國","s":"国","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"吾","s":"吾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"為","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"殺","s":"杀","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"太","s":"太","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"不然的话，我们将联合三个国家，一起把太子立为王。』」","tokens":[{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"然","s":"然","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"將","s":"将","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"與","s":"与","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"三","s":"三","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"國","s":"国","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"共","s":"共","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"立","s":"立","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true},{"t":"』","s":"』","punct":true},{"t":"」","s":"」","punct":true}]},{"tr":"齐王最终采用相的计策，把楚国太子送了回去。","tokens":[{"t":"齊","s":"齐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"卒","s":"卒","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"用","s":"用","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"相","s":"相","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"計","s":"计","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"歸","s":"归","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"楚","s":"楚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"太","s":"太","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"楚国人便把太子立为国君。","tokens":[{"t":"楚","s":"楚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"立","s":"立","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]},{"sentences":[{"tr":"秦王听说孟尝君贤能，派泾阳君到齐国做人质，以便请来孟尝君。","tokens":[{"t":"秦","s":"秦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"聞","s":"闻","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"孟","s":"孟","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"嘗","s":"尝","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"賢","s":"贤","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"使","s":"使","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"涇","s":"泾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"陽","s":"阳","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"為","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"質","s":"质","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"齊","s":"齐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"請","s":"请","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"孟尝君前来，进入秦国，秦王让他做了丞相。","tokens":[{"t":"孟","s":"孟","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"嘗","s":"尝","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"來","s":"来","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"入","s":"入","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"秦","s":"秦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"秦","s":"秦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"為","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"丞","s":"丞","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"相","s":"相","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"周赧王十六年是公元前299年。五月戊申，赵武灵王在东宫把君位传给小儿子何，自号主父，肥义为相国并辅导新王。主父穿着胡服，打算从云中、九原南下窥伺咸阳，假作使者入秦，秦王发觉时他已出关。同年秦伐楚，取八城，写信把楚怀王诱到武关。怀王不听昭睢，听了儿子子兰，入秦后被劫持到咸阳，秦要他割巫郡和黔中郡。他不肯，被扣留。楚臣向齐假报丧，齐湣王听从齐相，放回太子，楚人立他为王。秦又请来孟尝君做丞相。","theme":"这一年最要记住的是两场把人骗进来。主父自己扮成使者，进秦看地形和秦王为人，人已脱关，秦才知道是他。秦王则用兄弟盟约和武关相会，把楚怀王骗入关内，闭关西行，按藩臣之礼索地。赵是君父主动让位，再亲自探敌；楚是国君轻信书信，身困咸阳。齐廷争论要不要扣留楚太子，最后送还，楚才有了新君。","technique":"这一年不再是一句一事，也没有「臣光曰」。传国只用朝会、庙见和「主父」名号几个镜头。入秦探路写成小故事：假称使者、形貌雄伟、追赶不及、查问才知。楚事先整段收录秦王的信，让「会武关，面相约」的好话自己露出诱饵；再让昭睢与子兰各说相反的话，然后用伏兵、闭关、章台、要地把骗局落实。楚臣和齐臣的对话，争的是空质、下东国和杀太子，全靠说话人分出取舍。","keyContentWords":[{"word":"主父","reading":"zhǔ fù","note":"武灵王传位以后的自称，意思是国君的父亲。"},{"word":"庙见","reading":"miào jiàn","note":"到宗庙参见祖先。新王行完这个礼，大夫才向他称臣。"},{"word":"遗","reading":"wèi","note":"送给。「遗楚王书」是把书信送给楚王，不是遗失。"},{"word":"要","reading":"yāo","note":"要挟、强迫索取。「要以割地」「强要我以地」都不是普通的想要。"},{"word":"陵","reading":"líng","note":"欺凌。「陵杀」是凌辱并且杀死秦的重臣。"},{"word":"籓臣","reading":"fān chén","note":"籓同藩。藩臣是属国之臣。楚王被要求按这个身份在章台朝见。"},{"word":"空质","reading":"kōng zhì","note":"没有用处的人质。郢都若另立王，扣在齐国的太子就失去分量。"}],"keyFunctionWords":[{"word":"见","reading":"jiàn","note":"「恐见欺」的见放在动词前，表示被动，是怕被欺骗。"},{"word":"将","reading":"jiāng","note":"「将自云中」的将是打算、将要。同篇「将士大夫」的将读去声，是率领。"},{"word":"乃","reading":"nǎi","note":"「乃主父也」的乃表示判断，就是。"}],"ancientModern":[{"word":"审问","note":"仔细追问、查问，不是现代法庭里的审讯。"},{"word":"书","note":"「遗楚王书」的书是信，不是一部书籍。"},{"word":"谢","note":"「不谢而亡去」的谢是谢罪，不是感谢。"}],"phoneticLoans":[{"word":"赴","loan":"讣","note":"「诈赴于齐」的赴是报丧，后来写作讣。楚臣是假传死讯，不是亲自奔赴。"},{"word":"倍","loan":"背","note":"「倍王命」的倍通背，是违背，不是一倍两倍。"}],"flexibleUsage":[{"word":"傅","note":"「并傅王」的傅是做师傅、辅导，名词用法转成动词。"},{"word":"市","note":"「与其新王市」的市是做交易、讲条件，不是名词的集市。"},{"word":"归","note":"「归楚太子」是把太子送回去，使动用法，不是太子自己归来。"}],"specialSyntax":[{"name":"恐见欺","note":"见字放在欺前面，表示楚王怕的是自己被骗。"},{"name":"乃主父也","note":"乃……也构成判断，追查之后才确认那个人就是主父。"},{"name":"秦，虎狼也","note":"用判断句把秦比成虎狼，昭睢以此来劝怀王不要入关。"}]}}
