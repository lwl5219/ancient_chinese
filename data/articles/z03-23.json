,"pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"故","s":"故","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"辯","s":"辩","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"可","s":"可","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"為","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"等到堆砌烦琐的文辞来互相作假，用修饰过的言辞互相逼压，用巧妙的比喻把对方挪开，引着人走却让人到不了本意，这样就损害了大道。","tokens":[{"t":"及","s":"及","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"至","s":"至","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"煩","s":"烦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"文","s":"文","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"相","s":"相","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"假","s":"假","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"飾","s":"饰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"辭","s":"辞","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"相","s":"相","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"惇","s":"惇","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"巧","s":"巧","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"譬","s":"譬","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"相","s":"相","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"移","s":"移","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"引","s":"引","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"使","s":"使","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"得","s":"得","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"及","s":"及","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"意","s":"意","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"如","s":"如","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"此","s":"此","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"害","s":"害","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"大","s":"大","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"道","s":"道","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"缠绕纷乱地抢着说话，又比赛谁最后才住口，不可能不伤害君子，我衍不做这种事。」","tokens":[{"t":"夫","s":"夫","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"繳","s":"缴","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"紛","s":"纷","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爭","s":"争","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"言","s":"言","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"競","s":"竞","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"後","s":"后","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"息","s":"息","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"能","s":"能","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"害","s":"害","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"衍","s":"衍","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"為","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true},{"t":"」","s":"」","punct":true}]},{"tr":"在座的人都说好。","tokens":[{"t":"座","s":"座","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"皆","s":"皆","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"稱","s":"称","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"善","s":"善","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"公孙龙因此就被斥退了。","tokens":[{"t":"公","s":"公","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"孫","s":"孙","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"龍","s":"龙","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"由","s":"由","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"是","s":"是","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"遂","s":"遂","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"絀","s":"绌","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"周赧王十七年，公元前298年。孟尝君是齐国公子，这时在秦国为相，秦廷怀疑他凡事把齐国放在秦国前面。楚怀王被扣在秦，楚人宣告本国已经另有君主，秦王因此出武关攻楚。赵王把弟弟胜封为平原君。平原君收养善辩的公孙龙；孔穿字子高，从鲁国来到赵国，文中又称为孔子高。齐人邹衍路过，把白马非马的辩法挡了回去。","theme":"这一年要记住两件看起来隔得很远的事。一件是孟尝君靠门客偷回狐白裘、学鸡叫开了关，才从秦国脱身，秦王的追兵只差一步。另一件是平原君门下的名辩：公孙龙几乎把臧说成三只耳朵，孔穿却问他到底听从容易而真实的，还是听从困难而虚假的。邹衍接着说明，辩论若只会缠住人不放，就损害大道。公孙龙因此被疏远。","technique":"司马光把这一年收成前后两截。前半是短叙事，狐白裘、府库、鸡鸣和出关一句扣一句，不写孟尝君的心情，只留下关法还没到放人的时候。后半几乎全是对话：平原君发问，孔穿用两难反问，邹衍正面讲辩论该做什么、不该做什么。末尾只用遂绌两个字收住，没有臣光曰。谁把道理说完，谁就站住了。","keyContentWords":[{"word":"狐白裘","reading":"hú bái qiú","note":"集白狐腋下白毛制成的皮衣，极其贵重。孟尝君只有一件，已经献给秦王，宠姬却指名要这一件。"},{"word":"狗盗","reading":"gǒu dào","note":"像狗一样从缝隙钻进去行窃。门客靠这个本事进入秦的府库，把已经献出的狐白裘偷回来。"},{"word":"食客","reading":"shí kè","note":"寄居在贵族家里、由主人供给饮食的士。平原君好士，这种食客常常有几千人。"},{"word":"坚白","reading":"jiān bái","note":"名家辩论的题目，把同一块石头的坚硬和白色拆开来争。这里用来标公孙龙的专长，与同异并称。"},{"word":"臧","reading":"zāng","note":"奴仆常用的名字。臧三耳是说这个叫臧的人有三只耳朵，是故意抬杠的命题，不是真有第三只耳。"}],"keyFunctionWords":[{"word":"其","reading":"qí","note":"「秦其危哉」的其放在主语后面，表示推测，相当于恐怕。同句的哉配合它，构成感叹。"},{"word":"乃","reading":"nǎi","note":"「乃以楼缓为相」「乃得脱归」的乃都是承接，相当于于是、这才。事情被推进了一步。"},{"word":"之","reading":"zhī","note":"本篇的之多作代词。欲杀之、遣之指孟尝君，已献之的之指狐白裘，要看它紧挨着哪一件事。"}],"ancientModern":[{"word":"幸","note":"「幸姬」的幸是宠爱，不是今天说的幸运。秦王幸姬就是秦王特别宠爱的姬。"},{"word":"藏","note":"「入秦藏中」的藏读 zàng，是府库，不是躲藏。门客进的是存放狐白裘的库房。"},{"word":"适","note":"「自鲁适赵」的适是到、往，不是适合。孔穿是从鲁国前往赵国。"},{"word":"信","note":"「信辩」的信是的确、实在，不是书信，也不是相信。平原君是说公孙的话确实善辩。"},{"word":"仆","note":"孔穿说「仆愿得又问于君」，仆是谦称自己，不是家里的仆人。"},{"word":"座","note":"「座皆称善」的座指在座的人，不是一张座位。听见邹衍说话的人都表示赞同。"},{"word":"异端","note":"「序异端」的异端是不同的头绪、分歧的论点，不是后世骂人的异端邪说。邹衍要求把这些头绪排清楚。"},{"word":"惇","note":"「饰辞以相惇」的惇不作忠厚讲，这里取敦迫的意思，指用修饰过的言辞互相逼压。"}],"phoneticLoans":[{"word":"蚤","loan":"早","note":"「时尚蚤」的蚤借作早，指天色还早，追兵将到而关还没到放行的时候。不是跳蚤。"},{"word":"绌","loan":"黜","note":"「遂绌」的绌借作黜，是贬退、不再以客礼相待。公孙龙从此被平原君疏远。"}],"flexibleUsage":[{"word":"客","reading":"kè","note":"「平原君客之」的客由名词转为动词，是按门客的礼遇收留公孙龙。同篇「出客」的客则是过关的旅客。"},{"word":"相","reading":"xiàng","note":"「孟尝君相秦」「以楼缓为相」的相读 xiàng，前一个是动词，做相；后一个是名词，相位。"}],"specialSyntax":[{"name":"无以","note":"「无以应姬求」是没有什么可以用来回应姬的要求。无以后面省去了所凭借的东西，只留下做不到的结果。"},{"name":"其亦选择","note":"「将从易而是者乎，其亦从难而非者乎」先用将……乎提出一边，再用其亦接出另一边，是让平原君二选一的问句。"}]}}
