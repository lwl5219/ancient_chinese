"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"勿","s":"勿","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"稱","s":"称","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"秦国如果称了帝，天下也安然接受，大王接着再称，就不会落在人后。","tokens":[{"t":"秦","s":"秦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"稱","s":"称","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"天","s":"天","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"下","s":"下","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"安","s":"安","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乃","s":"乃","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"稱","s":"称","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"後","s":"后","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"秦国如果称了帝，天下却憎恶这件事，大王就因此不称帝，用来收揽天下人心，这可是很大的资本。","tokens":[{"t":"秦","s":"秦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"稱","s":"称","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"天","s":"天","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"下","s":"下","py":"","ctx":"","pos"