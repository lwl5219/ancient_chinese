{"id":"z04-10","volume":4,"volumeTitle":"周纪四","volumeSubtitle":"前288","index":10,"title":{"t":"赧王二十七年","s":"赧王二十七年"},"book":{"t":"資治通鑑","s":"资治通鉴"},"sourceHead":{"t":"周紀四 · 前288 · 癸酉","s":"周纪四 · 前288 · 癸酉"},"author":"司马光","annotated":true,"paragraphs":[{"sentences":[{"tr":"冬天十月，秦王自称西帝，派使者把齐王立为东帝，想约定两国一起攻打赵国。","tokens":[{"t":"冬","s":"冬","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"十","s":"十","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"月","s":"月","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"秦","s":"秦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"稱","s":"称","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"西","s":"西","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"帝","s":"帝","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"遣","s":"遣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"使","s":"使","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"立","s":"立","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"齊","s":"齐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"為","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"東","s":"东","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"帝","s":"帝","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"欲","s":"欲","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"約","s":"约","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"與","s":"与","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"共","s":"共","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"伐","s":"伐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"趙","s":"赵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。