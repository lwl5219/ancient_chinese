,"extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"这样做，就是我们在名义上把秦国尊起来，却让天下人憎恨它，正是所谓用谦卑换取尊崇。」","tokens":[{"t":"是","s":"是","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"我","s":"我","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"名","s":"名","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"尊","s":"尊","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"秦","s":"秦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"令","s":"令","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"天","s":"天","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"下","s":"下","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"憎","s":"憎","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"所","s":"所","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"謂","s":"谓","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"卑","s":"卑","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"為","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"尊","s":"尊","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true},{"t":"」","s":"」","punct":true}]},{"tr":"齐王听从了，只称了两天帝，就把帝号退了回去。","tokens":[{"t":"齊","s":"齐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"從","s":"从","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"稱","s":"称","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"帝","s":"帝","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"二","s":"二","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"日","s":"日","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"復","s":"复","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"歸","s":"归","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"十二月，吕礼从齐国进入秦国，秦王也去掉帝号，重新改称王。","tokens":[{"t":"十","s":"十","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"二","s":"二","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"月","s":"月","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"呂","s":"吕","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"禮","s":"礼","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"自","s":"自","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"齊","s":"齐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"入","s":"入","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"秦","s":"秦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"秦","s":"秦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"亦","s":"亦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"去","s":"去","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"帝","s":"帝","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"復","s":"复","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"稱","s":"称","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]},{"sentences":[{"tr":"秦国攻打赵国，攻下了杜阳。","tokens":[{"t":"秦","s":"秦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"攻","s":"攻","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"趙","s":"赵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"拔","s":"拔","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"杜","s":"杜","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"陽","s":"阳","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"这一年是周赧王二十七年，前288年。秦王自称西帝，派魏冉把齐王立为东帝，想借并立的帝号拉齐国一起伐赵。苏代从燕国赶到齐国，劝齐王先把帝号收下，却不要马上使用。齐王只称了两天帝就把帝号退回。十二月吕礼从齐入秦，秦王也去掉帝号，仍旧称王。年底秦军还是攻赵，夺取杜阳。","theme":"这一年要记住的是帝号本身会招恨。苏代不让齐王硬拒，也不让他立刻和秦并尊，而是分成两条路：天下若安然接受，齐国再称也不晚；天下若憎恶，齐国不称，反而能收人心。他要齐国打的不是赵，而是暴虐的宋。名义上把秦抬高，怨恨也让秦去承担。","technique":"编年只钉住冬十月、十二月和年末拔城三处，中间整段是苏代对齐王的对话。话里用「秦称之，天下安之」和「秦称之，天下恶之」两路对举，再用「孰与」逼出伐赵还是伐宋。司马光没有另写评论。齐王称帝二日就归还，秦王跟着去帝，事情本身把这番话验完了。","keyContentWords":[{"word":"西帝","reading":"xī dì","note":"秦王自称的帝号，和东帝相对。本年十月才称，十二月就去掉。"},{"word":"魏冉","reading":"wèi rǎn","note":"秦国派来向齐王送达帝号的人。齐王问苏代时点了他的名字。"},{"word":"桀宋","reading":"jié sòng","note":"苏代对宋国的叫法，拿夏桀比宋君，强调宋君暴虐，所以该打。"},{"word":"杜阳","reading":"dù yáng","note":"赵国城邑。帝号已经取消，秦军仍攻赵，拔了这座城。"},{"word":"梁","reading":"liáng","note":"楚、赵、梁、卫里的梁，指魏。魏迁都大梁以后，常被这样称呼。"}],"keyFunctionWords":[{"word":"以","reading":"yǐ","note":"「以收天下」「以伐桀宋」「以名尊秦」「以卑为尊」的以，都是拿、用来。"},{"word":"乃","reading":"nǎi","note":"「王乃称之」的乃是这才、然后再。先看天下接不接受，再决定称帝。"},{"word":"子","reading":"zǐ","note":"齐王称苏代为子，是敬称，相当于您，不是儿子。"}],"ancientModern":[{"word":"安","note":"「天下安之」是安然接受称帝这件事，不是地方平安，也不是安装。"},{"word":"资","note":"「此大资也」的资是可以倚仗的资本，不是单指钱财货物。"},{"word":"去","note":"「去帝」是除去帝号，不是到某个地方去。"},{"word":"释","note":"「释帝」是放下、放弃帝号，不是解释。"},{"word":"举","note":"「宋举」是宋国被攻下，不是举起，也不是举例。"},{"word":"无后","note":"「无后也」是不至于落在人后，不是没有子孙后代。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"尊","note":"「以名尊秦」的尊作动词，把秦国推到尊贵的位子上，不是形容词「尊贵」直接放着。"}],"specialSyntax":[{"name":"孰与","note":"「伐赵孰与伐桀宋利」把伐赵和伐桀宋放在一起比利害。孰与是在问哪一边更有利。"}]}}
