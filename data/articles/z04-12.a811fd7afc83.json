,"ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"至","s":"至","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"國","s":"国","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"中","s":"中","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"敢","s":"敢","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"呼","s":"呼","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"萬","s":"万","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"歲","s":"岁","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"天下的人把宋叫作「桀宋」。","tokens":[{"t":"天","s":"天","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"下","s":"下","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"謂","s":"谓","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"「","s":"「","punct":true},{"t":"桀","s":"桀","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"宋","s":"宋","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"」","s":"」","punct":true},{"t":"。","s":"。","punct":true}]},{"tr":"齐湣王起兵讨伐宋国，百姓逃散，城池也守不住。","tokens":[{"t":"齊","s":"齐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"湣","s":"湣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"起","s":"起","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"兵","s":"兵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"伐","s":"伐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"民","s":"民","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"散","s":"散","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"城","s":"城","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"守","s":"守","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"宋王逃奔到魏国，最后死在温地。","tokens":[{"t":"宋","s":"宋","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"奔","s":"奔","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"魏","s":"魏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"死","s":"死","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"溫","s":"温","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"这一年是周赧王二十九年，前286年。秦将司马错进攻魏国河内，魏国把安邑献出来求和，秦国把城中居民遣回魏国，又在夏山打败韩军。同一年的主线转到宋：宋康王因城角的异鸟自信能霸天下，四面用兵，随后射天笞地、焚烧社稷，全国被逼着呼喊万岁。齐湣王起兵攻宋，宋国民散城破，宋王逃到魏国，死在温。","theme":"宋康王的兴起和灭亡被写在同一年。麻雀生出猛禽，史官说小而生巨、必霸天下，他便当真去灭滕、伐薛，东打齐、南打楚、西打魏。霸业还没站稳，他先羞辱天地和社稷，再用万岁的呼声把国家变成一片应和。天下叫他桀宋。齐兵一到，百姓散了，城也守不住，吉兆以出逃和身死作结。","technique":"开篇三句仍是秦对魏、韩的短编年，安邑的人被送回，只记结果，不写谈判。写到宋，笔法换成异事、占辞和一连串动作：射天、笞地、斩社稷，室中呼万岁一直传到国中。司马光不加评论，只用「天下之人谓之桀宋」，再接民散、奔魏、死于温，让暴政自己走到头。","keyContentWords":[{"word":"司马错","reading":"sī mǎ cuò","note":"秦国将领。本年他进攻的是魏国河内。"},{"word":"安邑","reading":"ān yì","note":"魏国献出的城，用来向秦求和。秦国收下城，把居民遣回魏国。"},{"word":"𪄟","reading":"zhān","note":"猛禽，也就是鹯。麻雀生出这种鸟，史官把它说成小而生巨的吉兆。"},{"word":"社稷","reading":"shè jì","note":"土地神和谷神的祭坛，代表国家。宋康王把它砍断烧毁，是向鬼神示威。"},{"word":"桀宋","reading":"jié sòng","note":"天下人对宋的称呼，用夏桀比宋康王的暴虐。"}],"keyFunctionWords":[{"word":"以","reading":"yǐ","note":"「献安邑以和」的以是用来求和；「以示威服鬼神」的以也是用来。"},{"word":"乃","reading":"nǎi","note":"「乃愈自信」的乃是于是、就。打过胜仗之后，他就更加自信。"}],"ancientModern":[{"word":"出","note":"「出其人」是把安邑的居民迁出去，不是出门。"},{"word":"奔","note":"「奔魏」是逃往魏国，不是奔跑。"},{"word":"亟","note":"「欲霸之亟成」的亟是赶快、急切，读 jí。他恨不得霸业立刻成功。"},{"word":"占","note":"「史占之」是占测吉凶，读 zhān，不是占据。"},{"word":"陬","note":"角落。「城之陬」是城墙的拐角，不是城门正中。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"饮","note":"「长夜之饮」的饮指饮酒这件事，用作名词，就是通宵的酒宴。"}],"specialSyntax":[{"name":"双重否定","note":"「无敢不呼万岁者」用「无……不……」说全国没有人敢不喊。比直接说人人都呼，更显出是被逼的。"}]}}
