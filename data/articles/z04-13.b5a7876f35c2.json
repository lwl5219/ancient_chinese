"dict"},{"t":"獨","s":"独","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"攻","s":"攻","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"大王如果一定要讨伐它。","tokens":[{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"必","s":"必","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"欲","s":"欲","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"伐","s":"伐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"没有比约上赵国，再联合楚国、魏国更好的办法。」","tokens":[{"t":"莫","s":"莫","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"如","s":"如","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"約","s":"约","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"趙","s":"赵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"及","s":"及","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"楚","s":"楚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"魏","s":"魏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true},{"t":"」","s":"」","punct":true}]},{"tr":"于是派乐毅去和赵国约定，另外派使者联络楚、魏，并且让赵国用伐齐的好处去引诱秦国。","tokens":[{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"是","s":"是","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"使","s":"使","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"樂","s":"乐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"毅","s":"毅","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"約","s":"约","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"趙","s":"赵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"別","s":"别","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"使","s":"使","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"使","s":"使","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"連","s":"连","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"楚","s":"楚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"魏","s":"魏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"且","s":"且","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"令","s":"令","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"趙","s":"赵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"啖","s":"啖","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"秦","s":"秦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"伐","s":"伐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"齊","s":"齐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"利","s":"利","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"诸侯都忌恨齐王的骄横残暴，争着合谋，跟燕国一起攻打齐国。","tokens":[{"t":"諸","s":"诸","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"侯","s":"侯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"害","s":"害","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"齊","s":"齐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"驕","s":"骄","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"暴","s":"暴","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"皆","s":"皆","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爭","s":"争","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"合","s":"合","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"謀","s":"谋","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"與","s":"与","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"燕","s":"燕","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"伐","s":"伐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"齊","s":"齐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"这一年是周赧王三十年，前285年。秦王在宛会见楚王，在中阳会见赵王，蒙武又从齐国夺走九座城。齐湣王灭宋之后更加骄横，南侵楚，西侵三晋，还想吞并二周、自己做天子，并把劝谏的狐咺、陈举杀死。燕昭王日夜抚循百姓，国家渐渐富实，于是和乐毅商量伐齐，开始约赵、楚、魏，并让赵去引诱秦。","theme":"齐湣王的骄暴把诸侯推到了同一边。灭宋本是他的顶点，他却接着向楚和三晋伸手，对直言的人公开行刑。燕国走的是相反的路：先把人民安抚富足，再由乐毅判断齐国地大人众，不能单独进攻。要约赵及楚、魏，还要让赵拿伐齐的好处去打动秦。恨齐的诸侯争着与燕合谋，下一年的大战在这里已经排好了位子。","technique":"这一年先用会盟和拔城交代秦的动作，句子都很短。齐湣王的扩张和杀人写成对举：狐咺死在檀衢，陈举死在东闾。然后把话交给乐毅。他的话不长，只判定齐是霸国余业、不宜独攻，并给出该约哪些国家。司马光不写战场，用「皆争合谋」把各国的怨恨收成大战之前的一口气。","keyContentWords":[{"word":"宛","reading":"yuān","note":"地名。秦王在这里会见楚王。作地名时不要读成弯曲的 wǎn。"},{"word":"蒙武","reading":"méng wǔ","note":"秦国将领。本年攻齐，拔了九座城。"},{"word":"狐咺","reading":"hú xuǎn","note":"向齐湣王正言进谏的人，被杀死在檀衢。咺读 xuǎn。"},{"word":"乐毅","reading":"yuè yì","note":"燕国主将。乐读 yuè。他判断齐国不能独攻，主张约赵及楚、魏。"},{"word":"三晋","reading":"sān jìn","note":"韩、赵、魏。齐湣王向西侵犯的就是这三国。"}],"keyFunctionWords":[{"word":"既","reading":"jì","note":"「既灭宋而骄」的既是已经。灭宋是后面骄傲的前提。"},{"word":"且","reading":"qiě","note":"「且令赵啖秦」的且是并且。约楚、魏之外，再加上引诱秦。"},{"word":"莫","reading":"mò","note":"「莫如约赵」的莫是没有什么。莫如，没有哪种办法比得上。"}],"ancientModern":[{"word":"害","note":"「诸侯害齐王之骄暴」的害是忌恨、把这件事当成祸害，不是动手去伤害齐王。"},{"word":"余业","note":"「霸国之余业」是霸主留下来的基业，不是业余。"},{"word":"啖","note":"「啖秦」是拿好处去引诱秦国。字面本有给人吃的意思，这里是喂一个甜头。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"约","note":"「约赵」的约是动词，去订立约定，不是名词「条约」本身。"}],"specialSyntax":[{"name":"条件句单列","note":"「王必欲伐之」只把条件说完，句子就断了。办法在下一句「莫如约赵及楚、魏」，不要理解成已经决定单独出兵。"}]}}
