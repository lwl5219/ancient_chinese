:"dict"},{"t":"斂","s":"敛","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"計","s":"计","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"數","s":"数","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"未","s":"未","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"及","s":"及","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"取","s":"取","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"民","s":"民","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"子产是能够取得民心的人，还没有做到治理政事。","tokens":[{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"產","s":"产","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"取","s":"取","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"民","s":"民","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"未","s":"未","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"及","s":"及","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"為","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"政","s":"政","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"管仲是能够治理政事的人，还没有做到修明礼制。","tokens":[{"t":"管","s":"管","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"仲","s":"仲","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"為","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"政","s":"政","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"未","s":"未","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"及","s":"及","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"修","s":"修","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"禮","s":"礼","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"所以修明礼制的人可以称王，治理政事的人可以使国家强盛，取得民心的人可以使国家安定，聚敛财物的人会使国家灭亡。","tokens":[{"t":"故","s":"故","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"修","s":"修","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"禮","s":"礼","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"為","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"政","s":"政","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"強","s":"强","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"取","s":"取","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"民","s":"民","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"安","s":"安","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"聚","s":"聚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"斂","s":"敛","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"亡","s":"亡","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"周赧王三十二年，即公元前283年。此前燕军攻破齐国，湣王逃到莒地，被楚将淖齿杀死，齐国大片土地落入燕军之手。法章是湣王的儿子，王孙贾是齐国王室子弟，太史敫是莒地的太史。同一年秦国与赵国在穰地会面，又攻下魏国安城，军队抵达魏都大梁后撤回。赵惠文王手中有楚国的和氏璧，秦昭王提出用十五座城交换。卫国嗣君也在这一年去世，儿子怀君继位。","theme":"这一年要记住三条线。齐国一线：法章隐名藏在太史敫家里，王孙贾被母亲责问后，在集市召集四百人杀掉淖齿，法章才敢在莒城即位，齐国因此留下了抗拒燕军的据点。赵国一线：蔺相如主张宁可把璧送去，让不交出城的秦国承担理亏；城没有交来，他就把璧完好送回，自己留在秦国。卫国一线：嗣君死后追记他窥探隐微、让宠臣互相牵制，荀子把这种只会计较聚敛的君主，放在终将灭亡的一等。","technique":"司马光把这一年分成几段短纪事，没有写臣光曰。齐国一段靠母亲的责备和集市上的号召把事情推进，话都很短，动作却很快。和氏璧一段只写赵王的犹豫、蔺相如的对答，以及璧由小路归赵、人留在秦国，骗取璧的具体手法用“以诈绐”三字带过。卫嗣君一段先记去世，再追叙几件细事，最后借荀子的话分出聚敛、取民、为政、修礼四等，作者自己不再另下断语。","keyContentWords":[{"word":"佣","reading":"yōng","note":"受雇做工的人。法章改了姓名，在太史敫家里当佣工，借此躲过搜捕。"},{"word":"绐","reading":"dài","note":"欺骗。蔺相如用计把璧从秦王那里骗回来，通鉴没有展开这个计谋的步骤。"},{"word":"间行","reading":"jiàn xíng","note":"抄小路秘密行走。随从带着璧潜回赵国，与留在秦国的蔺相如分头行动。"},{"word":"和氏璧","reading":"hé shì bì","note":"楚国的名玉。此时在赵王手中，秦昭王提出用十五座城来换。"},{"word":"曲","reading":"qū","note":"理亏。蔺相如比较的是：不答应则亏在赵，给了璧却拿不到城则亏在秦。"},{"word":"取民","reading":"qǔ mín","note":"取得百姓的拥护。荀子把它放在聚敛之上、治理政事之下，认为能做到这一层，国家可以安定。"},{"word":"壅","reading":"yōng","note":"堵塞、蒙蔽。嗣君担心泄姬和如耳凭宠爱挡住自己的耳目。"}],"keyFunctionWords":[{"word":"乃","reading":"nǎi","note":"于是、这才。用来承接前事，表示后一个动作是被前事推出来的。"},{"word":"弗","reading":"fú","note":"相当于不。后面的动词常不再带宾语，“弗诛”就是不杀他。"},{"word":"见","reading":"jiàn","note":"用在“恐见欺”里，表示被动，意思是害怕被秦国欺骗。"}],"ancientModern":[{"word":"走","reading":"zǒu","note":"这里是逃走。母亲说的“王走”，是湣王已经跑了，不是平常走路。"},{"word":"窃","reading":"qiè","note":"这里是暗中、私下。太史敫的女儿偷偷送衣送食，不是去偷窃。"},{"word":"亡","reading":"wáng","note":"“亡臣”的亡是流亡在外；篇末“聚敛者亡”的亡是国家灭亡。两个地方都要随句子理解。"},{"word":"薨","reading":"hōng","note":"诸侯去世叫薨。卫嗣君是诸侯，所以这里用薨来记他的死。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"奇","reading":"qí","note":"形容词作意动，认为奇特。“奇法章状貌”是觉得法章的相貌不寻常。"},{"word":"负","reading":"fù","note":"动词的使动用法，使秦国承担。“宁许以负秦”是宁可答应，让秦国背上理亏。"},{"word":"衣食","reading":"yì sì","note":"两个名词都用作动词，后面的“之”指法章。衣是给他衣服，读 yì；食是给他食物，读 sì。"},{"word":"敌","reading":"dí","note":"用作动词，抗衡、使相匹敌。抬高薄疑，是为了不让如耳一人专宠。"},{"word":"完","reading":"wán","note":"使动用法，使璧保持完好。“完璧而归之”是把璧完好地带回去。"}],"specialSyntax":[{"name":"疑问代词作宾语前置","note":"“汝尚何归焉”的“何归”就是“归何”。疑问代词何放在动词归前面，整句是责问他还回家做什么。"},{"name":"介词宾语省略","note":"“以问蔺相如”的“以”后面省去了代词“之”，这个“之”指要不要把璧给秦国的两难。"}]}}
