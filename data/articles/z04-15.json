"t":"恐","s":"恐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"他又宠爱泄姬，看重如耳，却担心他们会仗着宠爱和看重来蒙蔽自己，于是把薄疑的地位抬高，用来抗衡如耳，又尊崇魏妃，让她与泄姬配对，说：「用这个办法让他们互相牵制。」","tokens":[{"t":"又","s":"又","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"愛","s":"爱","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"洩","s":"泄","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"姬","s":"姬","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"重","s":"重","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"如","s":"如","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"耳","s":"耳","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"恐","s":"恐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"因","s":"因","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"愛","s":"爱","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"重","s":"重","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"壅","s":"壅","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"己","s":"己","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"乃","s":"乃","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"貴","s":"贵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"薄","s":"薄","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"疑","s":"疑","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"敵","s":"敌","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"如","s":"如","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"耳","s":"耳","py":"","