":"dict"},{"t":"如","s":"如","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"法","s":"法","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"則","s":"则","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"上","s":"上","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"下","s":"下","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"平","s":"平","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"上","s":"上","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"下","s":"下","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"平","s":"平","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"則","s":"则","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"國","s":"国","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"強","s":"强","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"國","s":"国","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"強","s":"强","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"則","s":"则","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"趙","s":"赵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"固","s":"固","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"為","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"貴","s":"贵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"戚","s":"戚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"豈","s":"岂","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"輕","s":"轻","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"天","s":"天","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"下","s":"下","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"邪","s":"邪","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"！","s":"！","punct":true},{"t":"」","s":"」","punct":true}]},{"tr":"平原君认为他贤能，向赵王讲了他的长处。","tokens":[{"t":"平","s":"平","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"原","s":"原","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"為","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"賢","s":"贤","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"言","s":"言","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"赵王派他治理全国的赋税。国赋变得非常均平，百姓富足，府库也充实起来。","tokens":[{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"使","s":"使","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"治","s":"治","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"國","s":"国","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"賦","s":"赋","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"國","s":"国","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"賦","s":"赋","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"大","s":"大","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"平","s":"平","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"民","s":"民","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"富","s":"富","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"府","s":"府","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"庫","s":"库","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"實","s":"实","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"这一年是周赧王四十四年，前271年。赵国大臣蔺相如伐齐，进到平邑。另一件事发生在收租的场合：田部吏赵奢向平原君家收税，对方不肯交，赵奢依法杀掉主事的九个人。平原君要杀他，听完他的话反而向赵王推荐。赵王让赵奢治理国赋。这时的赵奢还是税吏，不是后来带兵的将军。","theme":"这一年要记住赵奢怎样讲法。平原君是赵国贵公子，家里抗租，赵奢连杀九个用事的人。他说纵容贵家就会法削、国弱，诸侯加兵，赵国不保，公子的富也保不住。平原君听进去了。结果是国赋均平，百姓富，府库也满。","technique":"开头一句仍是伐齐的编年。后面改成叙事：赵奢在将被杀时说完一整段因果，用「则」把纵家、法削、国弱、加兵、无赵串成一条，再从奉公说到国强。司马光不加臣光曰，只用平原君「以为贤」和「国赋大平」写出这番话的结果。","keyContentWords":[{"word":"田部吏","reading":"tián bù lì","note":"主管田租的官吏。赵奢这一年的身份是收税，不是将领。"},{"word":"用事者","reading":"yòng shì zhě","note":"平原君家里管事、办事的人。被杀的是这九个，不是平原君本人。"},{"word":"奉公","reading":"fèng gōng","note":"按公家的法度办事。赵奢要求平原君带头这样做。"},{"word":"贵戚","reading":"guì qī","note":"国君的亲族。赵奢说这种人的地位，要靠赵国还在才能保住。"},{"word":"国赋","reading":"guó fù","note":"国家的田赋。赵王后来把征收和管理交给赵奢。"}],"keyFunctionWords":[{"word":"以","reading":"yǐ","note":"「以法治之」的以是按照；「以君之贵」的以是凭着。"},{"word":"则","reading":"zé","note":"就、那么。把法削、国弱、加兵、国强一层层接起来。"},{"word":"安","reading":"ān","note":"怎么、从哪里。「安得有此富」是还能凭什么保住这份富。"},{"word":"岂","reading":"qǐ","note":"难道。和句末的邪一起构成反问。"},{"word":"邪","reading":"yé","note":"句末疑问语气，相当于吗。不要读成邪恶。"}],"ancientModern":[{"word":"出","note":"「不肯出」是不肯交出租税，不是不肯出门。"},{"word":"平","note":"「上下平」「国赋大平」是公平、均平，不是太平无事。"},{"word":"实","note":"「府库实」是充实、装满，不是实在、果实。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"纵","note":"放任。「纵君家」是放过平原君家里的人，不按法处分。"}],"specialSyntax":[{"name":"则字顶真","note":"「法削则国弱，国弱则诸侯加兵」上一小句的结果作下一小句的原因，用则把后果推成长链。"},{"name":"岂……邪","note":"岂和句末的邪配合，表示反问，意思是不会被天下轻视。"}]}}
