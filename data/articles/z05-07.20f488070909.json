":"dict"},{"t":"！","s":"！","punct":true}]},{"tr":"不然的话，就要屠灭大梁！」","tokens":[{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"然","s":"然","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"且","s":"且","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"屠","s":"屠","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"大","s":"大","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"梁","s":"梁","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"！","s":"！","punct":true},{"t":"」","s":"」","punct":true}]},{"tr":"须贾回到魏国，把这些话告诉了魏齐。","tokens":[{"t":"須","s":"须","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"賈","s":"贾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"還","s":"还","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"告","s":"告","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"魏","s":"魏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"齊","s":"齐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"魏齐逃往赵国，藏在平原君家里。","tokens":[{"t":"魏","s":"魏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"齊","s":"齐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"奔","s":"奔","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"趙","s":"赵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"匿","s":"匿","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"平","s":"平","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"原","s":"原","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"家","s":"家","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]},{"sentences":[{"tr":"赵惠文王去世了，他的儿子孝成王丹登上王位；又用平原君做相。","tokens":[{"t":"趙","s":"赵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"惠","s":"惠","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"文","s":"文","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"薨","s":"薨","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"孝","s":"孝","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"成","s":"成","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"丹","s":"丹","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"立","s":"立","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"；","s":"；","punct":true},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"平","s":"平","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"原","s":"原","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"為","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"相","s":"相","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"周赧王四十九年，是公元前二六六年。秦继续攻魏，拔下邢丘。范睢已经日益亲信、执掌政事，趁空对秦昭襄王说：住在山东时只听说齐有孟尝君，秦有太后和穰侯，听不见王。他用擅国、利害、杀生来说明怎样才配叫王，指出太后、穰侯、华阳、泾阳、高陵权重则国危，又拿淖齿杀齐王、李兑饿死主父作比。秦王听从，废太后，把穰侯、高陵、华阳、泾阳君逐到关外，用范睢为丞相，封应侯。随后魏使须贾来聘，应侯穿着破衣去见他，因一件绨袍留他一命，却要魏国送来魏齐的头。魏齐逃到赵国，藏在平原君家。同年赵惠文王去世，儿子孝成王丹即位，平原君为相。","theme":"这一年的中心是秦国的权从四贵手里抽出来。范睢说的王，必须能独自掌管国家、决定利害和生杀；人落在四贵下面，就是无王。穰侯的使者把战胜的利归到陶，战败的怨留给百姓和社稷。废逐之后，范睢以应侯的身份对旧日仇人须贾显示权势：堂下当马喂，口中要魏齐的头。赵国同时换了国君，平原君为相，魏齐正藏在他家里。","technique":"这一年没有「臣光曰」。司马光先用一句记下拔城，立刻接入范睢的长篇说辞。说辞用排比定义王，再用树的枝心、淖齿、李兑三层往前逼，然后用「王以为然」接上废逐和封侯。后半换成叙事：敝衣、间步、绨袍、膝行、堂下放置草料，动作很密，对话只留在门下答话和「速斩魏齐头来」。编年在赵惠文王薨、孝成王立处重新收住。","keyContentWords":[{"word":"四贵","reading":"sì guì","note":"范睢把太后、穰侯、华阳、泾阳、高陵放在一起说。四贵通常指穰侯、华阳、泾阳、高陵这四位权臣，太后在同一段话里居于他们之上。"},{"word":"应侯","reading":"yīng hóu","note":"范睢的封号。应是封邑，读 yīng。他刚受封，就穿着破衣服去见须贾。"},{"word":"绨袍","reading":"tí páo","note":"厚绸做成的袍子。须贾送给范睢。应侯后来就说，他能不死，是因为这件袍子还留着故人的情意。"},{"word":"主父","reading":"zhǔ fù","note":"赵武灵王传位以后的称号。李兑把他囚在沙丘，百日饿死。范睢用来说明权臣可以怎样对待君主。"},{"word":"有秩","reading":"yǒu zhì","note":"享有官秩、领取俸禄的人。范睢说从这一层往上到大吏，往下到大王身边，全是相国的人。"}],"keyFunctionWords":[{"word":"之","reading":"zhī","note":"「未之有也」的之是「有」的宾语，提前到动词前面，指四贵齐备而国家还不危这种事。"},{"word":"乃","reading":"nǎi","note":"「乃所谓无王也」的乃是判断，相当于「就是」。"},{"word":"以","reading":"yǐ","note":"「以范睢为丞相」「以平原君为相」的以，都是任用、让谁担任。"}],"ancientModern":[{"word":"用事","note":"「范睢日益亲，用事」和「四贵之用事」，都是掌权。不是今天说的有一件事要办。"},{"word":"击断","note":"「击断无讳」是擅自判案、刑杀，毫无顾忌。不是把物件击断。"},{"word":"疾","note":"「妒贤疾能」的疾读 jí，是憎恶、忌恨，不是疾病。"},{"word":"薨","note":"诸侯死叫薨。赵惠文王去世用的是这个字，和天子的崩不同。"},{"word":"聘","note":"「使须贾聘于秦」是诸侯之间派使者访问，不是今天的聘请、招聘。"},{"word":"披","note":"「披其枝」的披是折裂、压断，不是把衣服披在身上。果实太密，枝先断，树心跟着受伤。"},{"word":"间","note":"「承间说王」的间是空隙，趁空进言。「敝衣间步」的间是偷偷地、走小路。都读 jiàn。这一年没有把间用作间谍。"},{"word":"山东","note":"「臣居山东时」的山东，指崤山以东，不是专指后来的山东省。"}],"phoneticLoans":[{"word":"乡","loan":"向","note":"「乡者吾相张君也」的乡通向，读 xiàng。乡者就是刚才。不是乡村。"}],"flexibleUsage":[{"word":"大","reading":"dà","note":"「大其都」的大是使动，把都城弄大。同篇「诸大吏」的大是形容词，指大官。"},{"word":"卑","reading":"bēi","note":"「卑其主」的卑是使动，使君主变得卑下。"},{"word":"马","reading":"mǎ","note":"「马食之」的马是名词作状语，像喂马那样。须贾坐在堂下，面前放的是草料和豆子。"},{"word":"利害","reading":"lì hài","note":"「能利害之谓王」，利害在这里用作动词：能让人得利，也能让人受害。"},{"word":"膝","reading":"xī","note":"「膝行」是用膝盖走，名词作状语。须贾知道受骗，跪着挪进去请罪。"}],"specialSyntax":[{"name":"宾语前置","note":"「未之有也」是否定句里代词宾语提前。之指这件事，若按后来的语序就是「未有之」。"},{"name":"之谓","note":"「擅国之谓王」是「叫做」。能独自掌握国家的，才配称为王。利害、杀生两句用的是同一个句式。"},{"name":"见字被动","note":"「须贾知见欺」的见表示被动，是自己被骗了，不是看见别人欺骗。"}]}}
