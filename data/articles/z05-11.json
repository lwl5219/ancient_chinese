,"extra":"","level":"dict"},{"t":"受","s":"受","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true},{"t":"」","s":"」","punct":true}]},{"tr":"赵王又去告诉平原君，平原君请求把地接过来。","tokens":[{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"告","s":"告","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"平","s":"平","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"原","s":"原","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"平","s":"平","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"原","s":"原","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"請","s":"请","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"受","s":"受","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"赵王就派平原君前去接收土地，用万户的城邑三座封那里的太守为华阳君，用千户的城邑三座封那里的县令为侯，官吏和百姓都加爵三级。","tokens":[{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乃","s":"乃","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"使","s":"使","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"平","s":"平","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"原","s":"原","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"往","s":"往","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"受","s":"受","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"地","s":"地","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"萬","s":"万","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"戶","s":"户","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"都","s":"都","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"三","s":"三","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"封","s":"封","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"太","s":"太","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"守","s":"守","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"為","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"華","s":"华","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"陽","s":"阳","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"千","s":"千","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"戶","s":"户","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"都","s":"都","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"三","s":"三","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"封","s":"封","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"縣","s":"县","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"令","s":"令","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"為","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"侯","s":"侯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"吏","s":"吏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"民","s":"民","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"皆","s":"皆","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"益","s":"益","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"爵","s":"爵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"三","s":"三","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"級","s":"级","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"冯亭流着眼泪，不肯接见使者，说：「我不忍心卖掉主人的土地，再靠这份赏赐过日子！」","tokens":[{"t":"馮","s":"冯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"亭","s":"亭","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"垂","s":"垂","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"涕","s":"涕","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"見","s":"见","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"使","s":"使","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"：","s":"：","punct":true},{"t":"「","s":"「","punct":true},{"t":"吾","s":"吾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"忍","s":"忍","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"賣","s":"卖","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"主","s":"主","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"地","s":"地","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"食","s":"食","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"！","s":"！","punct":true},{"t":"」","s":"」","punct":true}]}]}],"lesson":{"background":"前262年是周赧王五十三年。楚国把州献给秦国讲和。武安君攻下韩国的野王，上党通往韩都郑的道路断绝，秦兵仍天天推进，韩都接应不上。上党守冯亭与百姓商议，与其把地交入秦国，不如把十七座城邑献给赵国：赵若接受，秦必攻赵，赵被攻就会亲韩，韩赵才能合力抵挡。赵王问平阳君赵豹，豹说这是无故之利，韩国是在嫁祸；平原君赵胜则请赵王接受。赵王派平原君受地，封太守为华阳君，县令为侯，吏民加爵三级。冯亭却流泪不见使者，说自己不忍卖掉主人的土地来换俸禄。","theme":"这一年的关键是上党该不该接。冯亭的打算很直白：把地给赵，是为了把秦军引向赵国，再换来韩赵一体。平阳君豹看得更冷。秦国费力蚕食，本准备坐收上党；韩国不交秦而交赵，是把祸转嫁过来。强大的一方尚且不能白拿弱小的便宜，弱小的一方更不能白拿秦国已经盯住的利。平原君请受，封赏随即铺开。冯亭垂涕不见使者，把受地的热闹和守土者的难堪放在同一年。","technique":"司马光把这个决策写成三层说话。冯亭对上党吏民讲归赵的理由，使者对赵王讲吏民愿为赵，平阳君豹和平原君对同一块地给出相反的答复。豹的话用蚕食、嫁祸和反问叠在一起：强大尚不能从弱小手里白得，弱小怎能从强大手里白得。叙事不写赵王如何当面驳冯亭，结尾只留他垂涕不见和一句不忍，让封爵的热闹停在送地者的眼泪上。","keyContentWords":[{"word":"蚕食","reading":"cán shí","note":"像蚕吃桑叶，一点一点吞并。平阳君豹用它说秦国逐步吃掉韩地。"},{"word":"太守","reading":"tài shǒu","note":"一郡的长官。封其太守为华阳君，这个太守就是上文的上党守冯亭。"},{"word":"垂涕","reading":"chuí tì","note":"流泪。冯亭不肯为了封赏去见赵国使者。"},{"word":"再拜","reading":"zài bài","note":"拜两次，表示献地十分郑重。不是今天说的再次拜访。"},{"word":"当","reading":"dāng","note":"抵挡。韩、赵为一，则可以当秦，是两国合力挡住秦军。"}],"keyFunctionWords":[{"word":"所以","reading":"suǒ yǐ","note":"……的原因。韩氏所以不入于秦者，是解释韩国不把地交给秦的缘故。"},{"word":"乃","reading":"nǎi","note":"于是、就。乃遣使者、王乃使平原君，都是接着采取下一步。"},{"word":"被","reading":"bèi","note":"遭受。赵被秦兵，是赵国受到秦军攻打。"}],"ancientModern":[{"word":"平","note":"讲和。楚人纳州于秦以平，是交出城邑来停战。不是平坦，也不是平白。"},{"word":"食","note":"吾不忍卖主地而食之，食是靠卖掉土地换来的俸禄过日子，不是单说吃一顿饭。"},{"word":"都","note":"万户都、千户都的都，是城邑，读 dū。不是「全都」的 dōu。"},{"word":"城市","note":"有城市邑十七，是城、市、邑三种居民点合起来共十七座。不是今天说的一座城市。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"嫁","note":"嫁其祸于赵，是把祸转嫁出去。嫁本指出嫁，这里用在祸事上。"},{"word":"祸","note":"甚祸无故之利，祸作动词，把无缘无故的利看得很有祸害，是意动用法。"},{"word":"益","note":"益爵三级，益是增加，动词。官吏百姓的爵位都往上加三级。"}],"specialSyntax":[{"name":"岂得","note":"岂得谓之非无故哉，用反问把话说死：这就是无缘无故的好处，不能再说它另有来由。"}]}}
