:"代","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"追","s":"追","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"北","s":"北","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"五","s":"五","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"百","s":"百","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"餘","s":"余","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"里","s":"里","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"遂","s":"遂","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"圍","s":"围","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"燕","s":"燕","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"燕国人请求讲和，赵国人说：「一定要让将渠来主持和议。」","tokens":[{"t":"燕","s":"燕","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"請","s":"请","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"和","s":"和","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"趙","s":"赵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"：","s":"：","punct":true},{"t":"「","s":"「","punct":true},{"t":"必","s":"必","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"令","s":"令","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"將","s":"将","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"渠","s":"渠","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"處","s":"处","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"和","s":"和","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true},{"t":"」","s":"」","punct":true}]},{"tr":"燕王任命将渠为相，由他主持讲和，赵军这才解围离去。","tokens":[{"t":"燕","s":"燕","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"將","s":"将","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"渠","s":"渠","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"為","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"相","s":"相","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"處","s":"处","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"和","s":"和","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"趙","s":"赵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"師","s":"师","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乃","s":"乃","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"解","s":"解","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"去","s":"去","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]},{"sentences":[{"tr":"赵国的平原君去世了。","tokens":[{"t":"趙","s":"赵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"平","s":"平","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"原","s":"原","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"卒","s":"卒","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"昭襄王五十六年，公元前251年。秋天昭襄王去世，孝文王继位，把母亲唐八子尊为唐太后，立子楚为太子。子楚的妻儿原先留在赵国，这一年被送回。韩王穿丧服来秦吊祭。同一年燕王喜听栗腹的话攻赵。昌国君乐闲在燕国劝阻，赵国出战的是廉颇和乐乘，两人不是同一人。燕军在鄗、代大败，赵军围燕，和议由将渠主持。平原君也死于这一年。","theme":"秦这一头是君位更替：老王去世，新王继立，太后和太子同时确定，子楚的家眷从赵国归来。燕赵那一头是一场不该打的仗。栗腹以为长平之后赵国只剩孤儿，乐闲两次说不可，将渠说背约出兵不祥，燕王仍坚持以五打一。廉颇、乐乘打败燕军之后，赵国点名要那个被踢过的将渠来讲和。被拒绝的劝告，最后变成和议的条件。","technique":"司马光先用短句写秦廷的丧、立、尊号和送还家眷，韩王吊祭也只用一句。写到燕赵，改成连续对话：栗腹的建议、乐闲的两次「不可」、燕王的「以五而伐一」、将渠的警告和哭诉。「王怒」单独成句，下面才是发兵。战事再收回编年，用鄗、代、追北、围燕、处和几个动作收束。平原君之卒另起一句，不附传。全年没有「臣光曰」。","keyContentWords":[{"word":"衰绖","reading":"cuī dié","note":"丧服。衰读 cuī，不读 shuāi，是丧衣；绖是系在头上或腰间的麻带。韩王穿着这身衣服来吊祭。"},{"word":"八子","reading":"bā zǐ","note":"秦国后宫的一个等级。唐八子的唐是姓，八子不是八个儿子。她被尊为唐太后。"},{"word":"四战","reading":"sì zhàn","note":"「四战之国」不是打了四场战争，而是四面都要作战、因此惯于用兵的国家。乐闲用这个理由阻止伐赵。"},{"word":"卿秦","reading":"qīng qín","note":"燕军将领的姓名，不是秦国的卿。他负责攻代，被乐乘打败。"},{"word":"乐闲","reading":"yuè xián","note":"人名。乐是姓，读 yuè，不读 lè。昌国君是他的封号。他在燕国反对这次出兵。"},{"word":"宋子","reading":"sòng zǐ","note":"赵地的地名，燕军到达这里，不是宋国的公子。"}],"keyFunctionWords":[{"word":"乃","reading":"nǎi","note":"于是。「乃发二千乘」是于是派出兵车；「赵师乃解去」是条件满足之后才撤军。"},{"word":"以","reading":"yǐ","note":"用、拿。「以五百金」是拿出这笔钱；「以五而伐一」是用五份力量去打一份；「以将渠为相」是任命他做相。"}],"ancientModern":[{"word":"妻子","note":"妻和子女，不单指今天所说的妻子。赵人送回的是子楚的家眷。"},{"word":"孤","note":"「其孤未壮」的孤是死了父亲的孩子，指长平之战留下的孤儿，不是孤独。"},{"word":"北","note":"「追北」的北是败逃的军队。追北是追击败兵，不是向北方追了五百里。"},{"word":"卒","note":"「平原君卒」的卒是去世，用于大夫这一级。同篇秦王之死用薨，用字不同。这里不是士兵，也不是终于。"},{"word":"乘","note":"「二千乘」的乘读 shèng，是兵车的量词，一乘一辆兵车。同篇「乐乘」是人名，乘读 chéng，不要和兵车的读音混成一个。"},{"word":"金","note":"「五百金」的金是货币计量单位，是办酒的厚礼，不是随口说的五百两金子。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"将","reading":"jiàng","note":"「栗腹将而攻鄗」「自将偏军」的将是率领，动词，读 jiàng，不是将来。"},{"word":"饮","reading":"yìn","note":"「饮人之王」的饮是请人喝酒，使动用法，读 yìn，不是自己饮的 yǐn。"}],"specialSyntax":[{"name":"状语后置","note":"「约欢于赵」「败栗腹于鄗」「乐乘败卿秦于代」都把地点放在「于」字后面，分别是在赵国约定友好、在鄗打败栗腹、在代打败卿秦。"},{"name":"承前省略","note":"「返而言于燕王」的主语是上一句派出的栗腹，这里不再点名。后面的「对曰」仍是乐闲在回答。"}]}}
