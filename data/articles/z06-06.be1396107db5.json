"，","punct":true},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"順","s":"顺","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"：","s":"：","punct":true},{"t":"「","s":"「","punct":true},{"t":"世","s":"世","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"；","s":"；","punct":true},{"t":"抑","s":"抑","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"可","s":"可","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"為","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"次","s":"次","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"魯","s":"鲁","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"仲","s":"仲","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"連","s":"连","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乎","s":"乎","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"！","s":"！","punct":true},{"t":"」","s":"」","punct":true}]},{"tr":"魏安厘王说：「鲁仲连是勉强做出来的，并不是从本性里自然如此。」","tokens":[{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"：","s":"：","punct":true},{"t":"「","s":"「","punct":true},{"t":"魯","s":"鲁","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"仲","s":"仲","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"連","s":"连","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"強","s":"强","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"作","s":"作","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"非","s":"非","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"體","s":"体","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"自","s":"自","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"然","s":"然","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true},{"t":"」","s":"」","punct":true}]},{"tr":"子顺说：「人都是要去做的。","tokens":[{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"順","s":"顺","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"：","s":"：","punct":true},{"t":"「","s":"「","punct":true},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"皆","s":"皆","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"作","s":"作","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"不停地做，才能成为君子；一直这样做而不改变，习惯就和自身一起养成；习惯和自身养成了，那就是自然。」","tokens":[{"t":"作","s":"作","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"止","s":"止","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"乃","s":"乃","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"成","s":"成","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"；","s":"；","punct":true},{"t":"作","s":"作","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"變","s":"变","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"習","s":"习","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"與","s":"与","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"體","s":"体","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"成","s":"成","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"；","s":"；","punct":true},{"t":"習","s":"习","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"與","s":"与","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"體","s":"体","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"成","s":"成","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"則","s":"则","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"自","s":"自","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"然","s":"然","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true},{"t":"」","s":"」","punct":true}]}]}],"lesson":{"background":"孝文王元年，公元前250年。孝文王在十月已亥即位，三天就去世，子楚继位为庄襄王。华阳夫人是孝文王的夫人，被尊为华阳太后；夏姬是子楚的母亲，被尊为夏太后。另一条线在齐、燕之间：燕将攻下聊城后被人诬陷，不敢回国。田单围城一年多，鲁仲连用箭书劝降，燕将自杀，聊城被攻克。齐国要封鲁仲连，他逃到海上。魏安厘王又向子顺追问他算不算高士。子顺是当时在魏国的孔氏后人。","theme":"秦君的即位短得只剩三天，两位太后的名分却写清楚了。更该记住的是鲁仲连。他不率兵，只用一封绑在箭上的信打破聊城的僵局；齐国要给他爵位，他宁可贫贱也不屈从别人。子顺随后把这件事说成修养：高士不是天生如此。人不停地去做，习惯和自身养成了，勉强也会变成自然。","technique":"秦廷三句仍是短编年，日期、即位和三日而薨连在一句里。聊城一段先叙事，再把鲁仲连的信和燕将的犹豫、长叹拆开，引文跨到下一句，中间不再重复。结尾换成魏安厘王和子顺的对话，用「强作」对「自然」收束。没有「臣光曰」，作者把评论交给子顺。","keyContentWords":[{"word":"谮","reading":"zèn","note":"说坏话、诬陷。「或谮之燕王」是有人向燕王诬告那位燕将。"},{"word":"强作","reading":"qiǎng zuò","note":"勉强做作。强读 qiǎng，不读 qiáng。魏安厘王认为鲁仲连的高洁是使劲装出来的。"},{"word":"轻世肆志","reading":"qīng shì sì zhì","note":"看轻世俗，放开自己的志向。这是鲁仲连拒绝爵位时的选择。"},{"word":"高士","reading":"gāo shì","note":"品德高出世俗的人。魏安厘王问的是天下有没有这样的人。"}],"keyFunctionWords":[{"word":"抑","reading":"yì","note":"「抑可以为次」的抑是或者、退一步说，不是压抑。"},{"word":"之","reading":"zhī","note":"多数是代词，如「拔之」「爵之」。「逃之海上」的之是动词，意思是到、往。"},{"word":"见","reading":"jiàn","note":"「见书」是看到信；「见辱」的见表示被动，是被羞辱。"},{"word":"与","reading":"yǔ","note":"「与人刃我，宁我自刃」的与接近「与其」，和后面的「宁」搭配。「习与体成」的与是连词，习惯和自身一起。"}],"ancientModern":[{"word":"书","note":"「为书」的书是书信，不是书籍。鲁仲连写的是给燕将的一封信。"},{"word":"遗","note":"「遗燕将」的遗读 wèi，是送给，不是遗失的 yí。"},{"word":"保","note":"「保聊城」是守住聊城、据城不走，不是现代所说的保护或保证。"},{"word":"体","note":"「非体自然」的体是体现在自己身上，动词。不是身体，也不是体制。"}],"phoneticLoans":[{"word":"诎","loan":"屈","reading":"qū","note":"「诎于人」的诎借作屈，是屈服、屈从。鲁仲连不愿富贵而屈从别人。"}],"flexibleUsage":[{"word":"爵","reading":"jué","note":"「欲爵之」的爵是授予爵位，名词用作动词。"},{"word":"刃","reading":"rèn","note":"「刃我」「自刃」的刃是用刀杀，名词用作动词。"},{"word":"约","reading":"yuē","note":"「约之矢」的约是捆扎，把信绑在箭上。这里不是盟约。"}],"specialSyntax":[{"name":"取舍句","note":"「不归燕则归齐」是两条路里必须选一条。「与人刃我，宁我自刃」和「富贵而诎于人，宁贫贱而轻世肆志」都用「宁」标出宁可选择的一边。"}]}}
