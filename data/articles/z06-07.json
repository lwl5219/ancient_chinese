ict"},{"t":"、","s":"、","punct":true},{"t":"穀","s":"谷","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"城","s":"城","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"平","s":"平","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"陰","s":"阴","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"偃","s":"偃","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"師","s":"师","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"鞏","s":"巩","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"緱","s":"缑","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"氏","s":"氏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]},{"sentences":[{"tr":"河南、洛阳的十万户成了相国不韦的封地，他的封号是文信侯。","tokens":[{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"河","s":"河","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"南","s":"南","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"洛","s":"洛","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"陽","s":"阳","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"十","s":"十","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"萬","s":"万","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"戶","s":"户","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"封","s":"封","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"相","s":"相","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"國","s":"国","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"韋","s":"韦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"為","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"文","s":"文","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"信","s":"信","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"侯","s":"侯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]},{"sentences":[{"tr":"蒙骜向韩国用兵，成皋、荥阳落入秦军之手，秦国从此开始设置三川郡。","tokens":[{"t":"蒙","s":"蒙","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"驁","s":"骜","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"伐","s":"伐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"韓","s":"韩","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"取","s":"取","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"成","s":"成","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"皋","s":"皋","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"滎","s":"荥","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"陽","s":"阳","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"初","s":"初","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"置","s":"置","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"三","s":"三","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"川","s":"川","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"郡","s":"郡","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]},{"sentences":[{"tr":"楚国灭掉鲁国，把鲁顷公迁到卞，让他做普通百姓。","tokens":[{"t":"楚","s":"楚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"滅","s":"灭","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"魯","s":"鲁","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"遷","s":"迁","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"魯","s":"鲁","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"頃","s":"顷","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"公","s":"公","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"卞","s":"卞","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"為","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"家","s":"家","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"庄襄王元年，公元前249年。吕不韦担任相国。东周君为诸侯谋划伐秦，庄襄王派他率军灭掉东周，把东周君迁到阳人聚，周的祭祀就此停止。周临亡时还剩河南、洛阳等七邑，其中河南、洛阳十万户封给不韦，号文信侯。蒙骜攻韩，取成皋、荥阳，秦始设三川郡。楚在这一年灭鲁，鲁顷公被迁到卞，降为平民。","theme":"这一年要记住周怎样结束，以及鲁怎样从诸侯变成平民。东周不是在长篇战纪里倒下的：先写讨灭，再写不祀，然后用七邑清单交代还剩下什么，又用十万户写明土地转到谁手里。人可以被迁走，祭祀却已经断了。鲁顷公被称为家人，国君的身份也同时消失。三川郡则在成皋、荥阳易手后第一次出现。","technique":"全是短编年，没有对话，没有「臣光曰」。周的灭亡被拆成灭国、绝祀、列邑、封侯四句，一句一个后果。七邑用冒号逐一点名，读起来像清单。楚灭鲁只保留迁徙和身份，「为家人」三个字把国君收成平民。作者不写战场细节，只写政治结果。","keyContentWords":[{"word":"不祀","reading":"bú sì","note":"祭祀断绝。周既不祀，是说周王室不再有人继承宗庙祭祀，标志着周作为王朝结束。"},{"word":"阳人聚","reading":"yáng rén jù","note":"地名。聚是聚落、村落。东周君被迁到这里，不是把民众召集起来。"},{"word":"三川","reading":"sān chuān","note":"郡名，因境内黄河、洛水、伊水而得名。取成皋、荥阳之后，秦第一次设这个郡。"},{"word":"家人","reading":"jiā rén","note":"普通百姓。鲁顷公被迁到卞以后失去君位，成为平民，不是回到自己亲戚家里。"}],"keyFunctionWords":[{"word":"比","reading":"bì","note":"「周比亡」的比读 bì，是临近、等到那个时候，不是比较的 bǐ。"},{"word":"以","reading":"yǐ","note":"「以河南、洛阳十万户封」的以是拿、用。用这些户口作为封地。"},{"word":"为","reading":"wèi","note":"「为诸侯谋」的为读 wèi，是替诸侯打算。「为相国」「为家人」「为文信侯」的为读 wéi，是担任或成为。"}],"ancientModern":[{"word":"邑","note":"城邑、城镇。七邑是七座城，不是七户人家。"},{"word":"初","note":"「初置」是第一次设置，不是「当初曾经设置过」。三川郡从这一年才有。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"帅","reading":"shuài","note":"「帅师」的帅是率领，动词。帅师就是带领军队。"}],"specialSyntax":[{"name":"状语后置","note":"「迁东周君于阳人聚」「迁鲁顷公于卞」都是把人迁到某地，地点放在「于」字后面。"}]}}
