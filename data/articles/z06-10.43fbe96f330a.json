:"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"渠道引进带着淤泥的水，灌溉盐碱地四万多顷，收成每亩都达到一钟，关中因此更加富饶。","tokens":[{"t":"注","s":"注","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"填","s":"填","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"閼","s":"阏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"水","s":"水","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"溉","s":"溉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"舄","s":"舄","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"鹵","s":"卤","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"地","s":"地","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"四","s":"四","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"萬","s":"万","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"餘","s":"余","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"頃","s":"顷","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"收","s":"收","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"皆","s":"皆","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"畝","s":"亩","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"一","s":"一","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"鐘","s":"钟","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"關","s":"关","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"中","s":"中","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"由","s":"由","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"是","s":"是","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"益","s":"益","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"富","s":"富","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"饒","s":"饶","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"始皇帝元年，公元前246年。上一年年底晋阳反叛，这一年开篇就是蒙骜把叛乱打平。韩国希望拖住秦的东进，派水工郑国入秦做间谍，从仲山开渠，引泾水沿北山向东注入洛水。工程中途败露，秦人要杀他。郑国说渠成对秦是万世之利，秦就让他修完。渠水灌溉盐碱地四万多顷，亩收一钟，关中由此更富。","theme":"这一年表面上是韩国的疲秦之计，结果却写成秦国的水利。郑国承认自己是为了给韩国多撑几年，但渠一旦修成，关中的盐碱地变成良田。间谍带来的工程，反过来养活了他想来拖垮的国家。蒙骜平叛只是开头一句，真正让秦更强的是渠成之后的亩产。","technique":"第一句承接上一年的叛乱，用「击定之」收住，不再展开战事。郑国入秦的动机、路线和败露分成几句叙事，他为自己辩解的话单独成句，只对比「数年之命」和「万世之利」。最后用灌溉顷数和「益富饶」作结果，不加「臣光曰」。作者让数字自己说明这名间谍留下了什么。","keyContentWords":[{"word":"郑国","reading":"zhèng guó","note":"水工的姓名，不是诸侯国郑。韩国派这个人入秦开渠。"},{"word":"水工","reading":"shuǐ gōng","note":"治水的工匠。郑国的身份是水利技师，开渠是他的本职，也是他做间谍的掩护。"},{"word":"间","reading":"jiàn","note":"「为间于秦」的间读 jiàn，是间谍，不是中间的 jiān。"},{"word":"舄卤","reading":"xì lǔ","note":"盐碱地。舄和卤都指含盐、长不好庄稼的地。渠水灌的就是这种地。"},{"word":"钟","reading":"zhōng","note":"古代较大的谷物容量单位。亩收一钟，是说产量很高，不是计时的钟。"},{"word":"顷","reading":"qǐng","note":"土地面积单位，一顷一百亩。四万余顷是很大一片地。"}],"keyFunctionWords":[{"word":"之","reading":"zhī","note":"「击定之」的之指上一年末的晋阳叛乱；「欲杀之」「卒为之」的之指郑国和他承修的渠。"},{"word":"乃","reading":"nǎi","note":"于是。「乃使卒为之」是秦人听完郑国的话之后，才让他把工程做完。"}],"ancientModern":[{"word":"卒","note":"「乃使卒为之」的卒读 zú，是完成、做到底。不是士兵，也不是去世。"},{"word":"洛","note":"「东注洛」的洛是洛水，渠水向东流入这条河，不是洛阳城。"},{"word":"填阏","note":"淤泥。填阏之水是带着泥沙、可以肥田的渠水，不是把渠道填满堵塞。"},{"word":"觉","note":"「中作而觉」的觉是被发觉。工程做到一半，间谍的意图暴露了。"}],"phoneticLoans":[{"word":"并","loan":"傍","reading":"bàng","note":"「并北山」的并通傍，读 bàng，是沿着。水渠顺着北山向东，不是把北山合并起来。"}],"flexibleUsage":[{"word":"疲","reading":"pí","note":"「疲秦人」是使秦人疲劳、消耗秦的人力，动词的使动用法。"}],"specialSyntax":[{"name":"目的复句","note":"「韩欲疲秦人，使无东伐」先写打算，再写要达成的结果：使秦没有余力向东攻打。开渠是实现这个目的的手段。"}]}}
