:"頗","s":"颇","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"去","s":"去","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"龐","s":"庞","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"煖","s":"煖","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"為","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"將","s":"将","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"欲","s":"欲","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"因","s":"因","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"敝","s":"敝","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"攻","s":"攻","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"問","s":"问","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"劇","s":"剧","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"辛","s":"辛","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"對","s":"对","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"：","s":"：","punct":true},{"t":"「","s":"「","punct":true},{"t":"龐","s":"庞","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"煖","s":"煖","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"易","s":"易","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"與","s":"与","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"耳","s":"耳","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true},{"t":"」","s":"」","punct":true}]},{"tr":"燕王便派剧辛统兵去攻打赵国。","tokens":[{"t":"燕","s":"燕","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"使","s":"使","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"劇","s":"剧","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"辛","s":"辛","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"將","s":"将","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"伐","s":"伐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"趙","s":"赵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"赵国由庞煖迎战，杀了剧辛，并俘获燕军两万人。","tokens":[{"t":"趙","s":"赵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"龐","s":"庞","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"煖","s":"煖","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"禦","s":"御","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"殺","s":"杀","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"劇","s":"剧","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"辛","s":"辛","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"取","s":"取","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"燕","s":"燕","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"師","s":"师","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"二","s":"二","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"萬","s":"万","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]},{"sentences":[{"tr":"各国诸侯都担心秦国这样攻打下去，没有停下来的时候。","tokens":[{"t":"諸","s":"诸","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"侯","s":"侯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"患","s":"患","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"秦","s":"秦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"攻","s":"攻","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"伐","s":"伐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"已","s":"已","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"時","s":"时","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"秦王政五年，蒙骜再次攻魏，取得酸枣、燕、虚、长平、雍丘、山阳等二十城，秦国在这片新地上第一次设置东郡。燕国看见赵国屡次被秦困住，廉颇已去，庞煖为将，便派曾与庞煖交好的剧辛伐赵。庞煖迎战，杀死剧辛，拿下燕军两万人。各国因此更担心秦的攻伐停不下来。","theme":"这一年先记住东郡：二十座魏城并入秦国，秦的势力伸到东方。再记住剧辛误判老相识。他以为庞煖好对付，燕王就出兵；结果主将战死，两万人被赵军俘获。末句把各国的恐惧收在秦身上，说明燕赵相攻并没有挡住秦，只让诸侯看见秦攻伐无已。","technique":"开篇仍是一句短编年，把取城和置郡写在一起。下面用「初」追叙剧辛和庞煖的旧交，再写燕王的盘算和剧辛只有四个字的答话「庞煖易与耳」。败仗也只用一句：谁迎战、谁被杀、损失多少。最后单独一句写诸侯的忧虑，不作评论，也没有「臣光曰」。","keyContentWords":[{"word":"东郡","reading":"dōng jùn","note":"秦国这一年新设的郡，地盘来自刚从魏国夺得的二十城。初置，就是第一次设立。"},{"word":"易与","reading":"yì yǔ","note":"容易对付。剧辛认为庞煖好打，燕王因此放心让他领兵伐赵。"},{"word":"御","reading":"yù","note":"「赵庞煖御之」的御是迎战、抵抗。庞煖率赵军挡住剧辛，并把他杀死。"},{"word":"已","reading":"yǐ","note":"「无已时」的已是停止。诸侯担心的是秦国攻伐没有收场的时候。同段「已而」的已则是随后，两处不要混。"}],"keyFunctionWords":[{"word":"因","reading":"yīn","note":"「欲因其敝而攻之」的因是趁着、凭借。燕王想利用赵国被秦拖累后的疲弱。"}],"ancientModern":[{"word":"初","note":"这一年里初有两个意思。「初置东郡」是第一次设置；「初，剧辛在赵」是早先，用来追叙旧事。"},{"word":"善","note":"「与庞煖善」的善是交好、关系亲密，不是善良，也不是擅长某件事。"},{"word":"敝","note":"「因其敝」的敝是疲败、困乏。燕王要打的是被秦国反复打击之后的赵国。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"将","reading":"jiàng","note":"「使剧辛将而伐赵」的将是率领军队，名词用作动词，读 jiàng。剧辛在这里是主将。"}],"specialSyntax":[{"name":"被动句","note":"「赵数困于秦」用「于」引出施事。赵国是被秦国反复逼困的一方，不是赵国去困秦。"}]}}
