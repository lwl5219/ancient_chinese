":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"阻","s":"阻","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"山","s":"山","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"保","s":"保","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"魏","s":"魏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"河","s":"河","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"內","s":"内","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"秦王政六年，楚、赵、魏、韩、燕合纵攻秦，楚王做纵长，春申君掌军务，先取寿陵，到函谷却被秦军击退。楚王责备春申君，他因而更受疏远。观津人朱英指出：从前秦不便越过黾阨或背靠韩、魏攻楚，现在魏国保不住许、鄢陵，秦兵离楚都陈只有一百六十里。楚国于是迁都寿春，仍称郢。春申君回到吴地的封邑，继续行相事。秦国又拔魏朝歌和卫濮阳，卫元君率支属迁到野王。","theme":"这一年的合纵只打到函谷就散了，真正要记住的是楚都为什么搬家。朱英认为楚弱不在春申君本人，而在秦军已经逼近陈。迁寿春、名之为郢，是躲开这每天都会打起来的前线。春申君就封于吴仍行相事，说明他失势却还没有交出相位。卫元君退保野王，则是小卫国被秦从濮阳挤走。","technique":"五国出兵、函谷败走、春申君被疏，三句就写完，几乎不写战阵。重心放在朱英的一段话：先引世人的看法，再用「其于英不然」翻过来，然后对比先君时的两条路和如今秦兵去陈的距离。迁都、就封、拔城、卫君徙居又回到短编年，一句一件事。没有「臣光曰」。","keyContentWords":[{"word":"合从","reading":"hé zòng","note":"南北各国联合抗秦。从读 zòng，就是纵。这一年楚、赵、魏、韩、燕五国一起出兵。"},{"word":"用事","reading":"yòng shì","note":"主持事务、掌握实权。春申君在这次合纵里实际管事，所以败后被楚王归罪。"},{"word":"旦暮","reading":"dàn mù","note":"早晨或晚上，形容时间极短。朱英说魏国随时会亡，所以顾不上许和鄢陵。"},{"word":"支属","reading":"zhī shǔ","note":"宗族里的旁支亲属。卫元君迁到野王时，带走的是这些族人，不是全国百姓。"}],"keyFunctionWords":[{"word":"以","reading":"yǐ","note":"「楚王以咎春申君」的以相当于因为，后面省了这件事。「割以与秦」的以则是把割出的土地交给秦。"},{"word":"其","reading":"qí","note":"「其于英不然」的其是句首语气词，表示要发表自己的判断。于英，就是在朱英看来。"}],"ancientModern":[{"word":"去","note":"这一年去有两义。「秦兵去陈百六十里」的去是距离，秦军离陈一百六十里；「楚于是去陈」的去才是离开。迁都那一句，楚国才真正撤出陈。"},{"word":"爱","note":"「不能爱许、鄢陵」的爱是吝惜、舍不得放弃，不是喜爱。魏国已经保不住这两座城。"},{"word":"从","note":"「合从」「从长」的从读 zòng，指合纵和纵约长，不是跟从，也不是由这里到那里。"}],"phoneticLoans":[{"word":"从","reading":"zòng","note":"「合从」的从通「纵」，指战国时南北相连的联盟。"}],"flexibleUsage":[{"word":"咎","reading":"jiù","note":"「以咎春申君」的咎是责备、归罪，名词用作动词。楚王把函谷之败算到春申君身上。"},{"word":"善","reading":"shàn","note":"「秦善楚」的善是与之交好，形容词用作动词。先君时秦楚维持了二十年和平。"},{"word":"阻","reading":"zǔ","note":"「阻其山」的阻是依仗山险阻挡敌人，名词性的险阻用作动词。卫元君靠野王的山守河内。"}],"specialSyntax":[{"name":"反问","note":"「二十年而不攻楚，何也」先摆出二十年不攻的事实，再追问原因。下面两句就回答：逾塞不便，借道也不可。"}]}}
