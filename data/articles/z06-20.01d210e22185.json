extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"秦王担心他起事作乱，就赐给文信侯一封书说：「您对秦国有什么功劳，竟把您封在河南，让您享用十万户的租税？","tokens":[{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"恐","s":"恐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"為","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"變","s":"变","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"乃","s":"乃","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"賜","s":"赐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"文","s":"文","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"信","s":"信","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"侯","s":"侯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"書","s":"书","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"：","s":"：","punct":true},{"t":"「","s":"「","punct":true},{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"何","s":"何","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"功","s":"功","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"秦","s":"秦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"封","s":"封","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"河","s":"河","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"南","s":"南","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"食","s":"食","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"十","s":"十","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"萬","s":"万","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"戶","s":"户","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"？","s":"？","punct":true}]},{"tr":"您跟秦国有什么亲属关系，竟能号称仲父？","tokens":[{"t":"何","s":"何","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"親","s":"亲","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"秦","s":"秦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"號","s":"号","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"稱","s":"称","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"仲","s":"仲","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"父","s":"父","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"？","s":"？","punct":true}]},{"tr":"你带着家属迁到蜀地去住！」","tokens":[{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"與","s":"与","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"家","s":"家","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"屬","s":"属","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"徙","s":"徙","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"處","s":"处","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"蜀","s":"蜀","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"！","s":"！","punct":true},{"t":"」","s":"」","punct":true}]},{"tr":"文信侯心里清楚，自己的地位正一步步被侵削，害怕会被杀掉。","tokens":[{"t":"文","s":"文","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"信","s":"信","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"侯","s":"侯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"自","s":"自","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"知","s":"知","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"稍","s":"稍","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"侵","s":"侵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"恐","s":"恐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"誅","s":"诛","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"前236年，秦王在位第十一年。赵国攻燕，夺取貍、阳，军队还没撤回，秦将王翦、桓𬺈、杨端和便攻赵，攻邺取九城，又分别取得阏与、轑阳、邺、安阳。同年赵悼襄王去世，儿子迁即位，他的母亲原是倡，因受宠而使他取代嫡子嘉。文信侯就国一年多，诸侯使者络绎来请，秦王怕他生变，赐书追问功和亲，命令他与家属迁往蜀地。","theme":"这一年秦对赵的进攻和赵国的废嫡立幼叠在一起。赵军还在燕地，秦已经取走九城。新君迁素来没有好品行，能够即位只是因为母亲得宠，嫡子嘉被废。另一条线是文信侯的末路：诸侯仍争着请他，秦王用一封书信勾销河南十万户和仲父的名号，直接令他徙处蜀。功和亲两问，都没有留下辩解的余地。","technique":"前半是短编年。战事只排列将名和城名，不写交战过程。赵王去世用三句交代继位、母亲的身份和迁的无行，废嫡的后果先埋在这里。后半把冲突收进一封赐书，连续两问之后，第三句用「其」直接下令迁蜀，不写文信侯的答书。末句只记他自知稍侵、恐诛，死留到下一年。没有长篇对话，也没有「臣光曰」。","keyContentWords":[{"word":"无行","reading":"wú xíng","note":"没有善行，品行不好。迁还没有即位，国内已经因为他的无行而知道他。"},{"word":"仲父","reading":"zhòng fǔ","note":"仅次于父的尊称，父读 fǔ。秦王质问文信侯跟秦没有亲属，凭什么得到这个称呼。"},{"word":"嫡子","reading":"dí zǐ","note":"正妻所生的儿子。嘉是嫡子，悼襄王因为他的母亲失势、倡母得宠而把他废掉。"}],"keyFunctionWords":[{"word":"其","reading":"qí","note":"「其与家属徙处蜀」的其表示命令，相当于「你要」，不是「他的」。"},{"word":"于","reading":"yú","note":"「何功于秦」「何亲于秦」的于引进对象，相当于「对于」。"}],"ancientModern":[{"word":"倡","reading":"chāng","note":"「其母，倡也」的倡读 chāng，是以歌舞为业的人，不是提倡、倡导的 chàng。"},{"word":"稍","reading":"shāo","note":"「稍侵」的稍是渐渐，不是今天「稍微」的意思。文信侯感到自己被一步步侵削。"},{"word":"罢","reading":"bà","note":"「兵未罢」的罢是收兵、撤回，不是罢免官职。"},{"word":"闻","reading":"wén","note":"「闻于国」是名声传到国中、人人知道，不是用鼻子闻。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"食","reading":"shí","note":"「食十万户」的食是动词，表示享用十万户交纳的租税，不是坐下来吃饭。"}],"specialSyntax":[{"name":"判断句","note":"「其母，倡也」用「……也」判断迁的母亲是什么身份。"},{"name":"状语后置","note":"「相望于道」把「于道」放在动词后面，表示使者在道路上前后相望，人很多。"}]}}
