s":"易","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"宗","s":"宗","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"吕不韦干下的这种盗，真是钻墙洞的小偷里最了得的一个！","tokens":[{"t":"呂","s":"吕","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"韋","s":"韦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"盜","s":"盗","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"穿","s":"穿","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"窬","s":"窬","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"雄","s":"雄","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乎","s":"乎","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"！","s":"！","punct":true}]},{"tr":"讲到钻墙洞的小偷，我只见过他们拿走一担一石，从没见过谁把雒阳也拿走。」","tokens":[{"t":"穿","s":"穿","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"窬","s":"窬","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"吾","s":"吾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"見","s":"见","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"擔","s":"担","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"石","s":"石","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"矣","s":"矣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"未","s":"未","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"見","s":"见","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"雒","s":"雒","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"陽","s":"阳","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true},{"t":"」","s":"」","punct":true}]}]},{"sentences":[{"tr":"从六月起没有下雨，一直持续到八月。","tokens":[{"t":"自","s":"自","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"六","s":"六","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"月","s":"月","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"雨","s":"雨","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"至","s":"至","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"八","s":"八","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"月","s":"月","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]},{"sentences":[{"tr":"调发四个郡的军队，去帮助魏国攻打楚国。","tokens":[{"t":"發","s":"发","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"四","s":"四","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"郡","s":"郡","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"兵","s":"兵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"助","s":"助","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"魏","s":"魏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"伐","s":"伐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"楚","s":"楚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"前235年，秦王在位第十二年。文信侯在被责令迁蜀之后喝毒酒死去，下葬也不公开，前来哭吊的舍人被赶走。秦王随即下令，把嫪毐和不韦当作掌管国事而无道的样本，以后遇到这类人都要籍没门户。扬子《法言》用一段问答，把不韦从「智」改说成「盗」。同一年从六月到八月不下雨，秦又征发四郡兵帮助魏国攻楚。","theme":"这一年要记住文信侯的结局不是公开伏诛，而是饮毒酒、被窃葬，连吊丧的人都受到牵连。禁令把嫪毐和不韦并列，用「视此」把一个人的下场变成以后的通例。扬子的问答则认为，拿人换货物算不上聪明，真正发生的交换是国家连着宗族一起被搭进去；普通穿窬最多拿走担石，没有人拿走过雒阳。旱和出兵两句，把这一年拉回秦的天时和对外用兵。","technique":"叙事先压缩成三句：怎样死，怎样葬，怎样下禁令。禁令用「自今以来」和「视此」，从个案跳到常法。接着整段接入扬子《法言》的问答，问者只给「以人易货」，答者用「以国易宗」对翻，再用穿窬、担石、雒阳作比。这是引用前人的话，不是「臣光曰」。天不雨和发四郡兵另起两条编年，不与前面的评论缠在一起。","keyContentWords":[{"word":"窃葬","reading":"qiè zàng","note":"不按公开的礼仪下葬，而是私下埋葬。文信侯死后没有得到正式的葬礼。"},{"word":"穿窬","reading":"chuān yú","note":"穿是把墙壁挖通，窬是墙上的洞。合起来指钻洞翻墙的小偷。扬子用它给吕不韦的行为定性。"},{"word":"易","reading":"yì","note":"交换。「以人易货」是拿人换货物；「以国易宗」用同一个句式说他拿国家换掉了宗族。问的人觉得这是聪明，答的人觉得宗族因此赔了进去。"},{"word":"担石","reading":"dàn shí","note":"担和石都是很小的计量。扬子拿它和雒阳对照，说普通小偷只能拿走一点点。"}],"keyFunctionWords":[{"word":"且","reading":"qiě","note":"「且曰」的且是并且。前面已经写了哭吊的人被迁走，这里再补出一条禁令。"},{"word":"者","reading":"zhě","note":"「临者」指前来哭吊的那一类人，「如嫪毐、不韦者」指像他们那样的人。者把前面的话收成一类人。"},{"word":"欤","reading":"yú","note":"「谁谓不韦智者欤」的欤是疑问语气。这句话表面在问，实际是否认有人能称不韦为智者。"}],"ancientModern":[{"word":"临","reading":"lìn","note":"「临者」的临读 lìn，是到丧礼上哭吊，不是来临、面临的 lín。"},{"word":"宗","reading":"zōng","note":"「以国易宗」的宗是宗族、祖先这一系，不是宗教，也不是宗旨。"},{"word":"视","reading":"shì","note":"「视此」是照这次的做法看待、办理，用来警告后来的人，不是单纯用眼睛看。"}],"phoneticLoans":[{"word":"酖","reading":"zhèn","note":"「饮酖」的酖读 zhèn，同「鸩」，指毒酒。文信侯是喝毒酒死去的。"}],"flexibleUsage":[{"word":"籍","reading":"jí","note":"「籍其门」的籍是登记并抄没门户，名词用作动词。这一家要按犯罪的门户处置。"}],"specialSyntax":[{"name":"反问句","note":"「谁谓不韦智者欤」不是在寻找说这句话的人，而是用反问否定不韦的智。"},{"name":"提起论题","note":"「穿窬也者」用「也者」把穿窬提出来，下面才用担石和雒阳说明这种小偷的分量。"}]}}
