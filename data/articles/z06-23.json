tra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"？","s":"？","punct":true},{"t":"」","s":"」","punct":true}]},{"tr":"「君子按礼来行动，按义来停止，合于道就前进，不合就退下来，心意坚定，并不发愁自己不能投合。","tokens":[{"t":"「","s":"「","punct":true},{"t":"君","s":"君","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"禮","s":"礼","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"動","s":"动","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"義","s":"义","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"止","s":"止","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"合","s":"合","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"則","s":"则","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"進","s":"进","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"否","s":"否","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"則","s":"则","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"退","s":"退","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"確","s":"确","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乎","s":"乎","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"憂","s":"忧","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"合","s":"合","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"去游说别人，心里却愁自己的话投合不上，那就什么事都做得出来了。」","tokens":