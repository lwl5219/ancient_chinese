:"劫","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"必","s":"必","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"得","s":"得","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"約","s":"约","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"契","s":"契","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"報","s":"报","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"太","s":"太","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"！","s":"！","punct":true},{"t":"」","s":"」","punct":true}]},{"tr":"于是把荆轲肢解，用来示众。","tokens":[{"t":"遂","s":"遂","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"體","s":"体","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"解","s":"解","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"荊","s":"荆","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"軻","s":"轲","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"徇","s":"徇","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"秦王因此大怒，增派军队到赵地，会合王翦去攻打燕国，与燕军、代军在易水西边交战，把他们打得大败。","tokens":[{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"是","s":"是","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"大","s":"大","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"怒","s":"怒","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"益","s":"益","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"發","s":"发","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"兵","s":"兵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"詣","s":"诣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"趙","s":"赵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"就","s":"就","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"翦","s":"翦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"伐","s":"伐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"燕","s":"燕","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"與","s":"与","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"燕","s":"燕","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"師","s":"师","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"代","s":"代","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"師","s":"师","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"戰","s":"战","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"易","s":"易","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"水","s":"水","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"西","s":"西","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"大","s":"大","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"破","s":"破","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"秦始皇二十年，荆轲到达咸阳，靠秦王宠臣蒙嘉求见。秦王穿朝服，用九宾礼接见。地图展尽，匕首露出，行刺没有刺中，荆轲被肢解示众。秦王大怒，增兵赶到赵地，会合王翦攻燕，在易水以西大破燕军和代军。上一年备好的头颅和地图，在本年殿上用完。","theme":"这一年要记住行刺的现场和它立刻带来的后果。荆轲抓住袖子却没刺到身上，秦王绕柱奔逃，殿上的人按秦法不能带兵器，靠喊「王负剑」才拔出长剑，砍断荆轲左腿。荆轲临死说明自己本想活捉秦王、取得约定再回报太子。刺秦没有换成合纵，只换成易水之西的大败。","technique":"咸阳殿上几乎全是动作：进图、匕首出现、抓袖、袖断、追逐、绕柱，一句接一句。中间插入秦法「不得操尺寸之兵」，解释群臣为什么只能用手搏斗。荆轲的骂留下动机，点明他要的是活捉而不是一刺。末句从殿上跳到易水之西，用「大怒」「益发兵」把行刺和伐燕接上。没有「臣光曰」。","keyContentWords":[{"word":"九宾","reading":"jiǔ bīn","note":"用九位僚相依次传呼的隆重接待礼。秦王以此接见荆轲，说明他把献图看成大事。"},{"word":"图穷","reading":"tú qióng","note":"地图展到尽头。穷是尽，匕首就卷在图的末端，展完才露出来。"},{"word":"负剑","reading":"fù jiàn","note":"把长剑转到背上，以便拔出。殿上的人这样喊，秦王才砍断荆轲的腿。"},{"word":"体解","reading":"tǐ jiě","note":"把肢体分解。行刺失败后，荆轲被这样处死并拿去示众。"}],"keyFunctionWords":[{"word":"因","reading":"yīn","note":"「因王宠臣蒙嘉」的因是凭借、通过，荆轲靠蒙嘉才能把求见的话送到秦王面前。"},{"word":"以","reading":"yǐ","note":"「奉图以进」的以连接前后两个动作，捧着地图然后上前；「体解荆轲以徇」的以表示用来示众。"}],"ancientModern":[{"word":"见","note":"「匕首见」的见读 xiàn，是显露出来，不是看见。"},{"word":"卒","note":"「卒起不意」的卒读 cù，是突然，同「猝」，不是士兵，也不是终于。"},{"word":"度","note":"「尽失其度」的度是常态、举止的分寸，不是计算用的度数。"},{"word":"股","note":"「断其左股」的股是大腿，不是今天股份的股。"},{"word":"益","note":"「益发兵」的益是更加、增派，不是利益。"}],"phoneticLoans":[{"word":"卒","reading":"cù","note":"「卒起不意」的卒通「猝」，突然发生。"}],"flexibleUsage":[{"word":"朝服","reading":"cháo fú","note":"「王大喜，朝服」的朝服在这里作动词，穿上朝会的礼服。"},{"word":"负","reading":"fù","note":"「王负剑」的负是把剑背到身后，动词，不是辜负。"}],"specialSyntax":[{"name":"所以……者","note":"「事所以不成者，以欲生劫之」先用「所以……者」提出失败的原因，再用「以」说明是因为想活捉。"},{"name":"插入说明","note":"「而秦法，群臣侍殿上者不得操尺寸之兵」在追逐之间插入法律，解释左右为什么手无兵器。"}]}}
