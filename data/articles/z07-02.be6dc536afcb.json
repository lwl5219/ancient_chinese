,"ctx":"","pos":"","extra":"","level":"dict"},{"t":"萬","s":"万","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true},{"t":"」","s":"」","punct":true}]},{"tr":"秦王又拿这件事问王翦，王翦说：「没有六十万人就不行。」","tokens":[{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"問","s":"问","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"翦","s":"翦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"翦","s":"翦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"：","s":"：","punct":true},{"t":"「","s":"「","punct":true},{"t":"非","s":"非","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"六","s":"六","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"十","s":"十","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"萬","s":"万","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"可","s":"可","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true},{"t":"」","s":"」","punct":true}]},{"tr":"秦王说：「王将军年纪大了，怎么这样胆怯！」","tokens":[{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"：","s":"：","punct":true},{"t":"「","s":"「","punct":true},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"將","s":"将","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"軍","s":"军","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"老","s":"老","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"矣","s":"矣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"何","s":"何","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"怯","s":"怯","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"！","s":"！","punct":true},{"t":"」","s":"」","punct":true}]},{"tr":"于是派李信、蒙武率领二十万人攻打楚国；王翦便称病辞归，回到频阳。","tokens":[{"t":"遂","s":"遂","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"使","s":"使","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"李","s":"李","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"信","s":"信","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"蒙","s":"蒙","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"武","s":"武","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"將","s":"将","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"二","s":"二","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"十","s":"十","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"萬","s":"万","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"伐","s":"伐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"楚","s":"楚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"；","s":"；","punct":true},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"翦","s":"翦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"因","s":"因","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"謝","s":"谢","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"病","s":"病","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"歸","s":"归","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"頻","s":"频","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"陽","s":"阳","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"秦始皇二十一年冬十月，王翦攻下燕都蓟。燕王和太子丹率精兵东保辽东，李信追击。代王嘉写信让燕王杀掉太子丹献给秦，燕王照做，秦军仍继续进攻。同年王贲攻楚，取得十多座城。秦王问灭楚需要多少人，李信说二十万，王翦说非六十万不可。秦王笑王翦胆怯，派李信、蒙武带二十万伐楚，王翦称病回到频阳。","theme":"燕国这一年失去蓟，又失去太子丹，却没有换来秦军停手。代王嘉的信把上一年的行刺收成一颗头颅。更要记住的是伐楚的人数之争：李信二十万，王翦六十万，秦王用「老了」「为何胆怯」否定老将。王翦谢病回到频阳，把后来的胜负先留在这个选择上。","technique":"前半仍是短编年：拔蓟、东保、追击、送信、斩丹、继续进兵，因果接得很紧，没有辩解。后半改成殿上问答，三个人的话都极短，只留下二十万、六十万和「何怯」。作者不再解释谁对，只用「谢病归频阳」把王翦送出战场。没有「臣光曰」。","keyContentWords":[{"word":"精兵","reading":"jīng bīng","note":"精锐部队。蓟失守后，燕王和太子只带着这支军队退往辽东。"},{"word":"谢病","reading":"xiè bìng","note":"以生病为理由推辞。王翦不被采用之后，以此离开，回到频阳。"},{"word":"频阳","reading":"pín yáng","note":"王翦归去的地方。他辞去伐楚的将职后回到这里。"},{"word":"衍水","reading":"yǎn shuǐ","note":"太子丹躲藏的河流一带。燕王的使者就在这里把他杀掉。"}],"keyFunctionWords":[{"word":"以","reading":"yǐ","note":"「令杀太子丹以献」「欲以献王」的以是「用来」，杀丹是为了献给秦王。"},{"word":"于","reading":"yú","note":"「王问于将军李信」的于介绍询问的对象，后面的「于将军度」则是在李信的估量之中。"}],"ancientModern":[{"word":"拔","note":"「拔蓟」的拔是攻克城池，不是把东西拔出来。"},{"word":"保","note":"「东保辽东」的保是退到那里据守，不是泛泛的保护。"},{"word":"遗","note":"「遗燕王书」的遗读 wèi，是送给，不是遗失、遗传。"},{"word":"度","note":"「于将军度」的度读 duó，是估计、揣量，不是尺度、风度。"},{"word":"谢","note":"「谢病」的谢是推辞，不是感谢。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"将","reading":"jiàng","note":"「将二十万人伐楚」的将是率领，动词。"}],"specialSyntax":[{"name":"双重否定","note":"「非六十万人不可」用「非……不可」表示一定要有六十万人，语气比直说需要更硬。"},{"name":"使令","note":"「使使斩丹」前一个使是派遣，后一个使是使者，连用表示燕王派人去执行斩杀。"}]}}
