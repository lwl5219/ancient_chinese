{"id":"z07-02","volume":7,"volumeTitle":"秦纪二","volumeSubtitle":"前226","index":2,"title":{"t":"始皇帝二十一年","s":"始皇帝二十一年"},"book":{"t":"資治通鑑","s":"资治通鉴"},"sourceHead":{"t":"秦紀二 · 前226 · 乙亥","s":"秦纪二 · 前226 · 乙亥"},"author":"司马光","annotated":true,"paragraphs":[{"sentences":[{"tr":"冬天十月，王翦打下蓟城。燕王和太子带着精锐部队往东退守辽东，李信在后面紧追。","tokens":[{"t":"冬","s":"冬","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"十","s":"十","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"月","s":"月","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"翦","s":"翦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"拔","s":"拔","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"薊","s":"蓟","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"燕","s":"燕","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"及","s":"及","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"太","s":"太","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"率","s":"率","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"精","s":"精","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"兵","s":"兵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"東","s":"东","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"保","s":"保","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"遼","s":"辽","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"東","s":"东","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"李","s":"李","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"信","s":"信","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"急","s