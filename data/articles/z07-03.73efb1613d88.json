t":"善","s":"善","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"田","s":"田","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"五","s":"五","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"輩","s":"辈","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"有人说：「将军这样乞求赏赐，未免也太过分了！」","tokens":[{"t":"或","s":"或","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"：","s":"：","punct":true},{"t":"「","s":"「","punct":true},{"t":"將","s":"将","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"軍","s":"军","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乞","s":"乞","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"貸","s":"贷","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"亦","s":"亦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"已","s":"已","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"甚","s":"甚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"矣","s":"矣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"！","s":"！","punct":true},{"t":"」","s":"」","punct":true}]},{"tr":"王翦说：「不是这个道理。","tokens":[{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"翦","s":"翦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"：","s":"：","punct":true},{"t":"「","s":"「","punct":true},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"然","s":"然","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"大王内心粗疏，不肯信任旁人。现在把国中的甲士全部调空，单独交给我。我要是不多请求田宅当作子孙的产业，好借此稳住自己，反倒会让大王坐在那里怀疑我。」","tokens":[{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"怚","s":"怚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"中","s":"中","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"信","s":"信","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"今","s":"今","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"空","s":"空","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"國","s":"国","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"中","s":"中","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"甲","s":"甲","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"士","s":"士","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"專","s":"专","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"委","s":"委","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"我","s":"我","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"我","s":"我","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"多","s":"多","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"請","s":"请","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"田","s":"田","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"宅","s":"宅","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"為","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"孫","s":"孙","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"業","s":"业","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"自","s":"自","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"堅","s":"坚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"顧","s":"顾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"令","s":"令","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"坐","s":"坐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"疑","s":"疑","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"我","s":"我","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"矣","s":"矣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true},{"t":"」","s":"」","punct":true}]}]}],"lesson":{"background":"前225年是秦王政二十二年。韩、赵已灭，燕太子丹刺秦失败之后，秦军继续东进。王贲是王翦之子，这一年负责攻魏。魏都大梁被河沟灌塌，魏王假投降后被杀，魏作为诸侯国消失。安陵是魏先王封出去的小邑，安陵君不肯用它交换五百里地，秦王反而许可他继续守着。同时李信、蒙武攻楚先胜后败，秦王亲自到频阳向称病的王翦道歉，答应给他六十万人。","theme":"这一年并列着两种结局。魏王假守不住大梁，人被杀，国被灭；安陵君守着先王给的小地，拒绝以小换大，秦王却称许他的义。攻楚则是另一层：李信破了鄢郢，仍在城父被楚军三日三夜咬住，折损七个都尉。王翦把出山的条件说死，必须六十万人，上路以后又不断讨田宅。他让秦王看见的是一个只为子孙置产的将军，从而稳住手握全国甲士的自己。","technique":"这一年没有「臣光曰」，全靠短编年和对话。灭魏只用三句，灌城、城坏、杀降连在一起。安陵君的拒绝是一段完整的对答，秦王的决定收在「义而许之」四个字里。李信之败写成一个长句，破、引、会、随、不顿舍、大败、入壁、杀都尉、奔还顺次堆下，中间几乎不解释。王翦的心理留到旁人指责乞贷之后才说破，秦王本人只听到田宅和子孙，于是大笑。","keyContentWords":[{"word":"河沟","reading":"hé gōu","note":"用来放水灌城的河道、沟渠。大梁的城墙是被这股水泡坏的。"},{"word":"顿舍","reading":"dùn shè","note":"停下并住宿。三日三夜不顿舍，是说楚军紧追不休息、不扎营。"},{"word":"都尉","reading":"dū wèi","note":"秦军里的中级武官。一仗被杀七个，可见李信败得惨。"},{"word":"乞贷","reading":"qǐ dài","note":"开口向人求赏。这里不是暂借后再还，而是向秦王索取田宅。"},{"word":"自坚","reading":"zì jiān","note":"把自己的立场做扎实，让秦王相信他只图家产，从而不疑心他拥兵。"}],"keyFunctionWords":[{"word":"以","reading":"yǐ","note":"「引河沟以灌大梁」的以，表示目的，相当于用来。"},{"word":"弗","reading":"fú","note":"「弗敢易」的弗等于不。不敢交换的，就是先王所授的那块地。"},{"word":"顾","reading":"gù","note":"「顾令王坐而疑我」的顾，是语气一转，相当于反而。"},{"word":"为","reading":"wéi","note":"「为听将军计耳」的为读 wéi，相当于只、不过。同篇「为大王将」「为子孙业」的为读 wèi，是替、给。"},{"word":"及","reading":"jí","note":"「及大王之向臣」的及，是趁着某个时候还在。趁秦王仍看重他，把田宅求到手。"}],"ancientModern":[{"word":"谢","note":"「谢王翦」是道歉；「谢病」是拿生病做理由推辞。两处都不是今天道谢的谢。"},{"word":"虽然","note":"这里的虽然先接住「以大易小，甚幸」，意思是即便如此，下面才转出不肯换。不宜读成「虽然我受地于先王」这种让步从句。"},{"word":"向","note":"「大王之向臣」的向，是偏向、看重，不是东向西向的方向。"},{"word":"壁","note":"「入两壁」的壁，是军营的壁垒。楚军攻破的是两座营垒，不是房屋的墙壁。"},{"word":"辈","note":"「五辈」的辈是一批人。使者回去求田，先后去了五拨，不是辈分。"},{"word":"城","note":"「城坏」的城是城墙。三月被水泡垮的是墙，不是笼统地说一座城市坏了。"}],"phoneticLoans":[{"word":"怚","reading":"cū","note":"「王怚中」的怚用法同「粗」。怚中是内心粗疏、容易猜忌，不是害怕。"}],"flexibleUsage":[{"word":"义","reading":"yì","note":"「王义而许之」的义，是认为安陵君做得对。形容词用作意动。"},{"word":"西","reading":"xī","note":"「引兵而西」的西，是向西行军。方位名词用作动词。"},{"word":"空","reading":"kòng","note":"「空国中之甲士」的空，是把甲士调空。形容词用作使动。"}],"specialSyntax":[{"name":"反问句","note":"「独忍弃寡人乎」「何忧贫乎」都是反问。前一句逼王翦不要弃王而去，后一句说王翦不必忧贫。"},{"name":"固定句式","note":"「非六十万人不可」是「非……不可」，表示少了这个条件就不行。"},{"name":"省略句","note":"「杀之」承前省去施事，被杀的是已经投降的魏王假。"}]}}
