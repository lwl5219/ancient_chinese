":true},{"t":"」","s":"」","punct":true}]},{"tr":"回报说：「正在扔石较力，也在跳跃比远。」","tokens":[{"t":"對","s":"对","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"：","s":"：","punct":true},{"t":"「","s":"「","punct":true},{"t":"方","s":"方","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"投","s":"投","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"石","s":"石","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"、","s":"、","punct":true},{"t":"超","s":"超","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"距","s":"距","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true},{"t":"」","s":"」","punct":true}]},{"tr":"王翦说：「这支军队可以派上用场了！」","tokens":[{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"翦","s":"翦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"：","s":"：","punct":true},{"t":"「","s":"「","punct":true},{"t":"可","s":"可","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"用","s":"用","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"矣","s":"矣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"！","s":"！","punct":true},{"t":"」","s":"」","punct":true}]},{"tr":"楚军既然求战不得，就领兵向东撤去。","tokens":[{"t":"楚","s":"楚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"既","s":"既","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"不","s":"不","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"得","s":"得","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"戰","s":"战","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"乃","s":"乃","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"引","s":"引","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"東","s":"东","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"王翦追上去，命令壮士出击，把楚军打得大败，直追到蕲南，杀死他们的将军项燕，楚军于是溃散逃走。","tokens":[{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"翦","s":"翦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"追","s":"追","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"令","s":"令","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"壯","s":"壮","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"士","s":"士","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"擊","s":"击","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"大","s":"大","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"破","s":"破","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"楚","s":"楚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"師","s":"师","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"至","s":"至","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"蘄","s":"蕲","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"南","s":"南","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"殺","s":"杀","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"將","s":"将","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"軍","s":"军","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"項","s":"项","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"燕","s":"燕","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"楚","s":"楚","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"師","s":"师","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"遂","s":"遂","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"敗","s":"败","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"走","s":"走","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"王翦趁着胜势，攻取并平定沿途城邑。","tokens":[{"t":"王","s":"王","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"翦","s":"翦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"因","s":"因","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乘","s":"乘","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"勝","s":"胜","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"略","s":"略","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"定","s":"定","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"城","s":"城","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"邑","s":"邑","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"前224年是秦王政二十三年。前一年李信攻楚失败，秦王改用王翦，并把六十万人交给他。这一年王翦已经打下陈以南直到平舆的地带，正是李信曾经进攻的区域。楚国得知秦军兵力大增，动员国中全部军队来挡。王翦的对策是坚壁不出，用休息、洗沐和同食把士气养起来，直到军中自己开始投石、超距。","theme":"这一年要记住王翦怎样把一支大军用到火候上。楚人倾国来战，他不接挑战；楚人求战不得，只好向东撤退。撤退一开始，他才令壮士追击，在蕲南杀死楚将项燕，楚师败走，城邑随胜势被平定。项燕一死，楚国的主力垮了，但楚王负刍还要到下一年才被俘虏。这一年的胜负，先决在谁更能等待。","technique":"叙事几乎不发议论，节奏前慢后快。前面反复写「不与战」「终不出」，再用洗沐、饮食、抚循、同食一组细事把等待写实。全篇对话只有三句：军中戏乎，方投石、超距，可用矣。问答本身就是判断士气的方法。楚军东撤之后，追、击、破、杀、败走、略定连成一串，项燕之死只是追击句中的一个分句，没有单独的悼词。","keyContentWords":[{"word":"洗沐","reading":"xǐ mù","note":"洗澡、洗头。古代常借洗沐给吏卒放假。这里天天如此，是让军队在营里养足精神。"},{"word":"抚循","reading":"fǔ xún","note":"抚慰并时时照看。王翦不只发粮食，还亲自把士兵的生活安顿好。"},{"word":"超距","reading":"chāo jù","note":"军中跳跃比远的游戏，用来较量腿脚。和投石一样，说明士兵已经有余力。"},{"word":"坚壁","reading":"jiān bì","note":"加固营垒并守在里面。壁是军营的壁垒。王翦以此拒绝楚人的挑战。"},{"word":"项燕","reading":"xiàng yān","note":"楚军主将。燕在这个名字里读 yān。他在蕲南被杀，楚师随之败走。"}],"keyFunctionWords":[{"word":"数","reading":"shuò","note":"「楚人数挑战」的数读 shuò，是屡次。不是数目的 shù，也不是数数的 shǔ。"},{"word":"方","reading":"fāng","note":"「方投石、超距」的方，是正在。士兵此刻正在游戏，不是方圆的方。"},{"word":"既","reading":"jì","note":"「楚既不得战」的既，是已经、既然。仗打不成，才有后面的东撤。"},{"word":"之","reading":"zhī","note":"「久之」的之凑足音节，没有实指；「追之」「抚循之」的之才分别指楚军和士卒。"}],"ancientModern":[{"word":"戏","note":"「军中戏乎」的戏，是游戏、比试力气，不是戏曲。王翦要听的是士兵有没有玩起来。"},{"word":"略","note":"「略定城邑」的略，是攻取、占领。不是省略，也不是粗略。"},{"word":"益","note":"「益军而来」的益，是增加。楚人害怕的是王翦把兵力加多了，不是受益的益。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"日","reading":"rì","note":"「日休士洗沐」的日，是每天。名词用作状语。"},{"word":"东","reading":"dōng","note":"「引而东」的东，是向东撤退。方位名词用作动词。"},{"word":"善","reading":"shàn","note":"「善饮食」的善，是把饮食办好、让士兵吃得丰足。形容词用作动词。"}],"specialSyntax":[{"name":"省略句","note":"「终不出」省去主语王翦或秦军。「不与战」是不与之战，介词与的宾语之也省去了。"},{"name":"连动句","note":"追击的一句里，追、令壮士击、大破、至蕲南、杀项燕、败走接连发生，主语到「楚师遂败走」才换到楚军。"}]}}
