,"level":"dict"},{"t":"堤","s":"堤","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"坊","s":"坊","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"秦始皇巡视北方边境，从上郡进入。","tokens":[{"t":"始","s":"始","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"皇","s":"皇","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"巡","s":"巡","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"北","s":"北","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"邊","s":"边","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"從","s":"从","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"上","s":"上","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"郡","s":"郡","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"入","s":"入","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"卢生奉命入海回来，趁机奏上《录图书》，书里说：「会使秦灭亡的，是胡。」","tokens":[{"t":"盧","s":"卢","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"生","s":"生","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"使","s":"使","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"入","s":"入","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"海","s":"海","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"還","s":"还","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"因","s":"因","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"奏","s":"奏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"《","s":"《","punct":true},{"t":"錄","s":"录","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"圖","s":"图","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"書","s":"书","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"》","s":"》","punct":true},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"：","s":"：","punct":true},{"t":"「","s":"「","punct":true},{"t":"亡","s":"亡","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"秦","s":"秦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"胡","s":"胡","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"也","s":"也","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true},{"t":"」","s":"」","punct":true}]},{"tr":"秦始皇于是派将军蒙恬出动三十万人，向北攻打匈奴。","tokens":[{"t":"始","s":"始","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"皇","s":"皇","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"乃","s":"乃","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"遣","s":"遣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"將","s":"将","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"軍","s":"军","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"蒙","s":"蒙","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"恬","s":"恬","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"發","s":"发","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"兵","s":"兵","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"三","s":"三","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"十","s":"十","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"萬","s":"万","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"人","s":"人","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"北","s":"北","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"伐","s":"伐","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"匈","s":"匈","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"奴","s":"奴","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"秦始皇三十二年，公元前215年。他巡行到碣石，派燕人卢生寻找仙人羡门，又在碣石门刻石，并拆城决堤。随后巡视北边，从上郡回来。卢生入海归来，呈上《录图书》，里面有「亡秦者胡也」一句。始皇把这句话理解成北方的胡人，派蒙恬率三十万军队北伐匈奴。","theme":"这一年的枢纽是那句预言。求仙的卢生带回图书，图书却说灭亡秦的是胡。始皇的反应不是再讨论仙人，而是立刻发兵三十万。北边的城郭、堤防被拆通，巡游也改到边境。胡这个字把求仙和战争接在了一起；后来断送秦朝的虽是身边的胡亥，本年文字本身指向的是北方。","technique":"仍是短编年，一句一个动作：到碣石、求羡门、刻石、坏城、决堤、巡北边、入海还、发兵。预言用卢生所奏的书中原句嵌进来，只有六个字，后面不再解释。蒙恬北伐紧接「乃」字，因果靠读者自己从「胡」连到匈奴。没有大臣辩论，也没有「臣光曰」。","keyContentWords":[{"word":"羡门","reading":"xiàn mén","note":"方士所说的仙人，上文出现过羡门子高。卢生此行是去寻找他。"},{"word":"录图书","reading":"lù tú shū","note":"卢生入海归来后奏上的图书，里面载着预言。亡秦者胡也就出在这本书里。"},{"word":"堤坊","reading":"dī fáng","note":"堤防。决通是把阻挡的堤坝挖开、使它贯通。坊在这里同防。"}],"keyFunctionWords":[{"word":"乃","reading":"nǎi","note":"「始皇乃遣将军蒙恬」的乃是于是。预言刚奏上，发兵就跟着来了。"},{"word":"因","reading":"yīn","note":"「因奏《录图书》」的因是趁机、就着这个机会。卢生回来以后才把书献上。"}],"ancientModern":[{"word":"胡","note":"「亡秦者胡也」的胡，秦人用来指北方胡人。这里不是后来的姓氏通称。始皇因此把兵锋指向匈奴。"},{"word":"使","note":"「卢生使入海还」的使是奉命出使。他是被派到海上再回来的人，不是现代「使、让」那种单纯的致使。"}],"phoneticLoans":[{"word":"坊","loan":"防","note":"「堤坊」的坊通「防」，读 fáng，指堤坝。不是牌坊、街坊的坊。"}],"flexibleUsage":[{"word":"坏","reading":"huài","note":"「坏城郭」是把城郭拆毁，动词。不是停在「城坏了」那种状态说明。"},{"word":"北","reading":"běi","note":"「北伐匈奴」的北是向北，方位名词用作状语。"}],"specialSyntax":[{"name":"判断句","note":"「亡秦者胡也」用者字提示要判断的对象，用也字收尾，判断使秦灭亡的是胡。"}]}}
