，","punct":true},{"t":"收","s":"收","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"河","s":"河","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"南","s":"南","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"地","s":"地","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"為","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"四","s":"四","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"十","s":"十","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"四","s":"四","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"縣","s":"县","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"修筑长城，顺着地形，用来控扼险要的关塞。","tokens":[{"t":"築","s":"筑","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"長","s":"长","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"城","s":"城","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"因","s":"因","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"地","s":"地","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"形","s":"形","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"用","s":"用","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"制","s":"制","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"險","s":"险","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"塞","s":"塞","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"长城从临洮起，直到辽东，绵延一万多里。","tokens":[{"t":"起","s":"起","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"臨","s":"临","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"洮","s":"洮","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"至","s":"至","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"遼","s":"辽","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"東","s":"东","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"延","s":"延","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"袤","s":"袤","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"萬","s":"万","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"餘","s":"余","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"里","s":"里","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"于是渡过黄河，占据阳山，弯弯曲曲地向北延伸。","tokens":[{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"是","s":"是","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"渡","s":"渡","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"河","s":"河","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"據","s":"据","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"陽","s":"阳","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"山","s":"山","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"逶","s":"逶","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"迤","s":"迤","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"北","s":"北","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"军队暴露在野外十多年。","tokens":[{"t":"暴","s":"暴","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"師","s":"师","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"於","s":"于","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"外","s":"外","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"十","s":"十","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"餘","s":"余","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"年","s":"年","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"蒙恬长期驻在上郡统辖这些军队，威势震动匈奴。","tokens":[{"t":"蒙","s":"蒙","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"恬","s":"恬","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"常","s":"常","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"居","s":"居","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"上","s":"上","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"郡","s":"郡","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"統","s":"统","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"治","s":"治","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"威","s":"威","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"振","s":"振","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"匈","s":"匈","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"奴","s":"奴","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]}]}],"lesson":{"background":"秦始皇三十三年，公元前214年。南边征发曾经逃亡的人、赘婿和商人去攻南越，在陆梁地设置桂林、南海、象郡，又把五十万被贬谪的百姓派去戍守五岭。北边则接上一年蒙恬的北伐：驱逐匈奴，收回河南地，设四十四县，并沿地形修长城，从临洮延伸到辽东。蒙恬驻在上郡指挥。","theme":"这一年是帝国同时向南、向北撑开边界。南边用罪犯、赘婿、商人和谪民换来三郡，让中原人与越人杂处；北边用长城和四十四县守住新收回的河南地。最该记住的数字是五十万戍岭的人和万余里的长城。军队在外十多年、威振匈奴，则把一年的出兵写成了长期驻守。","technique":"司马光把南、北两线分成两截，各自用短句罗列。南线一句里塞进兵源、地名、三郡和五十万人；北线从斥逐、收地、筑城、起讫、渡河、暴师，排到蒙恬居上郡。 「暴师于外十余年」超出本年，是把后来的长期驻军提前收束在出兵这一年。没有奏对，没有「臣光曰」。","keyContentWords":[{"word":"赘婿","reading":"zhuì xù","note":"到女家成婚、依附女方的女婿。秦把他们和逃亡者、商人一起征发为兵。"},{"word":"陆梁","reading":"lù liáng","note":"南越地区的称呼。攻取之后，在这里设置桂林、南海、象郡。"},{"word":"河南地","reading":"hé nán dì","note":"黄河河套以南的一片土地，不是今天的河南省。蒙恬从匈奴手里收回，设为四十四县。"},{"word":"延袤","reading":"yán mào","note":"伸展开的长度。这里说长城从临洮到辽东，绵延一万多里。"},{"word":"暴师","reading":"pù shī","note":"让军队暴露在野外，也就是长期留在边境。暴读 pù，不是粗暴。"}],"keyFunctionWords":[{"word":"以","reading":"yǐ","note":"「以谪徙民五十万人戍五岭」的以是用。被贬谪迁走的百姓被用来戍边。"}],"ancientModern":[{"word":"河","note":"「渡河」的河是黄河。前面的河南地也是就这条河说的，不能按今天的河网理解。"},{"word":"贾","note":"「贾人」是商人，贾读 gǔ。这里把商人连同逃亡者、赘婿一起征发为兵，不是姓氏。"},{"word":"振","note":"「威振匈奴」的振是震动、震慑，意思近于震。不是振兴匈奴。"}],"phoneticLoans":[],"flexibleUsage":[{"word":"北","reading":"běi","note":"「逶迤而北」的北是向北延伸，方位名词用在谓语的位置上。"}],"specialSyntax":[{"name":"状语后置","note":"「暴师于外十余年」是在野外让军队暴露。表示处所的「于外」放在动词后面，再补时间。"},{"name":"主语承前省略","note":"「起临洮至辽东」「于是渡河，据阳山」都不再重复写出长城或蒙恬，动作顺着上一句接下去。"}]}}
