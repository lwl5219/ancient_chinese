:"，","s":"，","punct":true},{"t":"而","s":"而","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"為","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"書","s":"书","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"籍","s":"籍","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"主","s":"主","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"危","s":"危","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"哉","s":"哉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"！","s":"！","punct":true},{"t":"」","s":"」","punct":true}]},{"tr":"子鱼说：「我从事的是没有用处的学问，了解我的只有朋友。","tokens":[{"t":"子","s":"子","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"魚","s":"鱼","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"曰","s":"曰","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"：","s":"：","punct":true},{"t":"「","s":"「","punct":true},{"t":"吾","s":"吾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"為","s":"为","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"用","s":"用","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"學","s":"学","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"知","s":"知","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"吾","s":"吾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"者","s":"者","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"惟","s":"惟","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"友","s":"友","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true}]},{"tr":"秦并不是我的朋友，我有什么危险！","tokens":[{"t":"秦","s":"秦","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"非","s":"非","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"吾","s":"吾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"友","s":"友","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"吾","s":"吾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"何","s":"何","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"危","s":"危","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"哉","s":"哉","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"！","s":"！","punct":true}]},{"tr":"我要把这些书藏起来，等将来有人来求；等到求书的时候到了，就没有祸患了。」","tokens":[{"t":"吾","s":"吾","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"將","s":"将","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"藏","s":"藏","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"之","s":"之","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"以","s":"以","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"待","s":"待","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"其","s":"其","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"求","s":"求","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"；","s":"；","punct":true},{"t":"求","s":"求","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"至","s":"至","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"，","s":"，","punct":true},{"t":"無","s":"无","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"患","s":"患","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"矣","s":"矣","py":"","ctx":"","pos":"","extra":"","level":"dict"},{"t":"。","s":"。","punct":true},{"t":"」","s":"」","punct":true}]}]}],"lesson":{"background":"秦始皇三十四年，公元前213年。朝廷先把审案不公、复审时故意或过失错判的官吏贬去修长城、驻南越。丞相李斯接着上书，认为天下已定，不该再让诸生拿私学非议法令，请求烧掉秦记以外的史书，以及博士官职掌之外的《诗》、《书》和百家语，并规定以吏为师。始皇批示可。魏人陈余为此警告孔鲋，孔鲋自称将把书藏起来等待来求的人。","theme":"这一年要记住的是焚书令怎样从一句「禁之便」铺成完整的刑罚。私藏要送去烧掉，相聚谈论《诗》、《书》要弃市，以古非今要灭族，知情不举与犯人同罪，三十天不烧就黥为城旦。医药、卜筮、种树之书留下，学法令只能向官吏学。孔鲋的回答把另一条线留下：书可以藏，等到有人来求再说。","technique":"本年开头仍是一句谪罚。主体改成李斯的长篇上书，从诸侯厚招游学说到党与成于下，再用「臣请」逐条列出烧什么、杀什么、留什么。始皇只有「可」一个字。陈余和子鱼的对话放在制书之后，用私人谈话接住公开禁令，不再加作者的评判。没有「臣光曰」。","keyContentWords":[{"word":"覆狱","reading":"fù yù","note":"把已经审过的案子再审一遍。故是故意错判，失是过失错判。这两种人和审案不公的吏一起被贬。"},{"word":"偶语","reading":"ǒu yǔ","note":"相对聚谈。禁令针对的是凑在一起谈论《诗》、《书》，处罚是弃市。"},{"word":"弃市","reading":"qì shì","note":"在闹市处死并暴露尸体。这是对偶语《诗》、《书》的刑罚。"},{"word":"城旦","reading":"chéng dàn","note":"天亮就去服役筑城的徒刑。命令下达三十天仍不烧书的人，刺字以后罚作城旦。"}],"keyFunctionWords":[{"word":"所","reading":"suǒ","note":"「非博士官所职」是博士官所掌管的；「所不去者」是不被烧掉的那些书。所字把后面的动作转成被处置的对象。"},{"word":"乎","reading":"hū","note":"「主势降乎上，党与成乎下」的乎相当于于，分别引出上面和下面。"}],"ancientModern":[{"word":"狱","note":"「治狱」「覆狱」的狱是案件，不是只指关人的监狱。"},{"word":"党","note":"「党与」是结成的同伙、朋党。不是现代的政党。"},{"word":"树","note":"「种树之书」的树和种连用，指栽种、培植。这类书和医药、卜筮一起被留下，不是单指种树的手册这个现代窄义。"},{"word":"籍","note":"「先王之籍」是先王传下来的典籍。陈余担心的是书被毁，不是户籍。"}],"phoneticLoans":[{"word":"黔","loan":"黥","note":"「黔为城旦」的黔通「黥」，读 qíng，是在脸上刺字。同篇「黔首」的黔仍是黑，两处不要混读。"}],"flexibleUsage":[{"word":"力","reading":"lì","note":"「力农工」是把力气用到农耕和手工业上，名词用作动词。"},{"word":"师","reading":"shī","note":"「不师今」是不效法当今，名词用作动词。同篇「以吏为师」的师仍是老师。"},{"word":"非","reading":"fēi","note":"「非当世」「非法教」「以古非今」的非都是非议、认为不对，用作动词。"},{"word":"族","reading":"zú","note":"「以古非今者族」的族是灭族，名词用作动词。谓语只有这一个字。"}],"specialSyntax":[{"name":"所字结构","note":"「所不去者，医药、卜筮、种树之书」先用所字指出保留的范围，再用三类书来说明。"},{"name":"者字短语作主语","note":"「以古非今者族」里，者字短语是被处罚的人，族是对他们施加的刑罚，中间不再加「则」或「之」。"}]}}
